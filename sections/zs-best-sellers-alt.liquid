{%- comment -%}
  ZAISEN Best Sellers — responsive eight-product collection carousel.
  Four visible per desktop view, all products shown in the mobile grid.
  Actual selected-variant compare-at pricing drives the discount badges.
  Previous product blocks can optionally override a matching product image/note.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign featured_collection = s.collection
  if featured_collection == blank
    assign featured_collection = collections['best-sellers']
  endif
  assign cta_link = s.button_link | default: featured_collection.url | default: routes.all_products_collection_url
  assign display_font = s.editorial_font
  assign font_light = display_font | font_modify: 'weight', '300'
  assign font_medium = display_font | font_modify: 'weight', '500'
  assign font_semibold = display_font | font_modify: 'weight', '600'
  assign font_bold = display_font | font_modify: 'weight', '700'
-%}
{%- if display_font != blank -%}
  {% style %}
    {{ display_font | font_face: font_display: 'swap' }}
    {% if font_light != blank %}{{ font_light | font_face: font_display: 'swap' }}{% endif %}
    {% if font_medium != blank %}{{ font_medium | font_face: font_display: 'swap' }}{% endif %}
    {% if font_semibold != blank %}{{ font_semibold | font_face: font_display: 'swap' }}{% endif %}
    {% if font_bold != blank %}{{ font_bold | font_face: font_display: 'swap' }}{% endif %}
    #zsp-{{ section.id }} {
      font-family: {{ display_font.family | json }}, {{ display_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  #zsp-{{ section.id }}{
    --zsp-white:{{ s.bg_color }};
    --zsp-ink:{{ s.heading_color }};
    --zsp-walnut:{{ s.wood_color }};
    --zsp-accent:{{ s.accent_color }};
    --zsp-description:{{ s.text_color }};
    --zsp-size:{{ s.heading_size }}px;
    --zsp-pt:{{ s.padding_top }}px;
    --zsp-pb:{{ s.padding_bottom }}px;
  }
{% endstyle %}

<section id="zsp-{{ section.id }}" class="zsp" aria-labelledby="zsp-heading-{{ section.id }}">
  <div class="zsp__inner">
    <header class="zsp__header">
      {%- if s.eyebrow != blank -%}
        <p class="zsp__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="zsp-heading-{{ section.id }}" class="zsp__title">
        <span class="zsp__title-light">{{ s.heading | escape }}</span>
        {%- if s.heading_emphasis != blank -%}
          <strong class="zsp__title-strong">{{ s.heading_emphasis | escape }}</strong>
        {%- endif -%}
      </h2>
      {%- if s.text != blank -%}
        <p class="zsp__description">{{ s.text | escape }}</p>
      {%- endif -%}
    </header>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="zsp__carousel-nav" role="group" aria-label="Best sellers carousel navigation">
        <button class="zsp__nav-button" type="button" data-zsp-prev aria-label="Previous best sellers" aria-controls="zsp-products-{{ section.id }}" disabled>
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
        </button>
        <button class="zsp__nav-button" type="button" data-zsp-next aria-label="Next best sellers" aria-controls="zsp-products-{{ section.id }}">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </button>
      </div>
      <div class="zsp__products" id="zsp-products-{{ section.id }}" data-zsp-carousel>
        {%- liquid
          assign ordered_handles = s.first_product.handle | append: '|' | append: s.second_product.handle | append: '|' | append: s.third_product.handle | append: '|' | append: s.fourth_product.handle | split: '|'
          assign shown_count = 0
        -%}
        {%- for preferred_handle in ordered_handles -%}
          {%- if preferred_handle != blank -%}
            {%- for product in featured_collection.products -%}
              {%- if product.handle == preferred_handle -%}
                {% render 'zs-best-seller-card', product: product, blocks: section.blocks, show_compare: s.show_compare %}
                {%- assign shown_count = shown_count | plus: 1 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for product in featured_collection.products -%}
          {%- if shown_count >= 8 -%}{%- break -%}{%- endif -%}
          {%- unless ordered_handles contains product.handle -%}
            {% render 'zs-best-seller-card', product: product, blocks: section.blocks, show_compare: s.show_compare %}
            {%- assign shown_count = shown_count | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {% endif %}
    {%- if s.button_label != blank -%}
      <div class="zsp__footer">
        <a class="zsp__shop-all" href="{{ cta_link }}">
          <span>{{ s.button_label | escape }}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.zsp{background:var(--zsp-white,#FFFFFF);color:var(--zsp-ink,#2B1D17);padding:clamp(60px,7vw,var(--zsp-pt,84px)) 0 clamp(60px,7vw,var(--zsp-pb,84px));overflow:clip}
.zsp *{box-sizing:border-box}
.zsp__inner{width:100%;max-width:1440px;margin:auto;padding:0 clamp(20px,4vw,58px)}
.zsp__header{margin:0 0 clamp(36px,4vw,56px)}
.zsp__eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 23px;color:#946F51;font-size:clamp(10px,.82vw,12px);font-weight:500;letter-spacing:.17em;line-height:1.45;text-transform:uppercase}
.zsp__eyebrow span{display:block;flex:0 0 30px;width:30px;height:2px;background:var(--zsp-accent,#D8B56A)}
.zsp__title{display:flex;flex-direction:column;align-items:flex-start;gap:0;margin:0;font-family:inherit!important;font-size:clamp(42px,4.1vw,var(--zsp-size,64px));line-height:1.12;letter-spacing:-.055em;color:var(--zsp-ink,#2B1D17);text-wrap:balance}
.zsp__title-light{display:block;font-weight:300}
.zsp__title-strong{display:block;font-weight:700;line-height:1.12}
.zsp__description{margin:18px 0 0;max-width:72ch;color:var(--zsp-description,#80736A);opacity:.75;font-size:clamp(13px,1.02vw,15px);line-height:1.75;font-weight:400}
.zsp__carousel-nav{display:flex;justify-content:flex-end;gap:10px;margin:-15px 0 18px}
.zsp__nav-button{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;padding:0;border:1px solid rgba(43,29,23,.28);border-radius:50%;background:#FFFFFF;color:var(--zsp-ink,#2B1D17);cursor:pointer;transition:background .2s ease,color .2s ease,border-color .2s ease}
.zsp__nav-button:not(:disabled):is(:hover,:focus-visible){background:#2B1D17;color:#FFFFFF;border-color:#2B1D17}
.zsp__nav-button:disabled{cursor:default;opacity:.33}
.zsp__nav-button:focus-visible{outline:2px solid var(--zsp-accent,#D8B56A);outline-offset:3px}
.zsp__products{--zsp-grid-gap:clamp(15px,1.8vw,27px);display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 3 * var(--zsp-grid-gap)) / 4);grid-template-columns:none;gap:var(--zsp-grid-gap);align-items:start;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scrollbar-width:none}
.zsp__products::-webkit-scrollbar{display:none}
.zsp__product{min-width:0;scroll-snap-align:start}
.zsp__link{display:block;text-decoration:none;color:inherit;outline-offset:4px}
.zsp__link:hover{color:inherit}
.zsp__media{position:relative;display:block;overflow:hidden;isolation:isolate;aspect-ratio:1 / 1;border-radius:22px;background:#FFFFFF;box-shadow:none;border:0}
.zsp__image{display:block;width:100%;height:100%;padding:0;object-fit:contain;object-position:center center;transition:opacity .25s ease}
.zsp__discount{position:absolute;top:12px;left:12px;z-index:2;display:inline-flex;align-items:center;justify-content:center;min-height:27px;padding:5px 9px;border-radius:7px;background:#762E3D;color:#FFFFFF;font-size:11px;font-weight:600;line-height:1.2;letter-spacing:.015em;box-shadow:0 2px 7px rgba(43,29,23,.1)}
.zsp__fallback{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:clamp(15px,2vw,26px);font-weight:300;letter-spacing:.23em;color:#A0836B}
.zsp__image-arrow{position:absolute;right:13px;bottom:13px;width:37px;height:37px;display:grid;place-items:center;border:1px solid rgba(43,29,23,.09);border-radius:50%;background:rgba(255,255,255,.95);color:var(--zsp-walnut,#2B1D17);box-shadow:0 4px 12px rgba(43,29,23,.08);opacity:0;transform:translateY(6px);transition:transform .26s ease,opacity .26s ease,background .26s ease,color .26s ease}
.zsp__details{display:flex;flex-direction:column;align-items:flex-start;gap:0;padding:16px 1px 0;background:transparent}
.zsp__name{margin:0;font-family:inherit!important;font-size:clamp(13px,1vw,15px);font-weight:500;line-height:1.5;color:var(--zsp-ink,#2B1D17);letter-spacing:-.02em;min-height:3em}
.zsp__note{margin:5px 0 0;color:#81766D;font-size:12px;line-height:1.5}
.zsp__prices{display:flex;flex-wrap:wrap;align-items:baseline;gap:7px 12px;margin:11px 0 0}
.zsp__price-now{color:var(--zsp-ink,#2B1D17);font-size:clamp(16px,1.28vw,19px);font-weight:600;line-height:1.35}
.zsp__price-old{color:#968B81;font-size:clamp(11px,.91vw,13px);font-weight:400;line-height:1.35;text-decoration:line-through;text-decoration-thickness:1px}
.zsp__sold-out{margin-top:7px;color:#83634D;font-size:11px;letter-spacing:.04em}
.zsp__discover{display:inline-flex;align-items:center;gap:9px;margin-top:16px;padding-bottom:4px;color:var(--zsp-walnut,#2B1D17);font-size:11px;font-weight:500;letter-spacing:.01em;border-bottom:1px solid transparent;transition:border-color .25s ease}
.zsp__discover svg{transition:transform .26s ease}
.zsp__footer{display:flex;justify-content:center;padding-top:clamp(40px,4.7vw,68px)}
.zsp__shop-all{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:56px;padding:14px 26px;border-radius:999px;border:1px solid #2B1D17;background:#2B1D17;color:#FFFFFF;text-decoration:none;font-family:inherit;font-size:13px;font-weight:500;letter-spacing:-.01em;transition:background .25s ease,transform .25s ease,box-shadow .25s ease}
.zsp__shop-all svg{transition:transform .25s ease}
.zsp__shop-all:hover{background:#472F22;color:#FFF;transform:translateY(-2px);box-shadow:0 9px 19px rgba(43,29,23,.12)}
.zsp__shop-all:hover svg{transform:translate(2px,-2px)}
.zsp a:focus-visible{outline:2px solid var(--zsp-accent,#D8B56A);outline-offset:4px}
@media(hover:hover) and (pointer:fine){
 .zsp__link:hover .zsp__image{opacity:.96}
 .zsp__link:hover .zsp__image-arrow{opacity:1;transform:translateY(0);background:#2B1D17;color:var(--zsp-accent,#D8B56A)}
 .zsp__link:hover .zsp__discover{border-bottom-color:var(--zsp-accent,#D8B56A)}
 .zsp__link:hover .zsp__discover svg{transform:translate(2px,-2px)}
}
.zsp__link:focus-visible .zsp__image-arrow{opacity:1;transform:none}
@media(min-width:750px) and (max-width:1099px){.zsp__products{--zsp-grid-gap:22px;grid-auto-columns:calc((100% - var(--zsp-grid-gap)) / 2)}.zsp__name{min-height:auto}}
@media(max-width:749px){
 .zsp{padding:48px 0 74px}
 .zsp__inner{padding:0 16px}
 .zsp__header{margin-bottom:28px}
 .zsp__eyebrow{font-size:9px;margin-bottom:18px}
 .zsp__title{font-size:clamp(36px,9.5vw,51px)}
 .zsp__description{font-size:12px;margin-top:15px}
 .zsp__carousel-nav{display:none}
 .zsp__products{display:grid;grid-auto-flow:row;grid-auto-columns:auto;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 13px;overflow:visible;scroll-snap-type:none}
 .zsp__media{border-radius:16px}
 .zsp__image{padding:0}
 .zsp__discount{top:8px;left:8px;min-height:23px;padding:4px 7px;font-size:10px;border-radius:6px}
 .zsp__image-arrow{opacity:1;transform:none;width:33px;height:33px;right:9px;bottom:9px}
 .zsp__image-arrow svg{width:15px;height:15px}
 .zsp__details{padding:12px 0 0}
 .zsp__name{font-size:12px;line-height:1.4;min-height:2.8em}
 .zsp__prices{gap:3px 7px;margin-top:8px}
 .zsp__price-now{font-size:14px}
 .zsp__price-old{font-size:11px}
 .zsp__discover{font-size:10px;margin-top:12px;gap:5px}
 .zsp__footer{padding-top:40px}
 .zsp__shop-all{min-height:52px;padding:13px 22px;font-size:12px;gap:16px}
}
@media(prefers-reduced-motion:no-preference){
 .zsp__product.zsp-is-in-view{animation:zsp-reveal .55s cubic-bezier(.2,.7,.2,1) both;animation-delay:var(--zsp-delay,0ms)}
 @keyframes zsp-reveal{from{opacity:.75;transform:translateY(11px)}to{opacity:1;transform:translateY(0)}}
}
@media(prefers-reduced-motion:reduce){.zsp__image,.zsp__image-arrow,.zsp__discover,.zsp__discover svg,.zsp__shop-all,.zsp__shop-all svg{transition:none}}
{% endstylesheet %}
{% javascript %}
(function(){
 function initializeBestSellers(){
   document.querySelectorAll('.zsp').forEach(function(section){
     var track=section.querySelector('[data-zsp-carousel]');
     if(!track)return;

     var prev=section.querySelector('[data-zsp-prev]');
     var next=section.querySelector('[data-zsp-next]');
     if(!track.dataset.zspCarouselReady&&prev&&next){
       track.dataset.zspCarouselReady='true';

       function refreshButtons(){
         var max=Math.max(0,track.scrollWidth-track.clientWidth);
         prev.disabled=track.scrollLeft<=2;
         next.disabled=track.scrollLeft>=max-2;
       }
       function move(direction){
         var first=track.querySelector('.zsp__product');
         if(!first)return;
         var gap=parseFloat(getComputedStyle(track).columnGap)||0;
         var visible=window.matchMedia('(max-width: 1099px)').matches?2:4;
         var distance=(first.getBoundingClientRect().width+gap)*visible;
         var reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
         track.scrollBy({left:direction*distance,behavior:reduceMotion?'instant':'smooth'});
       }
       prev.addEventListener('click',function(){move(-1)});
       next.addEventListener('click',function(){move(1)});
       track.addEventListener('scroll',refreshButtons,{passive:true});
       if('ResizeObserver' in window){
         new ResizeObserver(refreshButtons).observe(track);
       }else{
         window.addEventListener('resize',refreshButtons);
       }
       refreshButtons();
     }

     var products=section.querySelectorAll('.zsp__product:not([data-zsp-ready])');
     if(!products.length||!('IntersectionObserver' in window))return;
     var observer=new IntersectionObserver(function(entries){
       entries.forEach(function(entry){
         if(entry.isIntersecting){
           entry.target.classList.add('zsp-is-in-view');
           observer.unobserve(entry.target);
         }
       });
     },{threshold:.11,rootMargin:'0px 0px 50px 0px'});
     products.forEach(function(el,i){
       el.dataset.zspReady='true';
       el.style.setProperty('--zsp-delay',(i%4)*65+'ms');
       observer.observe(el);
     });
   });
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initializeBestSellers,{once:true});
 else initializeBestSellers();
 document.addEventListener('shopify:section:load',initializeBestSellers);
})();
{% endjavascript %}

{% schema %}
{
  "name": "ZAISEN Best Sellers",
  "tag": "section",
  "class": "section-zaisen-best-sellers-alt",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ZAISEN FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Bold second headline line",
      "default": "Best Sellers."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection (up to 8)"
    },
    {
      "type": "header",
      "content": "Homepage first four products"
    },
    {
      "type": "product",
      "id": "first_product",
      "label": "1. First: wall clock"
    },
    {
      "type": "product",
      "id": "second_product",
      "label": "2. Second: horse statue"
    },
    {
      "type": "product",
      "id": "third_product",
      "label": "3. Third: serving tray"
    },
    {
      "type": "product",
      "id": "fourth_product",
      "label": "4. Fourth: ship decor"
    },
    {
      "type": "font_picker",
      "id": "editorial_font",
      "label": "Heading and product font",
      "default": "poppins_n4"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Most-loved handcrafted pieces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Max heading size",
      "min": 40,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 76
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B69A6A"
    },
    {
      "type": "color",
      "id": "wood_color",
      "label": "Walnut accent",
      "default": "#77523A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Image / note override",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product to customize"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Image override (optional)"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Short note (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Best Sellers",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
