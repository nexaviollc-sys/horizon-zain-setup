      "id": "heading_size",
      "label": "Max heading size",
      "min": 40,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 76
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show 01–04 numerals",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B69A6A"
    },
    {
      "type": "color",
      "id": "wood_color",
