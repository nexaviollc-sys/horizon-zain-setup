{%- liquid
  assign s = section.settings
  assign destination = s.button_link | default: routes.all_products_collection_url
-%}
<section class="za-selected" aria-labelledby="za-selected-title-{{ section.id }}">
  <div class="za-selected__shell">
    <header class="za-selected__intro">
      <div><p class="za-small-label">{{ s.eyebrow | escape }}</p><h2 id="za-selected-title-{{ section.id }}">{{ s.heading | escape }}</h2></div>
      <div class="za-selected__right"><p>{{ s.text | escape }}</p><a class="za-editorial-link" href="{{ destination }}">{{ s.button_label | default: 'Shop all' | escape }} <span aria-hidden="true">↗</span></a></div>
    </header>
    <div class="za-selected__grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          {%- assign image = block.settings.custom_image | default: product.featured_image -%}
          <article class="za-selected__item" {{ block.shopify_attributes }}>
            <a class="za-selected__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if image != blank -%}
                {{ image | image_url: width: 1000 | image_tag: class: 'za-selected__image', loading: 'lazy', widths: '280, 420, 600, 800, 1000', sizes: '(min-width: 1200px) 23vw, (min-width: 680px) 46vw, 46vw', alt: product.title }}
              {%- else -%}
                <div class="za-selected__missing" aria-hidden="true"><span>ZAISEN</span></div>
              {%- endif -%}
            </a>
            <div class="za-selected__meta">
              <a class="za-selected__name" href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a>
              <div class="za-selected__price">
                <span>{{ product.price | money }}</span>
                {%- if s.show_compare and product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <a class="za-selected__mobile-all za-editorial-link" href="{{ destination }}">{{ s.button_label | default: 'Shop all' | escape }} <span aria-hidden="true">↗</span></a>
  </div>
</section>
{% stylesheet %}
.za-selected{background:#F7F6F2;color:#24211E;padding:clamp(76px,8vw,126px) 0;overflow:hidden}
.za-selected *{box-sizing:border-box}
.za-selected__shell{max-width:1560px;margin:auto;padding:0 clamp(20px,4.5vw,70px)}
.za-selected__intro{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:39px}
.za-selected__intro h2{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(3.1rem,5.4vw,6rem);font-weight:500;line-height:1.02;letter-spacing:-.05em;margin:0}
.za-selected__right{display:flex;align-items:end;flex-direction:column;gap:15px}
.za-selected__right p{font-family:var(--font-body--family,Arial,sans-serif);color:#777169;font-size:.88rem;line-height:1.7;margin:0}
.za-editorial-link{display:inline-flex;align-items:center;gap:19px;min-height:40px;border-bottom:1px solid #B49A80;color:#74533C;font-family:var(--font-body--family,Arial,sans-serif);font-size:.7rem;letter-spacing:.13em;font-weight:700;text-transform:uppercase;text-decoration:none;transition:gap .2s}
.za-editorial-link:hover{gap:24px}
.za-selected__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,1.7vw,26px)}
.za-selected__item{min-width:0}
.za-selected__image-link{display:block;position:relative;overflow:hidden;aspect-ratio:4/4.8;background:#F0EEE9;text-decoration:none}
.za-selected__image{width:100%;height:100%;display:block;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1)}
.za-selected__image-link:hover .za-selected__image{transform:scale(1.028)}
.za-selected__missing{display:grid;place-items:center;width:100%;height:100%;color:#B1A392;letter-spacing:.17em;font-family:var(--font-heading--family,Georgia,serif);font-size:2rem}
.za-selected__meta{padding:14px 0 0}
.za-selected__name{text-decoration:none;color:#24211E}
.za-selected__name h3{font-family:var(--font-body--family,Arial,sans-serif);font-weight:500;font-size:.86rem;line-height:1.45;letter-spacing:0;margin:0;min-height:2.75em}
.za-selected__name:hover{color:#74533C}
.za-selected__price{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-top:9px;font-family:var(--font-body--family,Arial,sans-serif);font-size:.88rem;font-weight:650;color:#24211E}
.za-selected__price s{font-size:.78rem;font-weight:400;color:#8D857C}
.za-selected__mobile-all{display:none}
.za-selected a:focus-visible{outline:2px solid #74533C;outline-offset:4px}
@media(max-width:1050px){.za-selected__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 18px}}
@media(max-width:680px){.za-selected{padding:67px 0}.za-selected__intro{margin-bottom:27px}.za-selected__intro h2{font-size:clamp(2.9rem,10vw,3.7rem)}.za-selected__right{display:none}.za-selected__grid{gap:23px 13px}.za-selected__image-link{aspect-ratio:4/5}.za-selected__name h3{font-size:.79rem}.za-selected__price{font-size:.82rem}.za-selected__mobile-all{display:inline-flex;margin-top:26px}}
@media(prefers-reduced-motion:reduce){.za-selected__image,.za-editorial-link{transition:none}}
{% endstylesheet %}

{% schema %}
