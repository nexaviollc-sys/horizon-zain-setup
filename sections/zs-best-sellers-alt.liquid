{%- comment -%}
  ZAISEN Best Sellers — a quiet four-product editorial gallery.
  Existing product selectors, custom images, real money fields and best-sellers
  collection destination stay merchant-editable. No boxed cards or fake reviews.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cta_link = s.button_link | default: routes.all_products_collection_url
  assign display_font = s.editorial_font
  assign font_light = display_font | font_modify: 'weight', '300'
  assign font_medium = display_font | font_modify: 'weight', '500'
  assign font_semibold = display_font | font_modify: 'weight', '600'
  assign font_bold = display_font | font_modify: 'weight', '700'
-%}
{%- if display_font != blank -%}
  {% style %}
    {{ display_font | font_face: font_display: 'swap' }}
    {% if font_light != blank %}{{ font_light | font_face: font_display: 'swap' }}{% endif %}
    {% if font_medium != blank %}{{ font_medium | font_face: font_display: 'swap' }}{% endif %}
    {% if font_semibold != blank %}{{ font_semibold | font_face: font_display: 'swap' }}{% endif %}
    {% if font_bold != blank %}{{ font_bold | font_face: font_display: 'swap' }}{% endif %}
    #zsp-{{ section.id }} {
      font-family: {{ display_font.family | json }}, {{ display_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  #zsp-{{ section.id }}{
    --zsp-white:{{ s.bg_color }};
    --zsp-ink:{{ s.heading_color }};
    --zsp-walnut:{{ s.wood_color }};
    --zsp-accent:{{ s.accent_color }};
    --zsp-description:{{ s.text_color }};
    --zsp-size:{{ s.heading_size }}px;
    --zsp-pt:{{ s.padding_top }}px;
    --zsp-pb:{{ s.padding_bottom }}px;
  }
{% endstyle %}

<section id="zsp-{{ section.id }}" class="zsp" aria-labelledby="zsp-heading-{{ section.id }}">
  <div class="zsp__inner">
    <header class="zsp__header">
      {%- if s.eyebrow != blank -%}
        <p class="zsp__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="zsp-heading-{{ section.id }}" class="zsp__title">
        <span class="zsp__title-light">{{ s.heading | escape }}</span>
        {%- if s.heading_emphasis != blank -%}
          <strong class="zsp__title-strong">{{ s.heading_emphasis | escape }}</strong>
        {%- endif -%}
      </h2>
      {%- if s.text != blank -%}
        <p class="zsp__description">{{ s.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="zsp__products">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign main_image = block.settings.custom_image
          if main_image == blank and product != blank
            assign main_image = product.featured_image
          endif
          assign variant = product.selected_or_first_available_variant
          assign display_price = product.price
          assign compare_price = product.compare_at_price
          if variant != blank
            assign display_price = variant.price
            assign compare_price = variant.compare_at_price
          endif
          assign product_title = product.title | default: 'Choose a product'
          assign product_url = product.url | default: routes.all_products_collection_url
        -%}
        <article class="zsp__product" {{ block.shopify_attributes }}>
          <a class="zsp__link" href="{{ product_url }}" aria-label="Discover {{ product_title | escape }}">
            <div class="zsp__media">
              {%- if main_image != blank -%}
                {{ main_image | image_url: width: 1100 | image_tag: class: 'zsp__image', widths: '260, 390, 540, 720, 880, 1100', sizes: '(min-width: 1500px) 320px, (min-width: 1100px) calc((100vw - 175px) / 4), (min-width: 750px) calc((100vw - 90px) / 2), calc((100vw - 48px) / 2)', loading: 'lazy', alt: product_title }}
              {%- else -%}
                <span class="zsp__fallback" aria-hidden="true">ZAISEN</span>
              {%- endif -%}
              <span class="zsp__image-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M7 5h12v12"/></svg>
              </span>
            </div>
            <div class="zsp__details">
              <h3 class="zsp__name">{{ product_title | escape }}</h3>
              {%- if block.settings.note != blank -%}
                <p class="zsp__note">{{ block.settings.note | escape }}</p>
              {%- endif -%}
              {%- if product != blank -%}
                <div class="zsp__prices">
                  <span class="zsp__price-now">{{ display_price | money }}</span>
                  {%- if s.show_compare and compare_price > display_price -%}
                    <s class="zsp__price-old">{{ compare_price | money }}</s>
                  {%- endif -%}
                </div>
                {%- unless product.available -%}
                  <span class="zsp__sold-out">Sold out</span>
                {%- endunless -%}
              {%- endif -%}
              <span class="zsp__discover">Discover this piece <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {%- if s.button_label != blank -%}
      <div class="zsp__footer">
        <a class="zsp__shop-all" href="{{ cta_link }}">
          <span>{{ s.button_label | escape }}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.zsp{background:var(--zsp-white,#FFFFFF);color:var(--zsp-ink,#2B1D17);padding:clamp(60px,7vw,var(--zsp-pt,84px)) 0 clamp(60px,7vw,var(--zsp-pb,84px));overflow:clip}
.zsp *{box-sizing:border-box}
.zsp__inner{width:100%;max-width:1440px;margin:auto;padding:0 clamp(20px,4vw,58px)}
.zsp__header{margin:0 0 clamp(36px,4vw,56px)}
.zsp__eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 23px;color:#946F51;font-size:clamp(10px,.82vw,12px);font-weight:500;letter-spacing:.17em;line-height:1.45;text-transform:uppercase}
.zsp__eyebrow span{display:block;flex:0 0 30px;width:30px;height:2px;background:var(--zsp-accent,#D8B56A)}
.zsp__title{display:flex;flex-direction:column;align-items:flex-start;gap:0;margin:0;font-family:inherit!important;font-size:clamp(42px,4.1vw,var(--zsp-size,64px));line-height:1.12;letter-spacing:-.055em;color:var(--zsp-ink,#2B1D17);text-wrap:balance}
.zsp__title-light{display:block;font-weight:300}
.zsp__title-strong{display:block;font-weight:700;line-height:1.12}
.zsp__description{margin:18px 0 0;max-width:72ch;color:var(--zsp-description,#80736A);opacity:.75;font-size:clamp(13px,1.02vw,15px);line-height:1.75;font-weight:400}
.zsp__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(15px,1.8vw,27px);align-items:start}
.zsp__product{min-width:0}
.zsp__link{display:block;text-decoration:none;color:inherit;outline-offset:4px}
.zsp__link:hover{color:inherit}
.zsp__media{position:relative;display:block;overflow:hidden;isolation:isolate;aspect-ratio:4 / 5;border-radius:22px;background:#F1ECE6;box-shadow:none;border:0}
.zsp__image{display:block;width:100%;height:100%;object-fit:cover;object-position:center center;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
.zsp__fallback{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:clamp(15px,2vw,26px);font-weight:300;letter-spacing:.23em;color:#A0836B}
.zsp__image-arrow{position:absolute;right:13px;bottom:13px;width:37px;height:37px;display:grid;place-items:center;border:1px solid rgba(43,29,23,.09);border-radius:50%;background:rgba(255,255,255,.95);color:var(--zsp-walnut,#2B1D17);box-shadow:0 4px 12px rgba(43,29,23,.08);opacity:0;transform:translateY(6px);transition:transform .26s ease,opacity .26s ease,background .26s ease,color .26s ease}
.zsp__details{display:flex;flex-direction:column;align-items:flex-start;gap:0;padding:16px 1px 0;background:transparent}
.zsp__name{margin:0;font-family:inherit!important;font-size:clamp(13px,1vw,15px);font-weight:500;line-height:1.5;color:var(--zsp-ink,#2B1D17);letter-spacing:-.02em;min-height:3em}
.zsp__note{margin:5px 0 0;color:#81766D;font-size:12px;line-height:1.5}
.zsp__prices{display:flex;flex-wrap:wrap;align-items:baseline;gap:7px 12px;margin:11px 0 0}
.zsp__price-now{color:var(--zsp-ink,#2B1D17);font-size:clamp(16px,1.28vw,19px);font-weight:600;line-height:1.35}
.zsp__price-old{color:#968B81;font-size:clamp(11px,.91vw,13px);font-weight:400;line-height:1.35;text-decoration:line-through;text-decoration-thickness:1px}
.zsp__sold-out{margin-top:7px;color:#83634D;font-size:11px;letter-spacing:.04em}
.zsp__discover{display:inline-flex;align-items:center;gap:9px;margin-top:16px;padding-bottom:4px;color:var(--zsp-walnut,#2B1D17);font-size:11px;font-weight:500;letter-spacing:.01em;border-bottom:1px solid transparent;transition:border-color .25s ease}
.zsp__discover svg{transition:transform .26s ease}
.zsp__footer{display:flex;justify-content:center;padding-top:clamp(40px,4.7vw,68px)}
.zsp__shop-all{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:56px;padding:14px 26px;border-radius:999px;border:1px solid #2B1D17;background:#2B1D17;color:#FFFFFF;text-decoration:none;font-family:inherit;font-size:13px;font-weight:500;letter-spacing:-.01em;transition:background .25s ease,transform .25s ease,box-shadow .25s ease}
.zsp__shop-all svg{transition:transform .25s ease}
.zsp__shop-all:hover{background:#472F22;color:#FFF;transform:translateY(-2px);box-shadow:0 9px 19px rgba(43,29,23,.12)}
.zsp__shop-all:hover svg{transform:translate(2px,-2px)}
.zsp a:focus-visible{outline:2px solid var(--zsp-accent,#D8B56A);outline-offset:4px}
@media(hover:hover) and (pointer:fine){
 .zsp__link:hover .zsp__image{transform:scale(1.024)}
 .zsp__link:hover .zsp__image-arrow{opacity:1;transform:translateY(0);background:#2B1D17;color:var(--zsp-accent,#D8B56A)}
 .zsp__link:hover .zsp__discover{border-bottom-color:var(--zsp-accent,#D8B56A)}
 .zsp__link:hover .zsp__discover svg{transform:translate(2px,-2px)}
}
.zsp__link:focus-visible .zsp__image-arrow{opacity:1;transform:none}
@media(min-width:750px) and (max-width:1099px){.zsp__products{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 22px}.zsp__name{min-height:auto}}
@media(max-width:749px){
 .zsp{padding:65px 0 74px}
 .zsp__inner{padding:0 16px}
 .zsp__header{margin-bottom:28px}
 .zsp__eyebrow{font-size:9px;margin-bottom:18px}
 .zsp__title{font-size:clamp(36px,9.5vw,51px)}
 .zsp__description{font-size:12px;margin-top:15px}
 .zsp__products{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 13px}
 .zsp__media{border-radius:16px}
 .zsp__image-arrow{opacity:1;transform:none;width:33px;height:33px;right:9px;bottom:9px}
 .zsp__image-arrow svg{width:15px;height:15px}
 .zsp__details{padding:12px 0 0}
 .zsp__name{font-size:12px;line-height:1.4;min-height:2.8em}
 .zsp__prices{gap:3px 7px;margin-top:8px}
 .zsp__price-now{font-size:14px}
 .zsp__price-old{font-size:11px}
 .zsp__discover{font-size:10px;margin-top:12px;gap:5px}
 .zsp__footer{padding-top:40px}
 .zsp__shop-all{min-height:52px;padding:13px 22px;font-size:12px;gap:16px}
}
@media(prefers-reduced-motion:no-preference){
 .zsp__product.zsp-is-in-view{animation:zsp-reveal .55s cubic-bezier(.2,.7,.2,1) both;animation-delay:var(--zsp-delay,0ms)}
 @keyframes zsp-reveal{from{opacity:.75;transform:translateY(11px)}to{opacity:1;transform:translateY(0)}}
}
@media(prefers-reduced-motion:reduce){.zsp__image,.zsp__image-arrow,.zsp__discover,.zsp__discover svg,.zsp__shop-all,.zsp__shop-all svg{transition:none}}
{% endstylesheet %}
{% javascript %}
(function(){
 function initBestSellers(){
   var elements=document.querySelectorAll('.zsp .zsp__product:not([data-zsp-ready])');
   if(!elements.length||!('IntersectionObserver' in window))return;
   var observer=new IntersectionObserver(function(entries){
     entries.forEach(function(entry){
       if(entry.isIntersecting){
         entry.target.classList.add('zsp-is-in-view');
         observer.unobserve(entry.target);
       }
     });
   },{threshold:.11,rootMargin:'0px 0px 50px 0px'});
   elements.forEach(function(el,i){el.dataset.zspReady='true';el.style.setProperty('--zsp-delay',(i%4)*65+'ms');observer.observe(el);});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initBestSellers,{once:true});
 else initBestSellers();
 document.addEventListener('shopify:section:load',initBestSellers);
})();
{% endjavascript %}

{% schema %}
{
  "name": "ZAISEN Best Sellers",
  "tag": "section",
  "class": "section-zaisen-best-sellers-alt",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ZAISEN FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Bold second headline line",
      "default": "Best Sellers."
    },
    {
      "type": "font_picker",
      "id": "editorial_font",
      "label": "Heading and product font",
      "default": "poppins_n4"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Most-loved handcrafted pieces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Max heading size",
      "min": 40,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 76
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B69A6A"
    },
    {
      "type": "color",
      "id": "wood_color",
      "label": "Walnut accent",
      "default": "#77523A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Image override (optional)"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Short note (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Best Sellers",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
