{%- liquid
  assign s = section.settings
  assign craft_image = s.image
-%}

<section
  id="zs-craft-{{ section.id }}"
  class="zs-craft"
  style="
    --zs-craft-bg: {{ s.bg_color }};
    --zs-craft-text: {{ s.text_color }};
    --zs-craft-accent: {{ s.accent_color }};
    --zs-craft-wood: {{ s.wood_color }};
    --zs-craft-line: {{ s.line_color }};
    --zs-craft-pt: {{ s.padding_top }}px;
    --zs-craft-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="zs-craft__inner">
    <div class="zs-craft__visual">
      <div class="zs-craft__frame">
        {% if craft_image != blank %}
          {{
            craft_image
            | image_url: width: 1600
            | image_tag:
              class: 'zs-craft__image',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 48vw, 92vw',
              loading: 'lazy',
              alt: s.image_alt
          }}
        {% else %}
          <div class="zs-craft__art" aria-hidden="true">
            <span class="zs-craft__grain zs-craft__grain--one"></span>
            <span class="zs-craft__grain zs-craft__grain--two"></span>
            <span class="zs-craft__grain zs-craft__grain--three"></span>
            <span class="zs-craft__arch"></span>
            <span class="zs-craft__disc"></span>
          </div>
        {% endif %}

        <div class="zs-craft__seal" aria-hidden="true">
          <span class="zs-craft__seal-small">HAND FINISHED</span>
          <span class="zs-craft__seal-mark">ZS</span>
          <span class="zs-craft__seal-small">NATURAL WOOD</span>
        </div>
      </div>

      {% if s.side_note != blank %}
        <p class="zs-craft__side-note">{{ s.side_note | escape }}</p>
      {% endif %}
    </div>

    <div class="zs-craft__content">
      {% if s.eyebrow != blank %}
        <p class="zs-craft__eyebrow">
          <span class="zs-craft__eyebrow-line" aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {% endif %}

      {% if s.heading != blank %}
        <h2 class="zs-craft__heading">{{ s.heading }}</h2>
      {% endif %}

      {% if s.text != blank %}
        <div class="zs-craft__lead">{{ s.text }}</div>
      {% endif %}

      <div class="zs-craft__principles">
        {% for block in section.blocks %}
          <article class="zs-craft__principle" {{ block.shopify_attributes }}>
            <span class="zs-craft__index">{{ forloop.index | prepend: '0' }}</span>
            <div>
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if s.quote != blank %}
        <p class="zs-craft__quote">{{ s.quote | escape }}</p>
      {% endif %}

      {% if s.button_label != blank and s.button_link != blank %}
        <a class="zs-craft__link" href="{{ s.button_link }}">
          <span>{{ s.button_label | escape }}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .zs-craft {
    --zs-craft-max: 1500px;
    background:
      radial-gradient(900px 520px at 88% 18%, color-mix(in srgb, var(--zs-craft-accent) 10%, transparent), transparent 68%),
      radial-gradient(760px 520px at 8% 86%, color-mix(in srgb, var(--zs-craft-wood) 7%, transparent), transparent 70%),
      var(--zs-craft-bg, #f6f1e7);
    color: var(--zs-craft-text, #2c2a29);
    padding-block: var(--zs-craft-pt) var(--zs-craft-pb);
    border-top: 1px solid color-mix(in srgb, var(--zs-craft-line) 70%, transparent);
    overflow: clip;
  }

  .zs-craft * { box-sizing: border-box; }

  .zs-craft__inner {
    width: min(calc(100% - 40px), var(--zs-craft-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 44px;
    align-items: center;
  }

  .zs-craft__visual { position: relative; min-width: 0; }

  .zs-craft__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--zs-craft-bg) 82%, white), color-mix(in srgb, var(--zs-craft-bg) 82%, var(--zs-craft-accent)));
    border-radius: 4px;
    box-shadow:
      0 30px 70px color-mix(in srgb, var(--zs-craft-wood) 10%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--zs-craft-wood) 12%, transparent);
  }

  .zs-craft__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zs-craft__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 15%, color-mix(in srgb, var(--zs-craft-accent) 10%, transparent), transparent 28%),
      linear-gradient(160deg, #f9f5ed 0%, color-mix(in srgb, var(--zs-craft-bg) 90%, white) 46%, color-mix(in srgb, var(--zs-craft-bg) 76%, var(--zs-craft-accent)) 100%);
  }

  .zs-craft__arch {
    position: absolute;
    width: 70%;
    height: 72%;
    right: -7%;
    bottom: -4%;
    border: 1px solid color-mix(in srgb, var(--zs-craft-accent) 30%, transparent);
    border-radius: 50% 50% 8px 8px / 35% 35% 8px 8px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--zs-craft-bg) 88%, white), color-mix(in srgb, var(--zs-craft-bg) 76%, var(--zs-craft-accent)));
    box-shadow: inset 0 0 70px color-mix(in srgb, var(--zs-craft-accent) 10%, transparent);
  }

  .zs-craft__disc {
    position: absolute;
    width: 48%;
    aspect-ratio: 1;
    left: 8%;
    bottom: 13%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--zs-craft-wood) 22%, transparent);
    background:
      radial-gradient(circle at 38% 34%, color-mix(in srgb, var(--zs-craft-accent) 18%, white), transparent 18%),
      repeating-radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--zs-craft-wood) 18%, transparent) 0 1px, transparent 2px 8px),
      color-mix(in srgb, var(--zs-craft-bg) 76%, var(--zs-craft-wood));
    box-shadow: 0 20px 40px color-mix(in srgb, var(--zs-craft-wood) 14%, transparent);
  }

  .zs-craft__grain {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--zs-craft-wood) 32%, transparent), transparent);
    transform: rotate(-12deg);
    transform-origin: left center;
  }

  .zs-craft__grain--one { width: 72%; left: -8%; top: 24%; }
  .zs-craft__grain--two { width: 58%; left: 4%; top: 32%; opacity: .7; }
  .zs-craft__grain--three { width: 44%; left: 18%; top: 40%; opacity: .45; }

  .zs-craft__seal {
    position: absolute;
    left: clamp(16px, 3vw, 34px);
    bottom: clamp(16px, 3vw, 34px);
    z-index: 3;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    text-align: center;
    color: #fbf9f6;
    background:
      radial-gradient(circle at 36% 26%, color-mix(in srgb, var(--zs-craft-accent) 92%, white), var(--zs-craft-wood));
    border: 1px solid color-mix(in srgb, #fff 30%, transparent);
    box-shadow:
      0 16px 34px color-mix(in srgb, var(--zs-craft-wood) 24%, transparent),
      inset 0 0 0 5px color-mix(in srgb, #fff 8%, transparent);
  }

  .zs-craft__seal-mark {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 29px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: .03em;
  }

  .zs-craft__seal-small {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .19em;
  }

  .zs-craft__side-note {
    position: absolute;
    right: -2px;
    bottom: -28px;
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .19em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--zs-craft-text) 55%, transparent);
  }

  .zs-craft__content {
    position: relative;
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 52px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, white 58%, var(--zs-craft-line));
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, white 64%, transparent),
        color-mix(in srgb, var(--zs-craft-bg) 72%, transparent)
      );
    box-shadow:
      0 30px 70px color-mix(in srgb, var(--zs-craft-wood) 9%, transparent),
      inset 0 1px 0 rgba(255,255,255,.72),
      inset 0 -1px 0 color-mix(in srgb, var(--zs-craft-accent) 8%, transparent);
    backdrop-filter: blur(14px) saturate(112%);
    -webkit-backdrop-filter: blur(14px) saturate(112%);
  }

  .zs-craft__content::before {
    content: '';
    position: absolute;
    inset: 0 12% auto;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.88), transparent);
  }

  .zs-craft__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .23em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--zs-craft-accent) 92%, var(--zs-craft-text));
  }

  .zs-craft__eyebrow-line {
    width: 34px;
    height: 1px;
    background: var(--zs-craft-accent);
  }

  .zs-craft__heading {
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(42px, 10vw, 64px);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.025em;
    color: var(--zs-craft-text);
    text-wrap: balance;
  }

  .zs-craft__heading em {
    font-style: italic;
    font-weight: 450;
    color: var(--zs-craft-accent);
  }

  .zs-craft__lead {
    max-width: 52ch;
    margin-top: 24px;
    font-size: 15.5px;
    line-height: 1.78;
    color: color-mix(in srgb, var(--zs-craft-text) 76%, transparent);
  }

  .zs-craft__lead p { margin: 0; }

  .zs-craft__principles {
    display: grid;
    gap: 10px;
    margin-top: 34px;
  }

  .zs-craft__principle {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, white 56%, var(--zs-craft-line));
    border-radius: 16px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, white 52%, transparent),
        color-mix(in srgb, var(--zs-craft-bg) 68%, transparent)
      );
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.62),
      0 8px 24px color-mix(in srgb, var(--zs-craft-wood) 4%, transparent);
    transition: border-color .28s ease, transform .28s ease, box-shadow .28s ease;
  }

  .zs-craft__index {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-top: 1px;
    border: 1px solid color-mix(in srgb, var(--zs-craft-accent) 28%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, white 38%, transparent);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .12em;
    color: var(--zs-craft-accent);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }

  .zs-craft__principle h3 {
    margin: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 23px;
    font-weight: 520;
    line-height: 1.1;
    color: var(--zs-craft-text);
  }

  .zs-craft__principle p {
    margin: 7px 0 0;
    max-width: 48ch;
    font-size: 13.5px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--zs-craft-text) 62%, transparent);
  }

  .zs-craft__quote {
    position: relative;
    margin: 30px 0 0;
    padding-top: 18px;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 20px;
    font-style: italic;
    line-height: 1.4;
    letter-spacing: -.01em;
    color: color-mix(in srgb, var(--zs-craft-accent) 86%, var(--zs-craft-text));
  }

  .zs-craft__quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 54px;
    height: 1px;
    background: linear-gradient(90deg, var(--zs-craft-accent), transparent);
  }

  .zs-craft__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    padding-bottom: 7px;
    border-bottom: 1px solid color-mix(in srgb, var(--zs-craft-accent) 45%, transparent);
    color: var(--zs-craft-wood);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .zs-craft__link svg { transition: transform .25s ease; }

  @media (hover:hover) and (pointer:fine) {
    .zs-craft__principle:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--zs-craft-accent) 32%, white);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.72),
        0 14px 30px color-mix(in srgb, var(--zs-craft-wood) 7%, transparent);
    }
    .zs-craft__link:hover svg { transform: translateX(3px); }
  }

  @media (min-width: 990px) {
    .zs-craft__inner {
      width: min(calc(100% - 96px), var(--zs-craft-max));
      grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
      gap: clamp(58px, 6vw, 108px);
    }

    .zs-craft__content { margin-inline: 0; }
    .zs-craft__heading { font-size: clamp(50px, 4.8vw, 72px); }
    .zs-craft__frame { aspect-ratio: 5 / 6; max-height: 760px; }
  }

  @media (max-width: 749px) {
    .zs-craft {
      padding-block: 58px 62px;
    }

    .zs-craft__inner {
      width: min(calc(100% - 28px), var(--zs-craft-max));
      gap: 24px;
    }

    .zs-craft__frame {
      aspect-ratio: 4 / 3;
      min-height: 0;
      max-height: 330px;
      border-radius: 18px;
    }

    .zs-craft__image {
      object-position: center center;
    }

    .zs-craft__seal {
      left: 14px;
      bottom: 14px;
      width: 76px;
      height: 76px;
      gap: 1px;
      box-shadow:
        0 10px 24px color-mix(in srgb, var(--zs-craft-wood) 20%, transparent),
        inset 0 0 0 4px color-mix(in srgb, #fff 8%, transparent);
    }

    .zs-craft__seal-mark { font-size: 20px; }
    .zs-craft__seal-small { font-size: 5.8px; letter-spacing: .14em; }

    .zs-craft__content {
      padding: 22px 18px 21px;
      border-radius: 20px;
    }

    .zs-craft__eyebrow {
      gap: 10px;
      margin-bottom: 13px;
      font-size: 9.5px;
      letter-spacing: .2em;
    }

    .zs-craft__eyebrow-line { width: 26px; }

    .zs-craft__heading {
      max-width: 11ch;
      font-size: clamp(38px, 10.8vw, 46px);
      line-height: 1;
    }

    .zs-craft__lead {
      margin-top: 17px;
      max-width: 100%;
      font-size: 14px;
      line-height: 1.62;
    }

    .zs-craft__principles {
      gap: 8px;
      margin-top: 24px;
    }

    .zs-craft__principle {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 12px;
      padding: 13px 13px;
      border-radius: 14px;
    }

    .zs-craft__index {
      width: 30px;
      height: 30px;
      font-size: 8px;
    }

    .zs-craft__principle h3 {
      font-size: 19px;
      line-height: 1.08;
    }

    .zs-craft__principle p {
      margin-top: 5px;
      font-size: 12.6px;
      line-height: 1.48;
    }

    .zs-craft__quote {
      margin-top: 21px;
      padding-top: 14px;
      font-size: 17px;
      line-height: 1.35;
    }

    .zs-craft__quote::before { width: 42px; }

    .zs-craft__link {
      margin-top: 20px;
      gap: 9px;
      font-size: 10px;
      letter-spacing: .13em;
    }

    .zs-craft__side-note { display: none; }
  }

  @media (max-width: 390px) {
    .zs-craft {
      padding-block: 52px 56px;
    }

    .zs-craft__frame {
      max-height: 292px;
    }

    .zs-craft__heading {
      font-size: clamp(36px, 10.4vw, 42px);
    }

    .zs-craft__content {
      padding: 20px 16px;
    }

    .zs-craft__principle {
      padding: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-craft__link svg { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Our Craft",
  "tag": "section",
  "class": "section-zaisen-our-craft",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Art of ZAISEN" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted by Nature. <em>Refined by Hand.</em>" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>At ZAISEN, wood is never treated as a blank surface. We preserve its grain, tone and natural variation, then shape each piece by hand into objects with quiet presence — considered for today and made to age beautifully.</p>"
    },
    { "type": "text", "id": "quote", "label": "Closing line", "default": "Objects with presence. Craft with permanence." },
    { "type": "text", "id": "side_note", "label": "Image side note", "default": "Natural grain • human craft • enduring form" },
    { "type": "image_picker", "id": "image", "label": "Craft image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Handcrafted wooden pieces by ZAISEN" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the Craft" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F6F1E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2A29" },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#A8794A" },
    { "type": "color", "id": "wood_color", "label": "Walnut accent", "default": "#7A5238" },
    { "type": "color", "id": "line_color", "label": "Divider", "default": "#D8C7B3" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Craft principle",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Material Integrity" },
        { "type": "text", "id": "text", "label": "Text", "default": "Chosen for authentic grain, natural warmth and the individual character that makes every piece distinct." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Our Craft",
      "blocks": [
        { "type": "principle", "settings": { "title": "Material Integrity", "text": "Chosen for authentic grain, natural warmth and the individual character that makes every piece distinct." } },
        { "type": "principle", "settings": { "title": "Hand-Finished Detail", "text": "Edges, surfaces and proportions are refined by hand for a tactile, considered finish." } },
        { "type": "principle", "settings": { "title": "Enduring Form", "text": "Sculptural silhouettes designed to live naturally with modern interiors and age with character." } }
      ]
    }
  ]
}
{% endschema %}
