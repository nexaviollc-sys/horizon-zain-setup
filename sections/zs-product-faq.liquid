{% comment %}
  ZAISEN product FAQ: mirrors the same headings, disclosure rows, + icons and
  typography as the FAQ on the homepage (sections/zs-shipping-faq.liquid).
  Compact desktop split / stacked mobile layout. Six editable questions.
{% endcomment %}
{%- liquid
  assign zs_faq_country = localization.country.iso_code
  assign zs_faq_destination = localization.country.name
  assign zs_faq_transit = ''
  case zs_faq_country
    when 'GB'
      assign zs_faq_destination = 'the United Kingdom'
      assign zs_faq_transit = '4–5 days'
    when 'US'
      assign zs_faq_destination = 'the United States'
      assign zs_faq_transit = '8–9 days'
    when 'DE'
      assign zs_faq_destination = 'Germany'
      assign zs_faq_transit = '8–9 days'
    when 'FR'
      assign zs_faq_destination = 'France'
      assign zs_faq_transit = '8–9 days'
    when 'AE'
      assign zs_faq_destination = 'the United Arab Emirates'
      assign zs_faq_transit = '8–9 days'
    when 'CA'
      assign zs_faq_destination = 'Canada'
      assign zs_faq_transit = '8–9 days'
    when 'AU'
      assign zs_faq_destination = 'Australia'
      assign zs_faq_transit = '8–9 days'
  endcase
-%}
<section class="zs-product-faq" id="zs-product-faq-{{ section.id }}" aria-labelledby="zs-product-faq-title-{{ section.id }}">
  <div class="zs-product-faq__container">
    <div class="zs-product-faq__layout">
      <header class="zs-product-faq__header">
        <p class="zs-product-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="zs-product-faq__heading" id="zs-product-faq-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="zs-product-faq__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
        <a class="zs-product-faq__contact-link" href="mailto:support@zaisenstore.com">
          {{ section.settings.help_heading | default: 'Contact ZAISEN' | escape }}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
        </a>
      </header>
      <div class="zs-product-faq__faq" aria-label="Frequently asked questions">
        <div class="zs-product-faq__faq-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'question' and block.settings.question != blank -%}
              <details class="zs-product-faq__faq-item" {{ block.shopify_attributes }}>
                <summary class="zs-product-faq__question">
                  <span>{{ block.settings.question | escape }}</span>
                  <span class="zs-product-faq__faq-toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 12h14"/><path class="zs-product-faq__vertical" d="M12 5v14"/></svg>
                  </span>
                </summary>
                <div class="zs-product-faq__answer rte">
                  {%- case block.settings.answer_kind -%}
                    {%- when 'delivery' -%}
                      <p>Shipping times are estimates, not guaranteed delivery dates. We normally prepare orders in <strong>1–2 days</strong> before dispatch. {% if zs_faq_transit != blank %}For <strong>{{ zs_faq_destination | escape }}</strong>, estimated transit after dispatch is <strong>{{ zs_faq_transit }}</strong>.{% else %}Shipping times depend on your selected destination and will be confirmed at checkout.{% endif %} Customs, holidays and carrier delays may affect delivery. You'll receive tracking after dispatch.</p>
                    {%- when 'returns' -%}
                      <p><strong>Yes.</strong> Contact us within <strong>14 days after delivery</strong> for an eligible return or refund request. If a piece arrives damaged, broken or not as described, email <a href="mailto:support@zaisenstore.com">support@zaisenstore.com</a> with your order number and clear photos. {% if shop.refund_policy != blank %}See our <a href="{{ shop.refund_policy.url }}">Refund Policy</a> for full details and exclusions.{% endif %}</p>
                    {%- else -%}
                      {{ block.settings.answer }}
                  {%- endcase -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* Values match the homepage .zs-shf__faq, __question, __faq-toggle and __answer. */
  #zs-product-faq-{{ section.id }} {
    --zs-pfaq-ink: #2b1d17;
    --zs-pfaq-muted: #80736a;
    --zs-pfaq-accent: #d8b56a;
    color: var(--zs-pfaq-ink);
    background: #fcfaf7;
    padding: clamp(35px,4vw,56px) 0 clamp(38px,4vw,58px);
  }
  #zs-product-faq-{{ section.id }} * { box-sizing: border-box; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px,4vw,58px);
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__layout {
    display: grid;
    grid-template-columns: minmax(0,.76fr) minmax(0,1.24fr);
    gap: clamp(28px,4vw,62px);
    align-items: start;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__header { min-width:0; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__eyebrow {
    color: #977653;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 10px;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__heading {
    font-family: inherit !important;
    font-size: clamp(27px,2.75vw,38px);
    font-weight: 700;
    letter-spacing: -.038em;
    margin: 0 0 17px;
    line-height: 1.25;
    max-width: 390px;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__intro {
    color: var(--zs-pfaq-muted);
    font-size: 13px;
    line-height: 1.75;
    margin: 0;
    max-width: 360px;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 12px;
    font-weight: 650;
    color: #664632;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq { min-width: 0; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-item {
    border-bottom: 1px solid #e4dcd2;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-item:first-child {
    border-top: 1px solid #e4dcd2;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    cursor: pointer;
    padding: 19px 0;
    min-height: 59px;
    list-style: none;
    font-weight: 650;
    line-height: 1.45;
    font-size: 14px;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__question::-webkit-details-marker { display:none; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__question::marker { content: ''; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #ded2c6;
    flex: 0 0 32px;
    color: var(--zs-pfaq-ink);
    background: #fff;
    transition: background .2s, border-color .2s;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__vertical {
    transform-origin: 50% 50%;
    transition: transform .2s ease;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-item[open] .zs-product-faq__vertical {
    transform: rotate(90deg);
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-item[open] .zs-product-faq__faq-toggle {
    background: #f3e9dc;
    border-color: #d8b56a;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__answer {
    padding: 0 42px 22px 0;
    color: var(--zs-pfaq-muted);
    font-size: 13px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__answer p { margin: 0 0 9px; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__answer p:last-child { margin: 0; }
  #zs-product-faq-{{ section.id }} .zs-product-faq__answer a {
    color: #664632;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #zs-product-faq-{{ section.id }} .zs-product-faq__faq-item:focus-within .zs-product-faq__question:focus-visible,
  #zs-product-faq-{{ section.id }} .zs-product-faq__contact-link:focus-visible {
    outline: 3px solid var(--zs-pfaq-accent);
    outline-offset: 3px;
  }
  @media (max-width:749px) {
    #zs-product-faq-{{ section.id }} { padding: 32px 0 42px; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__container { padding-inline: 16px; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__layout {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    #zs-product-faq-{{ section.id }} .zs-product-faq__header,
    #zs-product-faq-{{ section.id }} .zs-product-faq__faq { width:100%; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__eyebrow { font-size: 10px; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__heading {
      font-size: 28px; margin: 0 0 8px; max-width: none;
    }
    #zs-product-faq-{{ section.id }} .zs-product-faq__intro { font-size: 12px; line-height: 1.6; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__contact-link { margin-top: 9px; }
    #zs-product-faq-{{ section.id }} .zs-product-faq__question {
      font-size: 12.5px; padding: 16px 0; min-height: 56px;
    }
    #zs-product-faq-{{ section.id }} .zs-product-faq__answer {
      padding: 0 30px 18px 0; font-size: 12px; line-height: 1.75;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #zs-product-faq-{{ section.id }} .zs-product-faq__faq-toggle,
    #zs-product-faq-{{ section.id }} .zs-product-faq__vertical { transition: none; }
  }
</style>
{% schema %}
{
  "name": "ZAISEN Product FAQs",
  "tag": "section",
  "class": "section-zs-product-faq",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GOOD TO KNOW"},
    {"type":"text","id":"heading","label":"Heading","default":"Frequently Asked Questions"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Answers about our wood, handcrafted pieces and your order."},
    {"type":"text","id":"help_heading","label":"Support link text","default":"Contact ZAISEN"}
  ],
  "blocks": [
    {
      "type":"question",
      "name":"FAQ question",
      "settings": [
        {"type":"text","id":"question","label":"Question","default":"Your question"},
        {"type":"select","id":"answer_kind","label":"Answer source","default":"custom","info":"Delivery uses selected market. Returns links to your refund policy.","options":[
          {"value":"custom","label":"Custom answer"},
          {"value":"delivery","label":"Destination delivery estimate"},
          {"value":"returns","label":"Refund policy summary"}
        ]},
        {"type":"richtext","id":"answer","label":"Custom answer","default":"<p>Enter your answer here.</p>"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"ZAISEN Product FAQs"}]
}
{% endschema %}
