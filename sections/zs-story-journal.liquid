{%- comment -%}
  ZAISEN editorial Story / Journal homepage invitations.
  Two 16:9 landscape images, independent images and destinations, accessible
  inert Story CTA until the page exists; existing Shopify blog can be linked.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign editorial_font = s.editorial_font
  assign light_font = editorial_font | font_modify: 'weight', '300'
  assign medium_font = editorial_font | font_modify: 'weight', '500'
  assign bold_font = editorial_font | font_modify: 'weight', '700'

  assign story_img = s.story_image
  if story_img == blank
    assign story_collection = collections['home-decor']
    if story_collection != blank
      assign story_img = story_collection.image
      if story_img == blank
        assign story_img = story_collection.products.first.featured_image
      endif
    endif
  endif

  assign journal_img = s.journal_image
  if journal_img == blank
    assign journal_collection = collections['lighting']
    if journal_collection != blank
      assign journal_img = journal_collection.image
      if journal_img == blank
        assign journal_img = journal_collection.products.first.featured_image
      endif
    endif
  endif

  assign story_href = s.story_link
  if story_href == blank
    assign story_page = pages['our-story']
    if story_page != blank
      assign story_href = story_page.url
    endif
  endif

  assign journal_href = s.journal_link
  if journal_href == blank
    assign journal_blog = blogs['news']
    if journal_blog != blank
      assign journal_href = journal_blog.url
    endif
  endif
-%}
{%- if editorial_font != blank -%}
  {% style %}
    {{ editorial_font | font_face: font_display: 'swap' }}
    {% if light_font != blank %}{{ light_font | font_face: font_display: 'swap' }}{% endif %}
    {% if medium_font != blank %}{{ medium_font | font_face: font_display: 'swap' }}{% endif %}
    {% if bold_font != blank %}{{ bold_font | font_face: font_display: 'swap' }}{% endif %}
    #zs-story-journal-{{ section.id }} {
      font-family: {{ editorial_font.family | json }}, {{ editorial_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  #zs-story-journal-{{ section.id }} {
    --zs-sj-bg:{{ s.bg_color }};
    --zs-sj-ink:{{ s.heading_color }};
    --zs-sj-muted:{{ s.text_color }};
    --zs-sj-accent:{{ s.accent_color }};
    --zs-sj-pad-top:{{ s.padding_top }}px;
    --zs-sj-pad-bottom:{{ s.padding_bottom }}px;
  }
{% endstyle %}

<section id="zs-story-journal-{{ section.id }}" class="zs-sj" aria-labelledby="zs-story-journal-title-{{ section.id }}">
  <div class="zs-sj__container">
    <header class="zs-sj__intro">
      {% if s.eyebrow != blank %}
        <p class="zs-sj__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="zs-sj__headline" id="zs-story-journal-title-{{ section.id }}">
        <span class="zs-sj__headline-light">{{ s.heading_light | escape }}</span>
        <strong class="zs-sj__headline-strong">{{ s.heading_bold | escape }}</strong>
      </h2>
      {% if s.intro_text != blank %}
        <p class="zs-sj__intro-text">{{ s.intro_text | escape }}</p>
      {% endif %}
    </header>

    <div class="zs-sj__grid">
      <article class="zs-sj__card">
        {% if story_href != blank %}
          <a class="zs-sj__link" href="{{ story_href }}" aria-label="{{ s.story_cta | escape }}">
        {% else %}
          <div class="zs-sj__link zs-sj__link--pending">
        {% endif %}
          <div class="zs-sj__photo">
            {% if story_img != blank %}
              {{ story_img | image_url: width: 1400 | image_tag: class: 'zs-sj__image', loading: 'lazy', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 960px) calc((100vw - 150px) / 2), calc(100vw - 40px)', alt: s.story_title }}
            {% else %}
              <div class="zs-sj__image-placeholder" aria-hidden="true"><span>ZAISEN</span></div>
            {% endif %}
          </div>
          <div class="zs-sj__card-info">
            <div class="zs-sj__card-copy">
              <h3 class="zs-sj__card-title">{{ s.story_title | escape }}</h3>
              {% if s.story_text != blank %}
                <p class="zs-sj__card-description">{{ s.story_text | escape }}</p>
              {% endif %}
            </div>
            <span class="zs-sj__card-action">
              <span>{{ s.story_cta | escape }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
            </span>
          </div>
        {% if story_href != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </article>

      <article class="zs-sj__card">
        {% if journal_href != blank %}
          <a class="zs-sj__link" href="{{ journal_href }}" aria-label="{{ s.journal_cta | escape }}">
        {% else %}
          <div class="zs-sj__link zs-sj__link--pending">
        {% endif %}
          <div class="zs-sj__photo">
            {% if journal_img != blank %}
              {{ journal_img | image_url: width: 1400 | image_tag: class: 'zs-sj__image', loading: 'lazy', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 960px) calc((100vw - 150px) / 2), calc(100vw - 40px)', alt: s.journal_title }}
            {% else %}
              <div class="zs-sj__image-placeholder" aria-hidden="true"><span>ZAISEN</span></div>
            {% endif %}
          </div>
          <div class="zs-sj__card-info">
            <div class="zs-sj__card-copy">
              <h3 class="zs-sj__card-title">{{ s.journal_title | escape }}</h3>
              {% if s.journal_text != blank %}
                <p class="zs-sj__card-description">{{ s.journal_text | escape }}</p>
              {% endif %}
            </div>
            <span class="zs-sj__card-action">
              <span>{{ s.journal_cta | escape }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
            </span>
          </div>
        {% if journal_href != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
.zs-sj{background:var(--zs-sj-bg,#FAF8F5);color:var(--zs-sj-ink,#2B1D17);padding:var(--zs-sj-pad-top,92px) 0 var(--zs-sj-pad-bottom,96px)}
.zs-sj *{box-sizing:border-box}
.zs-sj__container{width:100%;max-width:1440px;margin:0 auto;padding-inline:clamp(20px,4vw,58px)}
.zs-sj__intro{margin:0 0 clamp(33px,3.4vw,48px)}
.zs-sj__eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 22px;color:#906D50;font-size:clamp(10px,.82vw,12px);font-weight:500;letter-spacing:.17em;text-transform:uppercase}
.zs-sj__eyebrow span{display:block;flex:0 0 32px;width:32px;height:2px;background:var(--zs-sj-accent,#D8B56A)}
.zs-sj__headline{display:flex;align-items:baseline;flex-wrap:wrap;gap:.25em;margin:0;font-family:inherit!important;font-size:clamp(40px,4.1vw,60px);line-height:1.12;letter-spacing:-.054em;text-wrap:balance;color:var(--zs-sj-ink,#2B1D17)}
.zs-sj__headline-light{font-weight:300}
.zs-sj__headline-strong{font-weight:700}
.zs-sj__intro-text{margin:17px 0 0;max-width:75ch;font-size:clamp(13px,1.02vw,15px);font-weight:400;line-height:1.75;color:var(--zs-sj-muted,#80736A)}
.zs-sj__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(18px,2.4vw,34px);align-items:start}
.zs-sj__card{min-width:0}
.zs-sj__link{display:block;color:inherit;text-decoration:none;outline-offset:5px}
.zs-sj__link:visited{color:inherit}
.zs-sj__photo{position:relative;display:block;width:100%;aspect-ratio:16 / 9;overflow:hidden;border-radius:20px;background:#EDE4D8;isolation:isolate}
.zs-sj__image{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .6s cubic-bezier(.22,.68,.2,1)}
.zs-sj__image-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:linear-gradient(145deg,#D7C7B5,#A98E76);color:#FDFBF8}
.zs-sj__image-placeholder span{font-size:clamp(20px,3vw,36px);font-weight:300;letter-spacing:.23em}
.zs-sj__card-info{display:flex;flex-direction:column;align-items:flex-start;gap:19px;padding:24px 2px 0}
.zs-sj__card-title{margin:0;font-family:inherit!important;font-size:clamp(21px,1.9vw,28px);font-weight:700;letter-spacing:-.04em;line-height:1.27;color:var(--zs-sj-ink,#2B1D17)}
.zs-sj__card-description{margin:9px 0 0;color:var(--zs-sj-muted,#80736A);font-size:clamp(12px,.98vw,14px);line-height:1.7;font-weight:400}
.zs-sj__card-action{display:inline-flex;align-items:center;gap:10px;padding-bottom:5px;border-bottom:1px solid color-mix(in srgb,var(--zs-sj-accent,#D8B56A) 58%,transparent);font-size:13px;font-weight:500;line-height:1.45;color:var(--zs-sj-ink,#2B1D17);transition:border-color .25s ease}
.zs-sj__card-action svg{flex-shrink:0;transition:transform .25s ease}
.zs-sj__link:focus-visible{outline:2px solid var(--zs-sj-accent,#D8B56A)}
.zs-sj__link--pending{cursor:default}
.zs-sj__link--pending .zs-sj__card-action{opacity:.68;border-bottom-color:transparent}
@media(hover:hover) and (pointer:fine){
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__image{transform:scale(1.035)}
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__card-action{border-bottom-color:var(--zs-sj-ink,#2B1D17)}
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__card-action svg{transform:translate(2px,-2px)}
}
@media(max-width:749px){
 .zs-sj{padding:66px 0 72px}
 .zs-sj__container{padding-inline:16px}
 .zs-sj__eyebrow{font-size:9px;margin-bottom:17px}
 .zs-sj__headline{font-size:clamp(36px,9.4vw,51px)}
 .zs-sj__intro{margin-bottom:29px}
 .zs-sj__intro-text{font-size:12px;line-height:1.65}
 .zs-sj__grid{grid-template-columns:1fr;gap:43px}
 .zs-sj__photo{border-radius:16px}
 .zs-sj__card-info{padding:17px 2px 0;gap:13px}
 .zs-sj__card-title{font-size:22px}
 .zs-sj__card-description{font-size:12px}
 .zs-sj__card-action{font-size:12px}
}
@media(prefers-reduced-motion:reduce){.zs-sj__image,.zs-sj__card-action,.zs-sj__card-action svg{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name":"ZAISEN Story & Journal",
  "tag":"section",
  "class":"section-zs-story-journal",
  "settings":[
    {"type":"header","content":"Section heading"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER MORE ABOUT ZAISEN"},
    {"type":"text","id":"heading_light","label":"Heading first part","default":"More Than"},
    {"type":"text","id":"heading_bold","label":"Heading bold part","default":"Wood."},
    {"type":"textarea","id":"intro_text","label":"Introduction","default":"Meet the people behind ZAISEN and find inspiration for a home filled with natural warmth."},
    {"type":"header","content":"Our Story"},
    {"type":"image_picker","id":"story_image","label":"Story landscape image"},
    {"type":"text","id":"story_title","label":"Story card heading","default":"Our Story"},
    {"type":"textarea","id":"story_text","label":"Story description","default":"Get to know the people and passion behind ZAISEN."},
    {"type":"text","id":"story_cta","label":"Story link text","default":"Discover Our Story"},
    {"type":"url","id":"story_link","label":"Story page link (active when page exists)"},
    {"type":"header","content":"Our Blog"},
    {"type":"image_picker","id":"journal_image","label":"Blog landscape image"},
    {"type":"text","id":"journal_title","label":"Blog card heading","default":"Our Blog"},
    {"type":"textarea","id":"journal_text","label":"Blog description","default":"Explore ideas, inspiration, and stories about wooden living."},
    {"type":"text","id":"journal_cta","label":"Blog link text","default":"Explore Our Blog"},
    {"type":"url","id":"journal_link","label":"Blog destination"},
    {"type":"header","content":"Appearance"},
    {"type":"font_picker","id":"editorial_font","label":"Text font","default":"poppins_n4"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FAF8F5"},
    {"type":"color","id":"heading_color","label":"Heading and links","default":"#2B1D17"},
    {"type":"color","id":"text_color","label":"Body text","default":"#80736A"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#D8B56A"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":40,"max":160,"step":4,"unit":"px","default":92},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":40,"max":160,"step":4,"unit":"px","default":96}
  ],
  "presets":[{"name":"ZAISEN Story & Journal"}]
}
{% endschema %}
