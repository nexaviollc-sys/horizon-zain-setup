{%- liquid
  assign s = section.settings
  assign blog = s.blog
  if blog == blank
    assign blog = blogs['news']
  endif
  assign story_link = s.story_link | default: routes.all_products_collection_url
-%}
<section id="zaisen-our-story" class="za-journal" aria-labelledby="za-journal-title-{{ section.id }}">
  <div class="za-journal__shell">
    <header class="za-journal__head">
      <p class="za-small-label">ROOTED IN MATERIAL / INSPIRED BY LIFE</p>
      <h2 id="za-journal-title-{{ section.id }}">{{ s.heading | escape }}</h2>
      <p>{{ s.intro | escape }}</p>
    </header>
    <div class="za-journal__layout">
      <article class="za-journal__story">
        <p class="za-journal__index">01 <span> / {{ s.story_label | escape }}</span></p>
        {%- if s.story_image != blank -%}
          <div class="za-journal__photograph">
            {{ s.story_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400, 600, 850, 1100', sizes: '(min-width: 900px) 47vw, 95vw', alt: 'ZAISEN natural wooden craftsmanship' }}
          </div>
        {%- endif -%}
        <h3>{{ s.story_title | escape }}</h3>
        <div class="za-journal__copy rte">{{ s.story_text }}</div>
        <a href="{{ story_link }}" class="za-editorial-link">{{ s.story_button | escape }} <span aria-hidden="true">↗</span></a>
      </article>
      <div class="za-journal__entries">
        <div class="za-journal__entries-head">
          <p class="za-journal__index">02 <span> / {{ s.journal_label | escape }}</span></p>
          <h3>{{ s.journal_title | escape }}</h3>
        </div>
        {%- if blog != blank and blog.articles_count > 0 -%}
          <div class="za-journal__articles">
            {%- for article in blog.articles limit:2 -%}
              <article class="za-journal__article">
                <a href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                  <span class="za-journal__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
                  <h4>{{ article.title | escape }}</h4>
                  <p>{{ article.excerpt_or_content | strip_html | truncate: 125 }}</p>
                  <span class="za-journal__read">{{ s.read_label | escape }} <span aria-hidden="true">↗</span></span>
                </a>
              </article>
            {%- endfor -%}
            <a class="za-editorial-link" href="{{ blog.url }}">{{ s.journal_button | escape }} <span aria-hidden="true">↗</span></a>
          </div>
        {%- else -%}
          <div class="za-journal__empty">
            <span class="za-journal__thin-rule" aria-hidden="true"></span>
            <span class="za-journal__empty-kicker">{{ s.empty_label | escape }}</span>
            <h4>{{ s.empty_title | escape }}</h4>
            <p>{{ s.empty_text | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.za-journal{background:#EAE4DB;color:#24211E;padding:clamp(75px,8vw,115px) 0;scroll-margin-top:95px}
.za-journal *{box-sizing:border-box}
.za-journal__shell{max-width:1520px;margin:0 auto;padding:0 clamp(20px,4.6vw,75px)}
.za-journal__head{margin-bottom:62px}
.za-journal__head h2{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(3rem,5vw,6rem);letter-spacing:-.05em;line-height:1;font-weight:500;margin:0 0 16px}
.za-journal__head>p:last-child{font-size:.9rem;line-height:1.8;color:#777067;margin:0}
.za-journal__layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(46px,7vw,105px)}
.za-journal__story{min-width:0}
.za-journal__index{font-family:var(--font-body--family,Arial,sans-serif);font-size:.9rem;letter-spacing:.06em;color:#74533C;font-weight:650;margin:0 0 25px}
.za-journal__index span{font-size:.63rem;letter-spacing:.15em;font-weight:600;text-transform:uppercase}
.za-journal__story h3,.za-journal__entries h3{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(2.4rem,3.9vw,4.5rem);font-weight:500;letter-spacing:-.038em;line-height:1.03;margin:0 0 27px;max-width:13ch}
.za-journal__copy{max-width:53ch;font-family:var(--font-body--family,Arial,sans-serif);color:#5F5851;line-height:1.85;font-size:.92rem}
.za-journal__copy p{margin:0 0 16px}
.za-journal__story>.za-editorial-link{margin-top:21px}
.za-journal__photograph{aspect-ratio:16/9;overflow:hidden;margin:0 0 30px;background:#DCD3C7}
.za-journal__photograph img{display:block;width:100%;height:100%;object-fit:cover}
.za-journal__entries{border-left:1px solid #CFC3B5;padding-left:clamp(30px,5vw,70px)}
.za-journal__entries-head h3{margin-bottom:20px}
.za-journal__article{border-top:1px solid #CFC3B5;padding:23px 0 26px}
.za-journal__article a{display:block;color:inherit;text-decoration:none}
.za-journal__date,.za-journal__empty-kicker{font-size:.63rem;letter-spacing:.13em;text-transform:uppercase;color:#74533C;font-weight:650}
.za-journal__article h4{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(1.75rem,2.6vw,2.7rem);font-weight:500;letter-spacing:-.03em;line-height:1.1;margin:10px 0}
.za-journal__article p{font-size:.82rem;line-height:1.65;color:#6D655C;margin:0 0 13px}
.za-journal__read{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:#74533C}
.za-journal__read span{margin-left:8px}
.za-journal__article a:hover h4{color:#74533C}
.za-journal__empty{border-top:1px solid #CFC3B5;padding-top:28px}
.za-journal__thin-rule{display:block;width:67px;height:1px;background:#74533C;margin:2px 0 45px}
.za-journal__empty h4{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(2.1rem,3vw,3.3rem);line-height:1.1;letter-spacing:-.038em;font-weight:500;margin:17px 0}
.za-journal__empty p{max-width:39ch;font-size:.87rem;line-height:1.75;color:#706960;margin:0}
.za-journal a:focus-visible{outline:2px solid #74533C;outline-offset:4px}
@media(max-width:900px){.za-journal__layout{grid-template-columns:1fr;gap:65px}.za-journal__entries{border-left:0;border-top:1px solid #CFC3B5;padding-left:0;padding-top:40px}.za-journal__story h3,.za-journal__entries h3{max-width:20ch}}
@media(max-width:600px){.za-journal{padding:67px 0}.za-journal__head{margin-bottom:40px}.za-journal__head h2{font-size:clamp(3.05rem,12vw,4.4rem)}.za-journal__layout{gap:48px}.za-journal__story h3{font-size:3rem}.za-journal__entries h3{font-size:2.9rem}.za-journal__copy{font-size:.85rem}}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Story & Blogs",
  "tag": "section",
  "class": "zs-story-journal-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Top eyebrow","default":"THE WORLD OF ZAISEN"},
    {"type":"text","id":"heading","label":"Main heading","default":"Our Story. Our Journal."},
    {"type":"textarea","id":"intro","label":"Section introduction","default":"A closer look at the hands, materials and ideas behind the objects we make."},
    {"type":"image_picker","id":"story_image","label":"Optional story photograph"},
    {"type":"text","id":"visual_caption","label":"Image caption","default":"ROOTED IN NATURE · REFINED BY HAND"},
    {"type":"text","id":"story_label","label":"Story eyebrow","default":"OUR STORY"},
    {"type":"text","id":"story_title","label":"Story title","default":"A little closer to the craft."},
    {"type":"richtext","id":"story_text","label":"Story text","default":"<p>At ZAISEN, we believe natural wood has its own quiet character. Through careful shaping and hand-finished details, we turn that character into pieces made to feel at home in the spaces you love.</p><p>Thoughtful materials. Unhurried craftsmanship. Everyday objects with something more to say.</p>"},
    {"type":"text","id":"story_button","label":"Story button","default":"Explore our collection"},
    {"type":"url","id":"story_link","label":"Story button link"},
    {"type":"blog","id":"blog","label":"Featured blog"},
    {"type":"text","id":"journal_label","label":"Journal eyebrow","default":"OUR BLOGS"},
    {"type":"text","id":"journal_title","label":"Journal heading","default":"From the Journal"},
    {"type":"text","id":"journal_button","label":"View all label","default":"View all stories"},
    {"type":"text","id":"read_label","label":"Read article label","default":"Read the story"},
    {"type":"text","id":"empty_label","label":"Empty journal eyebrow","default":"A NEW CHAPTER IS COMING"},
    {"type":"text","id":"empty_title","label":"Empty journal title","default":"Stories worth sharing."},
    {"type":"textarea","id":"empty_text","label":"Empty journal message","default":"Wood, craftsmanship and considered living. Notes from the ZAISEN workshop will appear here soon."},
    {"type":"color","id":"bg_color","label":"Section background","default":"#39463A"},
    {"type":"color","id":"text_color","label":"Text color","default":"#FAF9F6"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#B69A6A"},
    {"type":"color","id":"walnut_color","label":"Walnut color","default":"#7A5238"},
    {"type":"range","id":"padding_top","label":"Top padding","min":40,"max":140,"step":4,"unit":"px","default":88},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":40,"max":140,"step":4,"unit":"px","default":88}
  ],
  "presets":[{"name":"ZAISEN Story & Blogs"}]
}
{% endschema %}