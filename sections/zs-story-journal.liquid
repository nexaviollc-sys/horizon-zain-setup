{%- comment -%}
  ZAISEN editorial Story / Journal homepage invitations.
  Two 16:9 landscape images, independent images and destinations, accessible
  inert Story CTA until the page exists; existing Shopify blog can be linked.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign editorial_font = s.editorial_font
  assign light_font = editorial_font | font_modify: 'weight', '300'
  assign medium_font = editorial_font | font_modify: 'weight', '500'
  assign bold_font = editorial_font | font_modify: 'weight', '700'

  assign story_img = s.story_image
  if story_img == blank
    assign story_collection = collections['home-decor']
    if story_collection != blank
      assign story_img = story_collection.image
      if story_img == blank
        assign story_img = story_collection.products.first.featured_image
      endif
    endif
  endif

  assign journal_img = s.journal_image
  if journal_img == blank
    assign journal_collection = collections['lighting']
    if journal_collection != blank
      assign journal_img = journal_collection.image
      if journal_img == blank
        assign journal_img = journal_collection.products.first.featured_image
      endif
    endif
  endif

  assign story_image_alt = story_img.alt | default: 'ZAISEN Our Story - the craft behind our handcrafted wooden home decor'
  assign journal_image_alt = journal_img.alt | default: 'The ZAISEN Journal - wooden home decor ideas and craftsmanship inspiration'

  assign story_href = s.story_link
  if story_href == blank
    assign story_page = pages['our-story']
    if story_page != blank
      assign story_href = story_page.url
    endif
  endif

  assign journal_href = s.journal_link
  if journal_href == blank
    assign journal_blog = blogs['zaisen-journal']
    if journal_blog != blank
      assign journal_href = journal_blog.url
    endif
  endif
-%}
{%- if editorial_font != blank -%}
  {% style %}
    {{ editorial_font | font_face: font_display: 'swap' }}
    {% if light_font != blank %}{{ light_font | font_face: font_display: 'swap' }}{% endif %}
    {% if medium_font != blank %}{{ medium_font | font_face: font_display: 'swap' }}{% endif %}
    {% if bold_font != blank %}{{ bold_font | font_face: font_display: 'swap' }}{% endif %}
    #zs-story-journal-{{ section.id }} {
      font-family: {{ editorial_font.family | json }}, {{ editorial_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  #zs-story-journal-{{ section.id }} {
    --zs-sj-bg:{{ s.bg_color }};
    --zs-sj-ink:{{ s.heading_color }};
    --zs-sj-muted:{{ s.text_color }};
    --zs-sj-accent:{{ s.accent_color }};
    --zs-sj-pad-top:{{ s.padding_top }}px;
    --zs-sj-pad-bottom:{{ s.padding_bottom }}px;
  }
{% endstyle %}

<section id="zs-story-journal-{{ section.id }}" class="zs-sj" aria-labelledby="zs-story-journal-title-{{ section.id }}">
  <div class="zs-sj__container">
    <header class="zs-sj__intro">
      {% if s.eyebrow != blank %}
        <p class="zs-sj__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="zs-sj__headline" id="zs-story-journal-title-{{ section.id }}">
        <span class="zs-sj__headline-light">{{ s.heading_light | escape }}</span>
        <strong class="zs-sj__headline-strong">{{ s.heading_bold | escape }}</strong>
      </h2>
      {% if s.intro_text != blank %}
        <p class="zs-sj__intro-text">{{ s.intro_text | escape }}</p>
      {% endif %}
    </header>

    <div class="zs-sj__grid" aria-label="Discover ZAISEN stories and inspiration">
      <article class="zs-sj__card">
        {% if story_href != blank %}
          <a class="zs-sj__link" href="{{ story_href }}" aria-label="{{ s.story_cta | escape }}">
        {% else %}
          <div class="zs-sj__link zs-sj__link--pending">
        {% endif %}
          <div class="zs-sj__photo">
            {% if story_img != blank %}
              {{ story_img | image_url: width: 1400 | image_tag: class: 'zs-sj__image', loading: 'lazy', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 960px) calc((100vw - 150px) / 2), calc(100vw - 40px)', alt: story_image_alt }}
            {% else %}
              <div class="zs-sj__image-placeholder" aria-hidden="true"><span>ZAISEN</span></div>
            {% endif %}
          </div>
          <div class="zs-sj__card-info">
            <div class="zs-sj__card-copy">
              <p class="zs-sj__card-index">01 <span aria-hidden="true">/</span> BEHIND THE BRAND</p>
              <h3 class="zs-sj__card-title">{{ s.story_title | escape }}</h3>
              {% if s.story_text != blank %}
                <p class="zs-sj__card-description">{{ s.story_text | escape }}</p>
              {% endif %}
            </div>
            <span class="zs-sj__card-action">
              <span>{{ s.story_cta | escape }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
            </span>
          </div>
        {% if story_href != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </article>

      <article class="zs-sj__card">
        {% if journal_href != blank %}
          <a class="zs-sj__link" href="{{ journal_href }}" aria-label="{{ s.journal_cta | escape }}">
        {% else %}
          <div class="zs-sj__link zs-sj__link--pending">
        {% endif %}
          <div class="zs-sj__photo">
            {% if journal_img != blank %}
              {{ journal_img | image_url: width: 1400 | image_tag: class: 'zs-sj__image', loading: 'lazy', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 960px) calc((100vw - 150px) / 2), calc(100vw - 40px)', alt: journal_image_alt }}
            {% else %}
              <div class="zs-sj__image-placeholder" aria-hidden="true"><span>ZAISEN</span></div>
            {% endif %}
          </div>
          <div class="zs-sj__card-info">
            <div class="zs-sj__card-copy">
              <p class="zs-sj__card-index">02 <span aria-hidden="true">/</span> IDEAS & INSPIRATION</p>
              <h3 class="zs-sj__card-title">{{ s.journal_title | escape }}</h3>
              {% if s.journal_text != blank %}
                <p class="zs-sj__card-description">{{ s.journal_text | escape }}</p>
              {% endif %}
            </div>
            <span class="zs-sj__card-action">
              <span>{{ s.journal_cta | escape }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg>
            </span>
          </div>
        {% if journal_href != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
.zs-sj{
  position:relative;
  background:var(--zs-sj-bg,#FFFFFF);
  color:var(--zs-sj-ink,#2B1D17);
  padding:var(--zs-sj-pad-top,72px) 0 var(--zs-sj-pad-bottom,76px);
}
.zs-sj *{box-sizing:border-box}
.zs-sj__container{width:100%;max-width:1440px;margin:0 auto;padding-inline:clamp(20px,4vw,58px)}
.zs-sj__intro{
  display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);
  align-items:end;column-gap:clamp(28px,6vw,110px);
  margin:0 0 clamp(27px,3vw,43px);
}
.zs-sj__eyebrow{
  grid-column:1/-1;display:flex;align-items:center;gap:13px;
  margin:0 0 17px;color:#947255;font-size:10px;
  font-weight:500;line-height:1.5;letter-spacing:.17em;text-transform:uppercase;
}
.zs-sj__eyebrow span{
  display:block;flex:0 0 28px;width:28px;height:2px;background:var(--zs-sj-accent,#D8B56A);
}
.zs-sj__headline{
  display:flex;align-items:baseline;flex-wrap:wrap;gap:.22em;margin:0;
  color:var(--zs-sj-ink,#2B1D17);font-family:inherit!important;
  font-size:clamp(38px,4vw,58px);line-height:1.13;letter-spacing:-.058em;
}
.zs-sj__headline-light{font-weight:300}
.zs-sj__headline-strong{font-weight:700}
.zs-sj__intro-text{
  margin:0 0 6px;max-width:47ch;
  color:var(--zs-sj-muted,#80736A);
  font-size:clamp(12px,1vw,14px);font-weight:400;line-height:1.8;
}
.zs-sj__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(18px,2.1vw,32px)}
.zs-sj__card{min-width:0}
.zs-sj__link{display:block;min-width:0;color:inherit;text-decoration:none;outline-offset:5px}
.zs-sj__link:visited{color:inherit}
.zs-sj__photo{
  position:relative;display:block;width:100%;aspect-ratio:16/9;
  overflow:hidden;isolation:isolate;border:0;
  border-radius:18px;background:#F3EEE8;
}
.zs-sj__image{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .55s cubic-bezier(.22,.68,.2,1)}
.zs-sj__image-placeholder{
  display:flex;align-items:center;justify-content:center;
  width:100%;height:100%;
  background:linear-gradient(145deg,#E8DCCF,#C7AE98);color:#FFFCF9;
}
.zs-sj__image-placeholder span{font-size:clamp(18px,2.4vw,32px);font-weight:300;letter-spacing:.22em}
.zs-sj__card-info{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:26px;padding:19px 2px 0;
}
.zs-sj__card-copy{flex:1 1 auto;min-width:0}
.zs-sj__card-index{
  margin:0 0 12px;color:#9A795B;
  font-size:10px;font-weight:500;letter-spacing:.15em;line-height:1.5;
}
.zs-sj__card-index span{margin:0 5px;color:#BEA489}
.zs-sj__card-title{
  margin:0;color:var(--zs-sj-ink,#2B1D17);font-family:inherit!important;
  font-size:clamp(22px,1.9vw,29px);font-weight:700;
  letter-spacing:-.045em;line-height:1.28;
}
.zs-sj__card-description{
  max-width:50ch;margin:8px 0 0;color:var(--zs-sj-muted,#80736A);
  font-size:clamp(12px,.96vw,14px);font-weight:400;line-height:1.7;
}
.zs-sj__card-action{
  display:inline-flex;align-items:center;gap:9px;
  align-self:flex-end;flex:0 0 auto;
  margin-bottom:3px;padding:0 0 5px;
  border-bottom:1px solid var(--zs-sj-accent,#D8B56A);
  color:var(--zs-sj-ink,#2B1D17);
  font-size:12px;font-weight:600;line-height:1.5;white-space:nowrap;
  transition:border-color .22s ease,color .22s ease;
}
.zs-sj__card-action svg{flex-shrink:0;transition:transform .22s ease}
.zs-sj__link:focus-visible{outline:2px solid var(--zs-sj-accent,#D8B56A);outline-offset:5px}
.zs-sj__link--pending{cursor:default}
.zs-sj__link--pending .zs-sj__card-action{opacity:.55;border-bottom-color:transparent}
@media(hover:hover) and (pointer:fine){
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__image{transform:scale(1.025)}
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__card-action{color:#8C6545;border-color:#8C6545}
 .zs-sj__link:not(.zs-sj__link--pending):hover .zs-sj__card-action svg{transform:translate(2px,-2px)}
}
@media(max-width:1150px){
  .zs-sj__card-info{flex-wrap:wrap;gap:14px}
  .zs-sj__card-action{align-self:flex-start}
}
@media(max-width:749px){
 .zs-sj{padding:52px 0 62px}
 .zs-sj__container{padding-inline:16px}
 .zs-sj__intro{display:block;margin-bottom:28px}
 .zs-sj__eyebrow{font-size:9px;margin-bottom:15px}
 .zs-sj__headline{font-size:clamp(36px,9vw,49px)}
 .zs-sj__intro-text{max-width:52ch;margin:12px 0 0;font-size:12px;line-height:1.7}
 .zs-sj__grid{grid-template-columns:1fr;gap:35px}
 .zs-sj__photo{border-radius:15px}
 .zs-sj__card-info{padding:15px 1px 0;gap:13px}
 .zs-sj__card-index{font-size:9px;margin-bottom:7px}
 .zs-sj__card-title{font-size:23px}
 .zs-sj__card-description{font-size:12px}
 .zs-sj__card-action{font-size:11.5px;margin:0}
}
@media(prefers-reduced-motion:reduce){
 .zs-sj__image,.zs-sj__card-action,.zs-sj__card-action svg{transition:none}
}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Story & Journal",
  "tag": "section",
  "class": "section-zs-story-journal",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER MORE ABOUT ZAISEN"
    },
    {
      "type": "text",
      "id": "heading_light",
      "label": "Heading first part",
      "default": "More Than"
    },
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Heading bold part",
      "default": "Wood."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Introduction",
      "default": "Meet the people behind ZAISEN and find inspiration for a home filled with natural warmth."
    },
    {
      "type": "header",
      "content": "Our Story"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story landscape image"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story card heading",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story description",
      "default": "Get to know the people and passion behind ZAISEN."
    },
    {
      "type": "text",
      "id": "story_cta",
      "label": "Story link text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "story_link",
      "label": "Story page link (active when page exists)"
    },
    {
      "type": "header",
      "content": "Our Blog"
    },
    {
      "type": "image_picker",
      "id": "journal_image",
      "label": "Blog landscape image"
    },
    {
      "type": "text",
      "id": "journal_title",
      "label": "Blog card heading",
      "default": "Our Blog"
    },
    {
      "type": "textarea",
      "id": "journal_text",
      "label": "Blog description",
      "default": "Explore ideas, inspiration, and stories about wooden living."
    },
    {
      "type": "text",
      "id": "journal_cta",
      "label": "Blog link text",
      "default": "Explore Our Blog"
    },
    {
      "type": "url",
      "id": "journal_link",
      "label": "Blog destination"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "font_picker",
      "id": "editorial_font",
      "label": "Text font",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and links",
      "default": "#2B1D17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#80736A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#D8B56A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Story & Journal"
    }
  ]
}
{% endschema %}
