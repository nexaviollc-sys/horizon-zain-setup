{% comment %}
  ZAISEN | Styled in Real Spaces
  Each product uses its LAST existing gallery image by default.
  Optional editable product metafields (namespace custom):
  - zs_lifestyle_image       (file_reference / image) override
  - zs_lifestyle_heading     (single_line_text_field)
  - zs_lifestyle_description (multi_line_text_field)
  No stock or AI-generated images are inserted by this section.
{% endcomment %}

{% liquid
  assign zs_lifestyle_image = product.metafields.custom.zs_lifestyle_image.value
  if zs_lifestyle_image == blank
    assign zs_lifestyle_image = product.images.last
  endif

  assign zs_lifestyle_heading = product.metafields.custom.zs_lifestyle_heading.value
  assign zs_lifestyle_description = product.metafields.custom.zs_lifestyle_description.value

  assign zs_lifestyle_identity = product.title | downcase | append: ' ' | append: product.type | downcase

  if zs_lifestyle_heading == blank or zs_lifestyle_description == blank
    assign zs_default_heading = 'A Natural Place in Your Home'
    assign zs_default_description = 'Let the warmth and character of handcrafted wood bring a distinctive finishing touch to your favorite spaces.'

    if zs_lifestyle_identity contains 'horse' or zs_lifestyle_identity contains 'statue' or zs_lifestyle_identity contains 'sculpture'
      assign zs_default_heading = 'A Statement of Natural Character'
      assign zs_default_description = 'Bring an expressive handcrafted accent to your shelf, console, or workspace. Natural wood grain makes every display feel uniquely yours.'
    elsif zs_lifestyle_identity contains 'lamp' or zs_lifestyle_identity contains 'lighting'
      assign zs_default_heading = 'A Warmer Way to Light Your Space'
      assign zs_default_description = 'From a bedside table to a quiet reading corner, this wooden light adds a welcoming glow and handcrafted character.'
    elsif zs_lifestyle_identity contains 'clock'
      assign zs_default_heading = 'Time, Beautifully at Home'
      assign zs_default_description = 'A practical timepiece with the warmth of natural wood, ready to complement your wall, desk, or favorite corner.'
    elsif zs_lifestyle_identity contains 'tray' or zs_lifestyle_identity contains 'serving'
      assign zs_default_heading = 'Made for Moments Worth Sharing'
      assign zs_default_description = 'Style your table, welcome guests, or display everyday essentials with the naturally warm presence of handcrafted wood.'
    elsif zs_lifestyle_identity contains 'cutlery' or zs_lifestyle_identity contains 'spoon' or zs_lifestyle_identity contains 'fork'
      assign zs_default_heading = 'Bring Nature to the Table'
      assign zs_default_description = 'Give everyday meals and thoughtful gatherings a beautiful artisan touch with the warmth and texture of wooden tableware.'
    elsif zs_lifestyle_identity contains 'jug' or zs_lifestyle_identity contains 'pitcher' or zs_lifestyle_identity contains 'cup' or zs_lifestyle_identity contains 'drinkware'
      assign zs_default_heading = 'A Natural Touch to Every Gathering'
      assign zs_default_description = 'Set a welcoming table with wooden drinkware that brings texture, character, and a handmade feeling to shared moments.'
    elsif zs_lifestyle_identity contains 'tissue' or zs_lifestyle_identity contains 'canister' or zs_lifestyle_identity contains 'storage'
      assign zs_default_heading = 'Everyday Details, Beautifully Styled'
      assign zs_default_description = 'Even the smallest home essentials can feel special when crafted in natural wood and placed with intention.'
    elsif zs_lifestyle_identity contains 'boat' or zs_lifestyle_identity contains 'ship' or zs_lifestyle_identity contains 'nautical'
      assign zs_default_heading = 'An Artisan Touch of the Coast'
      assign zs_default_description = 'Bring nautical character and the warm texture of handcrafted wood to a console, shelf, or quiet study.'
    endif

    if zs_lifestyle_heading == blank
      assign zs_lifestyle_heading = zs_default_heading
    endif
    if zs_lifestyle_description == blank
      assign zs_lifestyle_description = zs_default_description
    endif
  endif
%}

{% if product != blank and zs_lifestyle_image != blank %}
  <section
    class="zs-lifestyle-section"
    id="zs-lifestyle-{{ section.id }}"
    aria-labelledby="zs-lifestyle-title-{{ section.id }}"
  >
    <div class="zs-lifestyle-section__inner page-width">
      <div class="zs-lifestyle-section__overline">
        <span class="zs-lifestyle-section__overline-diamond" aria-hidden="true"></span>
        <p>{{ section.settings.eyebrow | escape }}</p>
        <span class="zs-lifestyle-section__overline-rule" aria-hidden="true"></span>
        <span class="zs-lifestyle-section__overline-note">THE ZAISEN EDITION</span>
      </div>

      <div class="zs-lifestyle-section__stage">
        <figure class="zs-lifestyle-section__media">
          <div class="zs-lifestyle-section__image-frame">
            {{
              zs_lifestyle_image
              | image_url: width: 2000
              | image_tag:
                widths: '480, 640, 800, 1000, 1280, 1600, 2000',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                class: 'zs-lifestyle-section__image',
                alt: product.title
            }}
          </div>
          <figcaption class="zs-lifestyle-section__image-note">
            <span class="zs-lifestyle-section__image-note-line" aria-hidden="true"></span>
            {{ section.settings.image_label | escape }}
          </figcaption>
        </figure>

        <div class="zs-lifestyle-section__content">
          <p class="zs-lifestyle-section__kicker">
            <span class="zs-lifestyle-section__kicker-line" aria-hidden="true"></span>
            INSPIRED BY NATURE
          </p>
          <h2 class="zs-lifestyle-section__title" id="zs-lifestyle-title-{{ section.id }}">
            {{ zs_lifestyle_heading | escape }}
          </h2>
          <p class="zs-lifestyle-section__description">
            {{ zs_lifestyle_description | escape | newline_to_br }}
          </p>

          <div class="zs-lifestyle-section__signature">
            <span class="zs-lifestyle-section__monogram" aria-hidden="true">Z</span>
            <div>
              <span class="zs-lifestyle-section__signature-name">ZAISEN</span>
              <span class="zs-lifestyle-section__signature-note">Nature, shaped by hand.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}

  .zs-lifestyle-section-wrapper { background: #fff; }
  .zs-lifestyle-section {
    --zs-ls-ink: #30291f;
    --zs-ls-muted: #71695f;
    --zs-ls-copper: #977453;
    box-sizing: border-box;
    width: 100%;
    padding: clamp(40px, 6vw, 88px) clamp(20px, 4vw, 64px);
    margin: 0;
    background: #fff;
    color: var(--zs-ls-ink);
    clear: both;
  }
  .zs-lifestyle-section *, .zs-lifestyle-section *::before, .zs-lifestyle-section *::after { box-sizing: border-box; }
  .zs-lifestyle-section .zs-lifestyle-section__inner {
    display: block;
    width: 100%;
    max-width: 1280px;
    min-width: 0;
    padding: 0;
    margin: 0 auto;
  }
  .zs-lifestyle-section__overline {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0 0;
    margin: 0 0 clamp(24px, 3vw, 40px);
    border-top: 1px solid #e7e1da;
  }
  .zs-lifestyle-section__overline p {
    margin: 0;
    color: #665342;
    font: 600 10px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .18em;
  }
  .zs-lifestyle-section__overline-diamond, .zs-lifestyle-section__overline-rule { display: none; }
  .zs-lifestyle-section__overline-note {
    margin-inline-start: auto;
    color: #7c746b;
    font: 400 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .16em;
  }
  .zs-lifestyle-section__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(32px, 5.5vw, 88px);
    min-width: 0;
  }
  .zs-lifestyle-section__media { display: block; min-width: 0; width: 100%; margin: 0; }
  .zs-lifestyle-section__image-frame {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 0;
    border-radius: 6px;
    background: #f8f6f2;
    box-shadow: none;
  }
  .zs-lifestyle-section__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain !important;
    object-position: center;
    transform: none;
  }
  .zs-lifestyle-section__image-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 0;
    color: #74695b;
    font: 500 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .14em;
  }
  .zs-lifestyle-section__image-note-line { width: 22px; height: 1px; background: #b39a80; flex: 0 0 22px; }
  .zs-lifestyle-section__content {
    position: relative;
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 12px 0 30px;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .zs-lifestyle-section__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    color: #7c6249;
    font: 500 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .17em;
  }
  .zs-lifestyle-section__kicker-line { width: 24px; height: 1px; background: #b39a80; flex: 0 0 24px; }
  .zs-lifestyle-section__title {
    max-width: 19ch;
    margin: 0;
    color: var(--zs-ls-ink);
    font: 400 clamp(30px, 3.25vw, 50px)/1.13 var(--font-heading--family), Georgia, serif;
    letter-spacing: -.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .zs-lifestyle-section__description {
    max-width: 42ch;
    margin: 24px 0 0;
    color: var(--zs-ls-muted);
    font: 400 clamp(14px, 1.1vw, 16px)/1.85 var(--font-body--family), sans-serif;
    overflow-wrap: break-word;
  }
  .zs-lifestyle-section__signature {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    padding-top: 23px;
    border-top: 1px solid #e7e1da;
    max-width: 330px;
  }
  .zs-lifestyle-section__monogram {
    display: grid;
    place-items: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    color: #896a4c;
    border: 1px solid #d8cbbb;
    border-radius: 50%;
    font: italic 400 22px/1 Georgia, serif;
  }
  .zs-lifestyle-section__signature > div { display: flex; flex-direction: column; gap: 4px; }
  .zs-lifestyle-section__signature-name { color: #514335; font: 600 10px/1.3 var(--font-body--family), sans-serif; letter-spacing: .18em; }
  .zs-lifestyle-section__signature-note { color: #756b60; font: 400 11px/1.5 var(--font-body--family), sans-serif; }
  @media screen and (max-width: 749px) {
    .zs-lifestyle-section { padding: 34px 20px 44px; }
    .zs-lifestyle-section__overline { margin-bottom: 22px; padding-top: 16px; }
    .zs-lifestyle-section__overline p { font-size: 9px; letter-spacing: .14em; }
    .zs-lifestyle-section__overline-note { display: none; }
    .zs-lifestyle-section__stage { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .zs-lifestyle-section__content { padding: 0 2px; }
    .zs-lifestyle-section__kicker { margin-bottom: 15px; }
    .zs-lifestyle-section__title { max-width: 22ch; font-size: clamp(29px, 7.5vw, 40px); line-height: 1.14; }
    .zs-lifestyle-section__description { margin-top: 18px; font-size: 14px; line-height: 1.8; }
    .zs-lifestyle-section__signature { margin-top: 24px; padding-top: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Lifestyle Story",
  "tag": "div",
  "class": "zs-lifestyle-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "STYLED IN REAL SPACES"
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Image caption",
      "default": "A LITTLE CLOSER TO NATURE"
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Lifestyle Story"
    }
  ]
}
{% endschema %}
