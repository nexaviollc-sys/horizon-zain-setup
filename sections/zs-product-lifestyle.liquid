{% comment %}
  ZAISEN | Styled in Real Spaces
  Each product uses its LAST existing gallery image by default.
  Optional editable product metafields (namespace custom):
  - zs_lifestyle_image       (file_reference / image) override
  - zs_lifestyle_heading     (single_line_text_field)
  - zs_lifestyle_description (multi_line_text_field)
  No stock or AI-generated images are inserted by this section.
{% endcomment %}

{% liquid
  assign zs_lifestyle_image = product.metafields.custom.zs_lifestyle_image.value
  if zs_lifestyle_image == blank
    assign zs_lifestyle_image = product.images.last
  endif

  # Show a second, actual product photo as a small editorial detail on desktop.
  # Never duplicate the lifestyle image or insert a stock/generated photograph.
  assign zs_lifestyle_detail_image = blank
  for zs_candidate_image in product.images
    if zs_candidate_image.id != zs_lifestyle_image.id
      assign zs_lifestyle_detail_image = zs_candidate_image
      break
    endif
  endfor

  assign zs_lifestyle_heading = product.metafields.custom.zs_lifestyle_heading.value
  assign zs_lifestyle_description = product.metafields.custom.zs_lifestyle_description.value

  assign zs_lifestyle_identity = product.title | downcase | append: ' ' | append: product.type | downcase

  if zs_lifestyle_heading == blank or zs_lifestyle_description == blank
    assign zs_default_heading = 'A Natural Place in Your Home'
    assign zs_default_description = 'Let the warmth and character of handcrafted wood bring a distinctive finishing touch to your favorite spaces.'

    if zs_lifestyle_identity contains 'horse' or zs_lifestyle_identity contains 'statue' or zs_lifestyle_identity contains 'sculpture'
      assign zs_default_heading = 'A Statement of Natural Character'
      assign zs_default_description = 'Bring an expressive handcrafted accent to your shelf, console, or workspace. Natural wood grain makes every display feel uniquely yours.'
    elsif zs_lifestyle_identity contains 'lamp' or zs_lifestyle_identity contains 'lighting'
      assign zs_default_heading = 'A Warmer Way to Light Your Space'
      assign zs_default_description = 'From a bedside table to a quiet reading corner, this wooden light adds a welcoming glow and handcrafted character.'
    elsif zs_lifestyle_identity contains 'clock'
      assign zs_default_heading = 'Time, Beautifully at Home'
      assign zs_default_description = 'A practical timepiece with the warmth of natural wood, ready to complement your wall, desk, or favorite corner.'
    elsif zs_lifestyle_identity contains 'tray' or zs_lifestyle_identity contains 'serving'
      assign zs_default_heading = 'Made for Moments Worth Sharing'
      assign zs_default_description = 'Style your table, welcome guests, or display everyday essentials with the naturally warm presence of handcrafted wood.'
    elsif zs_lifestyle_identity contains 'cutlery' or zs_lifestyle_identity contains 'spoon' or zs_lifestyle_identity contains 'fork'
      assign zs_default_heading = 'Bring Nature to the Table'
      assign zs_default_description = 'Give everyday meals and thoughtful gatherings a beautiful artisan touch with the warmth and texture of wooden tableware.'
    elsif zs_lifestyle_identity contains 'jug' or zs_lifestyle_identity contains 'pitcher' or zs_lifestyle_identity contains 'cup' or zs_lifestyle_identity contains 'drinkware'
      assign zs_default_heading = 'A Natural Touch to Every Gathering'
      assign zs_default_description = 'Set a welcoming table with wooden drinkware that brings texture, character, and a handmade feeling to shared moments.'
    elsif zs_lifestyle_identity contains 'tissue' or zs_lifestyle_identity contains 'canister' or zs_lifestyle_identity contains 'storage'
      assign zs_default_heading = 'Everyday Details, Beautifully Styled'
      assign zs_default_description = 'Even the smallest home essentials can feel special when crafted in natural wood and placed with intention.'
    elsif zs_lifestyle_identity contains 'boat' or zs_lifestyle_identity contains 'ship' or zs_lifestyle_identity contains 'nautical'
      assign zs_default_heading = 'An Artisan Touch of the Coast'
      assign zs_default_description = 'Bring nautical character and the warm texture of handcrafted wood to a console, shelf, or quiet study.'
    endif

    if zs_lifestyle_heading == blank
      assign zs_lifestyle_heading = zs_default_heading
    endif
    if zs_lifestyle_description == blank
      assign zs_lifestyle_description = zs_default_description
    endif
  endif
%}

{% if product != blank and zs_lifestyle_image != blank %}
  <section
    class="zs-lifestyle-section"
    id="zs-lifestyle-{{ section.id }}"
    aria-labelledby="zs-lifestyle-title-{{ section.id }}"
  >
    <div class="zs-lifestyle-section__inner page-width">
      <div class="zs-lifestyle-section__overline">
        <span class="zs-lifestyle-section__overline-diamond" aria-hidden="true"></span>
        <p>{{ section.settings.eyebrow | escape }}</p>
        <span class="zs-lifestyle-section__overline-rule" aria-hidden="true"></span>
        <span class="zs-lifestyle-section__overline-note">THE ZAISEN EDITION</span>
      </div>

      <div class="zs-lifestyle-section__stage">
        <figure class="zs-lifestyle-section__media">
          <div class="zs-lifestyle-section__image-frame">
            {{
              zs_lifestyle_image
              | image_url: width: 2000
              | image_tag:
                widths: '480, 640, 800, 1000, 1280, 1600, 2000',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                class: 'zs-lifestyle-section__image',
                alt: product.title
            }}
          </div>
          {% if zs_lifestyle_detail_image != blank %}
            <div class="zs-lifestyle-section__detail-inset" aria-label="Another view of {{ product.title | escape }}">
              {{ zs_lifestyle_detail_image | image_url: width: 700 | image_tag: widths: '220,320,450,700', sizes: '(min-width: 1024px) 18vw, 1px', loading: 'lazy', class: 'zs-lifestyle-section__detail-image', alt: product.title }}
              <span class="zs-lifestyle-section__detail-caption">THE DETAILS</span>
            </div>
          {% endif %}
          <figcaption class="zs-lifestyle-section__image-note">
            <span class="zs-lifestyle-section__image-note-line" aria-hidden="true"></span>
            {{ section.settings.image_label | escape }}
          </figcaption>
        </figure>

        <div class="zs-lifestyle-section__content">
          <p class="zs-lifestyle-section__kicker">
            <span class="zs-lifestyle-section__kicker-line" aria-hidden="true"></span>
            INSPIRED BY NATURE
          </p>
          <h2 class="zs-lifestyle-section__title" id="zs-lifestyle-title-{{ section.id }}">
            {{ zs_lifestyle_heading | escape }}
          </h2>
          <p class="zs-lifestyle-section__description">
            {{ zs_lifestyle_description | escape | newline_to_br }}
          </p>

          <div class="zs-lifestyle-section__signature">
            <span class="zs-lifestyle-section__monogram" aria-hidden="true">
              {% if settings.favicon != blank %}
                {{ settings.favicon | image_url: width: 96 | image_tag: width: 34, height: 34, loading: 'lazy', alt: '' }}
              {% else %}
                Z
              {% endif %}
            </span>
            <div>
              <span class="zs-lifestyle-section__signature-name">ZAISEN</span>
              <span class="zs-lifestyle-section__signature-note">Nature, shaped by hand.</span>
            </div>
          </div>
          <p class="zs-lifestyle-section__editorial-note">Each piece carries its own natural wood grain and character.</p>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}

  .zs-lifestyle-section-wrapper { background: #fff; }
  .zs-lifestyle-section {
    --zs-ls-ink: #30291f;
    --zs-ls-muted: #71695f;
    --zs-ls-copper: #977453;
    box-sizing: border-box;
    width: 100%;
    padding: clamp(40px, 6vw, 88px) clamp(20px, 4vw, 64px);
    margin: 0;
    background: #fff;
    color: var(--zs-ls-ink);
    clear: both;
  }
  .zs-lifestyle-section *, .zs-lifestyle-section *::before, .zs-lifestyle-section *::after { box-sizing: border-box; }
  .zs-lifestyle-section .zs-lifestyle-section__inner {
    display: block;
    width: 100%;
    max-width: 1280px;
    min-width: 0;
    padding: 0;
    margin: 0 auto;
  }
  .zs-lifestyle-section__overline {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0 0;
    margin: 0 0 clamp(24px, 3vw, 40px);
    border-top: 1px solid #e7e1da;
  }
  .zs-lifestyle-section__overline p {
    margin: 0;
    color: #665342;
    font: 600 10px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .18em;
  }
  .zs-lifestyle-section__overline-diamond, .zs-lifestyle-section__overline-rule { display: none; }
  .zs-lifestyle-section__overline-note {
    margin-inline-start: auto;
    color: #7c746b;
    font: 400 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .16em;
  }
  .zs-lifestyle-section__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(32px, 5.5vw, 88px);
    min-width: 0;
  }
  .zs-lifestyle-section__media { display: block; min-width: 0; width: 100%; margin: 0; }
  .zs-lifestyle-section__image-frame {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 0;
    border-radius: 6px;
    background: #f8f6f2;
    box-shadow: none;
  }
  .zs-lifestyle-section__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain !important;
    object-position: center;
    transform: none;
  }
  .zs-lifestyle-section__image-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 0;
    color: #74695b;
    font: 500 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .14em;
  }
  .zs-lifestyle-section__image-note-line { width: 22px; height: 1px; background: #b39a80; flex: 0 0 22px; }
  .zs-lifestyle-section__content {
    position: relative;
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 12px 0 30px;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .zs-lifestyle-section__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    color: #7c6249;
    font: 500 9px/1.5 var(--font-body--family), sans-serif;
    letter-spacing: .17em;
  }
  .zs-lifestyle-section__kicker-line { width: 24px; height: 1px; background: #b39a80; flex: 0 0 24px; }
  .zs-lifestyle-section__title {
    max-width: 19ch;
    margin: 0;
    color: var(--zs-ls-ink);
    font: 400 clamp(30px, 3.25vw, 50px)/1.13 var(--font-heading--family), Georgia, serif;
    letter-spacing: -.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .zs-lifestyle-section__description {
    max-width: 42ch;
    margin: 24px 0 0;
    color: var(--zs-ls-muted);
    font: 400 clamp(14px, 1.1vw, 16px)/1.85 var(--font-body--family), sans-serif;
    overflow-wrap: break-word;
  }
  .zs-lifestyle-section__signature {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    padding-top: 23px;
    border-top: 1px solid #e7e1da;
    max-width: 330px;
  }
  .zs-lifestyle-section__monogram {
    display: grid;
    place-items: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    color: #896a4c;
    border: 0;
    border-radius: 0;
    font: italic 400 22px/1 Georgia, serif;
  }
  .zs-lifestyle-section__monogram img { display: block; width: 34px; height: 34px; object-fit: contain; }
  .zs-lifestyle-section__signature > div { display: flex; flex-direction: column; gap: 4px; }
  .zs-lifestyle-section__signature-name { color: #514335; font: 600 10px/1.3 var(--font-body--family), sans-serif; letter-spacing: .18em; }
  .zs-lifestyle-section__signature-note { color: #756b60; font: 400 11px/1.5 var(--font-body--family), sans-serif; }

  .zs-lifestyle-section__overline { border:0; padding-top:0; }
  .zs-lifestyle-section__overline p { font-size:12px; font-weight:650; letter-spacing:.07em; }
  .zs-lifestyle-section__overline-note { display:none; }
  .zs-lifestyle-section__kicker-line,
  .zs-lifestyle-section__image-note-line { display:none; }
  .zs-lifestyle-section__kicker {
    display:inline-flex; padding:8px 12px; border-radius:100px;
    background:#f3ede5; color:#684e37; letter-spacing:.06em; font-size:10px;
  }
  .zs-lifestyle-section__signature { border:0; padding-top:0; }
  @media screen and (max-width: 749px) {
    .zs-lifestyle-section { padding:28px 16px 36px; }
    .zs-lifestyle-section__overline { margin:0 4px 18px; }
    .zs-lifestyle-section__overline p {
      color:#342b22; font:650 12px/1.4 var(--font-body--family),sans-serif;
      letter-spacing:.055em;
    }
    .zs-lifestyle-section__stage {
      display:flex; flex-direction:column; align-items:stretch; gap:0;
      padding:10px; border-radius:26px; background:#f5f0e9;
    }
    .zs-lifestyle-section__media { margin:0; }
    .zs-lifestyle-section__image-frame { border-radius:18px; background:#fff; }
    .zs-lifestyle-section__image-note { display:none; }
    .zs-lifestyle-section__content { padding:24px 14px 18px; }
    .zs-lifestyle-section__kicker {
      margin:0 0 16px; padding:7px 10px;
      background:#e7dccd; color:#60462f; font-size:9px;
      font-weight:600; letter-spacing:.055em;
    }
    .zs-lifestyle-section__title {
      max-width:100%; margin:0; color:#31271e;
      font:650 clamp(28px,7.7vw,35px)/1.13 var(--font-body--family),sans-serif;
      letter-spacing:-.04em; text-wrap:balance;
    }
    .zs-lifestyle-section__description {
      max-width:100%; margin:16px 0 0; color:#685f55;
      font-size:14px; line-height:1.65;
    }
    .zs-lifestyle-section__signature {
      max-width:none; gap:10px; margin-top:22px; padding:12px;
      border:0; border-radius:14px; background:rgba(255,255,255,.65);
    }
    .zs-lifestyle-section__monogram { flex-basis:32px; width:32px; height:32px; }
    .zs-lifestyle-section__monogram img { width:32px; height:32px; }
    .zs-lifestyle-section__signature > div { gap:3px; }
    .zs-lifestyle-section__signature-name { font-size:10px; letter-spacing:.08em; }
    .zs-lifestyle-section__signature-note { font-size:11px; color:#6c5d4e; }
  }


  @media screen and (min-width: 750px) {
    .zs-lifestyle-section { padding-block:clamp(42px,5vw,72px); }
    .zs-lifestyle-section__overline { margin-bottom:22px; padding-inline:6px; }
    .zs-lifestyle-section__stage {
      grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
      gap:0; padding:14px; border-radius:32px;
      background:#f5f0e9;
    }
    .zs-lifestyle-section__media { position:relative; }
    .zs-lifestyle-section__image-frame { border-radius:22px; background:#fff; }
    .zs-lifestyle-section__image-note {
      position:absolute; left:18px; bottom:18px; z-index:1;
      width:fit-content; max-width:calc(100% - 36px); margin:0;
      padding:10px 14px; border-radius:100px;
      background:rgba(255,255,255,.93); color:#604b37;
      font-size:9px; letter-spacing:.055em;
    }
    .zs-lifestyle-section__content { padding:clamp(24px,3.5vw,56px); }
    .zs-lifestyle-section__kicker {
      background:#e7dccd; padding:9px 13px;
      margin-bottom:22px; color:#60462f; font-weight:600;
    }
    .zs-lifestyle-section__title {
      max-width:19ch; color:#31271e;
      font:650 clamp(29px,3.4vw,52px)/1.09 var(--font-body--family),sans-serif;
      letter-spacing:-.045em; text-wrap:balance;
    }
    .zs-lifestyle-section__description {
      margin-top:22px; max-width:40ch; color:#685f55;
      font-size:clamp(14px,1.15vw,16px); line-height:1.75;
    }
    .zs-lifestyle-section__signature {
      width:fit-content; max-width:100%; margin-top:28px;
      padding:13px 18px 13px 13px; gap:11px;
      border-radius:16px; background:rgba(255,255,255,.72);
    }
    .zs-lifestyle-section__signature-name { font-size:10px; letter-spacing:.08em; }
    .zs-lifestyle-section__signature-note { color:#6c5d4e; font-size:11px; }
  }


  /* ZAISEN desktop editorial — one real lifestyle image, one optional product detail. */
  .zs-lifestyle-section__detail-inset { display: none; }
  .zs-lifestyle-section__editorial-note { display: none; }
  @media screen and (min-width: 1024px) {
    .zs-lifestyle-section {
      padding: clamp(64px, 7vw, 110px) clamp(24px, 4vw, 64px);
      background: #fff;
    }
    .zs-lifestyle-section .zs-lifestyle-section__inner { max-width: 1280px; }
    .zs-lifestyle-section__overline {
      gap: 18px;
      padding: 0 0 16px;
      margin: 0 0 clamp(24px, 3.6vw, 50px);
      border: 0;
      border-bottom: 1px solid #e6dfd6;
    }
    .zs-lifestyle-section__overline p {
      color: #80634b;
      font: 700 10px/1.5 var(--font-body--family), sans-serif;
      letter-spacing: .17em;
    }
    .zs-lifestyle-section__overline-note {
      display: block;
      color: #8b8176;
      font-size: 10px;
      letter-spacing: .12em;
    }
    .zs-lifestyle-section__stage {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr);
      align-items: center;
      gap: clamp(54px, 7vw, 114px);
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .zs-lifestyle-section__media {
      position: relative;
      align-self: start;
      width: 100%;
      padding: 0 clamp(24px, 3.2vw, 42px) clamp(32px, 4vw, 54px) 0;
    }
    .zs-lifestyle-section__image-frame {
      aspect-ratio: 1;
      border: 1px solid #eee8e0;
      border-radius: 3px;
      background: #f8f6f2;
      overflow: hidden;
      box-shadow: 0 15px 45px rgba(51, 37, 23, .055);
    }
    .zs-lifestyle-section__image {
      object-fit: contain !important;
      object-position: center;
    }
    .zs-lifestyle-section__detail-inset {
      display: block;
      position: absolute;
      z-index: 2;
      width: clamp(145px, 33%, 220px);
      aspect-ratio: 1;
      right: 0;
      bottom: 0;
      padding: 9px 9px 26px;
      border: 1px solid #e5ddd1;
      background: #fffdf9;
      box-shadow: 0 16px 35px rgba(45, 30, 18, .12);
      transform: rotate(2deg);
    }
    .zs-lifestyle-section__detail-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #f8f5f1;
    }
    .zs-lifestyle-section__detail-caption {
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 8px;
      text-align: center;
      color: #77604d;
      font: 650 9px/1.1 var(--font-body--family), sans-serif;
      letter-spacing: .14em;
    }
    .zs-lifestyle-section__image-note {
      display: flex;
      position: absolute;
      bottom: 12px;
      left: 0;
      z-index: 1;
      margin: 0;
      padding: 0;
      border-radius: 0;
      background: transparent;
      color: #806f5d;
      font-size: 10px;
      letter-spacing: .12em;
    }
    .zs-lifestyle-section__image-note-line {
      display: block;
      background: #9b7a5e;
    }
    .zs-lifestyle-section__content {
      width: 100%;
      min-width: 0;
      padding: 18px 0 10px;
      margin: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    .zs-lifestyle-section__kicker {
      display: flex;
      align-items: center;
      gap: 13px;
      width: fit-content;
      margin: 0 0 25px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: #88674b;
      font: 700 10px/1.45 var(--font-body--family), sans-serif;
      letter-spacing: .17em;
    }
    .zs-lifestyle-section__kicker-line { display: block; background: #9a7b61; }
    .zs-lifestyle-section__title {
      max-width: 16ch;
      margin: 0;
      color: #30271f;
      font: 400 clamp(34px, 3.75vw, 59px)/1.09 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.034em;
      text-wrap: balance;
    }
    .zs-lifestyle-section__description {
      max-width: 42ch;
      margin: clamp(20px, 2.5vw, 32px) 0 0;
      color: #62574c;
      font: 400 clamp(14px, 1.1vw, 16px)/1.78 var(--font-body--family), sans-serif;
    }
    .zs-lifestyle-section__signature {
      display: flex;
      width: 100%;
      max-width: 390px;
      margin-top: 34px;
      padding: 19px 0 0;
      border-top: 1px solid #e8e0d6;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .zs-lifestyle-section__monogram {
      border: 1px solid #d8c7b5;
      border-radius: 50%;
      width: 37px;
      height: 37px;
      flex-basis: 37px;
      font-size: 20px;
    }
    .zs-lifestyle-section__signature-name {
      font-size: 10px;
      letter-spacing: .16em;
    }
    .zs-lifestyle-section__signature-note {
      font-size: 12px;
      color: #665a4d;
    }
    .zs-lifestyle-section__editorial-note {
      display: block;
      max-width: 38ch;
      margin: 18px 0 0;
      color: #8c7a68;
      font: italic 400 12px/1.6 var(--font-heading--family), Georgia, serif;
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1140px) {
    .zs-lifestyle-section__stage { gap: 44px; }
    .zs-lifestyle-section__detail-inset { width: 31%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zs-lifestyle-section__detail-inset { transform: none; }
  }


  /* ZAISEN editorial finish v2 — warm tactile details without changing content. */
  @media screen and (min-width: 1024px) {
    .zs-lifestyle-section {
      background: #fcfbf8;
    }
    .zs-lifestyle-section__overline {
      position: relative;
      padding-bottom: 20px;
      border-bottom: 1px solid #d9cbb9;
    }
    .zs-lifestyle-section__overline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 96px;
      height: 3px;
      background: #95704d;
    }
    .zs-lifestyle-section__stage {
      position: relative;
      z-index: 0;
      gap: clamp(46px, 5.6vw, 94px);
      padding: clamp(26px, 3.3vw, 44px);
      background: linear-gradient(124deg, #f1e9df 0%, #faf7f1 47%, #fffdf9 100%);
      border: 1px solid #e3d6c7;
      box-shadow: 0 22px 50px rgba(67, 43, 27, .055);
    }
    .zs-lifestyle-section__stage::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: 13px;
      border: 1px solid rgba(144, 103, 67, .16);
      pointer-events: none;
    }
    .zs-lifestyle-section__media {
      padding: 0 clamp(24px, 3vw, 39px) clamp(34px, 3.9vw, 50px) 0;
    }
    .zs-lifestyle-section__image-frame {
      border: 7px solid #fffdfa;
      border-radius: 1px;
      background: #fffefa;
      box-shadow: 0 12px 36px rgba(61, 39, 20, .13);
    }
    .zs-lifestyle-section__detail-inset {
      transform: rotate(-3deg);
      border: 6px solid #fffdf9;
      background: #fffdf9;
      box-shadow: 0 14px 32px rgba(47, 30, 15, .17);
    }
    .zs-lifestyle-section__image-note {
      bottom: 12px;
      color: #6d5745;
      font-weight: 650;
      letter-spacing: .1em;
    }
    .zs-lifestyle-section__content {
      padding: 20px 5px 28px 0;
    }
    .zs-lifestyle-section__kicker {
      color: #876444;
      font-size: 10px;
      margin-bottom: 20px;
    }
    .zs-lifestyle-section__title {
      font-size: clamp(36px, 3.7vw, 58px);
      line-height: 1.11;
      color: #332417;
    }
    .zs-lifestyle-section__title::after {
      content: "";
      display: block;
      width: 46px;
      height: 4px;
      margin-top: 25px;
      background: #9c7854;
    }
    .zs-lifestyle-section__description {
      margin-top: 23px;
      color: #5c4d40;
    }
    .zs-lifestyle-section__signature {
      margin-top: 30px;
      padding: 18px 0 0;
      border-top: 1px solid #dacaba;
    }
    .zs-lifestyle-section__monogram {
      width: 44px;
      height: 44px;
      flex-basis: 44px;
      border: 1px solid #9e815f;
      border-radius: 50%;
      background: #fffdfa;
      color: #694b31;
    }
    .zs-lifestyle-section__editorial-note {
      display: block;
      position: relative;
      max-width: 36ch;
      padding: 7px 0 7px 17px;
      margin: 19px 0 0;
      border-left: 2px solid #bd9d79;
      color: #81684f;
      font-size: 13px;
      font-style: italic;
      line-height: 1.65;
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1140px) {
    .zs-lifestyle-section__stage { padding: 27px; gap: 42px; }
    .zs-lifestyle-section__stage::before { inset: 10px; }
    .zs-lifestyle-section__content { padding: 16px 0; }
  }


  /* ZAISEN mobile atelier refinement — tactile frames, square photos, editorial type. */
  @media screen and (max-width: 749px) {
    .zs-lifestyle-section {
      padding: 30px 14px 42px;
      background: #fcfbf8;
      color: #33271e;
    }
    .zs-lifestyle-section__overline {
      position: relative;
      margin: 0 2px 19px;
      padding: 0 1px 14px;
      border-bottom: 1px solid #d8c7b3;
    }
    .zs-lifestyle-section__overline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 56px;
      height: 3px;
      background: #98714d;
    }
    .zs-lifestyle-section__overline p {
      font-size: 10px;
      font-weight: 750;
      letter-spacing: .135em;
      color: #7c5b40;
    }
    .zs-lifestyle-section__stage {
      position: relative;
      z-index: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 11px;
      border: 1px solid #e5d7c6;
      border-radius: 14px;
      background: linear-gradient(135deg, #f3ecdf, #fffaf4 75%);
      box-shadow: 0 12px 29px rgba(62, 39, 20, .06);
    }
    .zs-lifestyle-section__stage::before {
      content: "";
      position: absolute;
      inset: 5px;
      border: 1px solid rgba(146, 106, 72, .12);
      border-radius: 11px;
      z-index: -1;
      pointer-events: none;
    }
    .zs-lifestyle-section__media {
      position: relative;
      width: 100%;
      margin: 0;
      padding: 0 0 24px;
    }
    .zs-lifestyle-section__image-frame {
      aspect-ratio: 1;
      border: 5px solid #fffdfa;
      border-radius: 4px;
      background: #fffefa;
      box-shadow: 0 8px 22px rgba(58, 36, 19, .1);
    }
    .zs-lifestyle-section__image {
      object-fit: contain !important;
      object-position: center;
    }
    .zs-lifestyle-section__detail-inset {
      display: block;
      position: absolute;
      z-index: 2;
      right: 7px;
      bottom: 0;
      width: clamp(80px, 29%, 118px);
      aspect-ratio: 1;
      margin: 0;
      padding: 4px 4px 17px;
      border: 1px solid #e0d0bd;
      background: #fffdfa;
      box-shadow: 0 7px 21px rgba(61, 40, 22, .17);
      transform: rotate(-3deg);
    }
    .zs-lifestyle-section__detail-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #fbf8f3;
    }
    .zs-lifestyle-section__detail-caption {
      position: absolute;
      bottom: 4px;
      inset-inline: 3px;
      color: #7f644b;
      font: 700 7px/1.2 var(--font-body--family), sans-serif;
      letter-spacing: .1em;
      text-align: center;
    }
    .zs-lifestyle-section__image-note {
      display: flex;
      align-items: center;
      gap: 7px;
      position: relative;
      max-width: calc(100% - 125px);
      margin: 10px 0 0 2px;
      color: #745b44;
      font: 650 8px/1.55 var(--font-body--family), sans-serif;
      letter-spacing: .09em;
    }
    .zs-lifestyle-section__image-note-line {
      display: block;
      flex: 0 0 15px;
      width: 15px;
      height: 1px;
      background: #aa8b70;
    }
    .zs-lifestyle-section__content {
      position: relative;
      width: 100%;
      padding: 19px 11px 15px;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    .zs-lifestyle-section__kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      width: fit-content;
      margin: 0 0 15px;
      padding: 0;
      border-radius: 0;
      background: transparent;
      color: #8d6747;
      font: 700 9px/1.5 var(--font-body--family), sans-serif;
      letter-spacing: .15em;
    }
    .zs-lifestyle-section__kicker-line {
      display: block;
      flex: 0 0 20px;
      width: 20px;
      height: 1px;
      background: #a78261;
    }
    .zs-lifestyle-section__title {
      max-width: 18ch;
      color: #312419;
      font: 400 clamp(28px, 7.6vw, 39px)/1.13 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.032em;
      text-wrap: balance;
    }
    .zs-lifestyle-section__title::after {
      content: "";
      display: block;
      width: 38px;
      height: 3px;
      margin-top: 19px;
      background: #a07b57;
    }
    .zs-lifestyle-section__description {
      margin: 15px 0 0;
      max-width: 46ch;
      font: 400 13.5px/1.7 var(--font-body--family), sans-serif;
      color: #645447;
    }
    .zs-lifestyle-section__signature {
      margin-top: 21px;
      padding: 15px 0 0;
      gap: 11px;
      border: 0;
      border-top: 1px solid #dcccbb;
      border-radius: 0;
      background: transparent;
    }
    .zs-lifestyle-section__monogram {
      display: grid;
      place-items: center;
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      border: 1px solid #ae9070;
      border-radius: 50%;
      background: #fffefa;
      color: #674930;
    }
    .zs-lifestyle-section__signature-name {
      font-size: 10px;
      font-weight: 750;
      letter-spacing: .16em;
    }
    .zs-lifestyle-section__signature-note {
      font-size: 11px;
    }
    .zs-lifestyle-section__editorial-note {
      display: block;
      margin: 15px 0 0;
      padding-left: 12px;
      border-left: 2px solid #bd9c77;
      color: #80684f;
      font: italic 400 12px/1.55 var(--font-heading--family), Georgia, serif;
    }
  }
  @media screen and (max-width: 350px) {
    .zs-lifestyle-section { padding-inline: 10px; }
    .zs-lifestyle-section__stage { padding: 8px; }
    .zs-lifestyle-section__detail-inset { width: 82px; }
    .zs-lifestyle-section__image-note { max-width: calc(100% - 100px); }
    .zs-lifestyle-section__content { padding-inline: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zs-lifestyle-section__detail-inset { transform: none; }
  }

{% endstylesheet %}

