{%- comment -%}
  ZAISEN three-part craftsmanship statement, shown between Collections
  and Best Sellers. Compact editorial strip; no promotional claims or cards.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign editorial_font = s.editorial_font
  assign light_font = editorial_font | font_modify: 'weight', '300'
  assign medium_font = editorial_font | font_modify: 'weight', '500'
  assign bold_font = editorial_font | font_modify: 'weight', '700'
-%}
{%- if editorial_font != blank -%}
  {% style %}
    {{ editorial_font | font_face: font_display: 'swap' }}
    {% if light_font != blank %}{{ light_font | font_face: font_display: 'swap' }}{% endif %}
    {% if medium_font != blank %}{{ medium_font | font_face: font_display: 'swap' }}{% endif %}
    {% if bold_font != blank %}{{ bold_font | font_face: font_display: 'swap' }}{% endif %}
    #zs-why-{{ section.id }} {
      font-family: {{ editorial_font.family | json }}, {{ editorial_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}

<section
  id="zs-why-{{ section.id }}"
  class="zs-why"
  aria-labelledby="zs-why-title-{{ section.id }}"
  style="--zs-why-bg:{{ s.bg_color }};--zs-why-ink:{{ s.heading_color }};--zs-why-text:{{ s.text_color }};--zs-why-accent:{{ s.accent_color }};--zs-why-top:{{ s.padding_top }}px;--zs-why-bottom:{{ s.padding_bottom }}px;"
>
  <div class="zs-why__inner">
    <div class="zs-why__layout">
      <header class="zs-why__intro">
        <div class="zs-why__heading-wrap">
          {% if s.eyebrow != blank %}
            <p class="zs-why__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
          {% endif %}
          <h2 class="zs-why__title" id="zs-why-title-{{ section.id }}">
            <span>{{ s.heading_light | escape }}</span>
            <strong>{{ s.heading_bold | escape }}</strong>
          </h2>
        </div>
        {% if s.intro_text != blank %}
          <p class="zs-why__lead">{{ s.intro_text | escape }}</p>
        {% endif %}
      </header>

      <div class="zs-why__features">
        {% for block in section.blocks %}
          <article class="zs-why__feature" {{ block.shopify_attributes }}>
            <div class="zs-why__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'zs-why__image', loading: 'lazy', widths: '240,360,480,640,800,1000,1200', sizes: '(min-width: 1100px) 30vw, (min-width: 750px) 31vw, 118px', alt: block.settings.title }}
              {% else %}
                <div class="zs-why__image-placeholder" aria-hidden="true">
                  <span class="zs-why__placeholder-logo">ZAISEN</span>
                  <span class="zs-why__placeholder-title">{{ block.settings.title | escape }}</span>
                </div>
              {% endif %}
            </div>
            <div class="zs-why__feature-copy">
              {% if block.settings.title != blank %}
                <h3 class="zs-why__feature-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="zs-why__feature-text">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.zs-why {
  display:block;
  width:100%;
  margin:0;
  padding:var(--zs-why-top,44px) 0 var(--zs-why-bottom,44px);
  background:var(--zs-why-bg,#FFFFFF);
  color:var(--zs-why-ink,#2B1D17);
}
.zs-why *{box-sizing:border-box}
.zs-why__inner{
  width:100%;
  max-width:1440px;
  margin:0 auto;
  padding-inline:clamp(20px,4vw,58px);
}
.zs-why__layout{display:block}
.zs-why__intro{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:clamp(24px,5vw,80px);
  margin:0 0 clamp(25px,3.2vw,40px);
}
.zs-why__heading-wrap{min-width:0}
.zs-why__eyebrow{
  display:flex;align-items:center;gap:12px;
  margin:0 0 13px;
  color:#916B4B;
  font-size:10px;font-weight:500;letter-spacing:.16em;
  line-height:1.4;text-transform:uppercase;
}
.zs-why__eyebrow>span{
  display:block;flex:0 0 26px;width:26px;height:2px;
  background:var(--zs-why-accent,#D8B56A);
}
.zs-why__title{
  display:flex;flex-wrap:wrap;align-items:baseline;gap:.23em;
  margin:0;
  font-family:inherit!important;
  font-size:clamp(35px,3.1vw,48px);
  line-height:1.14;
  letter-spacing:-.055em;
  color:var(--zs-why-ink,#2B1D17);
}
.zs-why__title>span{font-weight:300}
.zs-why__title>strong{font-weight:700}
.zs-why__lead{
  flex:0 1 415px;
  max-width:47ch;
  margin:0 0 5px;
  color:var(--zs-why-text,#80736A);
  font-size:13px;line-height:1.75;font-weight:400;
}
.zs-why__features{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:clamp(17px,2vw,29px);
  align-items:start;
}
.zs-why__feature{min-width:0}
.zs-why__media{
  position:relative;
  width:100%;
  aspect-ratio:1 / 1;
  overflow:hidden;
  border-radius:18px;
  background:#EEE5DB;
  isolation:isolate;
}
.zs-why__image{
  display:block;
  width:100%;height:100%;
  object-fit:cover;object-position:center;
}
.zs-why__image-placeholder{
  display:flex;
  width:100%;height:100%;
  flex-direction:column;
  align-items:center;justify-content:center;
  gap:12px;
  padding:16px;
  background:linear-gradient(145deg,#F2EBE2,#E8DBCC);
  color:#8F7359;
  text-align:center;
}
.zs-why__placeholder-logo{
  font-size:12px;font-weight:500;
  letter-spacing:.25em;
  opacity:.65;
}
.zs-why__placeholder-title{
  font-size:clamp(15px,1.7vw,23px);
  line-height:1.25;
  font-weight:300;
  letter-spacing:-.025em;
}
.zs-why__feature-copy{
  padding:16px 1px 0;
}
.zs-why__feature-title{
  margin:0;
  color:var(--zs-why-ink,#2B1D17);
  font-family:inherit!important;
  font-size:clamp(15px,1.2vw,18px);
  line-height:1.4;
  letter-spacing:-.025em;
  font-weight:600;
}
.zs-why__feature-text{
  margin:6px 0 0;
  color:var(--zs-why-text,#80736A);
  font-size:12px;
  line-height:1.7;
  font-weight:400;
}
@media(min-width:750px) and (max-width:1050px){
  .zs-why__intro{align-items:start}
  .zs-why__lead{max-width:38ch;font-size:12px}
  .zs-why__title{font-size:clamp(33px,3.8vw,43px)}
  .zs-why__media{border-radius:15px}
}
@media(max-width:749px){
  .zs-why{padding:34px 0 37px}
  .zs-why__inner{padding-inline:16px}
  .zs-why__intro{display:block;margin-bottom:25px}
  .zs-why__eyebrow{font-size:9px;margin-bottom:12px}
  .zs-why__title{font-size:clamp(31px,8vw,39px)}
  .zs-why__lead{max-width:46ch;margin:9px 0 0;font-size:11.5px;line-height:1.6}
  .zs-why__features{grid-template-columns:1fr;gap:0}
  .zs-why__feature{
    display:grid;
    grid-template-columns:118px minmax(0,1fr);
    align-items:center;
    gap:17px;
    min-height:144px;
    padding:13px 0;
    border-top:1px solid rgba(128,96,68,.12);
  }
  .zs-why__media{aspect-ratio:1 / 1;border-radius:12px}
  .zs-why__image-placeholder{gap:5px;padding:7px}
  .zs-why__placeholder-logo{font-size:7px}
  .zs-why__placeholder-title{font-size:11px}
  .zs-why__feature-copy{padding:0}
  .zs-why__feature-title{font-size:14px}
  .zs-why__feature-text{margin-top:4px;font-size:11px}
}
@media(max-width:365px){
  .zs-why__feature{grid-template-columns:99px minmax(0,1fr);gap:13px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Why Choose Us",
  "tag": "section",
  "class": "section-zs-why-zaisen",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Editorial heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ZAISEN DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading_light",
      "label": "Light heading",
      "default": "Made with"
    },
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Bold heading",
      "default": "Care."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Short description",
      "default": "Real wood, careful craftsmanship, and little details that make every piece special."
    },
    {
      "type": "header",
      "content": "Visual style"
    },
    {
      "type": "font_picker",
      "id": "editorial_font",
      "label": "Font",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#2B1D17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Supporting text",
      "default": "#80736A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Line accent",
      "default": "#D8B56A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 20,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 20,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Craftsmanship point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pure Wood"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Made from natural wood."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Why Choose Us",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Pure Wood",
            "description": "Made from natural wood."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Handcrafted",
            "description": "Carefully made by skilled hands."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Made with Care",
            "description": "Attention to the little details."
          }
        }
      ]
    }
  ]
}
{% endschema %}
