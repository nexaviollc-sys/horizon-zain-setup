{%- liquid
  assign statue_product = all_products['handcrafted-wooden-horse-statue']
  assign statue_image = statue_product.featured_image
-%}

<section id="zs-creator-{{ section.id }}" class="zs-creator">
  <div class="zs-creator__hero">
    <div class="zs-creator__hero-copy">
      <p class="zs-creator__eyebrow">THE ZAISEN CREATOR PROGRAM</p>
      <h1>Get a free ZAISEN piece. <em>Earn 8% per sale.</em></h1>
      <p class="zs-creator__intro">Selected creators receive a handcrafted ZAISEN product as a gift, with standard delivery covered. Share it with your audience and earn 8% commission on qualifying orders through your personal link.</p>
      <div class="zs-creator__benefits" aria-label="Creator partnership benefits">
        <span>FREE HANDCRAFTED GIFT</span>
        <span>STANDARD DELIVERY COVERED</span>
        <span>8% PER QUALIFYING SALE</span>
      </div>
      <div class="zs-creator__hero-actions">
        <a class="zs-creator__button" href="#creator-application">Apply now <span aria-hidden="true">→</span></a>
        <a class="zs-creator__text-link" href="/collections/all">Shop ZAISEN</a>
      </div>
      <p class="zs-creator__hero-note">For selected creators · UK, USA and European audiences are prioritised</p>
    </div>

    <div class="zs-creator__hero-visual">
      <div class="zs-creator__image-frame">
        {% if statue_image != blank %}
          {{ statue_image | image_url: width: 1600 | image_tag: class: 'zs-creator__hero-image', loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(max-width: 900px) 100vw, 48vw', alt: statue_product.title }}
        {% else %}
          <img class="zs-creator__hero-image" src="https://cdn.shopify.com/s/files/1/1019/0884/0741/files/WhatsApp_Image_2026-09-29_at_5.33.09_PM.jpg?v=1790935879" alt="ZAISEN handcrafted wooden horse statue" loading="eager">
        {% endif %}
        
      </div>
    </div>
  </div>

  <div class="zs-creator__intro-band">
    <p class="zs-creator__eyebrow">WHO WE’RE LOOKING FOR</p>
    <h2>Love beautiful spaces? Let’s work together.</h2>
    <p>We’re looking for home, interior and lifestyle creators with an engaged audience in the UK, USA and Europe.</p>
  </div>

  <div class="zs-creator__offer-grid">
    <article class="zs-creator__offer-card zs-creator__offer-card--gift">
      <div class="zs-creator__card-kicker"><span>01</span> THE GIFT</div>
      <h3>A ZAISEN piece, on us.</h3>
      <p>Choose a product that suits your home and audience. If approved, we’ll send it to you as a gift and cover standard delivery.</p>
    </article>
    <article class="zs-creator__offer-card">
      <div class="zs-creator__card-kicker"><span>02</span> YOUR COMMISSION</div>
      <h3>Earn 8% per sale.</h3>
      <p>Share your personal affiliate link and earn 8% on qualifying orders placed through it.</p>
    </article>
    <article class="zs-creator__offer-card">
      <div class="zs-creator__card-kicker"><span>03</span> THE PARTNERSHIP</div>
      <h3>Let’s grow together.</h3>
      <p>We’re looking for genuine creative partnerships, with opportunities to work together on future launches and collections.</p>
    </article>
  </div>

  <div class="zs-creator__fit">
    <div class="zs-creator__fit-copy">
      <p class="zs-creator__eyebrow">IS THIS YOU?</p>
      <h2>Your content feels at home with ZAISEN.</h2>
      <p>You don’t need a huge following. We care about your style, your audience and the way you tell a story.</p>
    </div>
    <div class="zs-creator__fit-list">
      <div><span>01</span><p><strong>Home & interiors</strong>Styling, décor and beautiful everyday spaces.</p></div>
      <div><span>02</span><p><strong>Natural living</strong>Wood, artisan details and timeless design.</p></div>
      <div><span>03</span><p><strong>Relevant audience</strong>People who love distinctive home décor and gifts.</p></div>
      <div><span>04</span><p><strong>Real storytelling</strong>Honest, creative content your followers trust.</p></div>
    </div>
  </div>

  <div class="zs-creator__process">
    <div class="zs-creator__section-heading">
      <p class="zs-creator__eyebrow">HOW IT WORKS</p>
      <h2>Four steps. One lovely collaboration.</h2>
    </div>
    <div class="zs-creator__steps">
      <article><span>01</span><h3>Apply</h3><p>Share your profile and audience details.</p></article>
      <article><span>02</span><h3>Get approved</h3><p>We’ll contact you if it’s a good fit.</p></article>
      <article><span>03</span><h3>Choose your gift</h3><p>Pick a ZAISEN piece and receive it at home.</p></article>
      <article><span>04</span><h3>Post & earn</h3><p>Share your link and earn 8% per qualifying sale.</p></article>
    </div>
  </div>

  <div class="zs-creator__terms">
    <div class="zs-creator__terms-heading">
      <p class="zs-creator__eyebrow">GOOD TO KNOW</p>
      <h2>Clear terms. Honest content.</h2>
    </div>
    <div class="zs-creator__terms-copy">
      <p>Before dispatch, we’ll agree on your product, post format and timing. We welcome honest opinions—just remember to disclose gifted products and affiliate links to your audience.</p>
    </div>
  </div>

  <div id="creator-application" class="zs-creator__application">
    <div class="zs-creator__application-heading">
      <p class="zs-creator__eyebrow">LET’S GET TO KNOW YOU</p>
      <h2>Ready for your ZAISEN gift?</h2>
      <p>Tell us where to find your content. We’ll review your profile and get in touch if it’s a fit.</p>
    </div>

    {% form 'contact', id: 'zs-creator-application-form', class: 'zs-creator__form' %}
      {% if form.posted_successfully? %}
        <div class="zs-creator__success" role="status">
          <strong>Thank you for applying.</strong>
          <span>Your application has been received. The ZAISEN team will review your details and contact you if there’s a suitable opportunity.</span>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="zs-creator__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="zs-creator__form-grid">
          <div class="zs-creator__field">
            <label for="zs-creator-name">Your name <span>*</span></label>
            <input id="zs-creator-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" placeholder="Full name" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-email">Email address <span>*</span></label>
            <input id="zs-creator-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" placeholder="you@example.com" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-profile">Instagram, TikTok or YouTube profile <span>*</span></label>
            <input id="zs-creator-profile" type="url" name="contact[Social profile]" placeholder="https://..." required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-country">Where are you based? <span>*</span></label>
            <input id="zs-creator-country" type="text" name="contact[Country]" autocomplete="country-name" placeholder="Country" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-followers">Approximate follower count <span>*</span></label>
            <input id="zs-creator-followers" type="text" name="contact[Follower count]" placeholder="e.g. 8,500" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-audience">Where is most of your audience based? <span>*</span></label>
            <input id="zs-creator-audience" type="text" name="contact[Audience countries]" placeholder="e.g. UK, USA, Germany" required>
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-product">Which ZAISEN product would you love to feature? <small>Optional</small></label>
            <input id="zs-creator-product" type="text" name="contact[Product of interest]" placeholder="Product name or link">
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-message">Anything else we should know? <small>Optional</small></label>
            <textarea id="zs-creator-message" name="contact[body]" rows="4" placeholder="Tell us a little about your content or the product you have in mind."></textarea>
          </div>
        </div>
        <div class="zs-creator__form-footer">
          <button type="submit" class="zs-creator__button">Send my application <span aria-hidden="true">→</span></button>
          <p>We review every application. Complimentary products are sent to selected creators after the collaboration is agreed.</p>
        </div>
      {% endif %}
    {% endform %}
  </div>

  <p class="zs-creator__disclosure">Standard delivery is covered for approved collaborations. Any applicable import charges will be discussed before shipment. Gifted products and affiliate links must be disclosed in line with local advertising rules.</p>
</section>

<style>
  #zs-creator-{{ section.id }} {
    --zsc-ink: #2b241e;
    --zsc-muted: #6c6258;
    --zsc-walnut: #79543d;
    --zsc-brass: #b79b6d;
    --zsc-paper: #f7f4ee;
    --zsc-heading: var(--font-heading--family, Georgia, serif);
    --zsc-body: var(--font-body--family, Arial, sans-serif);
    color: var(--zsc-ink);
    font-family: var(--zsc-body);
    padding: clamp(22px, 3.5vw, 48px) 0 30px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #zs-creator-{{ section.id }} * { box-sizing: border-box; }
  #zs-creator-{{ section.id }} :is(h1,h2,h3) {
    color: var(--zsc-ink); font-family: var(--zsc-heading);
    font-weight: 500; text-wrap: balance;
  }
  #zs-creator-{{ section.id }} p { text-wrap: pretty; }
  #zs-creator-{{ section.id }} .zs-creator__eyebrow {
    display: flex; align-items: center; gap: 10px;
    margin: 0 0 15px; color: var(--zsc-walnut);
    font-family: var(--zsc-body); font-size: 10px; line-height: 1.5;
    font-weight: 700; letter-spacing: .19em; text-transform: uppercase;
  }
  #zs-creator-{{ section.id }} .zs-creator__eyebrow::before {
    content: ""; width: 24px; height: 1px; flex: 0 0 24px; background: var(--zsc-brass);
  }

  /* Hero: one clear offer, three proof points, two actions */
  #zs-creator-{{ section.id }} .zs-creator__hero {
    position: relative; isolation: isolate; overflow: hidden;
    max-width: 1320px; margin: 0 auto 66px;
    padding: clamp(30px, 4.5vw, 62px);
    border: 1px solid #e8dfd2; border-radius: 4px;
    background:
      radial-gradient(ellipse at 6% 95%, rgba(182,154,106,.12), transparent 35%),
      linear-gradient(118deg, #f8f5ef 0%, #f0e9de 58%, #eae0d2 100%);
    display: grid; grid-template-columns: minmax(0,1.06fr) minmax(330px,.94fr);
    gap: clamp(28px,4vw,62px); align-items: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero::before {
    content: "Z"; position: absolute; z-index: -1; left: 40%; bottom: -30%;
    color: rgba(119,82,58,.035); font-family: var(--zsc-heading);
    font-size: clamp(250px,35vw,510px); line-height: 1; pointer-events: none;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero h1 {
    max-width: 660px; margin: 0 0 19px;
    font-size: clamp(49px,5.8vw,78px); line-height: .99;
    font-weight: 500; letter-spacing: -.045em;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero h1 em {
    display: block; margin-top: 4px; color: var(--zsc-walnut);
    font-weight: 400; font-style: italic; letter-spacing: -.04em;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro {
    max-width: 590px; margin: 0; color: #5f564d;
    font-family: var(--zsc-body); font-size: 15px; line-height: 1.8;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 10px 17px; margin: 23px 0 27px;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits span {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 0; border: 0; border-radius: 0; background: transparent;
    color: #594b3d; font-family: var(--zsc-body);
    font-size: 10px; line-height: 1.5; font-weight: 700; letter-spacing: .075em;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits span::before {
    content: "✳"; color: var(--zsc-brass); font-size: 13px; font-weight: 400;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-actions {
    display: flex; flex-wrap: wrap; align-items: center; gap: 18px;
  }
  #zs-creator-{{ section.id }} .zs-creator__button {
    display: inline-flex; justify-content: center; align-items: center; gap: 20px;
    min-height: 52px; padding: 14px 23px; border: 1px solid var(--zsc-walnut);
    border-radius: 2px; background: var(--zsc-walnut); color: #fff;
    font-family: var(--zsc-body); font-size: 11px; font-weight: 700;
    letter-spacing: .095em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; transition: background .2s ease, transform .2s ease;
  }
  #zs-creator-{{ section.id }} .zs-creator__button:hover {
    background: #5d3f2d; border-color: #5d3f2d; transform: translateY(-2px);
  }
  #zs-creator-{{ section.id }} .zs-creator__text-link {
    color: #51463b; font-family: var(--zsc-body); font-size: 10px;
    font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
    text-decoration: none; border-bottom: 1px solid #b69a6a; padding-bottom: 5px;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-note {
    margin: 16px 0 0; color: #776d61; font-family: var(--zsc-body);
    font-size: 10px; line-height: 1.65; letter-spacing: .035em;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-visual {
    position: relative; max-width: 570px; width: 100%;
    justify-self: end; padding: 8px; border: 1px solid rgba(119,82,58,.15);
    border-radius: 3px; background: rgba(255,255,255,.8);
    box-shadow: 0 20px 50px rgba(55,42,28,.10);
  }
  #zs-creator-{{ section.id }} .zs-creator__image-frame {
    overflow: hidden; border-radius: 1px; background: #e7dfd2;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-image {
    display: block; width: 100%; height: clamp(360px,42vw,540px);
    object-fit: cover; object-position: center; filter: saturate(.96) contrast(1.02);
  }

  /* Short, scan-friendly offer cards */
  #zs-creator-{{ section.id }} .zs-creator__intro-band {
    max-width: 790px; margin: 0 auto 35px; padding: 0 22px; text-align: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band .zs-creator__eyebrow,
  #zs-creator-{{ section.id }} .zs-creator__section-heading .zs-creator__eyebrow,
  #zs-creator-{{ section.id }} .zs-creator__application-heading .zs-creator__eyebrow {
    justify-content: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band h2,
  #zs-creator-{{ section.id }} .zs-creator__section-heading h2,
  #zs-creator-{{ section.id }} .zs-creator__application-heading h2 {
    margin: 0 0 12px; font-size: clamp(35px,4.2vw,51px);
    line-height: 1.04; font-weight: 500; letter-spacing: -.035em;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band > p:last-child,
  #zs-creator-{{ section.id }} .zs-creator__application-heading > p:last-child {
    max-width: 650px; margin: 0 auto; color: var(--zsc-muted, #6c6258);
    font-family: var(--zsc-body); font-size: 13px; line-height: 1.8;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-grid {
    max-width: 1210px; margin: 0 auto 66px; padding: 0 20px;
    display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 15px;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card {
    position: relative; min-height: 220px; padding: 25px 25px 27px;
    border: 1px solid #e6ded3; border-radius: 3px;
    background: #fff; transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card:hover {
    transform: translateY(-3px); border-color: #d3c1a8;
    box-shadow: 0 13px 28px rgba(52,41,29,.06);
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card::before {
    content: ""; position: absolute; top: 0; left: 0;
    width: 52px; height: 2px; background: var(--zsc-brass);
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card--gift {
    background: linear-gradient(145deg,#f8f5ef 0%,#f1eade 100%);
    border-color: #e3d8c9;
  }
  #zs-creator-{{ section.id }} .zs-creator__card-kicker {
    display: flex; align-items: center; gap: 11px; margin-bottom: 25px;
    color: #8a7256; font-family: var(--zsc-body);
    font-size: 9px; font-weight: 700; letter-spacing: .15em;
  }
  #zs-creator-{{ section.id }} .zs-creator__card-kicker span {
    color: var(--zsc-walnut); font-family: var(--zsc-heading);
    font-size: 27px; line-height: 1; font-weight: 500; letter-spacing: -.04em;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card h3 {
    max-width: 310px; margin: 0 0 10px; font-size: clamp(24px,2.2vw,30px);
    line-height: 1.08; font-weight: 500; letter-spacing: -.025em;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card p {
    max-width: 360px; margin: 0; color: #6c6258;
    font-family: var(--zsc-body); font-size: 12px; line-height: 1.75;
  }

  /* Creator fit */
  #zs-creator-{{ section.id }} .zs-creator__fit {
    max-width: 1210px; margin: 0 auto 66px; padding: clamp(27px,4vw,46px);
    display: grid; grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr);
    gap: clamp(25px,4vw,52px); align-items: center;
    border: 1px solid #e8e0d5; border-radius: 3px; background: #f7f4ee;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit h2,
  #zs-creator-{{ section.id }} .zs-creator__terms h2 {
    margin: 0 0 13px; font-size: clamp(32px,3.6vw,44px);
    line-height: 1.03; font-weight: 500; letter-spacing: -.035em;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-copy > p:last-child {
    margin: 0; color: #6c6258; font-family: var(--zsc-body);
    font-size: 12px; line-height: 1.8;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list {
    display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 9px;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div {
    display: flex; gap: 11px; padding: 13px 14px;
    border: 1px solid rgba(119,82,58,.12); border-radius: 2px; background: rgba(255,255,255,.72);
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div > span {
    flex: 0 0 auto; color: var(--zsc-brass);
    font-family: var(--zsc-heading); font-size: 18px; line-height: 1.2;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list p {
    margin: 0; color: #6c6258; font-family: var(--zsc-body); font-size: 10px; line-height: 1.65;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list strong {
    display: block; margin-bottom: 3px; color: var(--zsc-ink);
    font-family: var(--zsc-body); font-size: 11px; font-weight: 700;
  }

  /* Four simple steps */
  #zs-creator-{{ section.id }} .zs-creator__process {
    max-width: 1210px; margin: 0 auto 60px; padding: 0 20px;
  }
  #zs-creator-{{ section.id }} .zs-creator__section-heading {
    max-width: 760px; margin: 0 auto 27px; text-align: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__steps {
    position: relative; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px;
  }
  #zs-creator-{{ section.id }} .zs-creator__steps::before {
    content: ""; position: absolute; top: 22px; left: 12%; right: 12%;
    height: 1px; background: linear-gradient(90deg,transparent,#c7b18f 12%,#c7b18f 88%,transparent);
  }
  #zs-creator-{{ section.id }} .zs-creator__steps article {
    position: relative; padding: 0 13px 10px; border: 0; background: transparent; text-align: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__steps article > span {
    position: relative; z-index: 1; display: grid; place-items: center;
    width: 45px; height: 45px; margin: 0 auto 13px;
    border: 1px solid #c7b18f; border-radius: 50%; background: #fff;
    color: var(--zsc-walnut); font-family: var(--zsc-heading); font-size: 18px;
  }
  #zs-creator-{{ section.id }} .zs-creator__steps h3 {
    margin: 0 0 6px; font-size: 24px; line-height: 1.05; font-weight: 500;
  }
  #zs-creator-{{ section.id }} .zs-creator__steps p {
    max-width: 210px; margin: 0 auto; color: #6c6258;
    font-family: var(--zsc-body); font-size: 11px; line-height: 1.7;
  }

  /* Short partnership note */
  #zs-creator-{{ section.id }} .zs-creator__terms {
    max-width: 1120px; margin: 0 auto 60px; padding: 22px 28px;
    display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr);
    gap: 25px; align-items: center; border: 1px solid #e5dbce;
    border-left: 3px solid var(--zsc-brass); border-radius: 2px; background: #f8f5ef;
  }
  #zs-creator-{{ section.id }} .zs-creator__terms .zs-creator__eyebrow { margin-bottom: 8px; }
  #zs-creator-{{ section.id }} .zs-creator__terms h2 { margin: 0; font-size: 31px; }
  #zs-creator-{{ section.id }} .zs-creator__terms-copy p {
    margin: 0; color: #6c6258; font-family: var(--zsc-body);
    font-size: 12px; line-height: 1.8;
  }

  /* Compact application panel */
  #zs-creator-{{ section.id }} .zs-creator__application {
    max-width: 1120px; margin: 0 auto 18px; padding: clamp(25px,3.5vw,40px);
