{%- liquid
  assign statue_product = all_products['handcrafted-wooden-horse-statue']
  assign statue_image = statue_product.featured_image
-%}

<section id="zs-creator-{{ section.id }}" class="zs-creator">
  <div class="zs-creator__hero">
    <div class="zs-creator__hero-copy">
      <p class="zs-creator__eyebrow">THE ZAISEN CREATOR PROGRAM</p>
      <h1>Receive a handcrafted ZAISEN gift. Share what you love.</h1>
      <p class="zs-creator__intro">We partner with selected creators whose content and audience are a natural fit for handcrafted home décor. If approved, we’ll send you a complimentary ZAISEN piece as a gift for your home, with standard delivery covered by us, and you can earn commission on qualifying sales through your personal link.</p>
      <div class="zs-creator__benefits" aria-label="Creator partnership benefits">
        <span><i aria-hidden="true">✳</i> A complimentary ZAISEN gift</span>
        <span><i aria-hidden="true">✳</i> Standard delivery covered</span>
        <span><i aria-hidden="true">✳</i> 8% affiliate commission</span>
      </div>
      <div class="zs-creator__hero-actions">
        <a class="zs-creator__button" href="#creator-application">Apply to collaborate <span aria-hidden="true">→</span></a>
        <a class="zs-creator__text-link" href="/collections/all">Explore the collection</a>
      </div>
      <p class="zs-creator__hero-note">For selected creators · UK, USA and European audiences are currently prioritised</p>
    </div>

    <div class="zs-creator__hero-visual">
      <div class="zs-creator__image-frame">
        {% if statue_image != blank %}
          {{ statue_image | image_url: width: 1600 | image_tag: class: 'zs-creator__hero-image', loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(max-width: 900px) 100vw, 48vw', alt: statue_product.title }}
        {% else %}
          <img class="zs-creator__hero-image" src="https://cdn.shopify.com/s/files/1/1019/0884/0741/files/WhatsApp_Image_2026-09-29_at_5.33.09_PM.jpg?v=1790935879" alt="ZAISEN handcrafted wooden horse statue" loading="eager">
        {% endif %}
        <div class="zs-creator__image-caption">
          <span>HANDCRAFTED WOODEN DECOR</span>
          <strong>A signature ZAISEN piece</strong>
        </div>
      </div>
      <div class="zs-creator__hero-stamp"><span>MADE WITH</span><strong>CARE</strong><span>SHARED WITH YOU</span></div>
    </div>
  </div>

  <div class="zs-creator__intro-band">
    <p class="zs-creator__eyebrow">A PARTNERSHIP, NOT JUST A POST</p>
    <h2>For creators who bring thoughtful spaces to life.</h2>
    <p>Whether you share home styling, interiors, natural materials or meaningful finds, we’d love to discover creators who can introduce ZAISEN in a way that feels genuine to them and their audience.</p>
  </div>

  <div class="zs-creator__offer-grid">
    <article class="zs-creator__offer-card zs-creator__offer-card--gift">
      <span class="zs-creator__card-number">01 / THE GIFT</span>
      <div class="zs-creator__card-icon" aria-hidden="true">✳</div>
      <h3>A ZAISEN piece, gifted to you</h3>
      <p>Creators selected for the programme receive a complimentary product from our collection as a gift for their home. We’ll choose it together to suit your style and audience, and cover standard delivery.</p>
    </article>
    <article class="zs-creator__offer-card">
      <span class="zs-creator__card-number">02 / YOUR EARNINGS</span>
      <div class="zs-creator__card-icon" aria-hidden="true">%</div>
      <h3>Earn 8% on referred sales</h3>
      <p>Approved creator partners receive a personal affiliate link and earn 8% commission on qualifying orders tracked through that link. Tracking and payout terms are shared before the partnership begins.</p>
    </article>
    <article class="zs-creator__offer-card">
      <span class="zs-creator__card-number">03 / GROW TOGETHER</span>
      <div class="zs-creator__card-icon" aria-hidden="true">↗</div>
      <h3>A relationship that can grow</h3>
      <p>We value thoughtful, ongoing partnerships. Creators whose content and audience continue to connect with ZAISEN may be invited to future launches and collaborations.</p>
    </article>
  </div>

  <div class="zs-creator__fit">
    <div class="zs-creator__fit-copy">
      <p class="zs-creator__eyebrow">WHO WE’D LOVE TO HEAR FROM</p>
      <h2>Your style matters more than a follower number.</h2>
      <p>We’re interested in creators whose audience genuinely enjoys interiors and considered home details. We look at content quality, audience location and engagement—not follower count alone.</p>
    </div>
    <div class="zs-creator__fit-list">
      <div><span>01</span><p><strong>Home & interior creators</strong>Room styling, home inspiration, décor finds and lived-in spaces.</p></div>
      <div><span>02</span><p><strong>Natural & handcrafted style</strong>Wood, artisan details, rustic textures and timeless pieces.</p></div>
      <div><span>03</span><p><strong>Relevant audiences</strong>Followers who enjoy home décor, thoughtful gifts and distinctive design.</p></div>
      <div><span>04</span><p><strong>Authentic storytelling</strong>Creators who share honest experiences and communicate clearly with their audience.</p></div>
    </div>
  </div>

  <div class="zs-creator__process">
    <div class="zs-creator__section-heading">
      <p class="zs-creator__eyebrow">HOW IT WORKS</p>
      <h2>Four simple steps to create together.</h2>
    </div>
    <div class="zs-creator__steps">
      <article><span>01</span><h3>Apply</h3><p>Tell us about your content, social profile and where your audience is based.</p></article>
      <article><span>02</span><h3>Get selected</h3><p>We review your application and contact you if we see a strong fit for ZAISEN.</p></article>
      <article><span>03</span><h3>Receive your gift</h3><p>We agree on a suitable product and the content plan, then send your complimentary piece with standard delivery covered.</p></article>
      <article><span>04</span><h3>Share & earn</h3><p>Feature your genuine experience, share your personal link and earn 8% on qualifying referred sales.</p></article>
    </div>
  </div>

  <div class="zs-creator__expectations">
    <div>
      <p class="zs-creator__eyebrow">CLEAR FROM THE START</p>
      <h2>We agree on the details before anything is sent.</h2>
      <p>Every collaboration is discussed individually. Before dispatch, we’ll confirm the selected product, destination, content format, posting timeline, affiliate tracking and commission terms with you.</p>
    </div>
    <div class="zs-creator__expectation-points">
      <p><span>✓</span> An agreed Reel, post, Story or unboxing feature</p>
      <p><span>✓</span> A genuine introduction to ZAISEN and the gifted product</p>
      <p><span>✓</span> Your personal affiliate link for tracking referred orders</p>
      <p><span>✓</span> Clear disclosure of gifted products and affiliate commission</p>
      <p class="zs-creator__honesty">We welcome honest opinions. A positive review is never required.</p>
    </div>
  </div>

  <div id="creator-application" class="zs-creator__application">
    <div class="zs-creator__application-heading">
      <p class="zs-creator__eyebrow">LET’S GET TO KNOW YOU</p>
      <h2>Apply to become a ZAISEN creator partner.</h2>
      <p>Share a few details about yourself and your audience. If your profile is a good fit, our team will get in touch to discuss the gifted product and partnership.</p>
    </div>

    {% form 'contact', id: 'zs-creator-application-form', class: 'zs-creator__form' %}
      {% if form.posted_successfully? %}
        <div class="zs-creator__success" role="status">
          <strong>Thank you for applying.</strong>
          <span>Your application has been received. The ZAISEN team will review your details and contact you if there’s a suitable opportunity.</span>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="zs-creator__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="zs-creator__form-grid">
          <div class="zs-creator__field">
            <label for="zs-creator-name">Your name <span>*</span></label>
            <input id="zs-creator-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" placeholder="Full name" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-email">Email address <span>*</span></label>
            <input id="zs-creator-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" placeholder="you@example.com" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-profile">Instagram, TikTok or YouTube profile <span>*</span></label>
            <input id="zs-creator-profile" type="url" name="contact[Social profile]" placeholder="https://..." required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-country">Where are you based? <span>*</span></label>
            <input id="zs-creator-country" type="text" name="contact[Country]" autocomplete="country-name" placeholder="Country" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-followers">Approximate follower count <span>*</span></label>
            <input id="zs-creator-followers" type="text" name="contact[Follower count]" placeholder="e.g. 8,500" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-audience">Where is most of your audience based? <span>*</span></label>
            <input id="zs-creator-audience" type="text" name="contact[Audience countries]" placeholder="e.g. UK, USA, Germany" required>
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-product">Which ZAISEN product would you love to feature? <small>Optional</small></label>
            <input id="zs-creator-product" type="text" name="contact[Product of interest]" placeholder="Product name or link">
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-message">Tell us about your content and your audience <span>*</span></label>
            <textarea id="zs-creator-message" name="contact[body]" rows="5" placeholder="What do you create, who follows you, and how would you feature ZAISEN?" required></textarea>
          </div>
        </div>
        <div class="zs-creator__form-footer">
          <p>Submitting an application does not guarantee selection or a gifted product. We’ll confirm product availability, delivery details and collaboration expectations with selected creators before dispatch.</p>
          <button type="submit" class="zs-creator__button">Submit application <span aria-hidden="true">→</span></button>
        </div>
      {% endif %}
    {% endform %}
  </div>

  <p class="zs-creator__disclosure">Creators must clearly disclose gifted products and affiliate relationships in line with the rules that apply in their country. Standard delivery is covered for approved collaborations. Any applicable destination-specific import charges will be discussed before shipment.</p>
</section>

<style>
  #zs-creator-{{ section.id }} {
    --zsc-ink: #302b25;
    --zsc-muted: #6d655b;
    --zsc-wood: #9a8061;
    --zsc-line: #e8dfd3;
    --zsc-paper: #f7f4ee;
    --zsc-white: #fff;
    color: var(--zsc-ink);
    padding: clamp(22px, 4vw, 54px) 0 34px;
  }
  #zs-creator-{{ section.id }} * { box-sizing: border-box; }
  #zs-creator-{{ section.id }} .zs-creator__hero {
    max-width: 1240px; margin: 0 auto 64px; padding: clamp(25px, 4vw, 52px);
    border-radius: 24px; background: linear-gradient(125deg,#f5f0e7 0%,#eee6d9 100%);
    display: grid; grid-template-columns: minmax(0,1.05fr) minmax(330px,.95fr); gap: clamp(28px,5vw,66px); align-items: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__eyebrow { margin: 0 0 13px; color: var(--zsc-wood); font-size: 11px; line-height: 1.4; font-weight: 700; letter-spacing: .19em; text-transform: uppercase; }
  #zs-creator-{{ section.id }} h1,
  #zs-creator-{{ section.id }} h2,
  #zs-creator-{{ section.id }} h3 { color: var(--zsc-ink); }
  #zs-creator-{{ section.id }} .zs-creator__hero h1 { max-width: 650px; margin: 0 0 18px; font-family: Georgia,serif; font-size: clamp(37px,4.7vw,61px); line-height: 1.05; font-weight: 400; letter-spacing: -.035em; }
  #zs-creator-{{ section.id }} .zs-creator__intro { max-width: 650px; margin: 0; color: #5e574e; font-size: 16px; line-height: 1.85; }
  #zs-creator-{{ section.id }} .zs-creator__benefits { display: flex; flex-wrap: wrap; gap: 9px; margin: 23px 0 25px; }
  #zs-creator-{{ section.id }} .zs-creator__benefits span { display: inline-flex; align-items: center; gap: 8px; padding: 9px 12px; border: 1px solid rgba(126,105,78,.2); border-radius: 99px; background: rgba(255,255,255,.72); color: #554c40; font-size: 12px; }
  #zs-creator-{{ section.id }} .zs-creator__benefits i { color: #987b58; font-style: normal; }
  #zs-creator-{{ section.id }} .zs-creator__hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  #zs-creator-{{ section.id }} .zs-creator__button { display: inline-flex; justify-content: center; align-items: center; gap: 18px; min-height: 48px; padding: 13px 20px; border: 1px solid var(--zsc-ink); border-radius: 4px; background: var(--zsc-ink); color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: .025em; cursor: pointer; transition: background .2s ease,color .2s ease,transform .2s ease; }
  #zs-creator-{{ section.id }} .zs-creator__button:hover { background: #51483d; border-color: #51483d; transform: translateY(-1px); }
  #zs-creator-{{ section.id }} .zs-creator__text-link { color: #4e463c; text-decoration: underline; text-underline-offset: 4px; font-size: 13px; }
  #zs-creator-{{ section.id }} .zs-creator__hero-note { margin: 18px 0 0; color: #766d61; font-size: 11px; letter-spacing: .02em; }
  #zs-creator-{{ section.id }} .zs-creator__hero-visual { position: relative; max-width: 550px; width: 100%; justify-self: end; padding: 11px; border-radius: 20px; background: rgba(255,255,255,.76); box-shadow: 0 20px 55px rgba(55,42,28,.12); }
  #zs-creator-{{ section.id }} .zs-creator__image-frame { position: relative; overflow: hidden; border-radius: 13px; background: #e7dfd2; }
  #zs-creator-{{ section.id }} .zs-creator__hero-image { display: block; width: 100%; height: clamp(370px,48vw,570px); object-fit: cover; object-position: center; }
  #zs-creator-{{ section.id }} .zs-creator__image-caption { position: absolute; right: 15px; bottom: 15px; left: 15px; display: flex; flex-direction: column; gap: 5px; padding: 15px 17px; border: 1px solid rgba(255,255,255,.4); border-radius: 9px; background: rgba(36,31,25,.68); color: #fff; backdrop-filter: blur(8px); }
  #zs-creator-{{ section.id }} .zs-creator__image-caption span { font-size: 9px; letter-spacing: .17em; opacity: .82; }
  #zs-creator-{{ section.id }} .zs-creator__image-caption strong { font-family: Georgia,serif; font-size: 20px; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp { position: absolute; top: 25px; left: -22px; display: flex; width: 92px; height: 92px; flex-direction: column; justify-content: center; align-items: center; border: 1px solid #d6c7b2; border-radius: 50%; background: #f8f5ef; color: #77664e; box-shadow: 0 8px 20px rgba(50,38,25,.08); transform: rotate(-8deg); }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp span { font-size: 7px; letter-spacing: .12em; }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp strong { margin: 2px 0; font-family: Georgia,serif; font-size: 22px; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__intro-band { max-width: 790px; margin: 0 auto 42px; padding: 0 24px; text-align: center; }
  #zs-creator-{{ section.id }} .zs-creator__intro-band h2,
  #zs-creator-{{ section.id }} .zs-creator__section-heading h2,
  #zs-creator-{{ section.id }} .zs-creator__application-heading h2 { margin: 0 0 13px; font-family: Georgia,serif; font-size: clamp(29px,3.5vw,41px); line-height: 1.16; font-weight: 400; letter-spacing: -.02em; }
  #zs-creator-{{ section.id }} .zs-creator__intro-band > p:last-child,
  #zs-creator-{{ section.id }} .zs-creator__application-heading > p:last-child { margin: 0; color: var(--zsc-muted); font-size: 15px; line-height: 1.8; }
  #zs-creator-{{ section.id }} .zs-creator__offer-grid { max-width: 1180px; margin: 0 auto 68px; padding: 0 20px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 17px; }
  #zs-creator-{{ section.id }} .zs-creator__offer-card { min-height: 250px; padding: 25px 24px; border: 1px solid var(--zsc-line); border-radius: 15px; background: #fff; }
  #zs-creator-{{ section.id }} .zs-creator__offer-card--gift { background: #f8f5ef; border-color: #e7ddcf; }
  #zs-creator-{{ section.id }} .zs-creator__card-number { color: #927b5e; font-size: 10px; font-weight: 700; letter-spacing: .15em; }
  #zs-creator-{{ section.id }} .zs-creator__card-icon { display: flex; width: 42px; height: 42px; margin: 20px 0 15px; align-items: center; justify-content: center; border: 1px solid #d9cbb8; border-radius: 50%; color: #8a7354; font-family: Georgia,serif; font-size: 23px; }
  #zs-creator-{{ section.id }} .zs-creator__offer-card h3 { margin: 0 0 10px; font-family: Georgia,serif; font-size: 23px; line-height: 1.2; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__offer-card p { margin: 0; color: var(--zsc-muted); font-size: 13px; line-height: 1.8; }
  #zs-creator-{{ section.id }} .zs-creator__fit { max-width: 1180px; margin: 0 auto 68px; padding: 38px; display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 42px; border-radius: 19px; background: #f6f3ed; }
  #zs-creator-{{ section.id }} .zs-creator__fit h2,
  #zs-creator-{{ section.id }} .zs-creator__expectations h2 { margin: 0 0 13px; font-family: Georgia,serif; font-size: clamp(28px,3.2vw,38px); line-height: 1.16; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__fit-copy > p:last-child,
  #zs-creator-{{ section.id }} .zs-creator__expectations > div:first-child > p:last-child { margin: 0; color: var(--zsc-muted); font-size: 14px; line-height: 1.85; }
  #zs-creator-{{ section.id }} .zs-creator__fit-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div { display: flex; gap: 12px; padding: 16px; border: 1px solid #e5dccf; border-radius: 12px; background: rgba(255,255,255,.68); }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div > span { color: #9a8061; font-size: 10px; font-weight: 700; letter-spacing: .08em; }
  #zs-creator-{{ section.id }} .zs-creator__fit-list p { margin: 0; color: var(--zsc-muted); font-size: 12px; line-height: 1.65; }
  #zs-creator-{{ section.id }} .zs-creator__fit-list strong { display: block; margin-bottom: 4px; color: var(--zsc-ink); font-size: 13px; }
  #zs-creator-{{ section.id }} .zs-creator__process { max-width: 1180px; margin: 0 auto 68px; padding: 0 20px; }
  #zs-creator-{{ section.id }} .zs-creator__section-heading { margin: 0 auto 25px; text-align: center; }
  #zs-creator-{{ section.id }} .zs-creator__steps { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  #zs-creator-{{ section.id }} .zs-creator__steps article { padding: 21px 19px; border-top: 1px solid #cdbda8; border-bottom: 1px solid var(--zsc-line); background: #fff; }
  #zs-creator-{{ section.id }} .zs-creator__steps article > span { color: #9a8061; font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  #zs-creator-{{ section.id }} .zs-creator__steps h3 { margin: 12px 0 7px; font-family: Georgia,serif; font-size: 22px; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__steps p { margin: 0; color: var(--zsc-muted); font-size: 13px; line-height: 1.75; }
  #zs-creator-{{ section.id }} .zs-creator__expectations { max-width: 1180px; margin: 0 auto 68px; padding: 32px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 35px; border: 1px solid var(--zsc-line); border-radius: 18px; }
  #zs-creator-{{ section.id }} .zs-creator__expectation-points { display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  #zs-creator-{{ section.id }} .zs-creator__expectation-points p { display: flex; gap: 10px; margin: 0; color: #554e44; font-size: 13px; line-height: 1.6; }
  #zs-creator-{{ section.id }} .zs-creator__expectation-points p span { color: #8b7659; font-weight: 700; }
  #zs-creator-{{ section.id }} .zs-creator__expectation-points .zs-creator__honesty { display: block; margin-top: 5px; padding: 13px 15px; border-radius: 9px; background: #f6f3ed; color: #655c50; font-size: 12px; }
  #zs-creator-{{ section.id }} .zs-creator__application { max-width: 1000px; margin: 0 auto 22px; padding: clamp(24px,4vw,42px); border-radius: 22px; background: linear-gradient(135deg,#f5f0e7,#eee6d9); }
  #zs-creator-{{ section.id }} .zs-creator__application-heading { max-width: 730px; margin: 0 auto 25px; text-align: center; }
  #zs-creator-{{ section.id }} .zs-creator__form { padding: clamp(18px,3vw,30px); border: 1px solid #e7ded2; border-radius: 16px; background: #fff; box-shadow: 0 12px 34px rgba(48,39,28,.055); }
  #zs-creator-{{ section.id }} .zs-creator__form-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 17px 16px; }
  #zs-creator-{{ section.id }} .zs-creator__field { min-width: 0; }
  #zs-creator-{{ section.id }} .zs-creator__field--full { grid-column: 1/-1; }
  #zs-creator-{{ section.id }} .zs-creator__field label { display: block; margin: 0 0 7px; color: #3c362f; font-size: 12px; font-weight: 650; }
  #zs-creator-{{ section.id }} .zs-creator__field label span { color: #9b624e; }
  #zs-creator-{{ section.id }} .zs-creator__field label small { color: #8b8277; font-size: 10px; font-weight: 400; }
  #zs-creator-{{ section.id }} .zs-creator__field input,
  #zs-creator-{{ section.id }} .zs-creator__field textarea { display: block; width: 100%; min-height: 47px; padding: 12px 13px; border: 1px solid #ddd5ca; border-radius: 7px; outline: none; background: #fff; color: #302b25; font: inherit; font-size: 13px; transition: border-color .18s ease,box-shadow .18s ease; }
  #zs-creator-{{ section.id }} .zs-creator__field textarea { min-height: 125px; resize: vertical; }
