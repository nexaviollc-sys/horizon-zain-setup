{%- liquid
  assign statue_product = all_products['handcrafted-wooden-horse-statue']
  assign statue_image = statue_product.featured_image
-%}

<section id="zs-creator-{{ section.id }}" class="zs-creator">
  <div class="zs-creator__hero">
    <div class="zs-creator__hero-copy">
      <p class="zs-creator__eyebrow">THE ZAISEN CREATOR PROGRAM</p>
      <h1>A handcrafted gift. <em>A story worth sharing.</em></h1>
      <p class="zs-creator__intro">We bring together thoughtful creators and handcrafted pieces made to be lived with. Selected partners receive a complimentary ZAISEN piece for their home, with standard delivery covered, and earn 8% commission on qualifying orders placed through their personal affiliate link.</p>
      <div class="zs-creator__benefits" aria-label="Creator partnership benefits">
        <span><i aria-hidden="true">✳</i> A complimentary ZAISEN gift</span>
        <span><i aria-hidden="true">✳</i> Standard delivery covered</span>
        <span><i aria-hidden="true">✳</i> 8% affiliate commission</span>
      </div>
      <div class="zs-creator__hero-actions">
        <a class="zs-creator__button" href="#creator-application">Apply to collaborate <span aria-hidden="true">→</span></a>
        <a class="zs-creator__text-link" href="/collections/all">Explore the collection</a>
      </div>
      <p class="zs-creator__hero-note">Applications are reviewed individually · UK, USA and selected European audiences are prioritised</p>
    </div>

    <div class="zs-creator__hero-visual">
      <div class="zs-creator__image-frame">
        {% if statue_image != blank %}
          {{ statue_image | image_url: width: 1600 | image_tag: class: 'zs-creator__hero-image', loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(max-width: 900px) 100vw, 48vw', alt: statue_product.title }}
        {% else %}
          <img class="zs-creator__hero-image" src="https://cdn.shopify.com/s/files/1/1019/0884/0741/files/WhatsApp_Image_2026-09-29_at_5.33.09_PM.jpg?v=1790935879" alt="ZAISEN handcrafted wooden horse statue" loading="eager">
        {% endif %}
        <div class="zs-creator__image-caption">
          <span>HANDCRAFTED WOODEN DECOR</span>
          <strong>A signature ZAISEN piece</strong>
        </div>
      </div>
      <div class="zs-creator__hero-stamp"><span>MADE WITH</span><strong>CARE</strong><span>SHARED WITH YOU</span></div>
    </div>
  </div>

  <div class="zs-creator__intro-band">
    <p class="zs-creator__eyebrow">A PARTNERSHIP, NOT JUST A POST</p>
    <h2>For the people who make a space feel like home.</h2>
    <p>From considered interiors to the small details that make a room personal, we look for creators who share our appreciation for natural materials, thoughtful design and pieces with a story.</p>
  </div>

  <div class="zs-creator__offer-grid">
    <article class="zs-creator__offer-card zs-creator__offer-card--gift">
      <span class="zs-creator__card-number">01 / THE GIFT</span>
      <div class="zs-creator__card-icon" aria-hidden="true">✳</div>
      <h3>A piece chosen for your home</h3>
      <p>If selected, you’ll receive a complimentary piece from the ZAISEN collection. We’ll agree on a design that feels right for your home and content, and cover standard delivery.</p>
    </article>
    <article class="zs-creator__offer-card">
      <span class="zs-creator__card-number">02 / YOUR EARNINGS</span>
      <div class="zs-creator__card-icon" aria-hidden="true">%</div>
      <h3>Earn 8% when your audience shops</h3>
      <p>Your personal affiliate link makes it easy to share the pieces you love. You’ll earn 8% commission on qualifying orders tracked through your link, with tracking and payout details confirmed before we begin.</p>
    </article>
    <article class="zs-creator__offer-card">
      <span class="zs-creator__card-number">03 / GROW TOGETHER</span>
      <div class="zs-creator__card-icon" aria-hidden="true">↗</div>
      <h3>More than a one-time collaboration</h3>
      <p>We’re here for genuine connections, not one-off posts. Creators whose work continues to resonate with ZAISEN may be considered for new collections, launches and future collaborations.</p>
    </article>
  </div>

  <div class="zs-creator__fit">
    <div class="zs-creator__fit-copy">
      <p class="zs-creator__eyebrow">WHO WE’D LOVE TO HEAR FROM</p>
      <h2>A point of view matters more than a number.</h2>
      <p>The right partnership begins with shared taste and an engaged community. We consider the quality of your content, audience location and the way your followers connect with you—not follower count alone.</p>
    </div>
    <div class="zs-creator__fit-list">
      <div><span>01</span><p><strong>Home & interior creators</strong>Room styling, home inspiration, décor finds and lived-in spaces.</p></div>
      <div><span>02</span><p><strong>Natural & handcrafted style</strong>Wood, artisan details, rustic textures and timeless pieces.</p></div>
      <div><span>03</span><p><strong>Relevant audiences</strong>Followers who enjoy home décor, thoughtful gifts and distinctive design.</p></div>
      <div><span>04</span><p><strong>Authentic storytelling</strong>Creators who share honest experiences and communicate clearly with their audience.</p></div>
    </div>
  </div>

  <div class="zs-creator__process">
    <div class="zs-creator__section-heading">
      <p class="zs-creator__eyebrow">HOW IT WORKS</p>
      <h2>A considered collaboration, from first hello to final post.</h2>
    </div>
    <div class="zs-creator__steps">
      <article><span>01</span><h3>Apply</h3><p>Tell us about your content, social profile and where your audience is based.</p></article>
      <article><span>02</span><h3>Get selected</h3><p>We review your application and contact you if we see a strong fit for ZAISEN.</p></article>
      <article><span>03</span><h3>Receive your gift</h3><p>We choose a piece together, confirm the collaboration details and arrange your complimentary delivery.</p></article>
      <article><span>04</span><h3>Share & earn</h3><p>Share your honest experience, introduce your personal link and earn 8% on qualifying referred orders.</p></article>
    </div>
  </div>

  <div class="zs-creator__expectations">
    <div>
      <p class="zs-creator__eyebrow">CLEAR FROM THE START</p>
      <h2>Thoughtfully planned. Clearly agreed. Never complicated.</h2>
      <p>Every partnership is personal. Before your gift is dispatched, we’ll confirm the product, delivery destination, agreed content, posting timeline and affiliate terms together—so everything is clear from the beginning.</p>
    </div>
    <div class="zs-creator__expectation-points">
      <p><span>✓</span> An agreed Reel, post, Story or unboxing feature</p>
      <p><span>✓</span> A genuine introduction to ZAISEN and the gifted product</p>
      <p><span>✓</span> Your personal affiliate link for tracking referred orders</p>
      <p><span>✓</span> Clear disclosure of gifted products and affiliate commission</p>
      <p class="zs-creator__honesty">We welcome honest opinions. A positive review is never required.</p>
    </div>
  </div>

  <div id="creator-application" class="zs-creator__application">
    <div class="zs-creator__application-heading">
      <p class="zs-creator__eyebrow">LET’S GET TO KNOW YOU</p>
      <h2>Let’s create something worth sharing.</h2>
      <p>Tell us a little about your work, your audience and what draws you to ZAISEN. If it feels like a natural fit, our team will be in touch to discuss your complimentary piece and collaboration.</p>
    </div>

    {% form 'contact', id: 'zs-creator-application-form', class: 'zs-creator__form' %}
      {% if form.posted_successfully? %}
        <div class="zs-creator__success" role="status">
          <strong>Thank you for applying.</strong>
          <span>Your application has been received. The ZAISEN team will review your details and contact you if there’s a suitable opportunity.</span>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="zs-creator__errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="zs-creator__form-grid">
          <div class="zs-creator__field">
            <label for="zs-creator-name">Your name <span>*</span></label>
            <input id="zs-creator-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" placeholder="Full name" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-email">Email address <span>*</span></label>
            <input id="zs-creator-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" placeholder="you@example.com" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-profile">Instagram, TikTok or YouTube profile <span>*</span></label>
            <input id="zs-creator-profile" type="url" name="contact[Social profile]" placeholder="https://..." required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-country">Where are you based? <span>*</span></label>
            <input id="zs-creator-country" type="text" name="contact[Country]" autocomplete="country-name" placeholder="Country" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-followers">Approximate follower count <span>*</span></label>
            <input id="zs-creator-followers" type="text" name="contact[Follower count]" placeholder="e.g. 8,500" required>
          </div>
          <div class="zs-creator__field">
            <label for="zs-creator-audience">Where is most of your audience based? <span>*</span></label>
            <input id="zs-creator-audience" type="text" name="contact[Audience countries]" placeholder="e.g. UK, USA, Germany" required>
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-product">Which ZAISEN product would you love to feature? <small>Optional</small></label>
            <input id="zs-creator-product" type="text" name="contact[Product of interest]" placeholder="Product name or link">
          </div>
          <div class="zs-creator__field zs-creator__field--full">
            <label for="zs-creator-message">Tell us about your content and your audience <span>*</span></label>
            <textarea id="zs-creator-message" name="contact[body]" rows="5" placeholder="What do you create, who follows you, and how would you feature ZAISEN?" required></textarea>
          </div>
        </div>
        <div class="zs-creator__form-footer">
          <p>Submitting an application does not guarantee selection or a gifted product. We’ll confirm product availability, delivery details and collaboration expectations with selected creators before dispatch.</p>
          <button type="submit" class="zs-creator__button">Submit application <span aria-hidden="true">→</span></button>
        </div>
      {% endif %}
    {% endform %}
  </div>

  <p class="zs-creator__disclosure">Creators must clearly disclose gifted products and affiliate relationships in line with the rules that apply in their country. Standard delivery is covered for approved collaborations. Any applicable destination-specific import charges will be discussed before shipment.</p>
</section>

<style>
  #zs-creator-{{ section.id }} {
    --zsc-ink: #28221d;
    --zsc-muted: #665d53;
    --zsc-walnut: #77523a;
    --zsc-brass: #b69a6a;
    --zsc-line: #ded6ca;
    --zsc-paper: #f7f4ee;
    --zsc-cream: #eee7dc;
    --zsc-heading: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    --zsc-body: var(--font-body--family, "Inter", Arial, sans-serif);
    color: var(--zsc-ink);
    font-family: var(--zsc-body);
    padding: clamp(24px, 4.5vw, 62px) 0 38px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #zs-creator-{{ section.id }} * { box-sizing: border-box; }
  #zs-creator-{{ section.id }} :is(h1,h2,h3) {
    color: var(--zsc-ink); font-family: var(--zsc-heading);
    font-weight: 500; text-wrap: balance;
  }
  #zs-creator-{{ section.id }} p { text-wrap: pretty; }
  #zs-creator-{{ section.id }} .zs-creator__eyebrow {
    display: flex; align-items: center; gap: 12px;
    margin: 0 0 17px; color: var(--zsc-walnut);
    font-family: var(--zsc-body); font-size: 10px; line-height: 1.5;
    font-weight: 650; letter-spacing: .22em; text-transform: uppercase;
  }
  #zs-creator-{{ section.id }} .zs-creator__eyebrow::before {
    content: ""; display: inline-block; width: 27px; height: 1px;
    flex: 0 0 27px; background: var(--zsc-brass);
  }
  #zs-creator-{{ section.id }} .zs-creator__hero {
    position: relative; isolation: isolate; overflow: hidden;
    max-width: 1320px; margin: 0 auto 82px;
    padding: clamp(34px, 5.2vw, 76px);
    border: 1px solid #e8dfd2; border-radius: 5px;
    background:
      radial-gradient(ellipse at 7% 92%, rgba(182,154,106,.13), transparent 34%),
      linear-gradient(118deg, #f8f5ef 0%, #f0e9de 58%, #eae0d2 100%);
    display: grid; grid-template-columns: minmax(0,1.06fr) minmax(330px,.94fr);
    gap: clamp(35px,5vw,78px); align-items: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero::before {
    content: "Z"; position: absolute; z-index: -1; left: 39%; bottom: -23%;
    color: rgba(119,82,58,.035); font-family: var(--zsc-heading);
    font-size: clamp(250px,35vw,510px); line-height: 1; pointer-events: none;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero h1 {
    max-width: 650px; margin: 0 0 22px;
    font-size: clamp(52px,6.3vw,84px); line-height: .96;
    font-weight: 500; letter-spacing: -.045em;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero h1 em {
    display: block; color: var(--zsc-walnut); font-weight: 400;
    font-style: italic; letter-spacing: -.04em;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro {
    max-width: 570px; margin: 0; color: #5f564d;
    font-family: var(--zsc-body); font-size: 15px;
    line-height: 1.9; letter-spacing: .005em;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits {
    display: flex; flex-wrap: wrap; gap: 8px; margin: 25px 0 29px;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits span {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 13px; border: 1px solid rgba(119,82,58,.15);
    border-radius: 3px; background: rgba(255,255,255,.62);
    color: #51463b; font-size: 11px; line-height: 1.4; letter-spacing: .015em;
  }
  #zs-creator-{{ section.id }} .zs-creator__benefits i { color: var(--zsc-brass); font-style: normal; font-size: 13px; }
  #zs-creator-{{ section.id }} .zs-creator__hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
  #zs-creator-{{ section.id }} .zs-creator__button {
    display: inline-flex; justify-content: center; align-items: center; gap: 24px;
    min-height: 52px; padding: 14px 22px; border: 1px solid var(--zsc-walnut);
    border-radius: 2px; background: var(--zsc-walnut); color: #fff;
    font-family: var(--zsc-body); font-size: 11px; font-weight: 650;
    letter-spacing: .11em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; transition: background .22s ease, color .22s ease, transform .22s ease;
  }
  #zs-creator-{{ section.id }} .zs-creator__button:hover { background: #5d3f2d; border-color: #5d3f2d; transform: translateY(-2px); }
  #zs-creator-{{ section.id }} .zs-creator__text-link {
    color: #51463b; font-size: 11px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; text-decoration: none; border-bottom: 1px solid #b69a6a; padding-bottom: 5px;
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-note { margin: 20px 0 0; color: #776d61; font-size: 10px; line-height: 1.7; letter-spacing: .045em; }
  #zs-creator-{{ section.id }} .zs-creator__hero-visual {
    position: relative; max-width: 570px; width: 100%; justify-self: end;
    padding: 9px; border: 1px solid rgba(119,82,58,.17); border-radius: 3px;
    background: rgba(255,255,255,.72); box-shadow: 0 25px 65px rgba(55,42,28,.13);
  }
  #zs-creator-{{ section.id }} .zs-creator__image-frame { position: relative; overflow: hidden; border-radius: 1px; background: #e7dfd2; }
  #zs-creator-{{ section.id }} .zs-creator__hero-image {
    display: block; width: 100%; height: clamp(390px,47vw,590px);
    object-fit: cover; object-position: center; filter: saturate(.94) contrast(1.025);
  }
  #zs-creator-{{ section.id }} .zs-creator__image-caption {
    position: absolute; right: 14px; bottom: 14px; left: 14px;
    display: flex; flex-direction: column; gap: 6px; padding: 17px 19px;
    border: 1px solid rgba(255,255,255,.28); border-radius: 2px;
    background: rgba(40,34,29,.76); color: #fff; backdrop-filter: blur(9px);
  }
  #zs-creator-{{ section.id }} .zs-creator__image-caption span { font-family: var(--zsc-body); font-size: 8px; font-weight: 650; letter-spacing: .2em; opacity: .83; }
  #zs-creator-{{ section.id }} .zs-creator__image-caption strong { font-family: var(--zsc-heading); font-size: 25px; line-height: 1.05; font-weight: 500; letter-spacing: .005em; }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp {
    position: absolute; top: 27px; left: -27px; display: flex;
    width: 94px; height: 94px; flex-direction: column; justify-content: center; align-items: center;
    border: 1px solid #c8b18c; border-radius: 50%; outline: 4px solid rgba(247,244,238,.92);
    background: #f7f3eb; color: var(--zsc-walnut); box-shadow: 0 8px 20px rgba(50,38,25,.08); transform: rotate(-8deg);
  }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp span { font-family: var(--zsc-body); font-size: 7px; font-weight: 600; letter-spacing: .13em; }
  #zs-creator-{{ section.id }} .zs-creator__hero-stamp strong { margin: 1px 0; font-family: var(--zsc-heading); font-size: 27px; line-height: 1; font-weight: 500; }

  #zs-creator-{{ section.id }} .zs-creator__intro-band {
    position: relative; max-width: 820px; margin: 0 auto 52px;
    padding: 0 24px 27px; text-align: center;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band::after {
    content: "✳"; position: absolute; bottom: -1px; left: 50%;
    padding: 0 13px; background: #fff; color: var(--zsc-brass);
    font-size: 13px; transform: translateX(-50%);
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band .zs-creator__eyebrow,
  #zs-creator-{{ section.id }} .zs-creator__section-heading .zs-creator__eyebrow,
  #zs-creator-{{ section.id }} .zs-creator__application-heading .zs-creator__eyebrow { justify-content: center; }
  #zs-creator-{{ section.id }} .zs-creator__intro-band h2,
  #zs-creator-{{ section.id }} .zs-creator__section-heading h2,
  #zs-creator-{{ section.id }} .zs-creator__application-heading h2 {
    margin: 0 0 14px; font-size: clamp(38px,4.5vw,56px);
    line-height: 1.02; font-weight: 500; letter-spacing: -.035em;
  }
  #zs-creator-{{ section.id }} .zs-creator__intro-band > p:last-child,
  #zs-creator-{{ section.id }} .zs-creator__application-heading > p:last-child {
    max-width: 690px; margin: 0 auto; color: var(--zsc-muted);
    font-family: var(--zsc-body); font-size: 14px; line-height: 1.9;
  }

  #zs-creator-{{ section.id }} .zs-creator__offer-grid {
    max-width: 1210px; margin: 0 auto 82px; padding: 0 20px;
    display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card {
    position: relative; min-height: 278px; overflow: hidden;
    padding: 27px 26px 30px; border: 1px solid #e7e0d6;
    border-radius: 3px; background: linear-gradient(145deg,#fff 0%,#fcfbf8 100%);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card:hover {
    transform: translateY(-4px); border-color: #d4c3aa; box-shadow: 0 15px 34px rgba(52,41,29,.07);
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card::after {
    content: ""; position: absolute; top: 0; left: 0; width: 58px; height: 2px; background: var(--zsc-brass);
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card--gift {
    background: linear-gradient(145deg,#f8f5ef 0%,#f0e9de 100%); border-color: #e2d7c8;
  }
  #zs-creator-{{ section.id }} .zs-creator__card-number { color: #8a7256; font-family: var(--zsc-body); font-size: 9px; font-weight: 700; letter-spacing: .18em; }
  #zs-creator-{{ section.id }} .zs-creator__card-icon {
    display: flex; width: 47px; height: 47px; margin: 24px 0 16px;
    align-items: center; justify-content: center; border: 1px solid #d6c5ad;
    border-radius: 50%; color: var(--zsc-walnut); font-family: var(--zsc-heading); font-size: 26px; line-height: 1;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card h3 {
    max-width: 300px; margin: 0 0 11px; font-size: 29px; line-height: 1.02; font-weight: 500; letter-spacing: -.02em;
  }
  #zs-creator-{{ section.id }} .zs-creator__offer-card p { margin: 0; color: var(--zsc-muted); font-family: var(--zsc-body); font-size: 12px; line-height: 1.85; }

  #zs-creator-{{ section.id }} .zs-creator__fit {
    max-width: 1210px; margin: 0 auto 82px; padding: clamp(28px,4.5vw,55px);
    display: grid; grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr);
    gap: clamp(28px,4.5vw,62px); align-items: center;
    border: 1px solid #e8e0d5; border-radius: 3px;
    background: radial-gradient(ellipse at 100% 0%,rgba(182,154,106,.12),transparent 42%), #f7f4ee;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit h2,
  #zs-creator-{{ section.id }} .zs-creator__expectations h2 {
    margin: 0 0 17px; font-size: clamp(37px,4vw,51px); line-height: 1.02; font-weight: 500; letter-spacing: -.035em;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-copy > p:last-child,
  #zs-creator-{{ section.id }} .zs-creator__expectations > div:first-child > p:last-child {
    margin: 0; color: var(--zsc-muted); font-family: var(--zsc-body); font-size: 13px; line-height: 1.9;
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 11px; }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div {
    display: flex; gap: 13px; padding: 18px 16px;
    border: 1px solid rgba(119,82,58,.13); border-radius: 2px; background: rgba(255,255,255,.72);
  }
  #zs-creator-{{ section.id }} .zs-creator__fit-list > div > span {
