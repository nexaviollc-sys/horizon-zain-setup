      background: #a27c57;
    }
    .zs-workshop__intro {
      max-width: 47ch;
      margin: 16px 0 0;
      color: #635449;
      font: 400 13px/1.7 var(--font-body--family), sans-serif;
    }
    .zs-workshop__steps {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 90%;
      align-items: stretch;
      gap: 11px;
      margin: 0 -3px;
      padding: 4px 3px 11px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 3px;
      scrollbar-width: thin;
      scrollbar-color: #b79876 transparent;
    }
    .zs-workshop__step,
    .zs-workshop__step:first-child {
      position: relative;
      display: grid;
      grid-template-columns: clamp(82px, 27vw, 112px) minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      min-width: 0;
      min-height: 154px;
      height: auto;
      padding: 11px;
      margin: 0;
      border: 1px solid #e1d1bd;
      border-left: 3px solid #9a7754;
      border-radius: 9px;
      background: #fffdf9;
      box-shadow: 0 5px 14px rgba(61, 40, 23, .06);
      scroll-snap-align: start;
    }
    .zs-workshop__step:nth-child(2) {
      border-left-color: #b48d68;
      background: #fffaf4;
    }
    .zs-workshop__step:nth-child(3) {
      border-left-color: #806146;
      background: #fcf7ef;
    }
    .zs-workshop__illustration,
    .zs-workshop__photo {
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      padding: 0;
      margin: 0;
      border: 1px solid #e5d6c3;
      border-radius: 4px;
      background: #f4eadd;
      color: #866b51;
      overflow: hidden;
    }
    .zs-workshop__photo {
      padding: 4px;
      background: #fffaf4;
      box-shadow: inset 0 0 0 4px #fffaf4;
    }
    .zs-workshop__photo img {
      position: absolute;
      inset: 4px;
      width: calc(100% - 8px);
      height: calc(100% - 8px);
      object-fit: cover;
    }
    .zs-workshop__illustration {
      background: repeating-radial-gradient(
        ellipse at 50% 50%, #f7eee2 0, #f7eee2 8px,
        #e9d8c4 9px, #f7eee2 11px, #f7eee2 18px
      );
    }
    .zs-workshop__illustration svg { display: none; }
    .zs-workshop__process-mark {
      position: relative;
      display: grid;
      place-items: center;
      flex: 0 0 56px;
      width: 56px;
      height: 56px;
      border: 1px solid #c5a989;
      border-radius: 50%;
      background: rgba(255, 253, 247, .96);
      color: #705137;
      font: 400 29px/1 var(--font-heading--family), Georgia, serif;
      box-shadow: 0 3px 11px rgba(57, 38, 20, .08);
    }
    .zs-workshop__number {
      position: static;
      display: block;
      width: auto;
      height: auto;
      padding: 0;
      margin: 0 0 7px;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: #916d4e;
      font: 750 9px/1.4 var(--font-body--family), sans-serif;
      letter-spacing: .12em;
    }
    .zs-workshop__number::before {
      content: "STEP ";
      letter-spacing: .12em;
    }
    .zs-workshop__step-copy {
      align-self: center;
      min-width: 0;
      padding: 0;
    }
    .zs-workshop h3 {
      max-width: 18ch;
      margin: 0 0 7px;
      color: #3d2b1e;
      font: 500 clamp(16px, 4.5vw, 20px)/1.2 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.02em;
    }
    .zs-workshop__step p {
      margin: 0;
      max-width: 28ch;
      color: #685647;
      font: 400 11.5px/1.55 var(--font-body--family), sans-serif;
    }
    .zs-workshop__swipe-note {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 10px 5px 0;
      color: #8f6f50;
      font: 750 9px/1.5 var(--font-body--family), sans-serif;
      letter-spacing: .11em;
    }
    .zs-workshop__swipe-note span:last-child {
      color: #6a523d;
      letter-spacing: .06em;
    }
    .zs-workshop__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 47px;
      margin: 23px 0 0;
      padding: 8px 10px 8px 16px;
      border: 1px solid #c7ae90;
      border-radius: 8px;
      background: #fffdf9;
      color: #493220;
      font-size: 12px;
      font-weight: 750;
      box-shadow: 0 3px 10px rgba(60, 39, 20, .04);
    }
    .zs-workshop__link span {
      flex: 0 0 30px;
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: #493320;
      color: white;
    }
  }
  @media screen and (max-width: 350px) {
    .zs-workshop { padding-inline: 10px; }
    .zs-workshop__inner { padding-inline: 10px; }
    .zs-workshop__steps { grid-auto-columns: 95%; }
    .zs-workshop__step { grid-template-columns: 75px minmax(0, 1fr); gap: 9px; padding: 9px; }
    .zs-workshop__process-mark { width: 46px; height: 46px; font-size: 25px; }
    .zs-workshop h3 { font-size: 16px; }
    .zs-workshop__step p { font-size: 11px; }
  }

{% endstylesheet %}
{% schema %}
{
  "name":"ZAISEN Workshop Journey",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Small heading","default":"THE CARE BEHIND EVERY PIECE"},
    {"type":"text","id":"heading","label":"Heading","default":"From Our Workshop to Your Home"},
    {"type":"text","id":"intro","label":"Introduction","default":"Natural wood, thoughtful handwork, and care in every detail. A closer look at the journey behind your ZAISEN piece."},
    {"type":"url","id":"link","label":"Story link"},
    {"type":"text","id":"link_label","label":"Link label","default":"Discover our story"}
  ],
  "max_blocks":3,
  "blocks":[{
