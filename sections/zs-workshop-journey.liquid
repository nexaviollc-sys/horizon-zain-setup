    }
    .zs-workshop h2 {
      max-width: 18ch;
      margin: 0;
      color: #34251b;
      font: 400 clamp(29px, 7.5vw, 39px)/1.13 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.028em;
