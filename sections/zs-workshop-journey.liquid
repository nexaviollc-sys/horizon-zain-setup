<section class="zs-workshop" aria-labelledby="zs-workshop-title-{{ section.id }}">
  <div class="zs-workshop__inner">
    <header class="zs-workshop__header">
      <div>
        <p class="zs-workshop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="zs-workshop-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <p class="zs-workshop__intro">{{ section.settings.intro | escape }}</p>
    </header>
    <ol class="zs-workshop__steps" tabindex="0" aria-labelledby="zs-workshop-title-{{ section.id }}">
      {% for block in section.blocks %}
        <li class="zs-workshop__step" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="zs-workshop__photo">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 750px) 30vw, 90vw', alt: block.settings.heading }}
            </div>
          {% else %}
            <div class="zs-workshop__illustration" aria-hidden="true">
              <span class="zs-workshop__process-mark">0{{ forloop.index }}</span>
              <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                {% case block.settings.icon %}
                  {% when 'wood' %}
                    <path d="M24 57 76 23l22 15-52 34Z M24 57V42l52-34 22 15v15 M46 72V57l52-34 M24 42l22 15"/>
                    <path d="m36 41 36-23m-24 29 37-24m-29 29 36-24m-36 34 32-21"/>
                    <ellipse cx="62" cy="34" rx="9" ry="3" transform="rotate(-33 62 34)"/>
                  {% when 'craft' %}
                    <path d="M22 61h75M30 57c4-19 20-27 37-24 14 3 23 11 27 24H30Z M35 62v8h53v-8"/>
                    <path d="m61 29 18-18 9 9-18 18m3-21 9 9M52 40c13-2 23 2 29 10M44 48c6-3 12-3 19-1"/>
                    <path d="m48 23 2-7m-12 13-7-2m13 7-5 5"/>
                  {% else %}
                    <path d="m26 31 34-15 34 15-34 16Z M26 31v32l34 15 34-15V31 M60 47v31 M43 23l34 16v16l-9-4V43"/>
                    <path d="m37 59 12 5m-12 0 7 3 M84 13l4 4 8-9"/>
                {% endcase %}
              </svg>
            </div>
          {% endif %}
          <div class="zs-workshop__step-copy">
            <span class="zs-workshop__number" aria-hidden="true">0{{ forloop.index }}</span>
            <div>
              <h3>{{ block.settings.heading | escape }}</h3>
              <p>{{ block.settings.description | escape }}</p>
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
    {% if section.blocks.size > 1 %}
      <p class="zs-workshop__swipe-note" aria-hidden="true">
        <span>SWIPE TO EXPLORE</span>
        <span>01 / 0{{ section.blocks.size }}</span>
      </p>
    {% endif %}
    {% if section.settings.link != blank %}
      <a class="zs-workshop__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>
    {% endif %}
  </div>
</section>
{% stylesheet %}

  .zs-workshop {
    padding:20px clamp(20px,4vw,64px) clamp(44px,5vw,72px);
    background:#fff; color:#31271e;
  }
  .zs-workshop *, .zs-workshop *::before, .zs-workshop *::after { box-sizing:border-box; }
  .zs-workshop__inner {
    max-width:1280px; margin-inline:auto;
    padding:clamp(24px,3.5vw,48px); border-radius:30px; background:#f5f0e9;
  }
  .zs-workshop__header {
    display:grid; grid-template-columns:1.2fr 1fr; gap:clamp(24px,4vw,60px);
    align-items:end; margin-bottom:30px;
  }
  .zs-workshop__eyebrow {
    display:inline-flex; margin:0 0 16px; padding:8px 12px;
    border-radius:100px; background:#e7dccd; color:#60462f;
    font:600 9px/1.4 var(--font-body--family),sans-serif; letter-spacing:.055em;
  }
  .zs-workshop h2 {
    max-width:22ch; margin:0;
    font:650 clamp(28px,3vw,44px)/1.1 var(--font-body--family),sans-serif;
    letter-spacing:-.045em; text-wrap:balance;
  }
  .zs-workshop__intro {
    max-width:40ch; margin:0; justify-self:end;
    font:400 14px/1.7 var(--font-body--family),sans-serif; color:#685f55;
  }
  .zs-workshop__steps {
    display:grid; grid-template-columns:repeat(3,minmax(0,1fr));
    gap:18px; list-style:none; padding:0; margin:0;
  }
  .zs-workshop__step {
    position:relative; min-width:0; margin:0; padding:10px;
    border-radius:22px; background:#fff;
  }
  .zs-workshop__illustration, .zs-workshop__photo {
    display:grid; place-items:center; position:relative;
    width:100%; aspect-ratio:1 / 1; height:auto;
    overflow:hidden; border-radius:14px; margin:0;
    background:#f7f4ee; color:#8c6b4b;
  }
  .zs-workshop__illustration svg { width:52%; height:auto; max-height:56%; }
  .zs-workshop__photo img {
    position:absolute; inset:0; display:block;
    width:100%; height:100%; object-fit:contain; object-position:center;
  }
  .zs-workshop__step-copy { display:block; padding:20px 10px 14px; }
  .zs-workshop__number {
    position:absolute; top:22px; left:22px; z-index:1;
    display:grid; place-items:center; width:34px; height:34px;
    border-radius:50%; background:#fff; color:#60462f;
    box-shadow:0 2px 12px rgba(55,36,18,.08);
    font:650 11px/1 var(--font-body--family),sans-serif;
  }
  .zs-workshop h3 {
    margin:0 0 10px; color:#31271e;
    font:650 clamp(18px,1.6vw,23px)/1.2 var(--font-body--family),sans-serif;
    letter-spacing:-.035em; text-wrap:balance;
  }
  .zs-workshop__step p {
    margin:0; max-width:34ch; color:#685f55;
    font:400 13px/1.7 var(--font-body--family),sans-serif;
  }
  .zs-workshop__link {
    display:flex; align-items:center; justify-content:space-between; gap:24px;
    width:fit-content; min-width:232px; min-height:54px;
    margin:30px auto 0; padding:8px 8px 8px 20px;
    border:1px solid #ded3c5; border-radius:16px;
    background:#fff; color:#433225; text-decoration:none;
    box-shadow:0 3px 8px rgba(67,50,37,.035);
    font:600 13px/1.4 var(--font-body--family),sans-serif;
    letter-spacing:-.01em;
    transition:background-color .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .zs-workshop__link span {
    display:grid; place-items:center; flex:0 0 36px;
    width:36px; height:36px; border-radius:11px;
    background:#433225; color:#fff; font-size:20px; line-height:1;
    transition:background-color .18s ease;
  }
  @media (hover:hover) {
    .zs-workshop__link:hover {
      background:#fffdf9; border-color:#af9478;
      box-shadow:0 5px 14px rgba(67,50,37,.08);
    }
    .zs-workshop__link:hover span { background:#765437; }
  }
  @media (prefers-reduced-motion:reduce) {
    .zs-workshop__link, .zs-workshop__link span { transition:none; }
  }
  .zs-workshop__link:focus-visible, .zs-workshop__steps:focus-visible {
    outline:2px solid #927252; outline-offset:5px;
  }
  @media(max-width:749px) {
    .zs-workshop { padding:8px 16px 36px; }
    .zs-workshop__inner { padding:24px 14px 22px; border-radius:26px; }
    .zs-workshop__header { display:block; margin:0 6px 24px; }
    .zs-workshop__eyebrow { font-size:8px; margin-bottom:15px; padding:7px 10px; }
    .zs-workshop h2 { max-width:20ch; font-size:clamp(27px,7.2vw,34px); line-height:1.12; }
    .zs-workshop__intro { margin-top:15px; max-width:100%; font-size:13px; line-height:1.65; }
    .zs-workshop__steps {
      display:grid; grid-template-columns:none; grid-auto-flow:column;
      grid-auto-columns:88%; align-items:stretch; gap:12px;
      overflow-x:auto; overscroll-behavior-inline:contain;
      scroll-snap-type:x mandatory; scroll-padding-inline:0;
      scrollbar-width:thin; scrollbar-color:#b19a82 transparent;
      padding:0 0 12px;
    }
    .zs-workshop__step { scroll-snap-align:start; padding:8px; border-radius:20px; }
    .zs-workshop__illustration, .zs-workshop__photo { border-radius:13px; aspect-ratio:1 / 1; }
    .zs-workshop__number { top:19px; left:19px; width:30px; height:30px; font-size:10px; }
    .zs-workshop__step-copy { padding:18px 10px 14px; }
    .zs-workshop h3 { font-size:22px; }
    .zs-workshop__step p { font-size:13px; line-height:1.65; }
    .zs-workshop__link { width:100%; min-width:0; margin:22px auto 0; padding:8px 8px 8px 18px; }
  }

  /* 2026 editorial workshop: original mobile carousel remains untouched. */
  .zs-workshop__process-mark { display: none; }
  @media screen and (min-width: 1024px) {
    .zs-workshop {
      padding: clamp(66px, 7vw, 110px) clamp(24px, 4vw, 64px);
      background: #fff;
    }
    .zs-workshop__inner {
      display: grid;
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      grid-template-areas: 'intro process' 'story-link process';
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: clamp(60px, 7.5vw, 120px);
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: clamp(32px, 4vw, 58px) 0 clamp(34px, 4vw, 60px);
      border-top: 1px solid #e7ded3;
      border-bottom: 1px solid #e7ded3;
      border-radius: 0;
      background: transparent;
    }
    .zs-workshop__header {
      grid-area: intro;
      display: block;
      min-width: 0;
      margin: 0;
    }
    .zs-workshop__eyebrow {
      display: block;
      width: fit-content;
      margin: 0 0 22px;
      padding: 0;
      background: transparent;
      border-radius: 0;
      color: #936d4d;
      font: 700 10px/1.45 var(--font-body--family), sans-serif;
      letter-spacing: .17em;
    }
    .zs-workshop h2 {
      max-width: 15ch;
      margin: 0;
      color: #30271e;
      font: 400 clamp(38px, 3.8vw, 58px)/1.11 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.033em;
      text-wrap: balance;
    }
    .zs-workshop__intro {
      justify-self: unset;
      max-width: 41ch;
      margin: 26px 0 0;
      color: #62574c;
      font: 400 clamp(14px, 1.08vw, 16px)/1.76 var(--font-body--family), sans-serif;
    }
    .zs-workshop__steps {
      grid-area: process;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-flow: row;
      gap: 0;
      align-self: stretch;
      height: auto;
      min-width: 0;
      padding: 0 0 0 clamp(24px, 3.1vw, 48px);
      margin: 0;
      border-left: 1px solid #e7ddd0;
      list-style: none;
      overflow: visible;
    }
    .zs-workshop__step {
      position: relative;
      display: grid;
      grid-template-columns: minmax(96px, 125px) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(18px, 2vw, 30px);
      min-width: 0;
      min-height: 157px;
      padding: 19px 0;
      margin: 0;
      border: 0;
      border-bottom: 1px solid #e8dfd4;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .zs-workshop__step:first-child { border-top: 1px solid #e8dfd4; }
    .zs-workshop__illustration,
    .zs-workshop__photo {
      display: grid;
      position: relative;
      place-items: center;
      width: 100%;
      height: auto;
      aspect-ratio: 6 / 5;
      padding: 0;
      margin: 0;
      border: 1px solid #e5d9ca;
      border-radius: 3px;
      background: #f6f1e9;
      color: #906c4e;
      overflow: hidden;
    }
    .zs-workshop__illustration {
      background: #f7f4ee;
      border-color: #ede5da;
    }
    .zs-workshop__illustration svg { display: none; }
    .zs-workshop__process-mark {
      display: block;
      color: #a68c72;
      font: 400 clamp(36px, 3.7vw, 54px)/1 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.055em;
    }
    .zs-workshop__photo img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .zs-workshop__step-copy {
      display: block;
      padding: 0;
      min-width: 0;
      align-self: center;
    }
    .zs-workshop__number {
      position: static;
      display: block;
      width: auto;
      height: auto;
      margin-bottom: 8px;
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
      color: #967459;
      font: 700 10px/1.5 var(--font-body--family), sans-serif;
      letter-spacing: .12em;
    }
    .zs-workshop h3 {
      max-width: 22ch;
      margin: 0 0 8px;
      font: 400 clamp(20px, 1.7vw, 26px)/1.24 var(--font-heading--family), Georgia, serif;
      letter-spacing: -.019em;
      color: #3a2b20;
    }
    .zs-workshop__step p {
      max-width: 43ch;
      color: #675a4d;
      font: 400 clamp(12px, .96vw, 14px)/1.68 var(--font-body--family), sans-serif;
    }
    .zs-workshop__link {
      grid-area: story-link;
      display: inline-flex;
      justify-content: flex-start;
      align-items: center;
      gap: 15px;
      justify-self: start;
      align-self: start;
      width: auto;
      min-width: 0;
      min-height: 42px;
      margin: 33px 0 0;
      padding: 0 0 8px;
      border: 0;
      border-bottom: 1px solid #9a795c;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: #4e3525;
      font: 700 13px/1.45 var(--font-body--family), sans-serif;
      letter-spacing: .015em;
    }
    .zs-workshop__link span {
      flex: 0 0 auto;
      width: 27px;
      height: 27px;
      border-radius: 50%;
      background: #443126;
      font-size: 16px;
    }
    .zs-workshop__link:hover {
      background: transparent;
      border-color: #654832;
      box-shadow: none;
    }
    .zs-workshop__link:hover span { background: #6f4e35; }
  }
  @media screen and (min-width: 1024px) and (max-width: 1140px) {
    .zs-workshop__inner { column-gap: 44px; }
    .zs-workshop__steps { padding-left: 24px; }
    .zs-workshop__step { grid-template-columns: 96px minmax(0,1fr); gap: 18px; }
    .zs-workshop h3 { font-size: 20px; }
  }


  /* ZAISEN workshop editorial finish v2 — layered wood-tone process notes, desktop only. */
  @media screen and (min-width: 1024px) {
