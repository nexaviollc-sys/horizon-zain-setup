      height: 32px;
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1140px) {
    .zs-workshop__inner { column-gap: 35px; padding: 38px 30px; }
    .zs-workshop__step,
    .zs-workshop__step:first-child { grid-template-columns: 95px minmax(0, 1fr); gap: 15px; }
    .zs-workshop__step { padding: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zs-workshop__step { transition: none; }
    .zs-workshop__step:hover { transform: none; }
  }


  /* ZAISEN mobile craft-process refinement — swipeable tactile steps. */
  .zs-workshop__swipe-note { display: none; }
