{%- comment -%}   ZAISEN · Best Sellers   Editorial layout: sticky intro column + staggered 2-column product grid.   No boxed cards. Hairlines, numerals and whitespace do the structuring. {%- endcomment -%}  {%- liquid   assign s = section.settings   assign cta_link = s.button_link | default: routes.all_products_collection_url -%}  <section   class="zbs color-{{ s.color_scheme }}{% if s.show_divider %} zbs--divider{% endif %}"   data-layout="{{ s.layout }}"   data-index="{{ s.show_index }}"   data-swap="{{ s.hover_swap }}"   data-reveal="{{ s.enable_reveal }}"   style="     --zbs-pt: {{ s.padding_top }}px;     --zbs-pb: {{ s.padding_bottom }}px;     --zbs-stagger: {{ s.stagger }}px;     --zbs-stagger-m: {{ s.stagger | divided_by: 3 }}px;     --zbs-heading-size: {{ s.heading_size }}px;   " >   <div class="zbs__inner">      <div class="zbs__intro">       <header class="zbs__header">         {%- if s.eyebrow != blank -%}           <p class="zbs__eyebrow">{{ s.eyebrow }}</p>         {%- endif -%}          {%- if s.heading != blank -%}           <h2 class="zbs__heading">{{ s.heading }}</h2>         {%- endif -%}          {%- if s.text != blank -%}           <div class="zbs__text">{{ s.text }}</div>         {%- endif -%}       </header>        {%- if s.button_label != blank -%}         <a href="{{ cta_link }}" class="zbs__cta zbs__cta--{{ s.button_style }}">           <span>{{ s.button_label }}</span>           <svg class="zbs__arrow" width="34" height="10" viewBox="0 0 34 10" fill="none" aria-hidden="true">             <path d="M0 5h33M29 1l4 4-4 4" stroke="currentColor" stroke-width="1"/>           </svg>         </a>       {%- endif -%}     </div>      <div class="zbs__products">       {%- for block in section.blocks -%}         {%- liquid           assign product = block.settings.product           assign primary = block.settings.custom_image | default: product.featured_image           assign secondary = product.images[1]           if block.settings.custom_image             assign secondary = product.featured_image           endif         -%}          <article class="zbs__item" style="--zbs-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>           <a             class="zbs__link"             href="{{ product.url | default: '#' }}"             {% if product == blank %}aria-disabled="true"{% endif %}           >             <div class="zbs__media">               {%- if primary -%}                 {{                   primary                   | image_url: width: 1200                   | image_tag:                     class: 'zbs__img zbs__img--primary',                     widths: '320, 480, 640, 800, 1000, 1200',                     sizes: '(min-width: 990px) 30vw, 50vw',                     loading: 'lazy',                     alt: product.title                 }}                 {%- if secondary and s.hover_swap -%}                   {{                     secondary                     | image_url: width: 1200                     | image_tag:                       class: 'zbs__img zbs__img--secondary',                       widths: '320, 480, 640, 800, 1000, 1200',                       sizes: '(min-width: 990px) 30vw, 50vw',                       loading: 'lazy',                       alt: ''                   }}                 {%- endif -%}               {%- else -%}                 <div class="zbs__placeholder">                   {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'zbs__img zbs__img--primary' }}                 </div>               {%- endif -%}             </div>              <div class="zbs__meta">               <span class="zbs__index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>                <div class="zbs__info">                 <h3 class="zbs__name"><span>{{ product.title | default: 'Product title' }}</span></h3>                 {%- if block.settings.note != blank -%}                   <p class="zbs__note">{{ block.settings.note }}</p>                 {%- endif -%}               </div>                <div class="zbs__price">                 {%- if product == blank -%}                   <span class="zbs__price-now">{{ 0 | money }}</span>                 {%- elsif product.available == false -%}                   <span class="zbs__soldout">Sold out</span>                 {%- else -%}                   {%- if s.show_compare and product.compare_at_price > product.price -%}                     <span class="visually-hidden">Sale price</span>                     <span class="zbs__price-now">                       {%- if s.show_from and product.price_varies %}<span class="zbs__from">From </span>{% endif -%}                       {{ product.price | money }}                     </span>                     <span class="visually-hidden">Regular price</span>                     <s class="zbs__price-was">{{ product.compare_at_price | money }}</s>                   {%- else -%}                     <span class="zbs__price-now">                       {%- if s.show_from and product.price_varies %}<span class="zbs__from">From </span>{% endif -%}                       {{ product.price | money }}                     </span>                   {%- endif -%}                 {%- endif -%}               </div>             </div>           </a>         </article>       {%- endfor -%}     </div>    </div> </section>  {% stylesheet %}   .zbs {     --zbs-line: color-mix(in srgb, currentColor 18%, transparent);     --zbs-muted: color-mix(in srgb, currentColor 58%, transparent);     --zbs-gutter: clamp(20px, 4.2vw, 72px);     --zbs-ease: cubic-bezier(.22, .61, .36, 1);      position: relative;     background: var(--color-background, #efeae2);     color: var(--color-foreground, #1d1a16);     padding-block: calc(var(--zbs-pt) * .6) calc(var(--zbs-pb) * .6);   }   .zbs--divider { border-top: 1px solid var(--zbs-line); }    .zbs *, .zbs *::before, .zbs *::after { box-sizing: border-box; }    .zbs__inner {     max-width: 1560px;     margin-inline: auto;     padding-inline: var(--zbs-gutter);     display: grid;     grid-template-columns: minmax(0, 1fr);   }    /* On mobile the intro dissolves so the CTA can sit below the products */   .zbs__intro { display: contents; }   .zbs__header { order: 1; margin-bottom: 28px; }   .zbs__products { order: 2; }   .zbs__cta { order: 3; }    /* ---------- Header ---------- */   .zbs__eyebrow {     display: flex;     align-items: center;     gap: 14px;     margin: 0 0 18px;     font-family: var(--font-body--family, inherit);     font-size: .6875rem;     letter-spacing: .24em;     text-transform: uppercase;     color: var(--zbs-muted);   }   .zbs__eyebrow::before {     content: "";     width: 28px;     height: 1px;     background: currentColor;     opacity: .7;   }    .zbs__heading {     margin: 0;     font-family: var(--font-heading--family, Georgia, serif);     font-weight: 400;     font-style: normal;     font-size: clamp(2.125rem, 9vw, 3rem);     line-height: 1.02;     letter-spacing: -.025em;     text-wrap: balance;   }   .zbs__heading em { font-style: italic; }    .zbs__text {     margin-top: 16px;     max-width: 30ch;     font-size: .9375rem;     line-height: 1.6;     color: var(--zbs-muted);   }   .zbs__text p { margin: 0; }    /* ---------- Products ---------- */   .zbs__products {     display: grid;     grid-template-columns: repeat(2, minmax(0, 1fr));     column-gap: 14px;     row-gap: 30px;     padding-bottom: var(--zbs-stagger-m);   }   .zbs__item { position: relative; }   .zbs__item:nth-child(even) { top: var(--zbs-stagger-m); }    .zbs__link {     display: block;     color: inherit;     text-decoration: none;   }    .zbs__media {     position: relative;     aspect-ratio: 1 / 1;     overflow: hidden;     background: color-mix(in srgb, currentColor 7%, transparent);   }   .zbs__img,   .zbs__placeholder,   .zbs__placeholder svg {     position: absolute;     inset: 0;     width: 100%;     height: 100%;     object-fit: cover;     display: block;   }   .zbs__placeholder svg { fill: currentColor; opacity: .25; padding: 18%; }   .zbs__img--primary {     transition: transform 1.4s var(--zbs-ease), opacity .7s var(--zbs-ease);   }   .zbs__img--secondary {     opacity: 0;     transition: opacity .8s var(--zbs-ease), transform 1.4s var(--zbs-ease);   }    /* Meta: hairline, numeral, name, price */   .zbs__meta {     display: grid;     grid-template-columns: minmax(0, 1fr);     gap: 6px;     margin-top: 12px;     padding-top: 11px;     border-top: 1px solid var(--zbs-line);     transition: border-color .5s var(--zbs-ease);   }   .zbs__index { display: none; }    .zbs__name {     margin: 0;     font-family: var(--font-heading--family, Georgia, serif);     font-weight: 400;     font-size: .9375rem;     line-height: 1.25;     letter-spacing: -.005em;   }   .zbs__name span {     text-decoration: underline;     text-decoration-thickness: 1px;     text-underline-offset: .28em;     text-decoration-color: transparent;     transition: text-decoration-color .5s var(--zbs-ease);   }   .zbs__note {     margin: 4px 0 0;     font-size: .75rem;     line-height: 1.4;     color: var(--zbs-muted);   }    .zbs__price {     display: flex;     flex-wrap: wrap;     align-items: baseline;     gap: 2px 8px;     font-size: .8125rem;     font-variant-numeric: tabular-nums;     letter-spacing: .01em;   }   .zbs__price-was { color: var(--zbs-muted); font-size: .75rem; }   .zbs__from, .zbs__soldout { color: var(--zbs-muted); }   .zbs__soldout { letter-spacing: .08em; text-transform: uppercase; font-size: .6875rem; }    /* ---------- CTA ---------- */   .zbs__cta {     margin-top: 40px;     display: flex;     align-items: center;     justify-content: space-between;     gap: 20px;     width: 100%;     padding: 18px 0;     border-block: 1px solid currentColor;     color: inherit;     text-decoration: none;     font-size: .75rem;     letter-spacing: .2em;     text-transform: uppercase;     transition: background-color .5s var(--zbs-ease), color .5s var(--zbs-ease);   }   .zbs__cta--outline { padding-inline: 20px; border: 1px solid currentColor; }   .zbs__arrow { flex: none; transition: transform .6s var(--zbs-ease); }    /* ---------- Desktop ---------- */   @media (min-width: 990px) {     .zbs {       padding-block: var(--zbs-pt) var(--zbs-pb);     }     .zbs__inner {       grid-template-columns: repeat(12, minmax(0, 1fr));       column-gap: clamp(16px, 2vw, 32px);       align-items: start;     }      .zbs__intro {       display: flex;       flex-direction: column;       align-items: flex-start;       grid-column: 1 / span 4;       grid-row: 1;       position: sticky;       top: calc(var(--header-height, 0px) + 48px);       padding-top: clamp(0px, 2vw, 32px);     }     .zbs[data-layout="right"] .zbs__intro { grid-column: 9 / span 4; }      .zbs__header { margin: 0; }     .zbs__eyebrow { margin-bottom: 28px; }     .zbs__heading { font-size: clamp(2.75rem, 4.6vw, var(--zbs-heading-size)); }     .zbs__text { margin-top: 28px; font-size: 1rem; max-width: 26ch; }      .zbs__cta {       width: auto;       justify-content: flex-start;       gap: 22px;       margin-top: 56px;       padding: 0 0 14px;       border: 0;       border-bottom: 1px solid currentColor;     }     .zbs__cta--outline { padding: 18px 28px; border: 1px solid currentColor; }     .zbs__cta:hover .zbs__arrow { transform: translateX(6px); }     .zbs__cta--outline:hover {       background: var(--color-foreground, #1d1a16);       color: var(--color-background, #efeae2);     }      .zbs__products {       grid-column: 6 / span 7;       grid-row: 1;       column-gap: clamp(24px, 3.4vw, 56px);       row-gap: clamp(56px, 6vw, 104px);       padding-bottom: var(--zbs-stagger);     }     .zbs[data-layout="right"] .zbs__products { grid-column: 1 / span 7; }     .zbs__item:nth-child(even) { top: var(--zbs-stagger); }      .zbs__meta { margin-top: 18px; padding-top: 16px; gap: 0 16px; }     .zbs[data-index="true"] .zbs__meta { grid-template-columns: 2rem minmax(0, 1fr) auto; }     .zbs[data-index="false"] .zbs__meta { grid-template-columns: minmax(0, 1fr) auto; }     .zbs[data-index="true"] .zbs__index {       display: block;       padding-top: .25em;       font-size: .6875rem;       letter-spacing: .12em;       color: var(--zbs-muted);       font-variant-numeric: tabular-nums;     }     .zbs__name { font-size: 1.1875rem; }     .zbs__note { font-size: .8125rem; }     .zbs__price { flex-direction: column; align-items: flex-end; gap: 3px; font-size: .875rem; padding-top: .2em; }     .zbs__price-was { font-size: .8125rem; }   }    /* ---------- Hover (pointer devices only) ---------- */   @media (hover: hover) and (min-width: 990px) {     .zbs__link:hover .zbs__img--primary { transform: scale(1.035); }     .zbs[data-swap="true"] .zbs__link:hover .zbs__img--secondary { opacity: 1; transform: scale(1.035); }     .zbs__link:hover .zbs__name span,     .zbs__link:focus-visible .zbs__name span { text-decoration-color: currentColor; }     .zbs__link:hover .zbs__meta { border-color: currentColor; }   }   .zbs__link:focus-visible { outline: 1px solid currentColor; outline-offset: 6px; }    /* ---------- Scroll reveal ---------- */   .zbs.is-ready .zbs__item {     opacity: 0;     transform: translateY(18px);     transition: opacity 1s var(--zbs-ease), transform 1s var(--zbs-ease);     transition-delay: calc(var(--zbs-i) * 90ms);   }   .zbs.is-ready .zbs__item.is-in { opacity: 1; transform: none; }    @media (prefers-reduced-motion: reduce) {     .zbs *, .zbs *::before, .zbs *::after { transition: none !important; }     .zbs.is-ready .zbs__item { opacity: 1; transform: none; }   } {% endstylesheet %}  {% javascript %}   (function () {     if (!('IntersectionObserver' in window)) return;     if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;     if (window.Shopify && Shopify.designMode) return;      function init() {       document.querySelectorAll('.zbs[data-reveal="true"]:not(.is-ready)').forEach(function (section) {         var io = new IntersectionObserver(function (entries) {           entries.forEach(function (entry) {             if (entry.isIntersecting) {               entry.target.classList.add('is-in');               io.unobserve(entry.target);             }           });         }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });          section.classList.add('is-ready');         section.querySelectorAll('.zbs__item').forEach(function (item) { io.observe(item); });       });     }      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);     else init();   })(); {% endjavascript %}  {% schema %} {   "name": "ZAISEN Best Sellers",   "tag": "section",   "class": "section-zaisen-best-sellers",   "max_blocks": 4,   "settings": [     { "type": "header", "content": "Content" },     { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ZAISEN FAVORITES" },     { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Our Best Sellers" },     { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Most-loved handcrafted pieces." },     { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Best Sellers" },     { "type": "url", "id": "button_link", "label": "Button link", "info": "Falls back to all products if empty." },     {       "type": "select",       "id": "button_style",       "label": "Button style",       "options": [         { "value": "link", "label": "Underlined link" },         { "value": "outline", "label": "Outline button" }       ],       "default": "link"     },      { "type": "header", "content": "Layout" },     {       "type": "select",       "id": "layout",       "label": "Desktop intro position",       "options": [         { "value": "left", "label": "Left" },         { "value": "right", "label": "Right" }       ],       "default": "left"     },     { "type": "range", "id": "stagger", "label": "Desktop stagger (right column offset)", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 96 },     { "type": "range", "id": "heading_size", "label": "Max heading size (desktop)", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 76 },     { "type": "checkbox", "id": "show_index", "label": "Show 01–04 numerals (desktop)", "default": true },     { "type": "checkbox", "id": "show_divider", "label": "Show hairline at top of section", "default": true },      { "type": "header", "content": "Products" },     { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true },     { "type": "checkbox", "id": "show_from", "label": "Show “From” when variants differ in price", "default": false },     { "type": "checkbox", "id": "hover_swap", "label": "Swap to second image on hover", "default": true },     { "type": "checkbox", "id": "enable_reveal", "label": "Soft reveal on scroll", "default": true },      { "type": "header", "content": "Appearance" },     { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },     { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 220, "step": 4, "unit": "px", "default": 128 },     { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 220, "step": 4, "unit": "px", "default": 128 }   ],   "blocks": [     {       "type": "product",       "name": "Product",       "settings": [         { "type": "product", "id": "product", "label": "Product" },         { "type": "image_picker", "id": "custom_image", "label": "Image override (optional)", "info": "Use a square image. Defaults to the product's featured image." },         { "type": "text", "id": "note", "label": "Short note (optional)", "info": "e.g. Solid walnut · Hand-oiled" }       ]     }   ],   "presets": [     {       "name": "ZAISEN Best Sellers",       "blocks": [         { "type": "product" },         { "type": "product" },         { "type": "product" },         { "type": "product" }       ]     }   ] } {% endschema %}