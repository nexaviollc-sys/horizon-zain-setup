

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section zs-journal-article{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <nav class="zs-ja__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      <a href="{{ blog.url }}">The ZAISEN Journal</a><span aria-hidden="true">/</span>
      <span>{{ article.title | escape | truncate: 57 }}</span>
    </nav>
    {% content_for 'blocks' %}
    <div class="zs-ja__footer">
      <a class="zs-ja__back" href="{{ blog.url }}">← Back to The ZAISEN Journal</a>
      <a class="zs-ja__browse" href="{{ routes.all_products_collection_url }}">Explore handcrafted wooden decor ↗</a>
    </div>

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
  /* Editorial article styling is isolated to Shopify's native article section. */
  .zs-journal-article{background:#fcfaf7;color:#2b1d17}
  .zs-journal-article .section-content-wrapper{max-width:1040px;margin:0 auto;gap:clamp(23px,4vw,42px)}
  .zs-ja__breadcrumbs{display:flex;flex-wrap:wrap;align-items:center;gap:10px;width:100%;color:#826f5f;font-size:12px;line-height:1.5;padding:11px 0 18px}
  .zs-ja__breadcrumbs a{color:inherit;text-decoration:none}
  .zs-ja__breadcrumbs a:hover{text-decoration:underline;text-underline-offset:3px}
  .zs-journal-article h1{font-family:var(--font-heading--family,Georgia,serif);font-weight:500;line-height:1.16;letter-spacing:-.043em;font-size:clamp(34px,5vw,66px);color:#2b1d17;max-width:930px;margin-inline:auto}
  .zs-journal-article img{max-width:100%;height:auto}
  .zs-journal-article .rte,.zs-journal-article [class*='blog-post-content']{line-height:1.85;color:#55483e}
  .zs-journal-article .rte p,.zs-journal-article [class*='blog-post-content'] p{margin-bottom:1.2em}
  .zs-journal-article .rte h2,.zs-journal-article [class*='blog-post-content'] h2{font-family:var(--font-heading--family,Georgia,serif);color:#2b1d17;letter-spacing:-.026em;line-height:1.3;font-size:clamp(25px,3vw,35px);margin:1.5em 0 .6em}
  .zs-journal-article .rte h3,.zs-journal-article [class*='blog-post-content'] h3{color:#2b1d17;font-size:clamp(19px,2.2vw,24px);line-height:1.35}
  .zs-journal-article .rte a,.zs-journal-article [class*='blog-post-content'] a{color:#85592f;text-decoration:underline;text-underline-offset:3px}
  .zs-journal-article figure{max-width:100%;margin:25px auto 35px}
  .zs-journal-article figcaption{font-size:12px;color:#806f60;text-align:center;padding-top:9px;line-height:1.5}
  .zs-ja__footer{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;width:100%;margin:35px 0 20px;padding:25px 0;border-top:1px solid #e2d7ca}
  .zs-ja__footer a{color:#68472f;font-size:13px;font-weight:700;text-decoration:none}
  .zs-ja__footer a:hover{text-decoration:underline;text-underline-offset:4px}
  .zs-ja__footer a:focus-visible,.zs-ja__breadcrumbs a:focus-visible{outline:2px solid #d8b56a;outline-offset:3px}
  @media(max-width:749px){.zs-ja__breadcrumbs{font-size:11px}.zs-journal-article .section-content-wrapper{gap:20px}.zs-ja__footer{align-items:flex-start;flex-direction:column}}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_blog-post-title"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "_blog-post-featured-image"
    },
    {
      "type": "_blog-post-content"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
