{% comment %}
  ZAISEN Premium Announcement. Match the seven active Shopify shipping zones.
  Free-shipping thresholds are denominated in USD by the current shipping profile.
  The destination label uses Shopify's selected country, never IP guesswork.
{% endcomment %}
{% liquid
  assign zs_shipping_threshold = 0
  assign zs_destination = localization.country.name
  assign zs_currency_prefix = 'US$'

  case localization.country.iso_code
    when 'US'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United States'
      assign zs_currency_prefix = '$'
    when 'GB'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United Kingdom'
    when 'DE'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'Germany'
    when 'FR'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'France'
    when 'AE'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United Arab Emirates'
    when 'CA'
      assign zs_shipping_threshold = 100
      assign zs_destination = 'Canada'
    when 'AU'
      assign zs_shipping_threshold = 100
      assign zs_destination = 'Australia'
  endcase

  assign zs_eyebrow = 'A LITTLE EXTRA FROM ZAISEN'
  assign zs_headline = 'Complimentary shipping'
  assign zs_qualifier = 'on orders from'
  assign zs_delivery_label = 'DELIVERING TO'

  case localization.language.iso_code
    when 'fr'
      assign zs_eyebrow = 'UNE ATTENTION DE ZAISEN'
      assign zs_headline = 'Livraison offerte'
      assign zs_qualifier = 'dès'
      assign zs_delivery_label = 'LIVRAISON VERS'
    when 'de'
      assign zs_eyebrow = 'EIN KLEINES EXTRA VON ZAISEN'
      assign zs_headline = 'Kostenloser Versand'
      assign zs_qualifier = 'ab'
      assign zs_delivery_label = 'LIEFERUNG NACH'
    when 'ar'
      assign zs_eyebrow = 'لمسة إضافية من زايسن'
      assign zs_headline = 'شحن مجاني'
      assign zs_qualifier = 'للطلبات من'
      assign zs_delivery_label = 'التوصيل إلى'
  endcase

  assign zs_simple_offer = 'Free shipping on orders over'
  assign zs_country_hint = 'Change your country to see shipping information for your location.'
  case localization.language.iso_code
    when 'fr'
      assign zs_simple_offer = 'Livraison gratuite pour les commandes de plus de'
      assign zs_country_hint = 'Changez de pays pour voir les informations de livraison correspondantes.'
    when 'de'
      assign zs_simple_offer = 'Kostenloser Versand für Bestellungen über'
      assign zs_country_hint = 'Land ändern, um die passenden Versandinformationen zu sehen.'
    when 'ar'
      assign zs_simple_offer = 'شحن مجاني للطلبات التي تزيد عن'
      assign zs_country_hint = 'غيّر بلدك للاطلاع على معلومات الشحن المناسبة له.'
  endcase
%}

<section
  class="zs-announcement{% unless template.name == 'index' %} zs-announcement--inner{% endunless %}"
  data-zs-announcement
  data-speed="{{ section.settings.speed | times: 1000 }}"
  style="
    --zs-a-bg: {{ section.settings.background_color }};
    --zs-a-text: {{ section.settings.text_color }};
    --zs-a-accent: {{ section.settings.accent_color }};
    --zs-a-border: {{ section.settings.border_color }};
    --zs-a-height: {{ section.settings.desktop_height }}px;
    --zs-a-height-mobile: {{ section.settings.mobile_height }}px;
  "
  aria-label="ZAISEN delivery announcements"
>
  <div class="zs-announcement__inner">
    {% if zs_shipping_threshold > 0 %}
      {% unless template.name == 'index' %}
        <div class="zs-announcement__minimal">
          <div class="zs-announcement__country">
            <span class="zs-announcement__country-name">{{ zs_destination | escape }}</span>
            <span class="zs-announcement__country-note">{{ zs_country_hint | escape }}</span>
          </div>
          <p class="zs-announcement__offer"{% if localization.language.iso_code == 'ar' %} dir="rtl"{% endif %}>
            <span>{{ zs_simple_offer | escape }}</span>
            <strong class="zs-announcement__minimal-amount">{{ zs_currency_prefix }}{{ zs_shipping_threshold }}</strong>
          </p>
        </div>
      {% else %}
      <div class="zs-announcement__shipping">
        <span class="zs-announcement__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M3 6.5h11v10H3zM14 10h3.7l3.3 3.5v3H14"/>
            <circle cx="7.2" cy="17.4" r="1.7"/>
            <circle cx="17.4" cy="17.4" r="1.7"/>
            <path d="M6 3.7h6"/>
          </svg>
        </span>
        <div class="zs-announcement__copy"{% if localization.language.iso_code == 'ar' %} dir="rtl"{% endif %}>
          <span class="zs-announcement__eyebrow">{{ zs_eyebrow | escape }}</span>
          <span class="zs-announcement__headline">
            <span class="zs-announcement__headline-main">{{ zs_headline | escape }}</span>
            <span class="zs-announcement__qualifier">{{ zs_qualifier | escape }}</span>
            <strong class="zs-announcement__amount">{{ zs_currency_prefix }}{{ zs_shipping_threshold }}+</strong>
          </span>
        </div>
      </div>
      <div class="zs-announcement__destination" aria-label="{{ zs_delivery_label | escape }}: {{ zs_destination | escape }}">
        <span class="zs-announcement__destination-label">{{ zs_delivery_label | escape }}</span>
        <span class="zs-announcement__destination-value">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
            <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/>
            <circle cx="12" cy="10" r="2.25"/>
          </svg>
          <span>{{ zs_destination | escape }}</span>
        </span>
      </div>
      {% endunless %}
    {% else %}
      <div class="zs-announcement__legacy" aria-live="polite">
        {% for i in (1..4) %}
          {% liquid
            assign text_key = 'message_' | append: i
            assign message = section.settings[text_key]
          %}
          {% if message != blank %}
            <div
              class="zs-announcement__message{% if forloop.first %} is-active{% endif %}"
              data-zs-announcement-message
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
            >
              <span class="zs-announcement__diamond" aria-hidden="true">◆</span>
              <span class="zs-announcement__text">{{ message | escape }}</span>
              <span class="zs-announcement__diamond" aria-hidden="true">◆</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .zs-announcement {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: max(var(--zs-a-height), 54px);
    overflow: hidden;
    color: var(--zs-a-text);
    background:
      radial-gradient(ellipse at 40% -100%, color-mix(in srgb, var(--zs-a-accent) 16%, transparent), transparent 78%),
      linear-gradient(108deg, color-mix(in srgb, var(--zs-a-bg) 88%, #120a07) 0%, var(--zs-a-bg) 55%, color-mix(in srgb, var(--zs-a-bg) 88%, #75513a) 100%);
    border-block-end: 1px solid color-mix(in srgb, var(--zs-a-accent) 40%, var(--zs-a-border));
  }

  .zs-announcement::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent 4%, color-mix(in srgb, var(--zs-a-accent) 40%, transparent) 50%, transparent 96%);
  }

  .zs-announcement__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    width: min(100%, 1320px);
    min-height: max(var(--zs-a-height), 54px);
    margin-inline: auto;
    padding: 7px 30px;
  }

  .zs-announcement__shipping {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-width: 0;
    padding-inline-start: 148px;
  }

  .zs-announcement__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--zs-a-accent);
    border: 1px solid color-mix(in srgb, var(--zs-a-accent) 55%, transparent);
    background: color-mix(in srgb, var(--zs-a-accent) 9%, transparent);
    border-radius: 50%;
  }

  .zs-announcement__icon svg {
    display: block;
    width: 20px;
    height: 20px;
  }

  .zs-announcement__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }

  .zs-announcement__eyebrow {
    color: var(--zs-a-accent);
    font-family: var(--font-body--family, inherit);
    font-size: 8.5px;
    font-weight: 650;
    letter-spacing: 0.21em;
    line-height: 1.2;
  }

  .zs-announcement__headline {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 7px;
    row-gap: 1px;
    color: var(--zs-a-text);
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: 0.005em;
  }

  .zs-announcement__headline-main {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .zs-announcement__qualifier {
    color: color-mix(in srgb, var(--zs-a-text) 80%, transparent);
    font-family: var(--font-body--family, inherit);
    font-size: 12px;
  }

  .zs-announcement__amount {
    color: var(--zs-a-accent);
    font-family: var(--font-body--family, inherit);
    font-size: 14px;
    font-weight: 750;
    white-space: nowrap;
  }

  .zs-announcement__destination {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 6px 0 6px 22px;
    border-inline-start: 1px solid color-mix(in srgb, var(--zs-a-accent) 36%, transparent);
  }

  .zs-announcement__destination-label {
    color: color-mix(in srgb, var(--zs-a-text) 68%, transparent);
    font-family: var(--font-body--family, inherit);
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.17em;
  }

  .zs-announcement__destination-value {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--zs-a-text);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.1;
    white-space: nowrap;
  }

  .zs-announcement__destination-value svg {
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--zs-a-accent);
  }

  .zs-announcement__legacy {
    grid-column: 1 / -1;
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(var(--zs-a-height), 54px);
  }

  .zs-announcement__message {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: opacity 320ms ease, transform 320ms ease, visibility 0s linear 320ms;
  }

  .zs-announcement__message.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .zs-announcement__text {
    font-family: var(--font-body--family, inherit);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .zs-announcement__diamond {
    flex: none;
    color: var(--zs-a-accent);
    font-size: 5px;
  }

  @media screen and (max-width: 990px) {
    .zs-announcement__shipping { padding-inline-start: 0; justify-content: flex-start; }
    .zs-announcement__inner { padding-inline: 18px; gap: 15px; }
    .zs-announcement__headline-main { font-size: 15px; }
    .zs-announcement__headline { font-size: 12px; }
    .zs-announcement__qualifier { font-size: 11px; }
    .zs-announcement__destination { padding-inline-start: 14px; }
  }

  @media screen and (max-width: 749px) {
    .zs-announcement { min-height: max(var(--zs-a-height-mobile), 68px); }
    .zs-announcement__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      min-height: max(var(--zs-a-height-mobile), 68px);
      padding: 7px 12px;
    }
    .zs-announcement__shipping { justify-content: center; gap: 8px; }
    .zs-announcement__icon { width: 27px; height: 27px; }
    .zs-announcement__icon svg { width: 16px; height: 16px; }
    .zs-announcement__copy { gap: 0; }
    .zs-announcement__eyebrow { display: none; }
    .zs-announcement__headline {
      justify-content: center;
      column-gap: 5px;
      font-size: 11px;
      line-height: 1.3;
    }
    .zs-announcement__headline-main { font-size: 14px; }
    .zs-announcement__qualifier { font-size: 10.5px; }
    .zs-announcement__amount { font-size: 12px; }
    .zs-announcement__destination {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 0;
      border: 0;
    }
    .zs-announcement__destination-label { font-size: 8px; }
    .zs-announcement__destination-value { font-size: 10px; }
    .zs-announcement__destination-value svg { width: 11px; height: 11px; }
    .zs-announcement__legacy { min-height: max(var(--zs-a-height-mobile), 68px); }
    .zs-announcement__text { font-size: 10px; letter-spacing: 0.08em; }
  }

  @media (max-width: 360px) {
    .zs-announcement__icon { display: none; }
    .zs-announcement__headline-main { font-size: 13px; }
    .zs-announcement__headline { column-gap: 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-announcement__message { transform: none; transition: opacity 120ms linear; }
  }

  /*
   * Inner pages only: restrained shipping strip directly under the header.
   * The original homepage announcement markup, style and position are preserved.
   */
  .zs-announcement.zs-announcement--inner {
    min-height: 48px;
    background: var(--zs-a-bg);
    border-block: 1px solid color-mix(in srgb, var(--zs-a-accent) 22%, transparent);
    box-shadow: none;
  }

  .zs-announcement--inner::before {
    display: none;
  }

  .zs-announcement--inner .zs-announcement__inner {
    display: block;
    grid-template-columns: none;
    min-height: 48px;
    max-width: 1300px;
    padding: 8px 24px;
  }

  .zs-announcement__minimal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: 24px;
    align-items: center;
    min-height: 32px;
    color: var(--zs-a-text);
    font-family: var(--font-body--family, inherit);
  }

  .zs-announcement__country {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 0;
    text-align: start;
  }

  .zs-announcement__country-name {
    color: var(--zs-a-text);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
  }

  .zs-announcement__country-note {
    color: color-mix(in srgb, var(--zs-a-text) 70%, var(--zs-a-bg));
    font-size: 10px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.005em;
  }

  .zs-announcement__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0 5px;
    margin: 0;
    text-align: end;
    color: var(--zs-a-text);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
  }

  .zs-announcement__minimal-amount {
    color: var(--zs-a-accent);
    font-size: 13px;
    font-weight: 750;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .zs-announcement.zs-announcement--inner { min-height: 60px; }

    .zs-announcement--inner .zs-announcement__inner {
      min-height: 60px;
      padding: 9px 14px;
    }

    .zs-announcement__minimal {
      grid-template-columns: minmax(0, 1fr);
      gap: 7px;
    }

    .zs-announcement__country {
      align-items: center;
      text-align: center;
      gap: 2px;
    }

    .zs-announcement__country-name { font-size: 11.5px; }
    .zs-announcement__country-note { font-size: 9.5px; }

    .zs-announcement__offer {
      justify-content: center;
      text-align: center;
      font-size: 11px;
    }

    .zs-announcement__minimal-amount { font-size: 11.5px; }
  }

{% endstylesheet %}

{% javascript %}
  const initZsAnnouncement = (root = document) => {
    root.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();

      const messages = Array.from(bar.querySelectorAll('[data-zs-announcement-message]'));
      if (messages.length < 2) return;

      const requestedSpeed = Number(bar.dataset.speed);
      const speed = Number.isFinite(requestedSpeed) ? Math.max(3000, requestedSpeed) : 4000;
      let current = Math.max(0, messages.findIndex((message) => message.classList.contains('is-active')));
      let timer = null;

      const render = (nextIndex) => {
        messages.forEach((message, index) => {
          const active = index === nextIndex;
          message.classList.toggle('is-active', active);
          message.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        current = nextIndex;
      };

      const advance = () => render((current + 1) % messages.length);

      const start = () => {
        if (timer || document.hidden) return;
        timer = window.setInterval(advance, speed);
      };

      const stop = () => {
        if (!timer) return;
        window.clearInterval(timer);
        timer = null;
      };

      const handleVisibility = () => {
        if (document.hidden) stop();
        else start();
      };

      document.addEventListener('visibilitychange', handleVisibility);
      start();

      bar._zsCleanup = () => {
        stop();
        document.removeEventListener('visibilitychange', handleVisibility);
      };
    });
  };

  initZsAnnouncement();

  document.addEventListener('shopify:section:load', (event) => {
    initZsAnnouncement(event.target);
  });

  document.addEventListener('shopify:section:unload', (event) => {
    event.target.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "ZS Premium Announcement",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Handcrafted from pure wood"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "Made to order • crafted with care"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Natural materials • timeless design"
    },
    {
      "type": "text",
      "id": "message_4",
      "label": "Message 4",
      "default": "Welcome to Zaisen"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Message duration",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2B1D17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Wood accent",
      "default": "#D8B56A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#2B1D17"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 34,
      "max": 54,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 32,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "ZS Premium Announcement"
    }
  ]
}
