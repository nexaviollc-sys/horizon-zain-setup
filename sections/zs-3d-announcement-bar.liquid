<section
  class="zs-announcement"
  data-zs-announcement
  data-speed="{{ section.settings.speed | times: 1000 }}"
  style="
    --zs-a-bg: {{ section.settings.background_color }};
    --zs-a-text: {{ section.settings.text_color }};
    --zs-a-accent: {{ section.settings.accent_color }};
    --zs-a-border: {{ section.settings.border_color }};
    --zs-a-height: {{ section.settings.desktop_height }}px;
    --zs-a-height-mobile: {{ section.settings.mobile_height }}px;
  "
  aria-label="Store announcements"
>
  <div class="zs-announcement__inner">
    <span class="zs-announcement__line" aria-hidden="true"></span>

    <div class="zs-announcement__stage" aria-live="polite">
      {% for i in (1..4) %}
        {% liquid
          assign text_key = 'message_' | append: i
          assign message = section.settings[text_key]
        %}
        {% if message != blank %}
          <div
            class="zs-announcement__message{% if forloop.first %} is-active{% endif %}"
            data-zs-announcement-message
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
          >
            <span class="zs-announcement__diamond" aria-hidden="true">◆</span>
            <span class="zs-announcement__text">{{ message | escape }}</span>
            <span class="zs-announcement__diamond" aria-hidden="true">◆</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <span class="zs-announcement__line zs-announcement__line--right" aria-hidden="true"></span>
  </div>
</section>

{% stylesheet %}
  .zs-announcement {
    position: relative;
    width: 100%;
    min-height: var(--zs-a-height);
    overflow: hidden;
    color: var(--zs-a-text);
    background: var(--zs-a-bg);
    border-block: 1px solid color-mix(in srgb, var(--zs-a-border) 82%, transparent);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      inset 0 -1px 0 color-mix(in srgb, var(--zs-a-accent) 8%, transparent);
    isolation: isolate;
  }

  .zs-announcement::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.24;
    background-image:
      linear-gradient(115deg, transparent 0 46%, color-mix(in srgb, var(--zs-a-accent) 8%, transparent) 49% 51%, transparent 54% 100%);
    background-size: 180px 100%;
  }

  .zs-announcement__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(28px, 1fr) minmax(280px, 760px) minmax(28px, 1fr);
    align-items: center;
    gap: 20px;
    width: min(100%, 1280px);
    min-height: var(--zs-a-height);
    margin-inline: auto;
    padding-inline: 28px;
  }

  .zs-announcement__line {
    display: block;
    justify-self: end;
    width: min(100%, 110px);
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--zs-a-accent) 58%, transparent));
  }

  .zs-announcement__line--right {
    justify-self: start;
    transform: scaleX(-1);
  }

  .zs-announcement__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--zs-a-height);
    overflow: hidden;
  }

  .zs-announcement__message {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding-inline: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition:
      opacity 320ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 320ms;
  }

  .zs-announcement__message.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .zs-announcement__text {
    font-family: var(--font-body--family, inherit);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .zs-announcement__diamond {
    flex: 0 0 auto;
    color: color-mix(in srgb, var(--zs-a-accent) 86%, var(--zs-a-text));
    font-size: 5px;
    line-height: 1;
    opacity: 0.82;
  }

  @media screen and (max-width: 749px) {
    .zs-announcement {
      min-height: var(--zs-a-height-mobile);
    }

    .zs-announcement__inner {
      grid-template-columns: 18px minmax(0, 1fr) 18px;
      gap: 8px;
      min-height: var(--zs-a-height-mobile);
      padding-inline: 10px;
    }

    .zs-announcement__stage {
      min-height: var(--zs-a-height-mobile);
    }

    .zs-announcement__line {
      width: 18px;
    }

    .zs-announcement__message {
      gap: 7px;
      padding-inline: 0;
    }

    .zs-announcement__text {
      font-size: 9.5px;
      letter-spacing: 0.12em;
    }

    .zs-announcement__diamond {
      font-size: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-announcement__message {
      transform: none;
      transition: opacity 120ms linear;
    }

    .zs-announcement__message.is-active {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initZsAnnouncement = (root = document) => {
    root.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();

      const messages = Array.from(bar.querySelectorAll('[data-zs-announcement-message]'));
      if (messages.length < 2) return;

      const requestedSpeed = Number(bar.dataset.speed);
      const speed = Number.isFinite(requestedSpeed) ? Math.max(3000, requestedSpeed) : 4000;
      let current = Math.max(0, messages.findIndex((message) => message.classList.contains('is-active')));
      let timer = null;

      const render = (nextIndex) => {
        messages.forEach((message, index) => {
          const active = index === nextIndex;
          message.classList.toggle('is-active', active);
          message.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        current = nextIndex;
      };

      const advance = () => render((current + 1) % messages.length);

      const start = () => {
        if (timer || document.hidden) return;
        timer = window.setInterval(advance, speed);
      };

      const stop = () => {
        if (!timer) return;
        window.clearInterval(timer);
        timer = null;
      };

      const handleVisibility = () => {
        if (document.hidden) stop();
        else start();
      };

      document.addEventListener('visibilitychange', handleVisibility);
      start();

      bar._zsCleanup = () => {
        stop();
        document.removeEventListener('visibilitychange', handleVisibility);
      };
    });
  };

  initZsAnnouncement();

  document.addEventListener('shopify:section:load', (event) => {
    initZsAnnouncement(event.target);
  });

  document.addEventListener('shopify:section:unload', (event) => {
    event.target.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "ZS Premium Announcement",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Handcrafted from pure wood"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "Made to order • crafted with care"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Natural materials • timeless design"
    },
    {
      "type": "text",
      "id": "message_4",
      "label": "Message 4",
      "default": "Welcome to Zaisen"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Message duration",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2B1D17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Wood accent",
      "default": "#D8B56A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#2B1D17"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 34,
      "max": 54,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 32,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "ZS Premium Announcement"
    }
  ]
}
{% endschema %}
