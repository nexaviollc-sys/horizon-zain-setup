{% comment %}
  Minimal ZAISEN free-shipping announcement under the header.
  Thresholds follow the seven active Shopify shipping zones in USD.
  The destination comes from the country selected in Shopify Markets.
{% endcomment %}
{% liquid
  assign zs_shipping_threshold = 0
  assign zs_destination = localization.country.name
  assign zs_currency_prefix = 'US$'
  case localization.country.iso_code
    when 'US'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United States'
      assign zs_currency_prefix = '$'
    when 'GB'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United Kingdom'
    when 'DE'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'Germany'
    when 'FR'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'France'
    when 'AE'
      assign zs_shipping_threshold = 60
      assign zs_destination = 'United Arab Emirates'
    when 'CA'
      assign zs_shipping_threshold = 100
      assign zs_destination = 'Canada'
    when 'AU'
      assign zs_shipping_threshold = 100
      assign zs_destination = 'Australia'
  endcase

  assign zs_title = 'Complimentary shipping'
  assign zs_condition = 'on orders from'
  assign zs_destination_label = 'Delivering to'
  case localization.language.iso_code
    when 'fr'
      assign zs_title = 'Livraison offerte'
      assign zs_condition = 'dès'
      assign zs_destination_label = 'Livraison vers'
    when 'de'
      assign zs_title = 'Kostenloser Versand'
      assign zs_condition = 'ab'
      assign zs_destination_label = 'Lieferung nach'
    when 'ar'
      assign zs_title = 'شحن مجاني'
      assign zs_condition = 'للطلبات من'
      assign zs_destination_label = 'التوصيل إلى'
  endcase
%}

<aside
  class="zs-announcement"
  data-zs-announcement
  data-speed="{{ section.settings.speed | times: 1000 }}"
  style="
    --zs-a-bg: {{ section.settings.background_color }};
    --zs-a-text: {{ section.settings.text_color }};
    --zs-a-accent: {{ section.settings.accent_color }};
    --zs-a-border: {{ section.settings.border_color }};
  "
  aria-label="ZAISEN shipping announcement"
>
  <div class="zs-announcement__inner">
    {% if zs_shipping_threshold > 0 %}
      <p class="zs-announcement__shipping"{% if localization.language.iso_code == 'ar' %} dir="rtl"{% endif %}>
        <span class="zs-announcement__title">{{ zs_title | escape }}</span>
        <span class="zs-announcement__condition">{{ zs_condition | escape }}</span>
        <strong class="zs-announcement__amount">{{ zs_currency_prefix }}{{ zs_shipping_threshold }}+</strong>
      </p>
      <span class="zs-announcement__separator" aria-hidden="true"></span>
      <p class="zs-announcement__destination">
        {{ zs_destination_label | escape }}
        <strong>{{ zs_destination | escape }}</strong>
      </p>
    {% else %}
      <div class="zs-announcement__legacy" aria-live="polite">
        {% for i in (1..4) %}
          {% liquid
            assign text_key = 'message_' | append: i
            assign message = section.settings[text_key]
          %}
          {% if message != blank %}
            <div class="zs-announcement__message{% if forloop.first %} is-active{% endif %}"
              data-zs-announcement-message
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
            >
              <span class="zs-announcement__text">{{ message | escape }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</aside>

{% stylesheet %}
  .zs-announcement {
    position: relative;
    isolation: isolate;
    width: 100%;
    color: var(--zs-a-text);
    background: var(--zs-a-bg);
    border-block-start: 1px solid color-mix(in srgb, var(--zs-a-accent) 24%, var(--zs-a-border));
    border-block-end: 1px solid color-mix(in srgb, var(--zs-a-accent) 20%, var(--zs-a-border));
  }

  .zs-announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 38px;
    padding: 8px 18px;
    max-width: 1300px;
    margin-inline: auto;
  }

  .zs-announcement__shipping,
  .zs-announcement__destination {
    margin: 0;
    line-height: 1.35;
  }

  .zs-announcement__shipping {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
    color: var(--zs-a-text);
    font-size: 12px;
  }

  .zs-announcement__title {
    font-family: var(--font-heading--family, Georgia, serif);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.005em;
  }

  .zs-announcement__condition {
    opacity: 0.84;
  }

  .zs-announcement__amount {
    color: var(--zs-a-accent);
    font-weight: 750;
    white-space: nowrap;
  }

  .zs-announcement__separator {
    flex: 0 0 auto;
    width: 1px;
    height: 13px;
    background: color-mix(in srgb, var(--zs-a-accent) 40%, transparent);
  }

  .zs-announcement__destination {
    color: color-mix(in srgb, var(--zs-a-text) 79%, transparent);
    font-size: 11px;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .zs-announcement__destination strong {
    color: var(--zs-a-text);
    font-weight: 650;
  }

  .zs-announcement__legacy {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 24px;
  }

  .zs-announcement__message {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms ease, visibility 0s linear 220ms;
  }

  .zs-announcement__message.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .zs-announcement__text {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-align: center;
  }

  @media (max-width: 749px) {
    .zs-announcement__inner {
      min-height: 48px;
      flex-direction: column;
      gap: 2px;
      padding: 7px 10px;
    }
    .zs-announcement__shipping { gap: 4px; font-size: 11px; }
    .zs-announcement__title { font-size: 12.5px; }
    .zs-announcement__separator { display: none; }
    .zs-announcement__destination { font-size: 10px; }
  }

  @media (max-width: 340px) {
    .zs-announcement__shipping { font-size: 10.5px; }
    .zs-announcement__title { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-announcement__message { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  const initZsAnnouncement = (root = document) => {
    root.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();

      const messages = Array.from(bar.querySelectorAll('[data-zs-announcement-message]'));
      if (messages.length < 2) return;

      const requestedSpeed = Number(bar.dataset.speed);
      const speed = Number.isFinite(requestedSpeed) ? Math.max(3000, requestedSpeed) : 4000;
      let current = Math.max(0, messages.findIndex((message) => message.classList.contains('is-active')));
      let timer = null;

      const render = (nextIndex) => {
        messages.forEach((message, index) => {
          const active = index === nextIndex;
          message.classList.toggle('is-active', active);
          message.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        current = nextIndex;
      };

      const advance = () => render((current + 1) % messages.length);

      const start = () => {
        if (timer || document.hidden) return;
        timer = window.setInterval(advance, speed);
      };

      const stop = () => {
        if (!timer) return;
        window.clearInterval(timer);
        timer = null;
      };

      const handleVisibility = () => {
        if (document.hidden) stop();
        else start();
      };

      document.addEventListener('visibilitychange', handleVisibility);
      start();

      bar._zsCleanup = () => {
        stop();
        document.removeEventListener('visibilitychange', handleVisibility);
      };
    });
  };

  initZsAnnouncement();

  document.addEventListener('shopify:section:load', (event) => {
    initZsAnnouncement(event.target);
  });

  document.addEventListener('shopify:section:unload', (event) => {
    event.target.querySelectorAll('[data-zs-announcement]').forEach((bar) => {
      if (bar._zsCleanup) bar._zsCleanup();
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "ZS Premium Announcement",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Handcrafted from pure wood"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
