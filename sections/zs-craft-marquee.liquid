{%- comment -%}
  ZAISEN craftsmanship marquee.
  Seamless horizontal loop using five identical groups (one animation cycle
  equals the width of one group). Shopify editor settings control copy,
  colors, pacing and height. One accessible content group; clones hidden.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign marquee_font = s.marquee_font
  assign marquee_bold = marquee_font | font_modify: 'weight', '700'
  assign brand_logo = s.logo_image | default: settings.logo
-%}
{%- if marquee_font != blank -%}
  {% style %}
    {{ marquee_font | font_face: font_display: 'swap' }}
    {% if marquee_bold != blank %}{{ marquee_bold | font_face: font_display: 'swap' }}{% endif %}
    #zs-craft-marquee-{{ section.id }} {
      font-family: {{ marquee_font.family | json }}, {{ marquee_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}

<section
  id="zs-craft-marquee-{{ section.id }}"
  class="zs-craft-marquee"
  aria-label="ZAISEN craftsmanship"
  style="--zs-craft-bg:{{ s.background_color }};--zs-craft-text:{{ s.text_color }};--zs-craft-accent:{{ s.accent_color }};--zs-craft-duration:{{ s.duration }}s;--zs-craft-height:{{ s.desktop_height }}px;--zs-craft-mobile-height:{{ s.mobile_height }}px;"
>
  <div class="zs-craft-marquee__inner">
    <a class="zs-craft-marquee__brand" href="{{ routes.root_url }}" aria-label="ZAISEN homepage">
      {%- if brand_logo != blank -%}
        {{ brand_logo | image_url: width: 200 | image_tag: class: 'zs-craft-marquee__logo', loading: 'eager', widths: '88,132,200', alt: '' }}
      {%- else -%}
        <span class="zs-craft-marquee__brand-fallback">ZS</span>
      {%- endif -%}
    </a>
    <div class="zs-craft-marquee__viewport">
      <div class="zs-craft-marquee__track">
      {%- for copy in (1..5) -%}
        <div class="zs-craft-marquee__group" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          {%- if s.line_1 != blank -%}
            <span class="zs-craft-marquee__line">{{ s.line_1 | escape }}</span>
            <span class="zs-craft-marquee__separator" aria-hidden="true">✦</span>
          {%- endif -%}
          {%- if s.line_2 != blank -%}
            <span class="zs-craft-marquee__line">{{ s.line_2 | escape }}</span>
            <span class="zs-craft-marquee__separator" aria-hidden="true">✦</span>
          {%- endif -%}
          {%- if s.line_3 != blank -%}
            <span class="zs-craft-marquee__line">{{ s.line_3 | escape }}</span>
            <span class="zs-craft-marquee__separator" aria-hidden="true">✦</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.zs-craft-marquee{
  display:block;
  width:100%;
  margin:0;
  padding:0;
  border:0;
  background:var(--zs-craft-bg,#2B1D17);
  background-image:linear-gradient(100deg,color-mix(in srgb,var(--zs-craft-bg,#2B1D17) 87%,#7A5942),var(--zs-craft-bg,#2B1D17) 31%);
  color:var(--zs-craft-text,#F7F3EE);
  overflow:hidden;
}
.zs-craft-marquee *{box-sizing:border-box}
.zs-craft-marquee__inner{
  display:flex;
  width:100%;
  height:var(--zs-craft-height,48px);
  align-items:stretch;
  overflow:hidden;
}
.zs-craft-marquee__brand{
  position:relative;
  display:flex;
  flex:0 0 84px;
  align-items:center;
  justify-content:center;
  height:100%;
  padding:3px 9px;
  background:transparent;
  color:var(--zs-craft-accent,#D8B56A);
  text-decoration:none;
}
.zs-craft-marquee__logo{
  display:block;
  width:100%;
  max-width:64px;
  height:100%;
  max-height:42px;
  object-fit:contain;
  object-position:center;
}
.zs-craft-marquee__brand-fallback{
  font-size:18px;
  font-weight:700;
  line-height:1;
  letter-spacing:-.045em;
}
.zs-craft-marquee__brand:focus-visible{
  outline:2px solid var(--zs-craft-accent,#D8B56A);
  outline-offset:-3px;
}
.zs-craft-marquee__brand::after{
  content:"";
  position:absolute;
  top:24%;
  right:0;
  width:1px;
  height:52%;
  background:color-mix(in srgb,var(--zs-craft-accent,#D8B56A) 35%,transparent);
}
.zs-craft-marquee__viewport{
  display:flex;
  flex:1 1 auto;
  align-items:center;
  min-width:0;
  height:100%;
  overflow:hidden;
  -webkit-mask-image:linear-gradient(to right,transparent,#000 3%,#000 96%,transparent);
  mask-image:linear-gradient(to right,transparent,#000 3%,#000 96%,transparent);
}
.zs-craft-marquee__track{
  display:flex;
  flex:0 0 auto;
  align-items:center;
  width:max-content;
  min-width:max-content;
  white-space:nowrap;
  animation:zs-craft-marquee-slide var(--zs-craft-duration,42s) linear infinite;
  will-change:transform;
}
.zs-craft-marquee__group{
  display:flex;
  flex:0 0 auto;
  align-items:center;
  justify-content:space-around;
  min-width:100vw;
  white-space:nowrap;
}
.zs-craft-marquee__line{
  display:inline-block;
  flex:0 0 auto;
  font-size:clamp(13px,1vw,15px);
  line-height:1.3;
  font-weight:700;
  letter-spacing:-.025em;
  white-space:nowrap;
}
.zs-craft-marquee__separator{
  display:inline-flex;
  flex:0 0 auto;
  align-items:center;
  justify-content:center;
  margin-inline:clamp(22px,2.4vw,38px);
  font-size:9px;
  line-height:1;
  color:var(--zs-craft-accent,#D8B56A);
  opacity:.88;
}
.zs-craft-marquee:hover .zs-craft-marquee__track,
.zs-craft-marquee:focus-within .zs-craft-marquee__track{
  animation-play-state:paused;
}
@keyframes zs-craft-marquee-slide{
  from{transform:translate3d(0,0,0)}
  to{transform:translate3d(-20%,0,0)}
}
@media(max-width:749px){
  .zs-craft-marquee__inner{height:var(--zs-craft-mobile-height,44px)}
  .zs-craft-marquee__brand{flex-basis:64px;padding:3px 6px}
  .zs-craft-marquee__logo{max-width:52px;max-height:38px}
  .zs-craft-marquee__brand-fallback{font-size:16px}
  .zs-craft-marquee__line{font-size:12px;letter-spacing:-.025em}
  .zs-craft-marquee__separator{font-size:8px;margin-inline:21px}
}
@media(prefers-reduced-motion:reduce){
  .zs-craft-marquee__inner{height:auto;min-height:var(--zs-craft-mobile-height,44px)}
  .zs-craft-marquee__brand{align-self:stretch}
  .zs-craft-marquee__viewport{
    height:auto;
    min-width:0;
    -webkit-mask-image:none;
    mask-image:none;
  }
  .zs-craft-marquee__track{
    width:100%;
    min-width:0;
    white-space:normal;
    animation:none;
    will-change:auto;
  }
  .zs-craft-marquee__group{
    min-width:0;
    width:100%;
    flex-wrap:wrap;
    justify-content:center;
    gap:10px 14px;
    padding:12px 18px;
    white-space:normal;
  }
  .zs-craft-marquee__group:not(:first-child){display:none}
  .zs-craft-marquee__line{white-space:normal;text-align:center}
  .zs-craft-marquee__separator{margin-inline:0}
}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Craft Marquee",
  "tag": "section",
  "class": "section-zs-craft-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Handcrafted messages"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Message 1",
      "default": "From our hands to your home."
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Message 2",
      "default": "Every piece is crafted with care."
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Message 3",
      "default": "Made from pure wood, with attention to every little detail."
    },
    {
      "type": "header",
      "content": "Marquee appearance"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Left logo (defaults to store logo)"
    },
    {
      "type": "font_picker",
      "id": "marquee_font",
      "label": "Font",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2B1D17"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separators",
      "default": "#D8B56A"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll time",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 44,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 40,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Craft Marquee"
    }
  ]
}
{% endschema %}
