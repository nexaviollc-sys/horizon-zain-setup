{% liquid
  assign s = section.settings
  assign lead_block = nil
  assign num_items = 0
  for block in section.blocks
    if block.settings.product != blank
      assign num_items = num_items | plus: 1
      if lead_block == nil
        assign lead_block = block
      endif
    endif
  endfor
  assign lead = lead_block.settings.product
  assign lead_price = lead.price
  assign lead_compare = lead.compare_at_price
  if lead.selected_or_first_available_variant != blank
    assign lead_price = lead.selected_or_first_available_variant.price
    assign lead_compare = lead.selected_or_first_available_variant.compare_at_price
  endif
  assign lead_discount = 0
  if lead_compare != blank and lead_compare > lead_price and lead_compare > 0
    assign lead_discount = lead_compare | minus: lead_price | times: 100.0 | divided_by: lead_compare | round
  endif
  assign carousel_collection = s.collection
  assign remaining_count = 0
  if carousel_collection != blank
    for candidate in carousel_collection.products
      assign already_featured = false
      for product_block in section.blocks
        if product_block.settings.product != blank and product_block.settings.product.id == candidate.id
          assign already_featured = true
          break
        endif
      endfor
      unless already_featured
        assign remaining_count = remaining_count | plus: 1
      endunless
    endfor
  endif
  assign typeface = s.editorial_font
  assign font_light = typeface | font_modify: 'weight', '300'
  assign font_semibold = typeface | font_modify: 'weight', '600'
%}
{% if typeface != blank %}
{% style %}
  {{ typeface | font_face: font_display: 'swap' }}
  {% if font_light != blank %}{{ font_light | font_face: font_display: 'swap' }}{% endif %}
  {% if font_semibold != blank %}{{ font_semibold | font_face: font_display: 'swap' }}{% endif %}
  #zs-kitchen-{{ section.id }}{font-family:{{ typeface.family | json }},{{ typeface.fallback_families }}}
{% endstyle %}
{% endif %}
{% style %}
#zs-kitchen-{{ section.id }}{
  --zk-bg:{{ s.background }};--zk-ink:{{ s.ink }};
  --zk-muted:{{ s.muted }};--zk-gold:{{ s.accent }};
  --zk-top:{{ s.padding_top }}px;--zk-bottom:{{ s.padding_bottom }}px;
}
{% endstyle %}
{% if lead != blank %}
<section id="zs-kitchen-{{ section.id }}" class="zs-kitchen" aria-labelledby="zs-kitchen-heading-{{ section.id }}">
  <div class="zs-kitchen__wrap">
    <header class="zs-kitchen__header">
      <div class="zs-kitchen__intro-wrap">
        {% if s.eyebrow != blank %}<p class="zs-kitchen__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>{% endif %}
        <h2 class="zs-kitchen__heading" id="zs-kitchen-heading-{{ section.id }}"><span>{{ s.title_light | escape }}</span> <strong>{{ s.title_bold | escape }}</strong></h2>
        {% if s.description != blank %}<p class="zs-kitchen__intro">{{ s.description | escape }}</p>{% endif %}
      </div>
      {% if s.collection != blank %}
      <a class="zs-kitchen__collection-cta" href="{{ s.collection.url }}">{{ s.button_label | escape }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg>
      </a>
      {% endif %}
    </header>
    <div class="zs-kitchen__body{% if num_items == 1 %} zs-kitchen__body--single{% endif %}">
      {% assign lead_picture = lead_block.settings.image_override | default: lead.featured_image %}
      <article class="zs-kitchen__featured" {{ lead_block.shopify_attributes }}>
        <div class="zs-kitchen__featured-photo">
          <span class="zs-kitchen__number" aria-hidden="true">01 / 0{{ num_items }}</span>
          <a href="{{ lead.url }}" aria-label="Shop {{ lead.title | escape }}" class="zs-kitchen__featured-image-link">
            {% if lead_picture != blank %}
              {{ lead_picture | image_url: width: 1400 | image_tag: class: 'zs-kitchen__featured-img', alt: lead.title, widths: '480,720,960,1200,1400', sizes: '(min-width: 950px) 48vw, 100vw', loading: 'lazy' }}
            {% else %}<span class="zs-kitchen__no-image">ZAISEN</span>{% endif %}
          </a>
          {% if lead_discount > 0 %}<span class="zs-kitchen__discount" aria-label="{{ lead_discount }} percent off">-{{ lead_discount }}%</span>{% endif %}
        </div>
        <div class="zs-kitchen__featured-details">
          <div class="zs-kitchen__featured-copy">
            <p class="zs-kitchen__type-label">{{ s.feature_label | escape }}</p>
            <h3><a href="{{ lead.url }}">{{ lead.title | escape }}</a></h3>
            <div class="zs-kitchen__price"><span>{{ lead_price | money }}</span>
              {% if lead_discount > 0 %}<s>{{ lead_compare | money }}</s>{% endif %}
              {% unless lead.available %}<span class="zs-kitchen__sold-out">{{ s.sold_out_text | escape }}</span>{% endunless %}
            </div>
          </div>
          <a href="{{ lead.url }}" class="zs-kitchen__featured-arrow" aria-label="View {{ lead.title | escape }}"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"/></svg></a>
        </div>
      </article>
      {% if num_items > 1 %}
      <div class="zs-kitchen__products" aria-label="{{ s.picks_label | escape }}">
        {% for block in section.blocks %}
          {% assign item = block.settings.product %}
          {% if item != blank and block.id != lead_block.id %}
            {% assign photo = block.settings.image_override | default: item.featured_image %}
            {% assign item_price = item.price %}
            {% assign item_compare = item.compare_at_price %}
            {% if item.selected_or_first_available_variant != blank %}
              {% assign item_price = item.selected_or_first_available_variant.price %}
              {% assign item_compare = item.selected_or_first_available_variant.compare_at_price %}
            {% endif %}
            {% assign item_discount = 0 %}
            {% if item_compare != blank and item_compare > item_price and item_compare > 0 %}
              {% assign item_discount = item_compare | minus: item_price | times: 100.0 | divided_by: item_compare | round %}
            {% endif %}
            <article class="zs-kitchen__product" {{ block.shopify_attributes }}>
              <a href="{{ item.url }}" class="zs-kitchen__product-image-link" aria-label="Shop {{ item.title | escape }}">
                {% if photo != blank %}
                  {{ photo | image_url: width: 620 | image_tag: class: 'zs-kitchen__product-img', alt: item.title, widths: '220,350,500,620', sizes: '(min-width: 950px) 180px, 33vw', loading: 'lazy' }}
                {% else %}<span class="zs-kitchen__no-image">ZAISEN</span>{% endif %}
                {% if item_discount > 0 %}<span class="zs-kitchen__discount" aria-label="{{ item_discount }} percent off">-{{ item_discount }}%</span>{% endif %}
              </a>
              <div class="zs-kitchen__product-copy">
                {% if block.settings.label != blank %}<p class="zs-kitchen__type-label">{{ block.settings.label | escape }}</p>{% endif %}
                <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                <div class="zs-kitchen__price"><span>{{ item_price | money }}</span>
                  {% if item_discount > 0 %}<s>{{ item_compare | money }}</s>{% endif %}
                </div>
                {% unless item.available %}<span class="zs-kitchen__sold-out">{{ s.sold_out_text | escape }}</span>{% endunless %}
              </div>
              <a href="{{ item.url }}" class="zs-kitchen__product-arrow" aria-label="View {{ item.title | escape }}"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if s.show_carousel and remaining_count > 0 %}
    <div class="zs-kitchen__carousel-area" aria-label="{{ s.carousel_title | escape }}">
      <div class="zs-kitchen__carousel-header">
        <div>
          {% if s.carousel_eyebrow != blank %}<p class="zs-kitchen__eyebrow zs-kitchen__carousel-eyebrow"><span aria-hidden="true"></span>{{ s.carousel_eyebrow | escape }}</p>{% endif %}
          <h3 class="zs-kitchen__carousel-title">{{ s.carousel_title | escape }}</h3>
          {% if s.carousel_description != blank %}<p class="zs-kitchen__carousel-description">{{ s.carousel_description | escape }}</p>{% endif %}
        </div>
        <div class="zs-kitchen__carousel-controls">
          <button class="zs-kitchen__carousel-control" type="button" data-zk-prev aria-label="Previous kitchen products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
          </button>
          <button class="zs-kitchen__carousel-control" type="button" data-zk-next aria-label="Next kitchen products">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </button>
        </div>
      </div>
      <div class="zs-kitchen__carousel-track" data-zk-track tabindex="0" role="region" aria-roledescription="carousel" aria-label="More handcrafted wooden kitchen and dining products">
        {% for candidate in carousel_collection.products %}
          {% assign already_featured = false %}
          {% for product_block in section.blocks %}
            {% if product_block.settings.product != blank and product_block.settings.product.id == candidate.id %}
              {% assign already_featured = true %}
              {% break %}
            {% endif %}
          {% endfor %}
          {% unless already_featured %}
            {% assign candidate_price = candidate.price %}
            {% assign candidate_compare = candidate.compare_at_price %}
            {% assign candidate_variant = candidate.selected_or_first_available_variant %}
            {% if candidate_variant != blank %}
              {% assign candidate_price = candidate_variant.price %}
              {% assign candidate_compare = candidate_variant.compare_at_price %}
            {% endif %}
            {% assign show_urgency_for_candidate = false %}
            {% if s.show_urgency and s.urgency_product != blank and candidate.id == s.urgency_product.id and candidate_variant != blank %}
              {% if candidate.available and candidate_variant.inventory_management == 'shopify' and candidate_variant.inventory_policy != 'continue' and candidate_variant.inventory_quantity > 0 and candidate_variant.inventory_quantity <= s.urgency_threshold %}
                {% assign show_urgency_for_candidate = true %}
              {% endif %}
            {% endif %}
            {% assign candidate_discount = 0 %}
            {% if candidate_compare != blank and candidate_compare > candidate_price and candidate_compare > 0 %}
              {% assign candidate_discount = candidate_compare | minus: candidate_price | times: 100.0 | divided_by: candidate_compare | round %}
            {% endif %}
            <article class="zs-kitchen__carousel-product">
              <a href="{{ candidate.url }}" class="zs-kitchen__carousel-link" aria-label="Discover {{ candidate.title | escape }}">
                <div class="zs-kitchen__carousel-photo">
                  {% if candidate.featured_image != blank %}
                    {{ candidate.featured_image | image_url: width: 700 | image_tag: class: 'zs-kitchen__carousel-img', alt: candidate.title, widths: '180,300,450,600,700', sizes: '(min-width: 1100px) 22vw, (min-width: 750px) 33vw, 44vw', loading: 'lazy' }}
                  {% else %}
                    <span class="zs-kitchen__no-image">ZAISEN</span>
                  {% endif %}
                  {% if candidate_discount > 0 %}<span class="zs-kitchen__discount" aria-label="{{ candidate_discount }} percent off">-{{ candidate_discount }}%</span>{% endif %}
                  {% if show_urgency_for_candidate %}
                    <span class="zs-kitchen__urgency-badge" aria-label="Only {{ candidate_variant.inventory_quantity }} remaining in stock"><span class="zs-kitchen__urgency-dot" aria-hidden="true"></span>Only {{ candidate_variant.inventory_quantity }} left</span>
                  {% endif %}
                </div>
                <div class="zs-kitchen__carousel-copy">
                  <h4>{{ candidate.title | escape }}</h4>
                  <div class="zs-kitchen__price">
                    <span>{{ candidate_price | money }}</span>
                    {% if candidate_discount > 0 %}<s>{{ candidate_compare | money }}</s>{% endif %}
                  </div>
                  {% unless candidate.available %}<span class="zs-kitchen__sold-out">{{ s.sold_out_text | escape }}</span>{% endunless %}
                </div>
              </a>
              <a href="{{ candidate.url }}" class="zs-kitchen__carousel-cta" aria-label="View product: {{ candidate.title | escape }}">
                {{ s.carousel_product_button | escape }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </a>
            </article>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% if s.bottom_text != blank %}<p class="zs-kitchen__footnote">{{ s.bottom_text | escape }}</p>{% endif %}
    {% if s.collection != blank %}
      <a class="zs-kitchen__mobile-cta" href="{{ s.collection.url }}">{{ s.button_label | escape }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>
</section>
{% endif %}
{% stylesheet %}
.zs-kitchen{background:var(--zk-bg,#fff);color:var(--zk-ink,#2b1d17);padding:var(--zk-top,76px) 0 var(--zk-bottom,80px)}
.zs-kitchen *{box-sizing:border-box}
.zs-kitchen__wrap{width:100%;max-width:1440px;margin:auto;padding:0 clamp(18px,4vw,58px)}
.zs-kitchen__header{display:flex;justify-content:space-between;align-items:flex-end;gap:34px;margin-bottom:32px}
.zs-kitchen__intro-wrap{max-width:820px;min-width:0}
.zs-kitchen__eyebrow{display:flex;gap:13px;align-items:center;margin:0 0 17px;color:#906d4d;letter-spacing:.16em;font-weight:600;font-size:10px;text-transform:uppercase}
.zs-kitchen__eyebrow span{display:block;width:29px;height:2px;background:var(--zk-gold,#d8b56a)}
.zs-kitchen__heading{margin:0;font-family:inherit!important;letter-spacing:-.05em;line-height:1.18;font-size:clamp(34px,3.8vw,56px)}
.zs-kitchen__heading span{font-weight:300}
.zs-kitchen__heading strong{font-weight:600}
.zs-kitchen__intro{margin:14px 0 0;max-width:720px;color:var(--zk-muted,#80736a);font-size:13px;line-height:1.8}
.zs-kitchen__collection-cta{display:inline-flex;align-items:center;gap:16px;flex-shrink:0;padding:0 0 11px;border-bottom:1px solid #cdbca7;text-decoration:none;font-size:12px;font-weight:600;white-space:nowrap;color:var(--zk-ink,#2b1d17)}
.zs-kitchen__collection-cta svg,.zs-kitchen__mobile-cta svg{width:19px;height:19px}
.zs-kitchen__collection-cta:hover{border-color:var(--zk-ink,#2b1d17)}
.zs-kitchen__body{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(0,1fr);gap:17px}
.zs-kitchen__body--single{grid-template-columns:1fr}
.zs-kitchen__featured{min-width:0;display:flex;flex-direction:column;justify-content:space-between;background:#f7f3ed;border:1px solid #efe7dc;border-radius:18px;overflow:hidden}
.zs-kitchen__featured-photo{position:relative;flex:0 0 auto;width:100%;aspect-ratio:1 / 1;height:auto;min-height:0;overflow:hidden;background:#f7f3ed}
.zs-kitchen__number{position:absolute;top:23px;left:24px;z-index:1;font-size:10px;font-weight:600;letter-spacing:.16em;color:#8e7966}
.zs-kitchen__featured-image-link{position:absolute;inset:0;display:block;width:100%;height:100%;min-height:0;padding:0;overflow:hidden}
.zs-kitchen__featured-img{display:block;max-height:none;height:100%;width:100%;object-fit:contain;object-position:center;transition:opacity .25s}
.zs-kitchen__featured-image-link:hover .zs-kitchen__featured-img{opacity:.97}
.zs-kitchen__photo-label{position:absolute;left:23px;bottom:19px;background:rgba(255,255,255,.86);padding:8px 12px;border-radius:5px;font-size:9px;font-weight:600;letter-spacing:.12em;color:#785a42}
.zs-kitchen__featured-details{display:flex;justify-content:space-between;align-items:center;gap:14px;background:#fffdfb;border-top:1px solid #ede6dc;padding:25px 28px}
.zs-kitchen__featured-copy{min-width:0}
.zs-kitchen__type-label{font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:#96704e;font-weight:600;margin:0 0 8px}
.zs-kitchen h3{font-family:inherit!important;letter-spacing:-.02em;line-height:1.4;margin:0}
.zs-kitchen h3 a{color:var(--zk-ink,#2b1d17);text-decoration:none}
.zs-kitchen h3 a:hover{text-decoration:underline;text-underline-offset:3px}
.zs-kitchen__featured h3{font-size:clamp(16px,1.45vw,20px);font-weight:600}
.zs-kitchen__price{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:9px;color:#593f2c;font-size:14px;font-weight:600}
.zs-kitchen__price s{font-size:11px;color:#9f9287;font-weight:400}
.zs-kitchen__sold-out{color:#955943;font-size:10px;font-weight:500}
.zs-kitchen__featured-arrow{flex:0 0 44px;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;color:#fff;background:#2b1d17;transition:background .2s}
.zs-kitchen__featured-arrow:hover{background:#59402e}
.zs-kitchen__featured-arrow svg{width:19px;height:19px}
.zs-kitchen__products{min-width:0;display:grid;grid-template-rows:repeat(4,minmax(0,1fr));gap:13px}
.zs-kitchen__product{min-width:0;display:grid;grid-template-columns:minmax(125px,32%) minmax(0,1fr) 22px;align-items:center;gap:17px;border:1px solid #eee7de;background:#fcfaf7;border-radius:14px;overflow:hidden;min-height:151px;padding:0 14px 0 0;transition:transform .2s,border-color .2s}
.zs-kitchen__product:hover{transform:translateY(-2px);border-color:#dcc6ac}
.zs-kitchen__product-image-link{position:relative;display:block;align-self:stretch;height:100%;min-height:132px;padding:0;background:#f3eee8;border-radius:0;overflow:hidden}
.zs-kitchen__product-img{position:absolute;inset:0;display:block;width:100%;height:100%;max-height:none;object-fit:cover;object-position:center}
.zs-kitchen__product-copy{min-width:0}
.zs-kitchen__product h3{font-size:clamp(13px,1.12vw,16px);font-weight:600}
.zs-kitchen__product .zs-kitchen__price{font-size:13px}
.zs-kitchen__product-arrow{display:grid;place-items:center;width:22px;color:#76533d}
.zs-kitchen__product-arrow svg{width:20px;height:20px}
.zs-kitchen__no-image{display:grid;place-items:center;width:100%;min-height:125px;color:#a28a72;letter-spacing:.18em}
.zs-kitchen__footnote{font-size:11px;color:#998a7d;margin:17px 0 0;line-height:1.7}
.zs-kitchen__mobile-cta{display:none}
.zs-kitchen a:focus-visible{outline:2px solid var(--zk-gold,#d8b56a);outline-offset:4px}

/* Discount badges use the same sizing and colors as ZAISEN Best Sellers. */
.zs-kitchen__discount{position:absolute;top:12px;left:12px;z-index:2;display:inline-flex;align-items:center;justify-content:center;min-height:27px;padding:5px 9px;border-radius:7px;background:#285B45;color:#FFFFFF;font-size:11px;font-weight:600;line-height:1.2;letter-spacing:.015em;box-shadow:0 2px 7px rgba(43,29,23,.1);pointer-events:none}
.zs-kitchen__number{left:auto;right:24px;text-shadow:0 1px 4px rgba(255,255,255,.7)}
.zs-kitchen__carousel-area{margin-top:38px}
.zs-kitchen__carousel-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}
.zs-kitchen__carousel-eyebrow{margin-bottom:10px}
.zs-kitchen__carousel-title{font-family:inherit!important;font-weight:600;font-size:clamp(22px,2.2vw,31px);letter-spacing:-.035em;line-height:1.25;margin:0}
.zs-kitchen__carousel-description{margin:8px 0 0;color:var(--zk-muted,#80736a);font-size:12px;line-height:1.6}
.zs-kitchen__carousel-controls{display:flex;gap:9px;flex-shrink:0}
.zs-kitchen__carousel-control{display:grid;place-items:center;width:38px;height:38px;border:1px solid #ddcdbb;border-radius:50%;background:#fff;color:var(--zk-ink,#2b1d17);cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.zs-kitchen__carousel-control:not(:disabled):hover{background:#2b1d17;color:#fff;border-color:#2b1d17}
.zs-kitchen__carousel-control:disabled{opacity:.35;cursor:default}
.zs-kitchen__carousel-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 54px)/4);gap:18px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:1px;scrollbar-width:none;-ms-overflow-style:none;padding:2px 1px 12px}
.zs-kitchen__carousel-track::-webkit-scrollbar{display:none}
.zs-kitchen__carousel-track:focus-visible{outline:2px solid var(--zk-gold,#d8b56a);outline-offset:3px}
.zs-kitchen__carousel-product{min-width:0;scroll-snap-align:start;display:flex;flex-direction:column}
.zs-kitchen__carousel-link{display:block;flex:1 1 auto;color:inherit;text-decoration:none}
.zs-kitchen__carousel-photo{position:relative;display:grid;place-items:center;aspect-ratio:1;background:#fff;border:1px solid #f0ebe5;border-radius:13px;overflow:hidden}
.zs-kitchen__carousel-img{width:100%;height:100%;display:block;object-fit:contain;object-position:center}
.zs-kitchen__carousel-copy{padding:12px 1px 0}
.zs-kitchen__carousel-copy h4{font-family:inherit!important;color:var(--zk-ink,#2b1d17);font-size:clamp(12px,1vw,14px);font-weight:600;line-height:1.45;margin:0;letter-spacing:-.015em}
.zs-kitchen__carousel-link:hover h4{text-decoration:underline;text-underline-offset:3px}
.zs-kitchen__carousel-copy .zs-kitchen__price{margin-top:8px;font-size:13px}
.zs-kitchen__carousel-cta{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:42px;margin-top:16px;padding:10px 15px;border:1px solid #3a2920;border-radius:9px;background:#35241b;color:#fff;text-decoration:none;font-family:inherit;font-size:12px;font-weight:600;letter-spacing:.02em;transition:background .2s,border-color .2s,transform .2s}
.zs-kitchen__carousel-cta svg{flex:0 0 auto}
.zs-kitchen__carousel-cta:hover{background:#62432e;border-color:#62432e;color:#fff;transform:translateY(-1px)}
.zs-kitchen__urgency-badge{position:absolute;top:12px;right:12px;z-index:2;display:inline-flex;align-items:center;gap:6px;min-height:27px;padding:5px 9px;border-radius:7px;background:#257247;color:#fff;font-size:11px;font-weight:600;line-height:1.2;white-space:nowrap;box-shadow:0 2px 7px rgba(19,76,44,.15);pointer-events:none}
.zs-kitchen__urgency-dot{width:6px;height:6px;border-radius:50%;background:#c6f2d5;flex:0 0 auto}
@media(max-width:1100px){.zs-kitchen__carousel-track{grid-auto-columns:calc((100% - 30px)/3);gap:15px}}
@media(max-width:749px){
.zs-kitchen__number{left:auto;right:17px}
.zs-kitchen__discount{top:9px;left:9px;min-height:24px;padding:4px 7px;font-size:10px}
.zs-kitchen__carousel-area{margin-top:27px}
.zs-kitchen__carousel-header{gap:12px;margin-bottom:14px}
.zs-kitchen__carousel-title{font-size:21px}
.zs-kitchen__carousel-description{font-size:11px}
.zs-kitchen__carousel-controls{gap:6px}
.zs-kitchen__carousel-control{position:relative;width:34px;height:34px}
.zs-kitchen__carousel-control::after{content:'';position:absolute;inset:-5px}
.zs-kitchen__carousel-track{grid-auto-columns:calc((100% - 12px)/2.1);gap:12px}
.zs-kitchen__carousel-copy h4{font-size:12px}
.zs-kitchen__carousel-copy .zs-kitchen__price{font-size:12px;gap:6px}
.zs-kitchen__urgency-badge{top:9px;right:9px;min-height:24px;padding:4px 7px;font-size:10px;gap:4px}
.zs-kitchen__carousel-cta{min-height:44px;margin-top:12px;padding:9px 11px;font-size:11px}
}
@media(max-width:1100px){
.zs-kitchen__body{grid-template-columns:1fr 1fr}
.zs-kitchen__product{grid-template-columns:minmax(100px,32%) minmax(0,1fr) 18px;gap:11px;padding-right:9px}
.zs-kitchen__featured-details{padding:20px}
}
@media(max-width:850px){
.zs-kitchen__header{display:block}
.zs-kitchen__collection-cta{margin-top:17px}
.zs-kitchen__body{grid-template-columns:1fr}
.zs-kitchen__products{grid-template-rows:repeat(4,auto)}
.zs-kitchen__product{grid-template-columns:145px minmax(0,1fr) 25px;min-height:136px}
}
@media(max-width:749px){
.zs-kitchen{padding-top:min(var(--zk-top,60px),60px);padding-bottom:min(var(--zk-bottom,60px),65px)}
.zs-kitchen__wrap{padding:0 16px}
.zs-kitchen__header{margin-bottom:22px}
.zs-kitchen__eyebrow{font-size:9px;margin-bottom:13px}
.zs-kitchen__heading{font-size:clamp(30px,8.1vw,44px)}
.zs-kitchen__intro{font-size:12px;line-height:1.75;margin-top:12px}
.zs-kitchen__collection-cta{display:none}
.zs-kitchen__body{gap:11px}
.zs-kitchen__featured{border-radius:14px}
.zs-kitchen__featured-photo{width:100%;aspect-ratio:1 / 1;min-height:0;height:auto;flex:0 0 auto}
.zs-kitchen__featured-image-link{min-height:0;padding:0}
.zs-kitchen__featured-img{max-height:none}
.zs-kitchen__number{left:auto;right:17px;top:17px}
.zs-kitchen__photo-label{left:15px;bottom:13px;padding:6px 9px;font-size:8px}
.zs-kitchen__featured-details{padding:17px}
.zs-kitchen__featured h3{font-size:15px}
.zs-kitchen__featured-arrow{flex-basis:38px;width:38px;height:38px}
.zs-kitchen__products{gap:10px}
.zs-kitchen__product{grid-template-columns:minmax(0,38%) minmax(0,1fr) 17px;min-height:0;gap:10px;padding:0 9px 0 0;border-radius:11px}
.zs-kitchen__product-image-link{align-self:center;width:100%;height:auto;aspect-ratio:1 / 1;min-height:0;padding:0;border-radius:0;background:#fcfaf7}
.zs-kitchen__product-img{inset:0;top:0;width:100%;height:100%;aspect-ratio:auto;max-height:none;object-fit:contain;object-position:center;transform:none}
.zs-kitchen__product h3{font-size:12px}
.zs-kitchen__product .zs-kitchen__type-label{font-size:8px;margin-bottom:5px}
.zs-kitchen__product .zs-kitchen__price{font-size:12px;gap:5px;margin-top:6px}
.zs-kitchen__product .zs-kitchen__price s{font-size:10px}
.zs-kitchen__product-arrow,.zs-kitchen__product-arrow svg{width:17px}
.zs-kitchen__footnote{font-size:10px}
.zs-kitchen__mobile-cta{display:flex;align-items:center;justify-content:space-between;margin-top:19px;background:#2b1d17;color:#fff;padding:14px 17px;text-decoration:none;font-weight:600;font-size:12px;border-radius:9px}
}
@media(max-width:390px){
.zs-kitchen__product{grid-template-columns:minmax(0,43%) minmax(0,1fr) 16px;gap:8px}
}
@media(prefers-reduced-motion:reduce){
.zs-kitchen__featured-img,.zs-kitchen__product{transition:none}
.zs-kitchen__featured-image-link:hover .zs-kitchen__featured-img{opacity:1}
.zs-kitchen__product:hover,.zs-kitchen__carousel-cta:hover{transform:none}
}
{% endstylesheet %}
{% javascript %}
(function(){
  function initZaisenKitchen(){
    document.querySelectorAll('.zs-kitchen').forEach(function(section){
      var track=section.querySelector('[data-zk-track]');
      var prev=section.querySelector('[data-zk-prev]');
      var next=section.querySelector('[data-zk-next]');
      if(!track||!prev||!next||track.dataset.zkReady==='true')return;
      track.dataset.zkReady='true';
      function refresh(){
        var max=Math.max(0,track.scrollWidth-track.clientWidth);
        prev.disabled=track.scrollLeft<=2;
        next.disabled=track.scrollLeft>=max-2;
      }
      function move(direction){
        var card=track.querySelector('.zs-kitchen__carousel-product');
        if(!card)return;
        var gap=parseFloat(getComputedStyle(track).columnGap)||0;
        var width=card.getBoundingClientRect().width+gap;
        var visible=Math.max(1,Math.floor((track.clientWidth+gap)/width));
        var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({left:direction*width*visible,behavior:reduced?'auto':'smooth'});
      }
      prev.addEventListener('click',function(){move(-1)});
      next.addEventListener('click',function(){move(1)});
      track.addEventListener('scroll',refresh,{passive:true});
      window.addEventListener('resize',refresh);
      refresh();
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initZaisenKitchen,{once:true});
  else initZaisenKitchen();
  document.addEventListener('shopify:section:load',initZaisenKitchen);
})();
{% endjavascript %}
