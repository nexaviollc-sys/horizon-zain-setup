{%- liquid
  assign s = section.settings
  assign contact_email = s.contact_email | default: shop.email
  assign contact_phone = s.contact_phone
  assign phone_href = s.phone_link | default: contact_phone
  assign display_font = s.editorial_font
  assign light_font = display_font | font_modify: 'weight', '300'
  assign medium_font = display_font | font_modify: 'weight', '500'
  assign bold_font = display_font | font_modify: 'weight', '700'
-%}
{%- if display_font != blank -%}
  {% style %}
    {{ display_font | font_face: font_display: 'swap' }}
    {% if light_font != blank %}{{ light_font | font_face: font_display: 'swap' }}{% endif %}
    {% if medium_font != blank %}{{ medium_font | font_face: font_display: 'swap' }}{% endif %}
    {% if bold_font != blank %}{{ bold_font | font_face: font_display: 'swap' }}{% endif %}
    #zs-contact-{{ section.id }} {
      font-family: {{ display_font.family | json }}, {{ display_font.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}

<section id="zs-contact-{{ section.id }}" class="zs-contact" style="
  --zs-bg:{{ s.bg_color }};
  --zs-surface:{{ s.surface_color }};
  --zs-text:{{ s.text_color }};
  --zs-muted:{{ s.muted_color }};
  --zs-accent:{{ s.accent_color }};
  --zs-deep:{{ s.deep_wood }};
">
  <div class="zs-contact__shell">
    <div class="zs-contact__intro">
      {% if s.eyebrow != blank %}
        <p class="zs-contact__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="zs-contact__title">{{ s.heading }}</h1>
      <div class="zs-contact__lead">{{ s.subheading }}</div>

      <div class="zs-contact__channels" aria-label="Contact ZAISEN">
        {% if contact_email != blank %}
          <div class="zs-contact__channel">
            <span class="zs-contact__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="m3 7 9 6 9-6"/>
              </svg>
            </span>
            <div class="zs-contact__channel-copy">
              <span class="zs-contact__channel-label">Email ZAISEN</span>
              <a class="zs-contact__contact-link" href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M7 5h12v12"/></svg>
              </a>
            </div>
          </div>
        {% endif %}
        {% if contact_phone != blank %}
          <div class="zs-contact__channel">
            <span class="zs-contact__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16.8v2.9a2 2 0 0 1-2.2 2A18.6 18.6 0 0 1 2.3 5.2 2 2 0 0 1 4.3 3h2.9a2 2 0 0 1 2 1.6l.6 2.8a2 2 0 0 1-.6 1.9L7.5 11a15 15 0 0 0 5.5 5.5l1.7-1.7a2 2 0 0 1 1.9-.6l2.8.6a2 2 0 0 1 1.6 2Z"/>
              </svg>
            </span>
            <div class="zs-contact__channel-copy">
              <span class="zs-contact__channel-label">Call ZAISEN</span>
              <a class="zs-contact__contact-link" href="tel:{{ phone_href | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ contact_phone | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M7 5h12v12"/></svg>
              </a>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="zs-contact__help-notes">
        {% if s.response_text != blank %}
          <p><span aria-hidden="true"></span>{{ s.response_text | escape }}</p>
        {% endif %}
        {% if s.order_text != blank %}
          <p><span aria-hidden="true"></span>{{ s.order_text | escape }}</p>
        {% endif %}
      </div>

      {% if s.note_title != blank or s.note_text != blank %}
        <div class="zs-contact__craft-note">
          {% if settings.logo != blank %}
            {{ settings.logo | image_url: width: 100 | image_tag: class: 'zs-contact__brand-mark', loading: 'lazy', widths: '50, 100', sizes: '46px', alt: 'ZAISEN' }}
          {% else %}
            <span class="zs-contact__brand-fallback">ZS</span>
          {% endif %}
          <div>
            {% if s.note_title != blank %}<strong>{{ s.note_title | escape }}</strong>{% endif %}
            {% if s.note_text != blank %}<p>{{ s.note_text | escape }}</p>{% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="zs-contact__form-panel">
      <div class="zs-contact__form-heading">
        <p class="zs-contact__form-kicker">{{ s.form_kicker | escape }}</p>
        <h2>{{ s.form_heading | escape }}</h2>
        <p>{{ s.form_text | escape }}</p>
      </div>
      {% form 'contact', class: 'zs-contact__form' %}
        {% if form.posted_successfully? %}
          <div class="zs-contact__success" role="status">
            <strong>Message received.</strong>
            <p>Thank you for contacting ZAISEN. We’ll get back to you as soon as possible.</p>
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="zs-contact__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="zs-contact__fields-row">
          <div class="zs-contact__field">
            <label for="zs-contact-name-{{ section.id }}">Your name</label>
            <input id="zs-contact-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name"
              value="{{ form.name | escape }}" placeholder="Your name">
          </div>
          <div class="zs-contact__field">
            <label for="zs-contact-email-{{ section.id }}">Email address <span aria-hidden="true">*</span></label>
            <input id="zs-contact-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email"
              autocorrect="off" autocapitalize="off" required
              value="{{ form.email | escape }}" placeholder="you@example.com">
          </div>
        </div>

        <div class="zs-contact__fields-row">
          <div class="zs-contact__field">
            <label for="zs-contact-phone-{{ section.id }}">Phone <small>(optional)</small></label>
            <input id="zs-contact-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel"
              value="{{ form.phone | escape }}" placeholder="Your phone number">
          </div>
          <div class="zs-contact__field">
            <label for="zs-contact-order-{{ section.id }}">Order number <small>(optional)</small></label>
            <input id="zs-contact-order-{{ section.id }}" type="text" name="contact[Order number]" placeholder="e.g. #1001">
          </div>
        </div>

        <div class="zs-contact__field">
          <label for="zs-contact-message-{{ section.id }}">Your message <span aria-hidden="true">*</span></label>
          <textarea id="zs-contact-message-{{ section.id }}" name="contact[body]" rows="5" required
            placeholder="Tell us what we can help you with…">{{ form.body | escape }}</textarea>
        </div>

        <div class="zs-contact__submit-row">
          <button type="submit" class="zs-contact__submit">
            Send message
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </button>
          <p class="zs-contact__privacy">We'll use your details only to respond to your inquiry.</p>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
.zs-contact{
  background:var(--zs-bg,#FFFFFF);
  color:var(--zs-text,#2B1D17);
  padding:clamp(55px,6.7vw,96px) 0 clamp(60px,6.7vw,100px);
  font-family:inherit;
}
.zs-contact *{box-sizing:border-box}
.zs-contact__shell{
  width:100%;max-width:1440px;margin:0 auto;
  padding:0 clamp(20px,4vw,58px);
  display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);
  align-items:start;gap:clamp(50px,7.5vw,125px);
}
.zs-contact__intro{min-width:0;padding-top:15px}
.zs-contact__eyebrow{
  display:flex;align-items:center;gap:13px;margin:0 0 24px;
  font-size:10px;font-weight:500;line-height:1.4;letter-spacing:.17em;
  color:#947255;text-transform:uppercase;
}
.zs-contact__eyebrow span{width:28px;height:2px;background:var(--zs-accent,#D8B56A);flex-shrink:0}
.zs-contact__title{
  max-width:12ch;margin:0;
  color:var(--zs-text,#2B1D17);
  font-family:inherit!important;
  font-size:clamp(45px,5.1vw,72px);font-weight:300;line-height:1.11;letter-spacing:-.06em;
}
.zs-contact__title em{font-style:normal;font-weight:700;color:var(--zs-text,#2B1D17)}
.zs-contact__lead{
  max-width:48ch;margin:22px 0 0;
  color:var(--zs-muted,#80736A);font-size:14px;line-height:1.85;
}
.zs-contact__lead p{margin:0}
.zs-contact__channels{display:grid;gap:0;margin-top:40px}
.zs-contact__channel{
  display:flex;align-items:center;gap:18px;padding:18px 0;
  border-top:1px solid #E9E1D9;
}
.zs-contact__channel:last-child{border-bottom:1px solid #E9E1D9}
.zs-contact__icon{
  display:grid;place-items:center;flex:0 0 40px;
  width:40px;height:40px;color:#72503B;
}
.zs-contact__icon svg{display:block;width:25px;height:25px}
.zs-contact__channel-copy{display:flex;flex-direction:column;gap:6px;min-width:0}
.zs-contact__channel-label{
  font-size:10px;letter-spacing:.13em;line-height:1.3;
  font-weight:500;color:#937C6A;text-transform:uppercase;
}
.zs-contact__contact-link{
  display:inline-flex;align-items:center;gap:9px;
  color:var(--zs-text,#2B1D17);font-size:clamp(14px,1.15vw,17px);
  font-weight:600;line-height:1.45;overflow-wrap:anywhere;text-decoration:none;
  transition:color .2s ease;
}
.zs-contact__contact-link svg{
  width:16px;height:16px;flex:0 0 16px;transition:transform .2s ease;
}
.zs-contact__contact-link:hover{color:#9B6F48}
.zs-contact__contact-link:hover svg{transform:translate(2px,-2px)}
.zs-contact__help-notes{display:grid;gap:7px;padding-top:21px}
.zs-contact__help-notes p{display:flex;align-items:flex-start;gap:10px;margin:0;color:var(--zs-muted,#80736A);font-size:12px;line-height:1.6}
.zs-contact__help-notes p span{width:5px;height:5px;flex:0 0 5px;margin-top:8px;border-radius:50%;background:var(--zs-accent,#D8B56A)}
.zs-contact__craft-note{
  display:flex;align-items:center;gap:17px;
  margin-top:clamp(28px,3.4vw,50px);padding:18px 0 0;
  border-top:1px solid #E9E1D9;
}
.zs-contact__brand-mark{display:block;width:46px;height:46px;flex:0 0 46px;object-fit:contain;mix-blend-mode:multiply}
.zs-contact__brand-fallback{display:grid;place-items:center;flex:0 0 46px;width:46px;height:46px;font-size:18px;font-weight:700;letter-spacing:-.08em;color:#936D4E}
.zs-contact__craft-note strong{display:block;font-size:12px;font-weight:600;color:var(--zs-text,#2B1D17)}
.zs-contact__craft-note p{margin:5px 0 0;font-size:11.5px;line-height:1.65;color:var(--zs-muted,#80736A)}
.zs-contact__form-panel{
  min-width:0;padding:clamp(26px,3.3vw,44px);
  border:1px solid #ECE3DA;border-radius:22px;
  background:var(--zs-surface,#FBF8F4);
}
.zs-contact__form-kicker{
  margin:0;color:#947255;text-transform:uppercase;
  font-size:10px;font-weight:500;letter-spacing:.17em;
}
.zs-contact__form-heading h2{
  margin:11px 0 7px;color:var(--zs-text,#2B1D17);
  font-family:inherit!important;font-size:clamp(27px,2.4vw,35px);
  line-height:1.2;letter-spacing:-.045em;font-weight:600;
}
.zs-contact__form-heading>p:last-child{
  max-width:47ch;margin:0 0 26px;color:var(--zs-muted,#80736A);
  font-size:12.5px;line-height:1.75;
}
.zs-contact__fields-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.zs-contact__field{display:flex;flex-direction:column;gap:8px;margin:0 0 16px;min-width:0}
.zs-contact__field label{
  font-size:12px;font-weight:500;line-height:1.45;color:var(--zs-text,#2B1D17);
}
.zs-contact__field label span{color:#9B6C44}
.zs-contact__field label small{font-size:11px;font-weight:400;color:#8D8177}
.zs-contact__field input,.zs-contact__field textarea{
  display:block;width:100%;min-height:48px;margin:0;
  padding:12px 13px;border:1px solid #DCD1C6;
  border-radius:10px;background:#FFFFFF;color:var(--zs-text,#2B1D17);
  outline:0;box-shadow:none;
  font:400 13px/1.5 inherit;
  transition:border-color .2s ease,box-shadow .2s ease;
}
.zs-contact__field textarea{min-height:132px;resize:vertical}
.zs-contact__field input::placeholder,.zs-contact__field textarea::placeholder{color:#A69B93;opacity:1}
.zs-contact__field input:focus,.zs-contact__field textarea:focus{
  border-color:#9B775B;box-shadow:0 0 0 3px rgba(155,119,91,.1)
}
.zs-contact__submit-row{display:flex;align-items:center;gap:20px;margin-top:7px}
.zs-contact__submit{
  display:inline-flex;align-items:center;justify-content:center;gap:20px;
  min-height:52px;padding:13px 25px;border:1px solid #2B1D17;
  border-radius:999px;background:#2B1D17;color:#FFF9F2;
  font:600 12.5px/1.1 inherit;letter-spacing:0;
  cursor:pointer;transition:background .2s ease,transform .2s ease;
  white-space:nowrap;
}
.zs-contact__submit svg{width:17px;height:17px;transition:transform .2s ease}
.zs-contact__submit:hover{background:#4A3025;transform:translateY(-1px)}
.zs-contact__submit:hover svg{transform:translateX(3px)}
.zs-contact__submit:focus-visible,.zs-contact__contact-link:focus-visible{
  outline:2px solid var(--zs-accent,#D8B56A);outline-offset:4px;
}
.zs-contact__privacy{max-width:210px;margin:0;font-size:10.5px;line-height:1.55;color:var(--zs-muted,#80736A)}
.zs-contact__success,.zs-contact__errors{
  margin:0 0 20px;padding:13px 16px;border-radius:10px;
  font-size:13px;line-height:1.6;
}
.zs-contact__success{background:#F0F7EE;border:1px solid #C7D9BF;color:#355432}
.zs-contact__success strong{display:block}
.zs-contact__success p{margin:2px 0 0}
.zs-contact__errors{background:#FFF0ED;border:1px solid #E8C9C1;color:#732C22}
@media(max-width:1020px){
  .zs-contact__shell{gap:40px;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
  .zs-contact__fields-row{grid-template-columns:1fr;gap:0}
  .zs-contact__title{font-size:clamp(40px,5vw,55px)}
}
@media(max-width:749px){
  .zs-contact{padding:43px 0 60px}
  .zs-contact__shell{display:block;padding:0 16px}
  .zs-contact__intro{padding:0}
  .zs-contact__eyebrow{font-size:9px;margin-bottom:17px}
  .zs-contact__title{max-width:14ch;font-size:clamp(40px,9vw,56px)}
  .zs-contact__lead{margin-top:13px;font-size:12.5px;line-height:1.7}
  .zs-contact__channels{margin-top:24px}
  .zs-contact__channel{padding:13px 0;gap:13px}
  .zs-contact__icon{flex-basis:34px;width:34px;height:34px}
  .zs-contact__icon svg{width:22px;height:22px}
  .zs-contact__contact-link{font-size:14px}
  .zs-contact__help-notes{padding-top:15px}
  .zs-contact__craft-note{margin-top:24px}
  .zs-contact__form-panel{margin-top:35px;padding:22px 17px;border-radius:17px}
  .zs-contact__form-heading h2{font-size:28px}
  .zs-contact__form-heading>p:last-child{margin-bottom:22px}
  .zs-contact__submit-row{flex-direction:column;align-items:stretch;gap:12px}
  .zs-contact__submit{width:100%}
  .zs-contact__privacy{max-width:none;text-align:center}
}
@media(prefers-reduced-motion:reduce){
  .zs-contact__submit,.zs-contact__submit svg,.zs-contact__contact-link,.zs-contact__contact-link svg{
    transition:none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Contact",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"ZAISEN Customer Care"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"We’re Here to <em>Help.</em>"},
    {"type":"richtext","id":"subheading","label":"Introduction","default":"<p>Questions about a handcrafted piece, an existing order, or choosing the right gift? Send us a message and our team will help you with care.</p>"},
    {"type":"font_picker","id":"editorial_font","label":"Font","default":"poppins_n4"},
    {"type":"text","id":"contact_email","label":"Contact email","default":"zaisenstore@gmail.com"},
    {"type":"text","id":"contact_phone","label":"Contact phone (display)","default":"(303) 943-8555"},
    {"type":"text","id":"phone_link","label":"Phone link (international)","default":"+13039438555"},
    {"type":"text","id":"response_text","label":"Customer care text","default":"Friendly help for product and order questions"},
    {"type":"text","id":"order_text","label":"Order support text","default":"Include your order number for faster assistance"},
    {"type":"text","id":"note_title","label":"Craft note heading","default":"Natural wood has its own character"},
    {"type":"textarea","id":"note_text","label":"Craft note text","default":"Small variations in grain, tone and handcrafted detail are part of what makes each ZAISEN piece unique."},
    {"type":"text","id":"form_kicker","label":"Form kicker","default":"Send a message"},
    {"type":"text","id":"form_heading","label":"Form heading","default":"Tell us what you need"},
    {"type":"textarea","id":"form_text","label":"Form introduction","default":"Share the details below and we’ll make sure your message reaches the right place."},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"surface_color","label":"Form surface","default":"#FBF8F4"},
    {"type":"color","id":"text_color","label":"Text","default":"#2B1D17"},
    {"type":"color","id":"muted_color","label":"Muted text","default":"#80736A"},
    {"type":"color","id":"accent_color","label":"Gold accent","default":"#D8B56A"},
    {"type":"color","id":"deep_wood","label":"Deep walnut","default":"#2B1D17"}
  ],
  "presets":[{"name":"ZAISEN Contact"}]
}
{% endschema %}
