<section class="zsj" id="zaisen-journal-{{ section.id }}" aria-labelledby="zsj-h1-{{ section.id }}">
  <div class="zsj__shell">
    <nav class="zsj__breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>The ZAISEN Journal</span></nav>
    <header class="zsj__intro">
      <p class="zsj__eyebrow">WOODEN LIVING <span aria-hidden="true">·</span> CRAFTSMANSHIP <span aria-hidden="true">·</span> INSPIRATION</p>
      <h1 id="zsj-h1-{{ section.id }}">The ZAISEN <strong>Journal.</strong></h1>
      <p>Discover wooden home decor ideas, natural interior styling, thoughtful craftsmanship, and the small details that make everyday spaces feel like home.</p>
    </header>
    {% paginate blog.articles by 9 %}
      <div class="zsj__browse" id="zsj-stories"><div><p class="zsj__eyebrow">EXPLORE THE JOURNAL</p><h2>Stories for natural living.</h2></div></div>
      <nav class="zsj__topics" aria-label="Browse journal topics">
        <a class="{% unless current_tags %}is-active{% endunless %}" href="{{ blog.url }}">All stories</a>
        {% assign journal_tags = 'Home Styling,Wood Care,Craftsmanship,Gift Guides,Kitchen & Dining' | split: ',' %}
        {% for tag in journal_tags %}
          <a class="{% if current_tags contains tag %}is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
        {% endfor %}
      </nav>
      {% if blog.articles_count > 0 %}
        <div class="zsj__grid">
          {% for post in blog.articles %}
              <article class="zsj__card">
                <a class="zsj__card-image" href="{{ post.url }}" aria-label="{{ post.title | escape }}">
                  {% if post.image != blank %}{{ post.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,480,680,850,1000', sizes: '(min-width: 900px) 30vw, (min-width: 600px) 46vw, 90vw', alt: post.image.alt | default: post.title }}{% else %}<div class="zsj__fallback">ZAISEN</div>{% endif %}
                </a>
                <div class="zsj__card-copy"><p class="zsj__eyebrow">By {{ post.author | escape }} · {{ post.published_at | date: '%B %Y' }}</p><h3><a href="{{ post.url }}">{{ post.title | escape }}</a></h3><p>{{ post.excerpt_or_content | strip_html | truncatewords: 24 }}</p><a class="zsj__card-more" href="{{ post.url }}">Read article <span aria-hidden="true">↗</span></a></div>
              </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="zsj__pages" aria-label="Article pages">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="zsj__empty">Our first stories are on their way. Explore our handcrafted wooden collections in the meantime.</p>
      {% endif %}
    {% endpaginate %}
    <section class="zsj__discover" aria-labelledby="zsj-discover-title"><div><p class="zsj__eyebrow">MADE WITH CARE · ZAISEN</p><h2 id="zsj-discover-title">Bring natural wood home.</h2><p>Discover the wooden pieces behind our stories, from handcrafted lighting and decor to everyday home essentials.</p></div><a href="{{ routes.all_products_collection_url }}">Explore ZAISEN <span aria-hidden="true">↗</span></a></section>
  </div>
</section>
{% stylesheet %}
.zsj{background:#fcfaf7;color:#2b1d17;padding:30px 0 90px}
.zsj *{box-sizing:border-box}
.zsj__shell{max-width:1440px;margin:auto;padding:0 clamp(18px,4vw,58px)}
.zsj__breadcrumb{display:flex;gap:11px;align-items:center;color:#806f60;font-size:12px;margin-bottom:64px}
.zsj__breadcrumb a{color:inherit;text-decoration:none}
.zsj__intro{max-width:800px;margin-bottom:65px}
.zsj__eyebrow{font-size:11px;letter-spacing:.16em;font-weight:650;color:#96704d;line-height:1.6}
.zsj__intro h1{font-size:clamp(46px,6vw,87px);font-weight:350;line-height:1.1;letter-spacing:-.06em;margin:20px 0 24px;font-family:var(--font-heading--family,Georgia,serif)}
.zsj__intro h1 strong{font-weight:700}
.zsj__intro>p:last-child{font-size:clamp(14px,1.4vw,17px);line-height:1.9;color:#74665b;max-width:730px}
.zsj a{text-decoration:none;color:inherit}
.zsj__card-more{display:inline-flex;align-items:center;gap:14px;color:#70472d!important;font-weight:700;font-size:13px;padding-bottom:5px;border-bottom:1px solid #b8916b}
.zsj__browse{margin:8px 0 23px}
.zsj__browse h2{font-size:clamp(28px,3.6vw,46px);font-family:var(--font-heading--family,Georgia,serif);letter-spacing:-.035em;margin:5px 0}
.zsj__topics{display:flex;flex-wrap:wrap;gap:9px;margin:0 0 30px}
.zsj__topics a{font-size:12px;border:1px solid #e3d7ca;background:#fff;padding:10px 16px;border-radius:50px;transition:background .2s ease}
.zsj__topics a:hover,.zsj__topics a.is-active{background:#2b1d17;color:#fff}
.zsj__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:1fr;gap:25px}
.zsj__card{display:flex;flex-direction:column;min-width:0;height:100%;background:#fff;border:1px solid #e9ded2;border-radius:15px;overflow:hidden;transition:box-shadow .2s ease}
.zsj__card-image{display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:16/9;background:#f4ede5;overflow:hidden}
.zsj__card-image img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}
.zsj__card:hover{box-shadow:0 10px 30px rgba(43,29,23,.09)}
.zsj__card-copy{display:flex;flex-direction:column;flex:1;padding:21px 20px 25px}
.zsj__card h3{font-size:22px;line-height:1.3;letter-spacing:-.025em;margin:9px 0;font-family:var(--font-heading--family,Georgia,serif)}
.zsj__card-copy>p:not(.zsj__eyebrow){color:#76675d;font-size:13px;line-height:1.75;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.zsj__card-more{margin-top:auto;align-self:flex-start;padding-top:12px}
.zsj__empty{font-size:15px;color:#806f60;padding:25px 0}
.zsj__pages{display:flex;justify-content:center;gap:24px;margin-top:30px;font-size:13px}
.zsj__discover{margin-top:85px;background:#2b1d17;color:#fff8f0;border-radius:17px;padding:45px clamp(23px,4vw,58px);display:flex;align-items:center;justify-content:space-between;gap:30px}
.zsj__discover h2{font-size:clamp(27px,3vw,40px);margin:9px 0;font-family:var(--font-heading--family,Georgia,serif)}
.zsj__discover p:not(.zsj__eyebrow){max-width:560px;font-size:13px;line-height:1.7;color:#d9c8b9}
.zsj__discover a{display:inline-flex;align-items:center;justify-content:center;gap:13px;background:#fff8f0;color:#2b1d17;padding:15px 21px;border-radius:50px;white-space:nowrap;font-weight:700;font-size:12px}
.zsj a:focus-visible{outline:2px solid #d8b56a;outline-offset:4px}
@media(max-width:899px){.zsj__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:599px){.zsj{padding:24px 0 56px}.zsj__breadcrumb{margin-bottom:43px}.zsj__intro{margin-bottom:46px}.zsj__intro h1{font-size:46px}.zsj__browse{margin-top:10px}.zsj__topics{overflow-x:auto;flex-wrap:nowrap;padding-bottom:7px}.zsj__topics a{flex-shrink:0}.zsj__grid{grid-template-columns:1fr}.zsj__discover{margin-top:54px;display:block;padding:30px 24px}.zsj__discover a{margin-top:20px}}
@media(prefers-reduced-motion:reduce){.zsj__card{transition:none}}
{% endstylesheet %}
{% schema %}
{"name":"ZAISEN Journal","tag":"section","settings":[],"presets":[{"name":"ZAISEN Journal"}]}
{% endschema %}