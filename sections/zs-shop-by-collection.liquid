{%- comment -%}
  ZAISEN — Shop by Collection
  Quiet-luxury collection grid.
  Desktop: 4 columns x 2 rows.
  Mobile: 2 columns x 4 rows.
{%- endcomment -%}

<section
  class="zs-collections"
  style="
    --zs-c-bg: {{ section.settings.background_color }};
    --zs-c-text: {{ section.settings.text_color }};
    --zs-c-muted: {{ section.settings.muted_color }};
    --zs-c-accent: {{ section.settings.accent_color }};
    --zs-c-line: {{ section.settings.line_color }};
  "
  aria-labelledby="zs-collections-heading-{{ section.id }}"
>
  <div class="zs-collections__inner">
    <header class="zs-collections__header">
      {% if section.settings.eyebrow != blank %}
        <p class="zs-collections__eyebrow">
          <span class="zs-collections__eyebrow-line" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="zs-collections-heading-{{ section.id }}" class="zs-collections__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="zs-collections__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </header>

    <div class="zs-collections__grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign card_image = block.settings.image_override

          if card_image == blank and collection != blank
            assign card_image = collection.image
          endif

          if card_image == blank and collection != blank and collection.products.first != blank
            assign card_image = collection.products.first.featured_image
          endif

          assign card_title = block.settings.title
          if card_title == blank and collection != blank
            assign card_title = collection.title
          endif

          assign card_url = '#'
          if collection != blank
            assign card_url = collection.url
          endif

          assign image_alt = card_image.alt | default: card_title
        %}

        <article class="zs-collections__card" {{ block.shopify_attributes }}>
          <a
            class="zs-collections__link"
            href="{{ card_url }}"
            {% if collection == blank %}aria-disabled="true"{% endif %}
          >
            <div class="zs-collections__media">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 640, 800, 1000',
                    sizes: '(max-width: 749px) 46vw, (max-width: 1199px) 48vw, 24vw',
                    alt: image_alt,
                    class: 'zs-collections__image'
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'zs-collections__placeholder' }}
              {% endif %}
            </div>

            <div class="zs-collections__meta">
              <h3 class="zs-collections__title">{{ card_title | escape }}</h3>
              <span class="zs-collections__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M4 10h11M11.5 6.5 15 10l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .zs-collections {
    position: relative;
    background: var(--zs-c-bg);
    color: var(--zs-c-text);
    border-block-start: 1px solid color-mix(in srgb, var(--zs-c-line) 70%, transparent);
  }

  .zs-collections__inner {
    width: min(100% - 48px, 1440px);
    margin-inline: auto;
    padding-block: 72px 82px;
  }

  .zs-collections__header {
    max-width: 720px;
    margin-bottom: 38px;
  }

  .zs-collections__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    color: var(--zs-c-accent);
    font-family: var(--font-body--family, inherit);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .2em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .zs-collections__eyebrow-line {
    width: 32px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
  }

  .zs-collections__heading {
    margin: 0;
    max-width: 13ch;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(42px, 3.7vw, 54px);
    font-weight: 520;
    letter-spacing: -.025em;
    line-height: 1;
    text-wrap: balance;
  }

  .zs-collections__heading em {
    color: var(--zs-c-accent);
    font-style: italic;
    font-weight: 450;
  }

  .zs-collections__description {
    margin: 14px 0 0;
    max-width: 52ch;
    color: var(--zs-c-muted);
    font-family: var(--font-body--family, inherit);
    font-size: 15px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .zs-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 22px;
    row-gap: 34px;
  }

  .zs-collections__card {
    min-width: 0;
  }

  .zs-collections__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .zs-collections__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3.35;
    border: 1px solid color-mix(in srgb, var(--zs-c-line) 78%, transparent);
    border-radius: 18px;
    background: #eadfd2;
  }

  .zs-collections__image,
  .zs-collections__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 420ms cubic-bezier(.16, 1, .3, 1),
      filter 320ms ease;
  }

  .zs-collections__placeholder {
    color: color-mix(in srgb, var(--zs-c-accent) 28%, transparent);
    background: #e9dfd2;
  }

  .zs-collections__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
    padding-top: 13px;
    border-bottom: 1px solid transparent;
  }

  .zs-collections__title {
    margin: 0;
    min-width: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 20px;
    font-weight: 560;
    letter-spacing: -.01em;
    line-height: 1.15;
  }

  .zs-collections__arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    color: color-mix(in srgb, var(--zs-c-accent) 88%, var(--zs-c-text));
    transition: transform 220ms ease;
  }

  .zs-collections__arrow svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 989px) {
    .zs-collections__inner {
      width: min(100% - 36px, 920px);
      padding-block: 62px 70px;
    }

    .zs-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 18px;
      row-gap: 30px;
    }

    .zs-collections__header {
      margin-bottom: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .zs-collections__inner {
      width: min(100% - 32px, 680px);
      padding-block: 48px 58px;
    }

    .zs-collections__header {
      max-width: 100%;
      margin-bottom: 26px;
    }

    .zs-collections__eyebrow {
      gap: 9px;
      margin-bottom: 9px;
      font-size: 9px;
      letter-spacing: .17em;
    }

    .zs-collections__eyebrow-line {
      width: 26px;
    }

    .zs-collections__heading {
      max-width: none;
      font-size: clamp(34px, 9vw, 40px);
      line-height: 1.02;
    }

    .zs-collections__description {
      margin-top: 10px;
      max-width: 34ch;
      font-size: 13.5px;
      line-height: 1.55;
    }

    .zs-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 12px;
      row-gap: 24px;
    }

    .zs-collections__media {
      aspect-ratio: 1 / 1;
      border-radius: 14px;
    }

    .zs-collections__meta {
      min-height: 36px;
      gap: 7px;
      padding-top: 9px;
    }

    .zs-collections__title {
      font-family: var(--font-body--family, inherit);
      font-size: 15px;
      font-weight: 650;
      letter-spacing: 0;
      line-height: 1.2;
    }

    .zs-collections__arrow {
      width: 20px;
      height: 20px;
    }

    .zs-collections__arrow svg {
      width: 15px;
      height: 15px;
    }
  }

  @media screen and (max-width: 380px) {
    .zs-collections__inner {
      width: min(100% - 24px, 360px);
    }

    .zs-collections__grid {
      column-gap: 10px;
      row-gap: 21px;
    }

    .zs-collections__title {
      font-size: 14px;
    }

    .zs-collections__arrow {
      width: 18px;
      height: 18px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .zs-collections__link:hover .zs-collections__image {
      transform: scale(1.025);
      filter: saturate(1.025) brightness(1.015);
    }

    .zs-collections__link:hover .zs-collections__arrow {
      transform: translateX(3px);
    }

    .zs-collections__link:hover .zs-collections__meta {
      border-bottom-color: color-mix(in srgb, var(--zs-c-accent) 40%, transparent);
    }
  }

  .zs-collections__link:focus-visible {
    outline: 2px solid var(--zs-c-accent);
    outline-offset: 4px;
    border-radius: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-collections__image,
    .zs-collections__arrow {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZS Shop by Collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Discover ZAISEN"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by <em>Collection.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore handcrafted wooden pieces for every part of the home."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F6F1EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2C2A29"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#6F6861"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Wood accent",
      "default": "#A8794A"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Border",
      "default": "#D8CABC"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image_override",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZS Shop by Collection",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
