{%- comment -%}
  ZAISEN curated-collections design.
  8 existing merchant-selected collections, 4x2 desktop / 2x4 mobile.
  Only images have rounded corners: cards stay borderless.
  Preserves destination, image override and dynamic collection image/product fallback.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign font_base = s.editorial_font
  assign font_light = font_base | font_modify: 'weight', '300'
  assign font_medium = font_base | font_modify: 'weight', '500'
  assign font_bold = font_base | font_modify: 'weight', '700'
  assign heading_tag = s.heading_tag | default: 'h2'
  assign all_collections_link = s.button_link | default: routes.collections_url
  assign radius = s.card_radius | default: 24
  assign section_gap = s.gap | default: 24
  assign max_width = s.max_width | default: 1440
  case s.image_ratio
    when 'square'
      assign aspect_ratio = '1 / 1'
    when 'tall'
      assign aspect_ratio = '3 / 4'
    when 'landscape'
      assign aspect_ratio = '4 / 3'
    else
      assign aspect_ratio = '4 / 5'
  endcase
-%}
{%- if font_base != blank -%}
  {% style %}
    {{ font_base | font_face: font_display: 'swap' }}
    {% if font_light != blank %}{{ font_light | font_face: font_display: 'swap' }}{% endif %}
    {% if font_medium != blank %}{{ font_medium | font_face: font_display: 'swap' }}{% endif %}
    {% if font_bold != blank %}{{ font_bold | font_face: font_display: 'swap' }}{% endif %}
    #zsbc-{{ section.id }} {
      font-family: {{ font_base.family | json }}, {{ font_base.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  #zsbc-{{ section.id }} {
    --zsc-background: {{ s.bg_color }};
    --zsc-heading: {{ s.heading_color }};
    --zsc-body: {{ s.text_color }};
    --zsc-accent: {{ s.accent_color }};
    --zsc-walnut: {{ s.wood_color }};
    --zsc-radius: {{ radius }}px;
    --zsc-gap: {{ section_gap }}px;
    --zsc-max-width: {{ max_width }}px;
    --zsc-image-ratio: {{ aspect_ratio }};
    --zsc-heading-size: {{ s.heading_size }}px;
    --zsc-padding-top: {{ s.padding_top }}px;
    --zsc-padding-bottom: {{ s.padding_bottom }}px;
  }
{% endstyle %}

<section id="zsbc-{{ section.id }}" class="zsc-section" aria-labelledby="zsc-heading-{{ section.id }}">
  <div class="zsc-section__inner">
    <header class="zsc-section__header">
      <div class="zsc-section__intro">
        {%- if s.eyebrow != blank -%}
          <p class="zsc-section__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} id="zsc-heading-{{ section.id }}" class="zsc-section__title">
          <span class="zsc-section__title-light">{{ s.heading | escape }}</span>
          {%- if s.heading_emphasis != blank -%}
            <strong class="zsc-section__title-bold">{{ s.heading_emphasis | escape }}</strong>
          {%- endif -%}
        </{{ heading_tag }}>
      </div>
      {%- if s.subheading != blank -%}
        <p class="zsc-section__subtitle">{{ s.subheading | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="zsc-section__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign selected_collection = block.settings.collection
          assign collection_title = block.settings.custom_title | default: selected_collection.title | default: 'Choose a collection'
          assign collection_link = selected_collection.url | default: routes.collections_url
          assign collection_image = block.settings.image
          if collection_image == blank and selected_collection != blank
            assign collection_image = selected_collection.image
          endif
          if collection_image == blank and selected_collection != blank
            assign collection_image = selected_collection.products.first.featured_image
          endif
          assign tagline = block.settings.tagline
          assign tile_loading = 'lazy'
          if section.index <= 2 and forloop.index <= 4
            assign tile_loading = 'eager'
          endif
        -%}
        <li class="zsc-collection" style="--zsc-delay:{{ forloop.index0 | modulo: 4 | times: 60 }}ms" {{ block.shopify_attributes }}>
          <a class="zsc-collection__link" href="{{ collection_link }}" aria-label="{{ collection_title | escape }}">
            <div class="zsc-collection__media">
              {%- if collection_image != blank -%}
                {{ collection_image | image_url: width: 1100 | image_tag: class: 'zsc-collection__image', loading: tile_loading, widths: '240, 340, 440, 560, 720, 900, 1100', sizes: '(min-width: 1500px) 325px, (min-width: 1200px) calc((100vw - 160px) / 4), (min-width: 750px) calc((100vw - 92px) / 3), calc((100vw - 56px) / 2)', alt: collection_title }}
              {%- else -%}
                <div class="zsc-collection__fallback" aria-hidden="true">
                  <span>{{ collection_title | slice: 0, 1 | escape }}</span>
                  <small>ZAISEN</small>
                </div>
              {%- endif -%}
              <span class="zsc-collection__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 19 19 5M7 5h12v12"/>
                </svg>
              </span>
            </div>
            <div class="zsc-collection__details">
              <h3 class="zsc-collection__name">{{ collection_title | escape }}</h3>
              {%- if tagline != blank -%}
                <p class="zsc-collection__tagline">{{ tagline | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <div class="zsc-section__footer">
      <a class="zsc-section__button" href="{{ all_collections_link }}">
        <span class="zsc-section__button-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <rect x="3" y="3" width="7" height="7" rx="1.1"/>
            <rect x="14" y="3" width="7" height="7" rx="1.1"/>
            <rect x="3" y="14" width="7" height="7" rx="1.1"/>
            <rect x="14" y="14" width="7" height="7" rx="1.1"/>
          </svg>
        </span>
        <span>{{ s.button_label | default: 'Explore All Collections' | escape }}</span>
        <svg class="zsc-section__button-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 19 19 5M7 5h12v12"/>
        </svg>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
.zsc-section {
  background:var(--zsc-background,#FFFFFF);
  color:var(--zsc-heading,#2B1D17);
  padding:var(--zsc-padding-top,88px) 0 var(--zsc-padding-bottom,96px);
  overflow:clip;
}
.zsc-section *{box-sizing:border-box}
.zsc-section__inner{
  width:100%;
  max-width:var(--zsc-max-width,1440px);
  margin:0 auto;
  padding:0 clamp(20px,4vw,58px);
}
.zsc-section__header{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:clamp(24px,5vw,90px);
  margin-bottom:clamp(34px,4vw,55px);
}
.zsc-section__intro{min-width:0;flex-shrink:0}
.zsc-section__eyebrow{
  display:flex;
  align-items:center;
  gap:14px;
  color:#906D50;
  font-size:clamp(10px,.81vw,12px);
  font-weight:500;
  letter-spacing:.18em;
  line-height:1.4;
  text-transform:uppercase;
  margin:0 0 clamp(21px,2.4vw,32px);
}
.zsc-section__eyebrow span{
  display:block;
  width:33px;
  height:2px;
  flex-shrink:0;
  background:var(--zsc-accent,#D8B56A);
}
.zsc-section__title {
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  margin:0;
  font-family:inherit!important;
  font-size:clamp(42px,4.1vw,var(--zsc-heading-size,60px));
  line-height:1.12;
  letter-spacing:-.056em;
  color:var(--zsc-heading,#2B1D17);
  text-wrap:balance;
}
.zsc-section__title-light{
  display:block;
  font-weight:300;
}
.zsc-section__title-bold{
  display:block;
  font-weight:700;
  line-height:1.12;
}
.zsc-section__subtitle{
  max-width:430px;
  margin:0 0 7px;
  color:var(--zsc-body,#80736A);
  opacity:.72;
  font-family:inherit;
  font-weight:400;
  font-size:clamp(13px,1.05vw,15px);
  line-height:1.9;
}
.zsc-section__grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(27px,3vw,46px) var(--zsc-gap,24px);
  margin:0;
  padding:0;
  list-style:none;
}
.zsc-collection{min-width:0;list-style:none}
.zsc-collection__link{
  display:block;
  color:inherit;
  text-decoration:none;
  outline-offset:4px;
}
.zsc-collection__link:hover{color:inherit}
.zsc-collection__media{
  position:relative;
  width:100%;
  aspect-ratio:var(--zsc-image-ratio,4 / 5);
  overflow:hidden;
  border-radius:var(--zsc-radius,24px);
  background:#F1EDE8;
  isolation:isolate;
}
.zsc-collection__image{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
  transition:transform .55s cubic-bezier(.2,.7,.2,1);
}
.zsc-collection__fallback{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  width:100%;
  height:100%;
  gap:9px;
  color:#977251;
  background:#F0EAE3;
  font-family:inherit;
}
.zsc-collection__fallback span{font-size:clamp(3rem,7vw,7rem);line-height:1;font-weight:300}
.zsc-collection__fallback small{font-size:9px;letter-spacing:.3em;font-weight:600}
.zsc-collection__arrow{
  position:absolute;
  right:17px;
  bottom:17px;
  display:grid;
  place-items:center;
  width:40px;
  height:40px;
  border:1px solid rgba(43,29,23,.08);
  border-radius:50%;
  background:rgba(255,255,255,.95);
  color:var(--zsc-walnut,#2B1D17);
  box-shadow:0 5px 14px rgba(43,29,23,.09);
  opacity:0;
  transform:translateY(7px) scale(.96);
  transition:opacity .26s ease,transform .3s cubic-bezier(.2,.7,.2,1),background-color .24s ease,color .24s ease,box-shadow .24s ease;
}
.zsc-collection__arrow svg{width:18px;height:18px;transition:transform .26s ease}

.zsc-collection__details{
  padding:18px 1px 0;
  background:transparent;
}
.zsc-collection__name{
  display:inline;
  margin:0;
  padding:0 0 2px;
  color:var(--zsc-heading,#2B1D17);
  border-bottom:1px solid transparent;
  font-family:inherit;
  font-size:clamp(13px,1.07vw,16px);
  line-height:1.5;
  letter-spacing:-.022em;
  font-weight:600;
  transition:border-color .25s ease,color .25s ease;
}
.zsc-collection__tagline{
  margin:7px 0 0;
  color:var(--zsc-body,#80736A);
  opacity:.72;
  font-family:inherit;
  font-size:clamp(11px,.86vw,13px);
  font-weight:400;
  line-height:1.7;
}
@media(hover:hover) and (pointer:fine){
  .zsc-collection__link:hover .zsc-collection__image{transform:scale(1.035)}
  .zsc-collection__link:hover .zsc-collection__arrow{
    opacity:1;
    transform:translateY(0) scale(1);
    background:var(--zsc-walnut,#2B1D17);
    border-color:var(--zsc-walnut,#2B1D17);
    color:var(--zsc-accent,#D8B56A);
    box-shadow:0 7px 17px rgba(43,29,23,.17);
  }
  .zsc-collection__link:hover .zsc-collection__arrow svg{transform:translate(1px,-1px)}
  .zsc-collection__link:hover .zsc-collection__name{
    border-bottom-color:var(--zsc-walnut,#2B1D17);
    color:var(--zsc-walnut,#2B1D17);
  }
}
.zsc-collection__link:focus-visible{outline:2px solid var(--zsc-walnut,#2B1D17)}
.zsc-collection__link:focus-visible .zsc-collection__arrow{
  opacity:1;
  transform:none;
  background:var(--zsc-walnut,#2B1D17);
  color:var(--zsc-accent,#D8B56A);
}
.zsc-section__footer{
  display:flex;
  justify-content:center;
  padding-top:clamp(44px,5vw,75px);
}
.zsc-section__button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:19px;
  min-height:71px;
  padding:7px 27px 7px 8px;
  border-radius:999px;
  border:0;
  background:#2B1D17;
  color:#FFFFFF;
  text-decoration:none;
  font-family:inherit;
  font-size:clamp(12px,1vw,15px);
  font-weight:500;
  white-space:nowrap;
  letter-spacing:-.015em;
  box-shadow:0 13px 28px rgba(43,29,23,.12);
  transition:transform .25s ease,box-shadow .25s ease;
}
.zsc-section__button:hover{
  color:#FFFFFF;
  transform:translateY(-2px);
  box-shadow:0 16px 33px rgba(43,29,23,.2);
}
.zsc-section__button-icon{
  display:grid;
  place-items:center;
  flex:0 0 54px;
  width:54px;
  height:54px;
  border-radius:50%;
  color:#2B1D17;
  background:var(--zsc-accent,#D8B56A);
}
.zsc-section__button-arrow{flex-shrink:0}
.zsc-section__button:focus-visible{outline:2px solid var(--zsc-accent,#D8B56A);outline-offset:4px}
@media(min-width:750px) and (max-width:1180px){
  .zsc-section__grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .zsc-section__header{gap:30px}
  .zsc-section__title{font-size:clamp(42px,5vw,58px)}
  .zsc-section__subtitle{max-width:310px}
}
@media(max-width:749px){
  .zsc-section{padding:clamp(60px,8vw,78px) 0 clamp(60px,8vw,78px)}
  .zsc-section__inner{padding:0 16px}
  .zsc-section__header{display:block;margin-bottom:27px}
  .zsc-section__eyebrow{font-size:9px;letter-spacing:.16em;margin-bottom:18px}
  .zsc-section__title{font-size:clamp(36px,9.5vw,51px)}
  .zsc-section__subtitle{max-width:43ch;margin:17px 0 0;font-size:12px;line-height:1.75}
  .zsc-section__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 13px}
  .zsc-collection__media{border-radius:min(var(--zsc-radius,24px),16px)}
  .zsc-collection__arrow{
    right:11px;bottom:11px;
    width:34px;height:34px;
    opacity:1;transform:none;
    border-color:rgba(43,29,23,.06);
    background:rgba(255,255,255,.95);
    color:var(--zsc-walnut,#2B1D17);
    box-shadow:0 4px 11px rgba(43,29,23,.09);
  }
  .zsc-collection__arrow svg{width:15px;height:15px}
  .zsc-collection__details{padding:11px 1px 0}
  .zsc-collection__name{font-size:12px;line-height:1.45;letter-spacing:-.024em}
  .zsc-collection__tagline{font-size:10px;margin-top:5px;line-height:1.45}
  .zsc-section__footer{padding-top:39px}
  .zsc-section__button{min-height:58px;padding:6px 20px 6px 6px;gap:12px;font-size:12px}
  .zsc-section__button-icon{width:46px;height:46px;flex-basis:46px}
  .zsc-section__button-icon svg{width:19px;height:19px}
}
@media(prefers-reduced-motion:no-preference){
  .zsc-collection.zsc-is-in-view{
    animation:zsc-reveal .55s cubic-bezier(.2,.7,.2,1) both;
    animation-delay:var(--zsc-delay,0ms);
  }
  @keyframes zsc-reveal{
    from{opacity:.65;transform:translateY(12px)}
    to{opacity:1;transform:translateY(0)}
  }
}
@media(prefers-reduced-motion:reduce){
  .zsc-collection__image,.zsc-collection__arrow,.zsc-collection__arrow svg,.zsc-collection__name,.zsc-section__button{transition:none}
}
{% endstylesheet %}
{% javascript %}
(function(){
  function initCollections(){
    var elements=document.querySelectorAll('.zsc-section .zsc-collection:not([data-zsc-ready])');
    if(!elements.length)return;
    if(!('IntersectionObserver' in window)){
      elements.forEach(function(el){el.dataset.zscReady='true';});
      return;
    }
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('zsc-is-in-view');
          io.unobserve(entry.target);
        }
      });
    },{threshold:.13,rootMargin:'0px 0px 55px 0px'});
    elements.forEach(function(el){el.dataset.zscReady='true';io.observe(el);});
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',initCollections,{once:true});
  }else{initCollections();}
  document.addEventListener('shopify:section:load',initCollections);
})();
{% endjavascript %}

{% schema %}
{
  "name": "ZAISEN Curved Collections",
  "tag": "section",
  "class": "section-zaisen-collections",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Handcrafted • Pure Wood"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Bold second line",
      "default": "Every Corner."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Timeless wooden pieces, handcrafted to bring natural warmth and character into your home."
    },
    {
      "type": "font_picker",
      "id": "editorial_font",
      "label": "Collections typography",
      "default": "poppins_n4"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "two",
          "label": "2-column grid"
        },
        {
          "value": "one",
          "label": "1-column list"
        },
        {
          "value": "swipe",
          "label": "Swipe carousel"
        }
      ],
      "default": "two"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "tall",
          "label": "Tall (3:4)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 1100,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "theme",
          "label": "Match theme heading font"
        },
        {
          "value": "serif",
          "label": "Classic serif"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#B69A6A"
    },
    {
      "type": "color",
      "id": "wood_color",
      "label": "Placeholder wood tone",
      "default": "#77523A"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
