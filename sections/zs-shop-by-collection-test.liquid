{%- assign s = section.settings -%}
<section class="za-collections" aria-labelledby="za-collections-title-{{ section.id }}">
  <div class="za-collections__wrap">
    <header class="za-collections__head">
      <div>
        <p class="za-small-label">{{ s.eyebrow | escape }}</p>
        <h2 id="za-collections-title-{{ section.id }}">{{ s.heading | escape }}</h2>
      </div>
      <p>{{ s.subheading | escape }}</p>
    </header>
    <div class="za-collections__featured">
      {%- for block in section.blocks limit:3 -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image
          if image == blank and collection != blank
            assign image = collection.image
          endif
          if image == blank and collection != blank
            assign image = collection.products.first.featured_image
          endif
          assign destination = collection.url | default: routes.all_products_collection_url
          assign title = block.settings.custom_title | default: collection.title
        -%}
        <a class="za-collection" href="{{ destination }}" {{ block.shopify_attributes }}>
          <div class="za-collection__media">
            {%- if image != blank -%}
              {{ image | image_url: width: 1050 | image_tag: class: 'za-collection__image', loading: 'lazy', widths: '320, 480, 640, 850, 1050', sizes: '(min-width: 990px) 31vw, (min-width: 680px) 47vw, 90vw', alt: title }}
            {%- else -%}
              <div class="za-collection__image-missing" aria-hidden="true"><span>{{ forloop.index | prepend: '0' }}</span></div>
            {%- endif -%}
          </div>
          <div class="za-collection__caption">
            <div><h3>{{ title | escape }}</h3><p>{{ block.settings.tagline | escape }}</p></div>
            <span class="za-collection__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 3 -%}
      <div class="za-collections__more">
        <p class="za-small-label">EXPLORE MORE</p>
        <div class="za-collections__link-grid">
          {%- for block in section.blocks offset:3 -%}
            {%- liquid
              assign collection = block.settings.collection
              assign title = block.settings.custom_title | default: collection.title
              assign destination = collection.url | default: routes.all_products_collection_url
            -%}
            <a href="{{ destination }}" {{ block.shopify_attributes }}><span>{{ title | escape }}</span><span aria-hidden="true">↗</span></a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.za-collections{background:#F7F6F2;color:#24211E;padding:clamp(76px,8vw,124px) 0}
.za-collections *{box-sizing:border-box}
.za-collections__wrap{max-width:1550px;padding:0 clamp(20px,4.5vw,70px);margin:auto}
.za-collections__head{display:grid;grid-template-columns:1fr minmax(250px,370px);align-items:end;gap:35px;margin-bottom:45px}
.za-small-label{font-family:var(--font-body--family,Arial,sans-serif);font-size:.64rem;letter-spacing:.22em;font-weight:700;color:#74533C;text-transform:uppercase;margin:0 0 15px}
.za-collections__head h2{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(3rem,5.2vw,6rem);font-weight:500;line-height:1;letter-spacing:-.045em;margin:0}
.za-collections__head>p{font-family:var(--font-body--family,Arial,sans-serif);font-size:.9rem;line-height:1.75;color:#766F67;margin:0 0 4px}
.za-collections__featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,29px)}
.za-collection{display:block;min-width:0;color:inherit;text-decoration:none}
.za-collection__media{aspect-ratio:4/4.55;background:#EAE4DB;overflow:hidden}
.za-collection:nth-child(2) .za-collection__media{aspect-ratio:4/5.1}
.za-collection__image{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.za-collection:hover .za-collection__image{transform:scale(1.035)}
.za-collection__image-missing{display:grid;place-items:center;width:100%;height:100%;font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(6rem,9vw,9rem);color:#C0AA94;background:#EAE4DB}
.za-collection__caption{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:20px 0 0}
.za-collection__caption h3{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(1.45rem,2.1vw,2rem);font-weight:500;letter-spacing:-.02em;margin:0;line-height:1.14}
.za-collection__caption p{font-family:var(--font-body--family,Arial,sans-serif);font-size:.79rem;line-height:1.6;color:#7D756B;margin:8px 0 0}
.za-collection__arrow{font-size:1.3rem;line-height:1;color:#74533C;margin-top:3px;transition:transform .25s}
.za-collection:hover .za-collection__arrow{transform:translate(3px,-3px)}
.za-collections__more{margin-top:56px;padding-top:25px;border-top:1px solid #DCD6CD;display:grid;grid-template-columns:210px 1fr;gap:24px}
.za-collections__more .za-small-label{padding-top:12px}
.za-collections__link-grid{display:flex;gap:6px clamp(20px,3vw,44px);flex-wrap:wrap}
.za-collections__link-grid a{font-family:var(--font-body--family,Arial,sans-serif);font-size:.77rem;letter-spacing:.02em;display:inline-flex;align-items:center;gap:14px;min-height:48px;color:#24211E;text-decoration:none;border-bottom:1px solid transparent;transition:border-color .2s}
.za-collections__link-grid a:hover{border-color:#74533C}
.za-collections__link-grid a>span:last-child{color:#74533C}
.za-collections a:focus-visible{outline:2px solid #74533C;outline-offset:4px}
@media(max-width:990px){.za-collections__head{grid-template-columns:1fr}.za-collections__head>p{max-width:55ch}.za-collections__featured{grid-template-columns:repeat(2,minmax(0,1fr))}.za-collection:nth-child(3){grid-column:span 2;max-width:75%}.za-collections__more{grid-template-columns:1fr;gap:6px}}
@media(max-width:680px){.za-collections{padding:68px 0}.za-collections__head{margin-bottom:27px;gap:17px}.za-collections__head h2{font-size:3.3rem}.za-collections__featured{grid-template-columns:1fr;gap:32px}.za-collection:nth-child(3){grid-column:auto;max-width:none}.za-collection__media,.za-collection:nth-child(2) .za-collection__media{aspect-ratio:5/4.8}.za-collection__caption{padding-top:13px}.za-collections__more{margin-top:43px}.za-collections__link-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 22px}.za-collections__link-grid a{align-items:flex-start;padding:9px 0;font-size:.73rem}}
@media(prefers-reduced-motion:reduce){.za-collection__image,.za-collection__arrow{transition:none}}
{% endstylesheet %}

