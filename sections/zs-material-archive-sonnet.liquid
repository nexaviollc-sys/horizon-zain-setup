{%- comment -%}   ZAISEN — Material Archive   A catalogue-plate style section for Shopify (Horizon-compatible).   Self-contained: scoped CSS (zs-), a small custom element, no dependencies. {%- endcomment -%}  {%- liquid   assign s = section.settings   assign specimens = section.blocks | where: 'type', 'specimen'   assign eager_first = false   if section.index <= 2     assign eager_first = true   endif   assign heading_italic = s.heading_font | font_modify: 'style', 'italic'   assign body_italic = s.body_font | font_modify: 'style', 'italic' -%}  {% style %}   {{ s.heading_font | font_face: font_display: 'swap' }}   {{ heading_italic | font_face: font_display: 'swap' }}   {{ s.body_font | font_face: font_display: 'swap' }}   {{ body_italic | font_face: font_display: 'swap' }}    #zs-{{ section.id }} {     --zs-bg: {{ s.color_bg }};     --zs-ink: {{ s.color_text }};     --zs-ink-soft: {{ s.color_text | color_modify: 'alpha', 0.7 }};     --zs-hair: {{ s.color_text | color_modify: 'alpha', 0.18 }};     --zs-gold: {{ s.color_gold }};     --zs-mat: {{ s.color_mat }};     --zs-font-head: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }}, 'Iowan Old Style', Georgia, serif;     --zs-head-weight: {{ s.heading_font.weight }};     --zs-font-body: {{ s.body_font.family }}, {{ s.body_font.fallback_families }}, Georgia, serif;     --zs-body-weight: {{ s.body_font.weight }};     --zs-title-max: {{ s.title_size }}px;     --zs-max: {{ s.max_width }};     --zs-ratio: {{ s.plate_ratio }};     --zs-mat-pad: {{ s.mat_padding }}px;     --zs-aside-offset: {{ s.aside_offset }}px;     --zs-pt: {{ s.padding_top }}px;     --zs-pb: {{ s.padding_bottom }}px;   } {% endstyle %}  <zaisen-archive class="zs{% if s.indent_italic %} zs--indent{% endif %}" id="zs-{{ section.id }}">   <div class="zs__inner">      {%- comment -%} Running head {%- endcomment -%}     <div class="zs__head">       {%- if s.running_head != blank -%}<span class="zs__head-brand">{{ s.running_head | escape }}</span>{%- endif -%}       {%- if s.folio != blank -%}<span class="zs__head-folio">{{ s.folio | escape }}</span>{%- endif -%}       {%- if s.edition != blank -%}<span class="zs__head-edition">{{ s.edition | escape }}</span>{%- endif -%}     </div>      <div class="zs__grid">        {%- if s.heading != blank -%}         <h2 class="zs__title">{{ s.heading }}</h2>       {%- endif -%}        {%- if s.intro != blank -%}         <div class="zs__intro">{{ s.intro }}</div>       {%- endif -%}        {%- comment -%} Plate {%- endcomment -%}       <div class="zs__plate">         <div class="zs__frame">           <i class="zs__crop zs__crop--tl" aria-hidden="true"></i>           <i class="zs__crop zs__crop--tr" aria-hidden="true"></i>           <i class="zs__crop zs__crop--bl" aria-hidden="true"></i>           <i class="zs__crop zs__crop--br" aria-hidden="true"></i>            <div class="zs__stack zs__stack--img">             {%- for block in specimens -%}               {%- liquid                 assign specimen_image = block.settings.image                 if specimen_image == blank and block.settings.product != blank                   assign specimen_image = block.settings.product.featured_image                 endif                 assign alt_text = block.settings.image_alt | default: specimen_image.alt | default: block.settings.name                 assign loading = 'lazy'                 if forloop.first and eager_first                   assign loading = 'eager'                 endif               -%}               <figure class="zs__panel{% if forloop.first %} is-active{% endif %}" data-zs-panel="{{ forloop.index0 }}">                 {%- if specimen_image != blank -%}                   {{                     specimen_image                     | image_url: width: 1600                     | image_tag:                       widths: '480, 720, 960, 1200, 1600',                       sizes: '(min-width: 1100px) 52vw, (min-width: 750px) 56vw, 92vw',                       alt: alt_text,                       loading: loading,                       class: 'zs__img'                   }}                 {%- else -%}                   {{ 'lifestyle-1' | placeholder_svg_tag: 'zs__img zs__placeholder' }}                 {%- endif -%}               </figure>             {%- else -%}               <figure class="zs__panel is-active">                 {{ 'lifestyle-1' | placeholder_svg_tag: 'zs__img zs__placeholder' }}               </figure>             {%- endfor -%}           </div>         </div>          {%- if s.side_note != blank -%}           <p class="zs__sidenote">{{ s.side_note | escape }}</p>         {%- endif -%}          <div class="zs__stack zs__caption" aria-live="polite">           {%- for block in specimens -%}             {%- assign no = forloop.index | prepend: '0' | slice: -2, 2 -%}             <div class="zs__panel zs__cap{% if forloop.first %} is-active{% endif %}" data-zs-panel="{{ forloop.index0 }}">               <span class="zs__numeral" aria-hidden="true">{{ no }}</span>               <div class="zs__cap-text">                 <p class="zs__cap-title">                   <span class="zs__cap-plate">{{ s.plate_word | escape }} {{ no }}</span>                   {{ block.settings.name | escape }}                 </p>                 {%- if block.settings.note != blank -%}                   <p class="zs__cap-note">{{ block.settings.note | escape }}</p>                 {%- endif -%}               </div>             </div>           {%- endfor -%}         </div>       </div>        {%- comment -%} Index {%- endcomment -%}       {%- if specimens.size > 0 -%}         <div class="zs__index" role="group" aria-label="{{ s.index_label | escape }}">           <p class="zs__label">             <span>{{ s.index_label | escape }}</span>             <span>{{ specimens.size | prepend: '0' | slice: -2, 2 }}</span>           </p>           <ol class="zs__list">             {%- for block in specimens -%}               {%- assign no = forloop.index | prepend: '0' | slice: -2, 2 -%}               <li {{ block.shopify_attributes }} data-zs-item="{{ forloop.index0 }}">                 <button                   type="button"                   class="zs__row{% if forloop.first %} is-active{% endif %}"                   data-zs-trigger="{{ forloop.index0 }}"                   aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"                 >                   <span class="zs__row-no">{{ no }}</span>                   <span class="zs__row-body">                     <span class="zs__row-name">{{ block.settings.name | escape }}</span>                     {%- if block.settings.latin != blank -%}                       <span class="zs__row-latin">{{ block.settings.latin | escape }}</span>                     {%- endif -%}                   </span>                   <span class="zs__row-line" aria-hidden="true"></span>                 </button>               </li>             {%- endfor -%}           </ol>         </div>          {%- comment -%} Specimen record {%- endcomment -%}         <div class="zs__spec">           <p class="zs__label"><span>{{ s.spec_label | escape }}</span></p>           <div class="zs__stack">             {%- for block in specimens -%}               <dl class="zs__panel zs__dl{% if forloop.first %} is-active{% endif %}" data-zs-panel="{{ forloop.index0 }}">                 {%- if block.settings.origin != blank -%}                   <div><dt>{{ s.label_origin | escape }}</dt><dd>{{ block.settings.origin | escape }}</dd></div>                 {%- endif -%}                 {%- if block.settings.seasoned != blank -%}                   <div><dt>{{ s.label_seasoned | escape }}</dt><dd>{{ block.settings.seasoned | escape }}</dd></div>                 {%- endif -%}                 {%- if block.settings.finish != blank -%}                   <div><dt>{{ s.label_finish | escape }}</dt><dd>{{ block.settings.finish | escape }}</dd></div>                 {%- endif -%}                 {%- if block.settings.tone_name != blank -%}                   <div>                     <dt>{{ s.label_tone | escape }}</dt>                     <dd><span class="zs__swatch" style="--tone: {{ block.settings.tone }}" aria-hidden="true"></span>{{ block.settings.tone_name | escape }}</dd>                   </div>                 {%- endif -%}               </dl>             {%- endfor -%}           </div>         </div>       {%- endif -%}        {%- comment -%} Aside: detail figure + marginalia {%- endcomment -%}       {%- if s.detail_image != blank or s.margin_text != blank -%}         <aside class="zs__aside">           {%- if s.detail_image != blank -%}             <figure class="zs__detail">               <div class="zs__detail-wrap">                 <div class="zs__detail-img">                   {{                     s.detail_image                     | image_url: width: 900                     | image_tag:                       widths: '320, 480, 640, 900',                       sizes: '(min-width: 1100px) 24vw, (min-width: 750px) 34vw, 44vw',                       alt: s.detail_alt | default: s.detail_image.alt | default: s.detail_caption,                       loading: 'lazy',                       class: 'zs__img'                   }}                 </div>               </div>               {%- if s.detail_caption != blank -%}                 <figcaption class="zs__detail-cap">                   {%- if s.detail_label != blank -%}<span class="zs__fig">{{ s.detail_label | escape }}</span>{%- endif -%}                   {{ s.detail_caption | escape }}                 </figcaption>               {%- endif -%}             </figure>           {%- endif -%}            {%- if s.margin_text != blank -%}             <div class="zs__margin">               {%- if s.margin_label != blank -%}<p class="zs__margin-label">{{ s.margin_label | escape }}</p>{%- endif -%}               <p class="zs__margin-text">{{ s.margin_text | escape }}</p>             </div>           {%- endif -%}         </aside>       {%- endif -%}        {%- comment -%} Foot: ruler + quiet link {%- endcomment -%}       <div class="zs__foot">         <div class="zs__scale">           <div class="zs__rule" aria-hidden="true"></div>           {%- if s.foot_note != blank -%}<p class="zs__scale-label">{{ s.foot_note | escape }}</p>{%- endif -%}         </div>         {%- if s.link_label != blank and s.link != blank -%}           <a class="zs__link" href="{{ s.link }}">             <span>{{ s.link_label | escape }}</span>             <span class="zs__link-line" aria-hidden="true"></span>           </a>         {%- endif -%}       </div>      </div>   </div> </zaisen-archive>  {% stylesheet %}   zaisen-archive { display: block; }    .zs {     background: var(--zs-bg);     color: var(--zs-ink);     font-family: var(--zs-font-body);     font-weight: var(--zs-body-weight);     font-size: 0.9375rem;     line-height: 1.7;     padding-block: calc(var(--zs-pt) * 0.6) calc(var(--zs-pb) * 0.6);     -webkit-font-smoothing: antialiased;     overflow-x: clip;   }   .zs *, .zs *::before, .zs *::after { box-sizing: border-box; }   .zs p { margin: 0; }    .zs__inner {     max-width: var(--zs-max);     margin-inline: auto;     padding-inline: clamp(1.25rem, 4vw, 3.5rem);   }    /* ---------- Running head: double rule ---------- */   .zs__head {     position: relative;     display: grid;     grid-template-columns: 1fr auto;     gap: 0.3rem 1rem;     padding-top: 1.05rem;     margin-bottom: clamp(2.25rem, 6vw, 4.5rem);     font-size: 0.6875rem;     line-height: 1.5;     letter-spacing: 0.2em;     text-transform: uppercase;   }   .zs__head::before,   .zs__head::after {     content: '';     position: absolute;     left: 0; right: 0;     height: 1px;     transform-origin: left center;   }   .zs__head::before { top: 0; background: var(--zs-gold); }   .zs__head::after  { top: 4px; background: var(--zs-hair); }   .zs__head-folio { text-align: right; }   .zs__head-edition { grid-column: 1 / -1; color: var(--zs-ink-soft); }    /* ---------- Grid (mobile first) ---------- */   .zs__grid {     display: grid;     grid-template-columns: minmax(0, 1fr);     --zs-gap: clamp(1.25rem, 2.6vw, 2.5rem);   }    /* ---------- Title + intro ---------- */   .zs__title {     font-family: var(--zs-font-head);     font-weight: var(--zs-head-weight);     font-size: clamp(2.5rem, 1.6rem + 5.2vw, var(--zs-title-max));     line-height: 0.98;     letter-spacing: -0.018em;     margin: 0;     text-wrap: balance;     min-width: 0;   }   .zs__title em { font-style: italic; }   .zs--indent .zs__title em { display: block; padding-inline-start: 0.8em; }    .zs__intro {     margin-top: 1.5rem;     max-width: 42ch;     text-wrap: pretty;   }   .zs__intro p + p { margin-top: 1em; }    /* ---------- Labels ---------- */   .zs__label {     display: flex;     justify-content: space-between;     align-items: baseline;     margin: 0 0 0.35rem !important;     padding-bottom: 0.7rem;     border-bottom: 1px solid var(--zs-gold);     font-size: 0.6875rem;     line-height: 1.4;     letter-spacing: 0.2em;     text-transform: uppercase;   }    /* ---------- Plate ---------- */   .zs__plate { position: relative; margin-top: 2.75rem; min-width: 0; }    .zs__frame {     position: relative;     background: var(--zs-mat);     border: 1px solid var(--zs-hair);     padding: min(var(--zs-mat-pad), 4vw);   }   .zs__crop {     position: absolute;     width: 14px; height: 14px;     border: 0 solid var(--zs-gold);     pointer-events: none;   }   .zs__crop--tl { top: -8px; left: -8px; border-top-width: 1px; border-left-width: 1px; }   .zs__crop--tr { top: -8px; right: -8px; border-top-width: 1px; border-right-width: 1px; }   .zs__crop--bl { bottom: -8px; left: -8px; border-bottom-width: 1px; border-left-width: 1px; }   .zs__crop--br { bottom: -8px; right: -8px; border-bottom-width: 1px; border-right-width: 1px; }    .zs__stack { display: grid; }   .zs__stack--img {     position: relative;     aspect-ratio: var(--zs-ratio);     overflow: hidden;     background: var(--zs-hair);   }   .zs__panel {     grid-area: 1 / 1;     margin: 0;     min-width: 0;     opacity: 0;     visibility: hidden;     transition: opacity 0.7s ease, visibility 0s linear 0.7s;   }   .zs__panel.is-active {     opacity: 1;     visibility: visible;     transition: opacity 0.7s ease, visibility 0s;   }   .zs__stack--img .zs__panel { position: absolute; inset: 0; }    .zs__img { display: block; width: 100%; height: 100%; object-fit: cover; }   .zs__placeholder { fill: var(--zs-ink); opacity: 0.22; background: var(--zs-mat); }    .zs__sidenote {     margin-top: 0.8rem !important;     font-size: 0.625rem;     letter-spacing: 0.18em;     text-transform: uppercase;     color: var(--zs-ink-soft);   }    .zs__caption { margin-top: 1.1rem; }   .zs__cap {     display: grid;     grid-template-columns: auto minmax(0, 1fr);     gap: 1.1rem;     align-items: end;   }   .zs__numeral {     font-family: var(--zs-font-head);     font-weight: 300;     font-size: clamp(3.5rem, 2.4rem + 3.4vw, 5.75rem);     line-height: 0.76;     letter-spacing: -0.02em;   }   .zs__cap-title {     font-family: var(--zs-font-head);     font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);     line-height: 1.2;   }   .zs__cap-plate {     display: block;     margin-bottom: 0.35rem;     font-family: var(--zs-font-body);     font-size: 0.625rem;     letter-spacing: 0.2em;     text-transform: uppercase;     color: var(--zs-ink-soft);   }   .zs__cap-note {     margin-top: 0.45rem !important;     max-width: 48ch;     font-size: 0.8125rem;     line-height: 1.6;     color: var(--zs-ink-soft);     text-wrap: pretty;   }    /* ---------- Index ---------- */   .zs__index { margin-top: 2.75rem; }   .zs__list { list-style: none; margin: 0; padding: 0; }   .zs__list li { border-bottom: 1px solid var(--zs-hair); }    .zs__row {     appearance: none;     -webkit-appearance: none;     background: none;     border: 0;     border-radius: 0;     margin: 0;     width: 100%;     display: grid;     grid-template-columns: 2.4rem minmax(0, 1fr) 2.75rem;     align-items: baseline;     padding: 0.85rem 0;     text-align: left;     font: inherit;     color: var(--zs-ink);     cursor: pointer;   }   .zs__row:focus-visible { outline: 1px solid var(--zs-ink); outline-offset: 3px; }    .zs__row-no {     font-size: 0.6875rem;     letter-spacing: 0.12em;     color: var(--zs-ink-soft);   }   .zs__row-body { display: block; }   .zs__row-name {     display: block;     font-family: var(--zs-font-head);     font-weight: var(--zs-head-weight);     font-size: 1.5rem;     line-height: 1.1;     color: var(--zs-ink-soft);     transition: color 0.4s ease;   }   .zs__row-latin {     display: block;     margin-top: 0.2rem;     font-style: italic;     font-size: 0.8125rem;     color: var(--zs-ink-soft);   }   .zs__row-line {     align-self: center;     height: 1px;     background: var(--zs-gold);     transform: scaleX(0.2);     transform-origin: left center;     transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);   }   .zs__row.is-active .zs__row-name,   .zs__row:hover .zs__row-name { color: var(--zs-ink); }   .zs__row.is-active .zs__row-line { transform: scaleX(1); }   .zs__row:hover .zs__row-line { transform: scaleX(0.6); }   .zs__row.is-active:hover .zs__row-line { transform: scaleX(1); }    /* ---------- Specimen record ---------- */   .zs__spec { margin-top: 2rem; }   .zs__dl { margin: 0; align-content: start; }   .zs__dl > div {     display: grid;     grid-template-columns: 5.75rem minmax(0, 1fr);     gap: 1rem;     padding: 0.65rem 0;     border-bottom: 1px solid var(--zs-hair);   }   .zs__dl dt {     padding-top: 0.28em;     font-size: 0.625rem;     letter-spacing: 0.18em;     text-transform: uppercase;     color: var(--zs-ink-soft);   }   .zs__dl dd { margin: 0; font-size: 0.875rem; line-height: 1.55; }   .zs__swatch {     display: inline-block;     width: 0.7rem; height: 0.7rem;     margin-inline-end: 0.55rem;     background: var(--tone);     border: 1px solid var(--zs-hair);     vertical-align: -0.05em;   }    /* ---------- Aside ---------- */   .zs__aside {     margin-top: 3.25rem;     display: grid;     grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);     gap: 1.25rem;     align-items: end;   }   .zs__detail { margin: 0; min-width: 0; }   .zs__detail-wrap { position: relative; margin: 0 10px 10px 0; }   .zs__detail-wrap::after {     content: '';     position: absolute;     inset: 10px -10px -10px 10px;     border: 1px solid var(--zs-gold);     pointer-events: none;   }   .zs__detail-img {     position: relative;     z-index: 1;     aspect-ratio: 4 / 5;     background: var(--zs-mat);     overflow: hidden;   }   .zs__detail-cap {     margin-top: 1.1rem;     font-size: 0.75rem;     line-height: 1.55;     color: var(--zs-ink-soft);     text-wrap: pretty;   }   .zs__fig {     display: block;     margin-bottom: 0.2rem;     font-size: 0.625rem;     letter-spacing: 0.2em;     text-transform: uppercase;     color: var(--zs-ink);   }   .zs__margin {     padding-inline-start: 0.9rem;     border-inline-start: 1px solid var(--zs-gold);     align-self: start;   }   .zs__margin-label {     margin-bottom: 0.5rem !important;     font-size: 0.625rem;     letter-spacing: 0.2em;     text-transform: uppercase;     color: var(--zs-ink-soft);   }   .zs__margin-text {     font-family: var(--zs-font-head);     font-style: italic;     font-size: 1.0625rem;     line-height: 1.45;     text-wrap: pretty;   }    /* ---------- Foot: ruler + link ---------- */   .zs__foot {     display: grid;     gap: 1.25rem;     align-items: end;     margin-top: clamp(3rem, 8vw, 5.5rem);   }   .zs__rule {     position: relative;     height: 14px;     border-bottom: 1px solid var(--zs-gold);   }   .zs__rule::before,   .zs__rule::after {     content: '';     position: absolute;     left: 0; right: 0; bottom: 0;     pointer-events: none;   }   .zs__rule::before {     height: 5px;     background-image: repeating-linear-gradient(90deg, var(--zs-gold) 0 1px, transparent 1px 8px);   }   .zs__rule::after {     height: 11px;     background-image: repeating-linear-gradient(90deg, var(--zs-gold) 0 1px, transparent 1px 80px);   }   .zs__scale-label {     margin-top: 0.7rem !important;     font-size: 0.625rem;     letter-spacing: 0.2em;     text-transform: uppercase;     color: var(--zs-ink-soft);   }   .zs__link {     display: inline-flex;     align-items: center;     gap: 0.9rem;     min-height: 44px;     font-size: 0.75rem;     letter-spacing: 0.2em;     text-transform: uppercase;     text-decoration: none;     color: var(--zs-ink);   }   .zs__link:focus-visible { outline: 1px solid var(--zs-ink); outline-offset: 4px; }   .zs__link-line {     display: block;     width: 2rem; height: 1px;     background: var(--zs-gold);     transition: width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);   }   .zs__link:hover .zs__link-line { width: 3.5rem; }    /* ---------- Reveal (only when JS arms it) ---------- */   .zs.is-armed .zs__head::before,   .zs.is-armed .zs__head::after { transform: scaleX(0); }   .zs.is-armed.is-inview .zs__head::before { transform: scaleX(1); transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1); }   .zs.is-armed.is-inview .zs__head::after  { transform: scaleX(1); transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s; }   .zs.is-armed .zs__frame { opacity: 0; }   .zs.is-armed.is-inview .zs__frame { opacity: 1; transition: opacity 1s ease 0.25s; }    /* ---------- Tablet ---------- */   @media (min-width: 750px) {     .zs { padding-block: calc(var(--zs-pt) * 0.8) calc(var(--zs-pb) * 0.8); }     .zs__head { grid-template-columns: 1fr auto 1fr; }     .zs__head-folio { text-align: center; }     .zs__head-edition { grid-column: auto; text-align: right; }     .zs--indent .zs__title em { padding-inline-start: 1.2em; }   }    @media (min-width: 750px) and (max-width: 1099.98px) {     .zs__grid {       grid-template-columns: repeat(12, minmax(0, 1fr));       column-gap: var(--zs-gap);     }     .zs__title  { grid-column: 1 / -1; grid-row: 1; }     .zs__intro  { grid-column: 1 / 9; grid-row: 2; }     .zs__plate  { grid-column: 1 / 8; grid-row: 3 / span 2; margin-top: 3rem; }     .zs__index  { grid-column: 8 / -1; grid-row: 3; margin-top: 3rem; }     .zs__spec   { grid-column: 8 / -1; grid-row: 4; align-self: start; }     .zs__aside  {       grid-column: 1 / -1; grid-row: 5;       grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);       gap: var(--zs-gap);       margin-top: 3.5rem;     }     .zs__detail { max-width: 340px; }     .zs__margin-text { font-size: 1.375rem; }     .zs__foot   { grid-column: 1 / -1; grid-row: 6; grid-template-columns: 1fr auto; gap: 3rem; }   }    /* ---------- Desktop ---------- */   @media (min-width: 1100px) {     .zs { padding-block: var(--zs-pt) var(--zs-pb); }     .zs__grid {       grid-template-columns: repeat(12, minmax(0, 1fr));       column-gap: var(--zs-gap);       align-items: start;     }     .zs__title  { grid-column: 1 / 9; grid-row: 1; }     .zs__intro  { grid-column: 9 / -1; grid-row: 1; align-self: end; margin-top: 0; padding-bottom: 0.7rem; }     .zs__index  { grid-column: 1 / 4; grid-row: 2; margin-top: clamp(3rem, 6vw, 5.5rem); }     .zs__spec   { grid-column: 1 / 4; grid-row: 3; margin-top: 2.25rem; }     .zs__plate  { grid-column: 4 / 10; grid-row: 2 / span 2; margin-top: clamp(3rem, 6vw, 5.5rem); }     .zs__aside  {       grid-column: 10 / -1; grid-row: 2 / span 2;       display: block;       margin-top: calc(clamp(3rem, 6vw, 5.5rem) + var(--zs-aside-offset));     }     .zs__margin { margin-top: 2.25rem; }     .zs__margin-text { font-size: 1.1875rem; }     .zs__foot   { grid-column: 1 / -1; grid-row: 4; grid-template-columns: 1fr auto; gap: 4rem; }      .zs__sidenote {       position: absolute;       top: 0;       right: 100%;       margin: 0 0.85rem 0 0 !important;       max-height: 100%;       overflow: hidden;       white-space: nowrap;       text-overflow: ellipsis;       writing-mode: vertical-rl;     