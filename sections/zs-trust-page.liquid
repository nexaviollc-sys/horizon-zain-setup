.zt__facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border-top:1px solid #d9cebf}.zt__fact{padding:35px 35px 0 0;min-width:0}.zt__fact:not(:first-child){border-inline-start:1px solid #d9cebf;padding-inline-start:35px}.zt__number{font-size:11px;letter-spacing:.15em;font-weight:700;color:#9f8055;display:block;margin-bottom:22px}.zt__fact h3{margin-bottom:16px}.zt__fact p,.zt__step p{font-size:14px;color:var(--zt-muted)}
.zt__steps{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.zt__step{border-top:1px solid #cdbda9;padding-top:25px;display:flex;flex-direction:column;gap:40px}.zt__step-n{font-family:Georgia,serif;font-size:45px;color:#b89b72}.zt__step h3{font-size:21px;margin-bottom:13px}.zt__step p{line-height:1.75}
.zt__split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,9vw,140px);align-items:start}.zt__prose>p{color:var(--zt-muted);font-size:15.5px;margin-bottom:18px}.zt__prose .zt__muted{font-size:13px;border-inline-start:2px solid #c9b38f;padding-inline-start:17px}.zt__inline-link{display:inline-flex;align-items:center;gap:12px;color:#483326!important;text-decoration:none;border-bottom:1px solid #a98963;font-size:13px;font-weight:650;line-height:2;margin-top:12px}.zt__inline-link:hover{color:#906e46!important}
.zt__external{display:grid;gap:22px}.zt__etsy{border:1px solid #cbbda7;padding:clamp(24px,4vw,40px);display:flex;align-items:center;justify-content:space-between;gap:30px;text-decoration:none;color:inherit!important;background:#fffaf4;transition:border .2s,box-shadow .2s}.zt__etsy:hover{border-color:#927149;box-shadow:0 8px 30px rgba(45,30,21,.06)}.zt__external-label{font-size:10px;letter-spacing:.14em;color:#8b795e;font-weight:700}.zt__etsy h3{font-family:Georgia,serif;font-size:clamp(27px,3vw,38px);margin:13px 0}.zt__etsy p{font-size:13.5px;color:var(--zt-muted)}.zt__eyebrow-action{font-size:12px;letter-spacing:.04em;text-decoration:underline;text-underline-offset:6px;white-space:nowrap}.zt__social{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}.zt__social>p{font-size:12px;color:var(--zt-muted)}.zt__social-links{display:flex;gap:24px;flex-wrap:wrap}.zt__social-links a{font-size:13px;color:#5b4331!important;text-decoration:underline;text-underline-offset:5px}
.zt__faq-layout{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(30px,7vw,120px)}.zt__faq-list{border-top:1px solid #cbbca9}.zt__faq{border-bottom:1px solid #cbbca9}.zt__faq summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:23px 0;cursor:pointer;font-size:16px;line-height:1.5;font-weight:550}.zt__faq summary::-webkit-details-marker{display:none}.zt__faq summary::marker{content:''}.zt__faq-sign{font-size:24px;font-weight:400;color:#9b7c57;transition:transform .18s}.zt__faq[open] .zt__faq-sign{transform:rotate(45deg)}.zt__faq-answer{padding:0 36px 27px 0}.zt__faq-answer p{font-size:14.5px;color:var(--zt-muted)}
.zt__end{background:radial-gradient(circle at 50% -20%,rgba(180,132,83,.2),transparent 65%),#2d211a;color:#f6efe7;text-align:center;padding-block:clamp(80px,10vw,142px)}.zt__end-inner{max-width:910px}.zt__end h2{margin:25px auto 20px;max-width:800px}.zt__end-inner>p:not(.zt__kicker){max-width:630px;margin-inline:auto;color:#d9cbbc;font-size:16px}.zt__actions--center{justify-content:center}.zt__closing{display:block;margin-top:65px;font-family:Georgia,serif;font-style:italic;font-size:18px;color:#c5aa83}
.zt a:focus-visible,.zt summary:focus-visible{outline:3px solid #a87a3a;outline-offset:4px}
@media(max-width:960px){.zt__hero-grid{grid-template-columns:1fr}.zt__hero-aside{display:none}.zt__facts{grid-template-columns:1fr}.zt__fact,.zt__fact:not(:first-child){padding:23px 0;border-inline-start:0;border-top:1px solid #ddd1c1}.zt__fact:first-child{border-top:none}.zt__steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.zt__split{grid-template-columns:1fr;gap:25px}.zt__faq-layout{grid-template-columns:1fr}}
@media(max-width:580px){.zt__hero-grid{padding-block:74px 80px}.zt h1{font-size:clamp(43px,11vw,62px)}.zt h2{font-size:clamp(34px,8.5vw,46px)}.zt__section{padding-block:65px}.zt__steps{grid-template-columns:1fr;gap:17px}.zt__step{gap:15px;padding:22px 0}.zt__step-n{font-size:31px}.zt__etsy{flex-direction:column;align-items:flex-start;gap:16px}.zt__eyebrow-action{white-space:normal}.zt__faq summary{font-size:15px}.zt__faq-answer{padding-inline-end:0}.zt__actions{align-items:stretch;flex-direction:column;gap:18px}.zt__text-link{align-self:flex-start}.zt__actions--center .zt__text-link{align-self:center}.zt__fineprint{font-size:9px;line-height:1.5}}
@media(prefers-reduced-motion:reduce){.zt__btn,.zt__faq-sign,.zt__etsy{transition:none!important}}
{% endstylesheet %}
