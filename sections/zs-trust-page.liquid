<article class="zt" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <div class="zt__wrap">
    <nav class="zt__crumb" aria-label="{{ zt_crumb | escape }}">
      <a href="{{ routes.root_url }}">ZAISEN</a><span aria-hidden="true">/</span><span>{{ zt_crumb | escape }}</span>
    </nav>
    <header class="zt__hero">
      <p class="zt__eyebrow">{{ zt_eyebrow | escape }}</p>
      <h1>{{ zt_heading | escape }}</h1>
      <p class="zt__quote">{{ zt_quote | escape }}</p>
      <p class="zt__lead">{{ zt_intro | escape }}</p>
    </header>

    <div class="zt__features">
      <section class="zt__etsy" aria-labelledby="zt-etsy-title">
        <p class="zt__eyebrow">{{ zt_etsyKicker | escape }}</p>
        <p class="zt__stars" aria-label="5 out of 5 stars" title="Five-star customer review on Etsy">★★★★★</p>
        <h2 id="zt-etsy-title">{{ zt_etsyTitle | escape }}</h2>
        <p>{{ zt_etsyText | escape }}</p>
        <a class="zt__btn zt__btn--gold" href="https://www.etsy.com/shop/ZAISEN" target="_blank" rel="noopener noreferrer">
          {{ zt_etsyButton | escape }} <span aria-hidden="true">↗</span>
        </a>
      </section>
      <section class="zt__contact" aria-labelledby="zt-contact-title">
        <p class="zt__eyebrow">{{ zt_contactKicker | escape }}</p>
        <h2 id="zt-contact-title">{{ zt_contactTitle | escape }}</h2>
        <p>{{ zt_contactText | escape }}</p>
        <div class="zt__emails">
          <div><span>{{ zt_support | escape }}</span><a href="mailto:support@zaisenstore.com">support@zaisenstore.com</a></div>
          <div><span>{{ zt_info | escape }}</span><a href="mailto:info@zaisenstore.com">info@zaisenstore.com</a></div>
          <div><span>{{ zt_contact | escape }}</span><a href="mailto:contact@zaisenstore.com">contact@zaisenstore.com</a></div>
        </div>
        <div class="zt__phone"><span>{{ zt_phoneLabel | escape }}</span><a href="tel:+13039438555" dir="ltr">+1 (303) 943-8555</a><a href="https://wa.me/13039438555" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div>
        <a class="zt__btn zt__btn--outline" href="{{ routes.root_url }}pages/contact">
          {{ zt_contactButton | escape }} <span aria-hidden="true">↗</span>
        </a>
      </section>
    </div>

    <section class="zt__about" aria-labelledby="zt-about-title">
      <div>
        <h2 id="zt-about-title">{{ zt_about | escape }}</h2>
        <p>{{ zt_aboutText | escape }}</p>
      </div>
      <nav class="zt__links" aria-label="{{ zt_about | escape }}">
        <a href="{{ routes.root_url }}pages/our-story">{{ zt_story | escape }} <span aria-hidden="true">↗</span></a>
        <a href="{{ routes.root_url }}policies/shipping-policy">{{ zt_shipping | escape }} <span aria-hidden="true">↗</span></a>
        <a href="{{ routes.root_url }}policies/refund-policy">{{ zt_refund | escape }} <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
    <section class="zt__addresses" aria-labelledby="zt-address-title">
      <h2 id="zt-address-title">{{ zt_locationTitle | escape }}</h2>
      <div class="zt__address-grid">
        <div class="zt__address">
          <span class="zt__address-label">{{ zt_workshopLabel | escape }}</span>
          <address>{{ zt_workshopAddress | escape }}</address>
        </div>
        <div class="zt__address">
          <span class="zt__address-label">{{ zt_companyLabel | escape }}</span>
          <address dir="ltr">{{ zt_companyAddress | escape }}</address>
        </div>
      </div>
      <p class="zt__address-note">{{ zt_locationNote | escape }}</p>
    </section>
    <section class="zt__social" aria-label="{{ zt_socialLabel | escape }}">
      <p class="zt__social-heading">{{ zt_socialLabel | escape }}</p>
      <div class="zt__social-profiles">
        <a href="https://www.etsy.com/shop/ZAISEN" target="_blank" rel="noopener noreferrer">Etsy <span aria-hidden="true">↗</span></a>
        {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>{% endif %}
        {% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer">Pinterest <span aria-hidden="true">↗</span></a>{% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">{{ zt_socialInstagram | escape }} <span aria-hidden="true">↗</span></a>
        {% else %}
          <span class="zt__social-soon">{{ zt_socialInstagram | escape }} <small>{{ zt_instagramSoon | escape }}</small></span>
        {% endif %}
      </div>
    </section>
    <p class="zt__foot">{{ zt_foot | escape }}</p>
  </div>
</article>
{% stylesheet %}
.zt{--zt-text:#30241d;--zt-muted:#6a5d51;--zt-gold:#b5935a;--zt-line:#e7ded3;color:var(--zt-text);background:#faf8f4;font-family:var(--font-body--family,Arial,sans-serif);padding-bottom:clamp(35px,5vw,65px)}
.zt *{box-sizing:border-box}.zt__wrap{max-width:1110px;margin:auto;padding-inline:clamp(18px,4vw,58px)}
.zt h1,.zt h2,.zt p{margin:0;color:inherit}.zt h1,.zt h2{font-family:var(--font-heading--family,Georgia,serif);font-weight:500;letter-spacing:-.035em;text-wrap:balance}
.zt h1{font-size:clamp(39px,5.2vw,70px);line-height:1.08}.zt h2{font-size:clamp(26px,2.8vw,37px);line-height:1.17}.zt p{font-size:14px;line-height:1.8}
.zt__crumb{display:flex;gap:10px;padding-block:20px 12px;color:#827368;font-size:12px;align-items:center}.zt__crumb a{color:inherit;text-decoration:none}.zt__crumb a:hover{text-decoration:underline}
.zt__hero{text-align:center;padding:45px 0 47px;max-width:830px;margin-inline:auto}.zt__eyebrow{color:#99754b!important;font-size:10px!important;font-weight:750;letter-spacing:.16em;text-transform:uppercase}
.zt__hero h1{margin-top:15px}.zt__quote{font-family:var(--font-heading--family,Georgia,serif)!important;font-style:italic;font-size:clamp(23px,3vw,39px)!important;line-height:1.27!important;margin:18px auto 12px!important;max-width:720px;color:#6d5038!important}
.zt__lead{max-width:610px;margin-inline:auto!important;color:var(--zt-muted)!important;font-size:15px!important}
.zt__features{display:grid;grid-template-columns:1fr 1fr;border:1px solid #e4d7c7;border-radius:9px;overflow:hidden;background:#fffdfb;box-shadow:0 10px 34px rgba(63,39,22,.035)}
.zt__etsy,.zt__contact{padding:clamp(26px,3.7vw,43px);min-width:0}.zt__etsy{background:linear-gradient(135deg,#34261e,#241a15);color:#fff3e5}.zt__etsy .zt__eyebrow{color:#d8b98a!important}.zt__stars{font-size:30px!important;letter-spacing:.14em;color:#e6c28a!important;margin:16px 0 12px!important;line-height:1.2!important}.zt__etsy h2{margin-bottom:12px}.zt__etsy>p:not(.zt__eyebrow):not(.zt__stars){color:#e2d6c9;margin-bottom:24px;max-width:400px}
.zt__contact h2{margin:16px 0 11px}.zt__contact>p:not(.zt__eyebrow){color:var(--zt-muted)}
.zt__btn{display:inline-flex;gap:12px;align-items:center;justify-content:center;min-height:45px;padding:10px 18px;border-radius:4px;text-decoration:none!important;font-size:12px;font-weight:700;line-height:1.5;transition:background .2s ease}.zt__btn--gold{background:#ead7b7;color:#34261e!important}.zt__btn--gold:hover{background:#fff2dd}.zt__btn--outline{border:1px solid #a48b6e;color:#392c20!important;margin-top:22px}.zt__btn--outline:hover{background:#f4eee5}
.zt__emails{display:grid;gap:12px;border-top:1px solid var(--zt-line);margin-top:18px;padding-top:17px}.zt__emails>div{min-width:0}.zt__emails span{display:block;font-size:11px;color:#796b5e;line-height:1.5}.zt__emails a{color:#493622!important;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
.zt__about{display:grid;grid-template-columns:1.25fr .75fr;gap:45px;padding:38px 0 24px;align-items:start}.zt__about h2{font-size:clamp(25px,2.5vw,34px);margin-bottom:10px}.zt__about p{color:var(--zt-muted);max-width:625px}
.zt__links{display:grid;gap:11px;padding-block:5px}.zt__links a{font-size:13px;display:flex;justify-content:space-between;gap:12px;padding-bottom:9px;border-bottom:1px solid var(--zt-line);text-decoration:none;color:#493622!important;font-weight:650}.zt__links a:hover{color:#987343!important}
.zt__phone{border-top:1px solid var(--zt-line);margin-top:15px;padding-top:14px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:12px}.zt__phone span{color:#796b5e;font-size:11px}.zt__phone a{color:#493622!important;font-weight:700;text-decoration:underline;text-underline-offset:3px}
.zt__addresses{padding:28px 0 20px;border-top:1px solid var(--zt-line)}.zt__addresses h2{font-size:clamp(24px,2.3vw,32px);margin-bottom:15px}.zt__address-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.zt__address{border:1px solid var(--zt-line);background:#fffdfb;border-radius:5px;padding:18px 21px}.zt__address-label{font-size:11px;display:block;letter-spacing:.04em;font-weight:700;color:#80603e;margin-bottom:9px}.zt__address address{font-size:13px;font-style:normal;line-height:1.7;overflow-wrap:anywhere}.zt__address-note{color:var(--zt-muted)!important;font-size:11px!important;margin-top:12px!important}
.zt__social{border-top:1px solid var(--zt-line);padding:19px 0;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.zt__social-heading{font-weight:700;font-size:12px!important;color:#5e4936!important}.zt__social-profiles{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.zt__social-profiles a{color:#60452a!important;text-decoration:underline;font-weight:700;font-size:12px;text-underline-offset:4px}.zt__social-soon{display:inline-flex;gap:5px;align-items:center;font-size:12px;color:#8c8074}.zt__social-soon small{font-size:10px;padding:3px 7px;border:1px solid #ddd4c9;border-radius:50px;color:#746657}.zt__foot{text-align:center;color:#837367!important;font-size:12px!important;border-top:1px solid var(--zt-line);margin-top:18px!important;padding-top:17px}
.zt a:focus-visible{outline:2px solid #a9824c;outline-offset:4px}
@media(max-width:760px){.zt__address-grid{grid-template-columns:1fr}.zt__social{align-items:flex-start;flex-direction:column;gap:9px}.zt__hero{padding:30px 0 33px}.zt__features,.zt__about{grid-template-columns:1fr}.zt__about{gap:20px;padding:30px 0 18px}.zt__contact,.zt__etsy{padding:26px 23px}.zt__hero h1{font-size:clamp(36px,9vw,53px)}}
@media(prefers-reduced-motion:reduce){.zt__btn{transition:none}}
{% endstylesheet %}
