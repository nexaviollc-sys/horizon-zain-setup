    {% comment %}Matches the eight customer-facing FAQs; rich search presentation is not guaranteed.{% endcomment %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Are ZAISEN products really handmade?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Our wooden products are created through hands-on craftsmanship at our workshop in Pakistan. Our team shapes, details, finishes and prepares the pieces we offer. We do not purchase finished wooden décor from local wholesale warehouses and simply resell it under the ZAISEN name."
            }
          },
          {
            "@type": "Question",
            "name": "Where are ZAISEN wooden products made?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Our working workshop is in the Saddar area near Islamabad, Pakistan. This is where our wooden products are crafted. Our administrative and legal business address is separate from our production location and is listed in our Legal Notice."
            }
          },
          {
            "@type": "Question",
            "name": "Are your product photographs real or AI-generated?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Our listings represent the actual wooden product designs we sell. Some images may be digitally polished or styled using AI-assisted editing to create consistent backgrounds and presentation. We aim to represent each design accurately, but natural wood grain, color and small handmade details can vary from piece to piece. Check each listing for dimensions and materials."
            }
          },
          {
            "@type": "Question",
            "name": "When is free international shipping available, and how long does delivery take?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ zs_story_shipping_faq_answer | strip | json }}
            }
          },
          {
            "@type": "Question",
            "name": "Which shipping company delivers ZAISEN orders?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We arrange international shipments through Star Cargo International and relevant delivery partners. Once tracking information becomes available after dispatch, we provide it so you can follow your order's journey."
            }
          },
          {
            "@type": "Question",
            "name": "What if my product arrives damaged or doesn't match its description?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Contact us within 14 days of delivery if your product arrives damaged, defective, incorrect or materially different from its description. Send your order number, a description of the problem and clear photographs or video. We review eligible cases under our Refund Policy. A suitable outcome may include a repair, replacement, partial refund or full refund, depending on the circumstances. Natural wood variations are not automatically defects."
            }
          },
          {
            "@type": "Question",
            "name": "Can I return an order simply because I changed my mind?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We do not offer discretionary change-of-mind returns unless applicable law requires otherwise. The 14-day period for reporting genuine product issues begins when your order arrives. You can read the eligibility details in our Refund Policy. Your mandatory consumer rights remain unaffected."
            }
          },
          {
            "@type": "Question",
            "name": "How can I contact ZAISEN before placing an order?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We welcome questions about materials, dimensions, finishes, shipping or existing orders. Email us at info@zaisenstore.com or use our Contact page. You can message us at any time; response times may vary."
            }
          }
        ]
      }
    </script>

