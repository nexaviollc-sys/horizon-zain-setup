{%- comment -%}
  ZAISEN Reference-Inspired Hero.
  Organic dark-walnut backdrop, layered product photo, pill CTA,
  real merchandise and responsive typographic hierarchy.
  The actual product is selected by the merchant or safely falls back
  to the live handcrafted-wooden-horse-statue product.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero_product = s.hero_product
  if hero_product == blank
    assign hero_product = all_products['handcrafted-wooden-horse-statue']
  endif
  assign hero_image = s.image
  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif
  assign hero_link = s.primary_link | default: routes.all_products_collection_url
  assign hero_alt = hero_image.alt | default: 'ZAISEN handcrafted wooden horse sculpture'
  assign font_base = s.hero_font
  assign font_light = font_base | font_modify: 'weight', '300'
  assign font_medium = font_base | font_modify: 'weight', '500'
  assign font_bold = font_base | font_modify: 'weight', '700'
-%}
{%- if font_base != blank -%}
  {% style %}
    {{ font_base | font_face: font_display: 'swap' }}
    {% if font_light != blank %}{{ font_light | font_face: font_display: 'swap' }}{% endif %}
    {% if font_medium != blank %}{{ font_medium | font_face: font_display: 'swap' }}{% endif %}
    {% if font_bold != blank %}{{ font_bold | font_face: font_display: 'swap' }}{% endif %}
    .zf-hero,body:has(.zf-hero) #header-component {
      font-family: {{ font_base.family | json }}, {{ font_base.fallback_families }};
    }
  {% endstyle %}
{%- endif -%}

<section
  id="zaisen-curved-hero-{{ section.id }}"
  class="zf-hero"
  style="--zf-white:{{ s.bg_color }};--zf-dark:{{ s.dark_color }};--zf-text:{{ s.text_color }};--zf-gold:{{ s.champagne_color }};"
  aria-label="ZAISEN handcrafted wooden home decor"
>
  <div class="zf-hero__canvas">
    <svg class="zf-hero__walnut-shape" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 810" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M1190 0H1440V810H590C525 768 516 701 578 629L1190 0Z" fill="{{ s.dark_color }}"/>
    </svg>

    <div class="zf-hero__detail zf-hero__detail--line" aria-hidden="true">
      <svg viewBox="0 0 430 280" fill="none"><path d="M427 15C307-20 229 18 214 83C200 149 323 155 296 205C273 248 148 214 21 275" stroke="currentColor" stroke-width="1.1" opacity=".4"/><circle cx="21" cy="275" r="3" fill="currentColor"/></svg>
    </div>
    <span class="zf-hero__spark zf-hero__spark--one" aria-hidden="true"></span>
    <span class="zf-hero__spark zf-hero__spark--two" aria-hidden="true"></span>
    <span class="zf-hero__spark zf-hero__spark--three" aria-hidden="true"></span>

    <div class="zf-hero__copy">
      <p class="zf-hero__eyebrow"><span aria-hidden="true" class="zf-hero__eyebrow-stroke"></span>{{ s.eyebrow | escape }}</p>
      <h1 class="zf-hero__headline">{{ s.heading }}</h1>
      <p class="zf-hero__subline">A little closer to nature.</p>
      <p class="zf-hero__description">{{ s.subheading | escape }}</p>
      <div class="zf-hero__actions">
        <a class="zf-hero__cta" href="{{ hero_link }}">
          <span class="zf-hero__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9h14l-1.2 11H6.2L5 9Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
          </span>
          <span>{{ s.primary_text | default: 'Explore Collection' | escape }}</span>
          <span class="zf-hero__cta-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="zf-hero__secondary" href="{{ routes.all_products_collection_url }}">Discover our pieces <span aria-hidden="true">↗</span></a>
      </div>
      <div class="zf-hero__pagination" aria-hidden="true"><span class="zf-hero__pagination-active"></span><span></span><span></span></div>
    </div>

    <div class="zf-hero__art" aria-label="Featured ZAISEN wooden sculpture">
      <span class="zf-hero__orbit" aria-hidden="true"></span>
      <div class="zf-hero__product">
        {%- if hero_image != blank -%}
          {{ hero_image | image_url: width: 1600 | image_tag: class: 'zf-hero__product-image', loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1100px) 44vw, (min-width: 750px) 49vw, 86vw', alt: hero_alt }}
        {%- else -%}
          <div class="zf-hero__product-fallback" aria-hidden="true"><span>ZAISEN</span><small>HANDCRAFTED PURE WOOD</small></div>
        {%- endif -%}
      </div>
      <span class="zf-hero__art-caption" aria-hidden="true">CRAFTED IN WOOD · MADE TO LAST</span>
    </div>

    <div class="zf-hero__bottom-note">
      <span class="zf-hero__note-mark" aria-hidden="true">Z.</span>
      <div><span>MADE WITH INTENTION</span><strong>Discover the beauty in every grain <span aria-hidden="true">↗</span></strong></div>
    </div>

    {%- if hero_product != blank -%}
      <a class="zf-hero__product-teaser" href="{{ hero_product.url }}" aria-label="View {{ hero_product.title | escape }}">
        <span class="zf-hero__teaser-eyebrow">FEATURED CRAFT <span class="zf-hero__teaser-direction">01 / 01</span></span>
        <span class="zf-hero__teaser-row">
          {%- if hero_product.featured_image != blank -%}
            {{ hero_product.featured_image | image_url: width: 180 | image_tag: class: 'zf-hero__teaser-photo', loading: 'lazy', widths: '90, 180', sizes: '70px', alt: hero_product.title }}
          {%- endif -%}
          <span class="zf-hero__teaser-description">
            <strong>{{ hero_product.title | escape }}</strong>
            <small>{{ hero_product.price | money }}</small>
          </span>
          <span class="zf-hero__teaser-arrow" aria-hidden="true">↗</span>
        </span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .zf-hero {
    --zf-white:#fff;--zf-dark:#2B1D17;--zf-text:#2B1D17;--zf-gold:#D8B56A;
    position:relative;z-index:1;background:#fff;color:var(--zf-text);
    padding:0 clamp(12px,4.6vw,74px) clamp(28px,4.4vw,70px);
  }
  .zf-hero *{box-sizing:border-box}
  .zf-hero__canvas {
    position:relative;isolation:isolate;max-width:1640px;margin:0 auto;
    width:100%;height:clamp(650px,58vw,830px);border-radius:34px;
    background:var(--zf-white);overflow:hidden;
    box-shadow:0 26px 90px rgba(43,29,23,.055);
  }
  .zf-hero__walnut-shape{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
  .zf-hero__copy{position:absolute;z-index:4;left:clamp(34px,12.9%,205px);top:26%;width:40%;max-width:530px}
  .zf-hero__eyebrow{font-size:clamp(10px,.85vw,12px);font-weight:500;letter-spacing:.16em;color:#987657;text-transform:uppercase;display:flex;align-items:center;gap:13px;margin:0 0 31px}
  .zf-hero__eyebrow-stroke{display:block;width:26px;height:1px;background:var(--zf-gold)}
  .zf-hero__headline{font-size:clamp(37px,3.7vw,63px);font-weight:300;line-height:1.19;letter-spacing:-.047em;margin:0;color:var(--zf-text);max-width:14ch}
  .zf-hero__headline strong,.zf-hero__headline b{display:block;font-weight:700;letter-spacing:-.048em;line-height:1.13}
  .zf-hero__headline em{font-style:normal;font-weight:700;display:block}
  .zf-hero__subline{margin:24px 0 4px;font-size:clamp(14px,1.05vw,16px);color:#68554C;font-weight:500;line-height:1.5}
  .zf-hero__description{margin:0;max-width:37ch;font-size:clamp(12px,.93vw,14px);line-height:1.7;color:#938B84;font-weight:400}
  .zf-hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:34px}
  .zf-hero__cta{display:inline-flex;align-items:center;gap:17px;padding:6px 25px 6px 7px;border-radius:999px;background:var(--zf-dark);color:#fff;text-decoration:none;min-height:66px;font-size:14px;letter-spacing:-.01em;font-weight:500;box-shadow:0 17px 32px rgba(43,29,23,.13);transition:transform .25s ease,box-shadow .25s ease}
  .zf-hero__cta:hover{transform:translateY(-3px);box-shadow:0 20px 35px rgba(43,29,23,.2);color:#fff}
  .zf-hero__cta-icon{width:49px;height:49px;border-radius:50%;display:grid;place-items:center;background:var(--zf-gold);color:var(--zf-dark);flex-shrink:0}
  .zf-hero__cta-arrow{font-size:18px;margin-left:4px}
  .zf-hero__secondary{display:inline-flex;align-items:center;gap:8px;color:var(--zf-text);text-decoration:none;font-size:12px;font-weight:500;line-height:1.6}
  .zf-hero__secondary:hover{text-decoration:underline}
  .zf-hero__pagination{display:flex;align-items:center;gap:8px;margin-top:42px}
  .zf-hero__pagination span{display:block;width:12px;height:3px;border-radius:10px;background:#CFCAC4}
  .zf-hero__pagination .zf-hero__pagination-active{width:38px;background:var(--zf-gold)}
  .zf-hero__art{position:absolute;z-index:2;right:5.1%;top:17%;width:min(49%,685px);height:66%;display:grid;place-items:center;pointer-events:none}
  .zf-hero__orbit{position:absolute;inset:10% 9% 8%;border:1px solid rgba(255,255,255,.18);border-radius:52% 48% 51% 49%;transform:rotate(20deg);pointer-events:none}
  .zf-hero__product{width:min(100%,560px);aspect-ratio:1;border-radius:50%;overflow:hidden;position:relative;box-shadow:0 35px 70px rgba(9,5,3,.38),0 0 0 1px rgba(255,255,255,.1);transform:rotate(-8deg);animation:zf-hero-float 8s ease-in-out infinite;background:#DED3C3}
  .zf-hero__product-image{width:100%;height:100%;display:block;object-fit:cover;transform:rotate(8deg) scale(1.21)}
  .zf-hero__product-fallback{width:100%;height:100%;display:grid;place-content:center;text-align:center;gap:15px;color:var(--zf-dark);background:#E2D4C1}
  .zf-hero__product-fallback span{font-size:clamp(44px,6vw,75px);font-weight:700;letter-spacing:.13em}
  .zf-hero__product-fallback small{font-size:11px;letter-spacing:.16em}
  @keyframes zf-hero-float{0%,100%{translate:0 0}50%{translate:0 -12px}}
  .zf-hero__art-caption{position:absolute;top:-6px;right:3%;font-size:9px;letter-spacing:.2em;color:#E9D4B5;white-space:nowrap}
  .zf-hero__detail--line{position:absolute;right:2%;top:27%;z-index:1;width:36%;color:#D8B56A;opacity:.35;pointer-events:none;transform:rotate(8deg)}
  .zf-hero__detail svg{width:100%;display:block}
  .zf-hero__spark{display:block;width:8px;height:8px;border-radius:50%;position:absolute;z-index:3;background:var(--zf-gold);box-shadow:0 0 0 5px rgba(216,181,106,.07)}
  .zf-hero__spark--one{top:25%;right:28%;width:6px;height:6px}
  .zf-hero__spark--two{top:44%;right:46%;width:10px;height:10px}
  .zf-hero__spark--three{top:17%;right:11%;width:6px;height:6px}
  .zf-hero__bottom-note{position:absolute;left:6.3%;bottom:7%;display:flex;align-items:center;gap:12px;color:var(--zf-text);z-index:3}
  .zf-hero__note-mark{width:59px;height:59px;display:grid;place-items:center;border-radius:50%;border:2px dashed #DDD4C9;background:#F8F2E9;color:#6F503E;font-size:22px;font-weight:700}
  .zf-hero__bottom-note>div{display:flex;flex-direction:column;gap:7px}
  .zf-hero__bottom-note>div>span{font-size:10px;letter-spacing:.12em;color:#A39B94}
  .zf-hero__bottom-note strong{font-size:14px;line-height:1.5;font-weight:600}
  .zf-hero__bottom-note strong span{color:#866747;margin-left:4px}
  .zf-hero__product-teaser{position:absolute;bottom:6%;right:5%;width:35%;max-width:490px;z-index:5;display:block;text-decoration:none;color:#fff;border:1px dashed rgba(255,255,255,.36);border-radius:22px;padding:13px 17px 16px;background:rgba(24,15,12,.24);backdrop-filter:blur(8px);transition:background .25s,border-color .25s}
  .zf-hero__product-teaser:hover{color:#fff;background:rgba(24,15,12,.4);border-color:rgba(216,181,106,.65)}
  .zf-hero__teaser-eyebrow{font-size:10px;font-weight:400;color:#E6DDD4;letter-spacing:.08em;display:flex;justify-content:space-between;padding:2px 1px 11px;border-bottom:1px solid rgba(255,255,255,.14)}
  .zf-hero__teaser-direction{color:var(--zf-gold)}
  .zf-hero__teaser-row{display:flex;align-items:center;gap:13px;padding-top:12px}
  .zf-hero__teaser-photo{width:67px;height:67px;border-radius:50%;object-fit:cover;flex-shrink:0}
  .zf-hero__teaser-description{min-width:0;display:flex;flex-direction:column;gap:7px}
  .zf-hero__teaser-description strong{font-size:12px;font-weight:500;line-height:1.4;max-width:22ch;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .zf-hero__teaser-description small{font-size:19px;font-weight:600;color:#fff}
  .zf-hero__teaser-arrow{margin-left:auto;width:34px;height:34px;background:var(--zf-gold);color:var(--zf-dark);border-radius:50%;display:grid;place-items:center;font-size:16px;flex-shrink:0}
  .zf-hero a:focus-visible{outline:2px solid var(--zf-gold);outline-offset:4px}
  @media(min-width:1100px) and (max-width:1410px){
    .zf-hero__copy{left:8.5%;width:43%;top:25%}
    .zf-hero__headline{font-size:clamp(40px,4vw,54px)}
    .zf-hero__product-teaser{right:3%;width:37%}
    .zf-hero__bottom-note{left:5%}
  }
  @media(max-width:1099px){
    .zf-hero{padding-inline:20px}
    .zf-hero__canvas{height:720px;border-radius:28px}
    .zf-hero__copy{left:6%;top:24%;width:49%}
    .zf-hero__headline{font-size:clamp(35px,4.1vw,52px)}
    .zf-hero__actions{gap:13px}
    .zf-hero__cta{min-height:58px;font-size:12px;padding-right:20px;gap:11px}
    .zf-hero__cta-icon{width:45px;height:45px}
    .zf-hero__product{width:100%}
    .zf-hero__art{right:3%;top:20%;width:50%;height:57%}
    .zf-hero__product-teaser{width:40%;right:3%}
  }
  @media(max-width:749px){
    .zf-hero{padding:0 12px 27px}
    .zf-hero__canvas{height:870px;border-radius:27px}
    .zf-hero__walnut-shape{display:none}
    .zf-hero__canvas::before{
      content:"";position:absolute;z-index:-1;inset:auto 0 0;height:59%;
      background:var(--zf-dark);clip-path:polygon(0 24%,20% 9%,41% 0,100% 0,100% 100%,0 100%)
    }
    .zf-hero__copy{top:33px;left:26px;right:26px;width:auto;max-width:none}
    .zf-hero__eyebrow{font-size:9px;margin-bottom:15px}
    .zf-hero__headline{font-size:clamp(36px,9vw,51px);max-width:15ch}
    .zf-hero__subline{margin-top:13px;font-size:14px}
    .zf-hero__description{font-size:12px;max-width:34ch}
    .zf-hero__actions{margin-top:21px;gap:12px}
    .zf-hero__cta{min-height:53px;padding:5px 18px 5px 5px;gap:13px;font-size:12px;box-shadow:0 10px 22px rgba(43,29,23,.13)}
    .zf-hero__cta-icon{width:43px;height:43px}
    .zf-hero__secondary{font-size:11px}
    .zf-hero__pagination{margin-top:20px}
    .zf-hero__art{top:44%;left:8%;width:84%;right:8%;height:38%}
    .zf-hero__product{width:min(100%,365px)}
    .zf-hero__art-caption{top:0;right:-2%;font-size:8px}
    .zf-hero__bottom-note{display:none}
    .zf-hero__product-teaser{width:auto;left:17px;right:17px;bottom:2.7%;max-width:none;padding:9px 14px 12px;border-radius:17px}
    .zf-hero__teaser-eyebrow{font-size:9px;padding-bottom:5px}
    .zf-hero__teaser-row{padding-top:9px}
    .zf-hero__teaser-photo{width:52px;height:52px}
    .zf-hero__teaser-description strong{font-size:11px;max-width:28ch}
    .zf-hero__teaser-description small{font-size:15px}
    .zf-hero__detail--line{width:80%;right:-8%;top:57%}
    .zf-hero__spark--one{top:55%;right:10%}
    .zf-hero__spark--two{top:66%;right:82%}
    .zf-hero__spark--three{top:43%;right:9%}
  }
  @media(max-width:390px){.zf-hero__canvas{height:895px}.zf-hero__copy{left:19px;right:19px}.zf-hero__headline{font-size:36px}.zf-hero__secondary{display:none}.zf-hero__art{top:43%}}
  @media(prefers-reduced-motion:reduce){
    .zf-hero__product{animation:none}
    .zf-hero__cta,.zf-hero__product-teaser{transition:none}
  }
  /* Reference-inspired header, but keep Horizon's native search, cart and locale controls */
  body:has(.zf-hero) #header-group .zs-announcement{display:none}
  body:has(.zf-hero) #header-group{background:#fff}
  body:has(.zf-hero) #header-component{--zs-header-accent:#2B1D17;color:#2B1D17}
  body:has(.zf-hero) #header-component .header__underlay-closed{
    box-shadow:none!important;background-color:#fff!important;
  }
  body:has(.zf-hero) #header-component .header__underlay-closed::before{display:none}
  body:has(.zf-hero) #header-component .header__row--top{border-bottom:0}
  body:has(.zf-hero) #header-component .header__columns{
    padding-inline:clamp(14px,3.2vw,52px);column-gap:clamp(11px,2vw,27px)
  }
  body:has(.zf-hero) #header-component .menu-list__link{font-size:13px;font-weight:400;letter-spacing:0;color:#2B1D17}
  body:has(.zf-hero) #header-component .menu-list__link-title::after{background:var(--zf-gold,#D8B56A)}
  body:has(.zf-hero) #header-component .header-actions__action:not(.dropdown-localization__button){
    background:transparent;box-shadow:none;border-radius:50%;
  }
  .zf-header-ctas{display:flex;align-items:center;gap:11px;padding-inline-start:13px;white-space:nowrap}
  .zf-header-ctas a{min-height:43px;display:inline-flex;align-items:center;justify-content:center;
    padding:10px 24px;border-radius:999px;text-decoration:none;
    font-size:12px;font-weight:500;transition:background .2s,color .2s,border-color .2s
  }
  .zf-header-ctas__outline{color:#2B1D17;border:1px solid #2B1D17;background:#fff}
  .zf-header-ctas__outline:hover{background:#F8F4F0}
  .zf-header-ctas__shop{background:#D8B56A;color:#2B1D17;border:1px solid #D8B56A}
  .zf-header-ctas__shop:hover{background:#F3D58D;border-color:#F3D58D}
  .zf-header-ctas a:focus-visible{outline:2px solid #2B1D17;outline-offset:3px}
  @media(max-width:1350px){.zf-header-ctas__outline{display:none!important}}
  @media(max-width:1140px){.zf-header-ctas{display:none!important}}
  @media(max-width:749px){
    body:has(.zf-hero) #header-component .header__columns{padding-inline:14px}
    body:has(.zf-hero) #header-component .header-logo__image{max-height:67px}
    body:has(.zf-hero) #header-group .header__row--top{min-height:68px}
  }

  /* Phase 1 correction: true edge-to-edge hero, never a padded/rounded card. */
  .zf-hero {
    width:100%;
    max-width:none;
    padding:0!important;
    margin:0;
    background:#FFFFFF;
  }
  .zf-hero__canvas {
    width:100%;
    max-width:none;
    height:clamp(720px, min(65vw, 92svh), 900px);
    min-height:720px;
    margin:0;
    border-radius:0!important;
    box-shadow:none!important;
  }
  /* Remove the artificial product photo disk. The natural photo fades into
     the composition with a soft edge; source product pixels stay unchanged. */
  .zf-hero__product {
    width:min(100%, 650px);
    border:0;
    border-radius:0!important;
    background:transparent!important;
    box-shadow:none!important;
    overflow:visible;
    transform:none;
    aspect-ratio:1;
    animation:zf-hero-float 8s ease-in-out infinite;
  }
  .zf-hero__product-image {
    width:100%;
    height:100%;
    object-fit:contain;
    transform:none;
    border-radius:0!important;
    -webkit-mask-image:radial-gradient(ellipse 48% 49% at 50% 50%, #000 70%, transparent 100%);
    mask-image:radial-gradient(ellipse 48% 49% at 50% 50%, #000 70%, transparent 100%);
    filter:drop-shadow(0 24px 25px rgba(18,9,5,.20));
  }
  .zf-hero__orbit{border:0;opacity:0}
  .zf-hero__art {
    width:min(51%,720px);
    height:70%;
    right:4%;
    top:15%;
  }
  .zf-hero__copy{top:30%}
  /* A sticky native Horizon header, translucent initially; white on scroll.
     No hardcoded scroll listener: we reuse the theme's own sticky state. */
  body:has(.zf-hero) #header-group {
    background:transparent!important;
  }
  body:has(.zf-hero) #header-group .shopify-section:has(.zs-announcement) {
    display:none!important;
  }
  body:has(.zf-hero) #header-group .zs-announcement {display:none!important}
  body:has(.zf-hero) #header-component[transparent='not-sticky']:not([data-sticky-state='active']) {
    position:absolute;
    inset-inline:0;
    top:0;
    background:transparent!important;
    --closed-underlay-height:0px;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky']:not([data-sticky-state='active']) .header__underlay-closed {
    height:0!important;
    background:transparent!important;
    box-shadow:none!important;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky']:not([data-sticky-state='active']) .header__row {
    background:transparent!important;
    border-color:transparent!important;
    box-shadow:none!important;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky'][data-sticky-state='active'] {
    background:#FFFFFF!important;
    color:#2B1D17!important;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky'][data-sticky-state='active'] .header__underlay-closed {
    height:100%!important;
    background:#FFFFFF!important;
    box-shadow:0 8px 25px rgba(43,29,23,.08)!important;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky'][data-sticky-state='active'] .header__row {
    background:#FFFFFF!important;
    --color-foreground:#2B1D17;
    border-color:transparent!important;
  }
  body:has(.zf-hero) #header-component[transparent='not-sticky'][data-sticky-state='active'] .zf-header-ctas__outline {
    color:#2B1D17;
    border-color:#2B1D17;
  }
  /* Reference: outlined secondary CTA floats on walnut; yellow main pill. */
  body:has(.zf-hero) #header-component:not([data-sticky-state='active']) .zf-header-ctas__outline {
    color:#FFFFFF;
    border-color:rgba(255,255,255,.84);
    background:transparent;
  }
  body:has(.zf-hero) #header-component:not([data-sticky-state='active']) .zf-header-ctas__outline:hover {
    color:#2B1D17;
    background:#FFFFFF;
  }
  .zf-hero__bottom-note{left:6%;bottom:9%}
  .zf-hero__product-teaser{bottom:8%;right:5%;max-width:480px}
  @media(min-width:1500px) {
    .zf-hero__copy{left:clamp(160px,12.8%,230px)}
    .zf-hero__art{right:7%}
  }
  @media(max-width:1099px) and (min-width:750px){
    .zf-hero__canvas{height:740px;min-height:740px;border-radius:0!important}
    .zf-hero__copy{top:29%}
    .zf-hero__art{top:20%;width:50%;height:58%}
    .zf-hero__product-teaser{bottom:6%}
  }
  @media(max-width:749px){
    .zf-hero{padding:0!important;margin:0}
    .zf-hero__canvas {
      width:100%;max-width:none;
      height:clamp(830px, 112svh, 970px);
      min-height:830px;
      border-radius:0!important;
      box-shadow:none!important;
    }
    .zf-hero__canvas::before {
      top:45%;
      left:-13%;
      width:130%;
      height:75%;
      transform:rotate(-8deg);
      border-radius:46% 0 0 0 / 20% 0 0 0;
      clip-path:none;
      background:var(--zf-dark);
    }
    .zf-hero__copy{top:clamp(85px,13svh,112px);left:22px;right:22px}
    .zf-hero__headline{font-size:clamp(36px,9vw,50px)}
    .zf-hero__art{top:47%;left:6%;right:6%;width:88%;height:37%}
    .zf-hero__product{width:min(100%,410px)}
    .zf-hero__product-image {
      -webkit-mask-image:radial-gradient(ellipse 49% 49% at 50% 50%,#000 66%,transparent 100%);
      mask-image:radial-gradient(ellipse 49% 49% at 50% 50%,#000 66%,transparent 100%);
    }
    .zf-hero__product-teaser{bottom:2.5%;left:15px;right:15px}
    .zf-hero__art-caption{top:3%;right:2%}
    .zf-hero__bottom-note{display:none}
  }
  @media(prefers-reduced-motion:reduce){
    .zf-hero__product{animation:none}
  }
{% endstylesheet %}

