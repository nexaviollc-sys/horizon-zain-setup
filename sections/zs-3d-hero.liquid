{%- liquid
  assign s = section.settings
  assign image = s.image
  if image == blank
    assign hero_product = all_products['handcrafted-carved-wooden-table-lamp']
    assign image = hero_product.featured_image
  endif
  assign primary_destination = s.primary_link | default: routes.all_products_collection_url
  assign secondary_destination = s.secondary_link | default: '#zaisen-making'
-%}
<section id="zaisen-hero" class="za-hero" aria-label="ZAISEN handcrafted wooden home decor">
  <div class="za-hero__shell">
    <div class="za-hero__editorial">
      <p class="za-eyebrow za-hero__eyebrow"><span class="za-rule" aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>
      <h1 class="za-hero__title">{{ s.heading }}</h1>
      <p class="za-hero__description">{{ s.subheading | escape }}</p>
      <div class="za-hero__actions">
        <a class="za-link-primary" href="{{ primary_destination }}">{{ s.primary_text | default: 'Explore the collection' | escape }} <span aria-hidden="true">↗</span></a>
        <a class="za-link-text" href="{{ secondary_destination }}">{{ s.secondary_text | default: 'Our craftsmanship' | escape }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="za-hero__signature" aria-hidden="true"><span>01</span><span class="za-hero__signature-line"></span><span>ZAISEN / EST. FOR TIMELESS LIVING</span></div>
    </div>
    <div class="za-hero__visual">
      {%- if image != blank -%}
        {{ image | image_url: width: 1800 | image_tag: class: 'za-hero__photo', widths: '540, 750, 990, 1200, 1500, 1800', sizes: '(min-width: 990px) 51vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'ZAISEN handcrafted wooden table lamp shown in warm light' }}
      {%- else -%}
        <div class="za-hero__fallback"><span>ZAISEN</span><small>OBJECTS OF NATURAL BEAUTY</small></div>
      {%- endif -%}
      <span class="za-hero__photo-caption">WOOD / FORM / FEELING</span>
    </div>
  </div>
</section>
{% stylesheet %}
.za-hero{background:#F7F6F2;color:#24211E;overflow:clip}
.za-hero *{box-sizing:border-box}
.za-hero__shell{display:grid;grid-template-columns:minmax(0,.98fr) minmax(0,1.02fr);min-height:clamp(610px,65vw,810px);max-width:1800px;margin:0 auto}
.za-hero__editorial{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(118px,11vw,174px) clamp(30px,5.6vw,110px) 57px clamp(24px,6.2vw,112px)}
.za-hero__eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 30px!important;font-family:var(--font-body--family,Arial,sans-serif);font-size:.67rem!important;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#74533C}
.za-rule{width:28px;height:1px;background:#74533C;flex:0 0 28px}
.za-hero__title{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(3.2rem,5.8vw,7.2rem);font-weight:500;line-height:.98;letter-spacing:-.052em;max-width:9.8ch;margin:0;color:#24211E;text-wrap:balance;animation:za-fade-up .8s cubic-bezier(.2,.7,.2,1) both}
.za-hero__title em{font-weight:400;color:#74533C}
.za-hero__description{max-width:43ch;margin:30px 0 0;font-family:var(--font-body--family,Arial,sans-serif);font-size:clamp(.9rem,1.1vw,1.04rem);line-height:1.8;letter-spacing:0;color:#59534C;animation:za-fade-up .9s .1s cubic-bezier(.2,.7,.2,1) both}
.za-hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:28px;margin-top:38px}
.za-link-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;min-height:54px;padding:15px 19px;text-transform:uppercase;font-family:var(--font-body--family,Arial,sans-serif);font-size:.7rem;letter-spacing:.14em;font-weight:700;text-decoration:none;background:#74533C;color:#F7F6F2;transition:background .2s ease,transform .2s ease}
.za-link-primary:hover{background:#593B28;transform:translateY(-2px)}
.za-link-primary span{font-size:1.1rem}
.za-link-text{display:inline-flex;gap:11px;align-items:center;min-height:44px;padding:2px 0;color:#24211E;text-transform:uppercase;font-size:.7rem;font-family:var(--font-body--family,Arial,sans-serif);letter-spacing:.13em;text-decoration:none;border-bottom:1px solid #B49A80;transition:color .2s}
.za-link-text:hover{color:#74533C}
.za-hero__signature{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:90px;font-size:.57rem;letter-spacing:.13em;color:#857C70;font-family:var(--font-body--family,Arial,sans-serif)}
.za-hero__signature-line{width:28px;height:1px;background:#B49A80}
.za-hero__visual{position:relative;background:#EAE4DB;overflow:hidden;min-height:600px}
.za-hero__photo{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 50%;position:absolute;inset:0;transform:scale(1.01)}
.za-hero__photo-caption{position:absolute;right:26px;bottom:25px;color:#F7F6F2;font-family:var(--font-body--family,Arial,sans-serif);font-size:.59rem;letter-spacing:.18em;text-shadow:0 1px 8px #24211E}
.za-hero__fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;color:#74533C;background:#EAE4DB}
.za-hero__fallback span{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(4rem,8vw,8rem);letter-spacing:.16em}
.za-hero__fallback small{font-size:.7rem;letter-spacing:.2em}
@keyframes za-fade-up{from{transform:translateY(22px)}to{transform:translateY(0)}}
.za-hero a:focus-visible{outline:2px solid #74533C;outline-offset:5px}
@media(max-width:989px){.za-hero__shell{grid-template-columns:1fr;min-height:auto}.za-hero__editorial{padding:96px 6vw 42px}.za-hero__title{font-size:clamp(3.45rem,9vw,5.5rem);max-width:12ch}.za-hero__signature{display:none}.za-hero__visual{min-height:clamp(350px,68vw,620px)}}
@media(max-width:600px){.za-hero__editorial{padding:62px 22px 36px}.za-hero__eyebrow{margin-bottom:20px!important}.za-hero__title{font-size:clamp(3.15rem,14vw,4.55rem)}.za-hero__description{margin-top:22px}.za-hero__actions{gap:14px;margin-top:27px}.za-hero__visual{min-height:360px}.za-hero__photo-caption{bottom:17px;right:16px}}
@media(prefers-reduced-motion:reduce){.za-hero__title,.za-hero__description{animation:none}.za-link-primary{transition:none}}
{% endstylesheet %}

