<section class="zs-benefits" aria-label="{{ section.settings.accessible_label | escape }}" style="--zs-benefits-bg:{{ section.settings.background_color }};--zs-benefits-fg:{{ section.settings.text_color }};--zs-benefits-accent:{{ section.settings.accent_color }};--zs-benefits-border:{{ section.settings.border_color }}">
  <div class="zs-benefits__wrap">
    {% for block in section.blocks %}
      {% capture benefit_content %}
        <span class="zs-benefits__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'wood' %}
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M25.5 5.5C16 5 8 8.5 7 17c-.6 5.1 2.5 9 7.5 9C23 26 27 15.5 25.5 5.5Z"/><path d="M7 27c4.5-8 9-12 16-16"/><path d="M14 17l-.5-5.5M17.5 14l5.5 1"/></svg>
            {% when 'delivery' %}
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 9h16v14h-16z"/><path d="M19.5 13h5l4 5v5h-9z"/><path d="M24.5 13v5h4"/><circle cx="9" cy="24" r="2.5" fill="var(--zs-benefits-bg)"/><circle cx="24" cy="24" r="2.5" fill="var(--zs-benefits-bg)"/></svg>
            {% when 'secure' %}
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3.5 26 7v8c0 7-4.2 11.3-10 13.6C10.2 26.3 6 22 6 15V7l10-3.5Z"/><path d="m11.5 16 3.1 3.1 6-6.2"/></svg>
            {% when 'care' %}
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6.5h20v15H15l-6 5v-5H6z"/><path d="M11.5 12.3h9M11.5 16.3h6"/></svg>
          {% endcase %}
        </span>
        <span class="zs-benefits__copy">
          <strong class="zs-benefits__title">{{ block.settings.title | escape }}</strong>
          <span class="zs-benefits__description">{{ block.settings.description | escape }}</span>
        </span>
        {% if block.settings.link != blank %}
          <svg class="zs-benefits__arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m7 4 6 6-6 6"/></svg>
        {% endif %}
      {% endcapture %}
      <div class="zs-benefits__item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a class="zs-benefits__content zs-benefits__content--link" href="{{ block.settings.link }}">{{ benefit_content }}</a>
        {% else %}
          <div class="zs-benefits__content">{{ benefit_content }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
{% stylesheet %}
  .zs-benefits{background:var(--zs-benefits-bg,#FBF9F6);color:var(--zs-benefits-fg,#2C2A29);border-block:1px solid var(--zs-benefits-border,#E6DACE);isolation:isolate}
  .zs-benefits *{box-sizing:border-box}
  .zs-benefits__wrap{max-width:1512px;padding-inline:clamp(18px,3.6vw,64px);margin-inline:auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .zs-benefits__item{position:relative;min-width:0}
  .zs-benefits__item:not(:last-child)::after{content:"";position:absolute;right:0;top:25%;height:50%;border-right:1px solid var(--zs-benefits-border,#E6DACE);pointer-events:none}
  .zs-benefits__content{position:relative;display:flex;align-items:center;gap:14px;min-height:132px;padding:24px clamp(12px,1.8vw,27px);text-decoration:none;color:inherit;transition:background-color .25s ease}
  .zs-benefits__content--link:hover{background:color-mix(in srgb,var(--zs-benefits-accent,#A8794A) 7%,transparent)}
  .zs-benefits__content--link:focus-visible{outline:2px solid var(--zs-benefits-accent,#A8794A);outline-offset:-4px}
  .zs-benefits__icon{display:grid;place-items:center;flex:0 0 49px;width:49px;height:49px;border:1px solid color-mix(in srgb,var(--zs-benefits-accent,#A8794A) 30%,transparent);border-radius:50%;background:color-mix(in srgb,var(--zs-benefits-accent,#A8794A) 7%,var(--zs-benefits-bg,#FBF9F6));color:var(--zs-benefits-accent,#A8794A)}
  .zs-benefits__icon svg{display:block;width:25px;height:25px}
  .zs-benefits__copy{min-width:0;display:flex;flex-direction:column;gap:5px}
  .zs-benefits__title{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(1.05rem,1.3vw,1.23rem);font-weight:600;line-height:1.15;letter-spacing:-.01em}
  .zs-benefits__description{font-family:var(--font-body--family,Arial,sans-serif);font-size:.76rem;line-height:1.5;color:color-mix(in srgb,var(--zs-benefits-fg,#2C2A29) 68%,transparent)}
  .zs-benefits__arrow{width:14px;height:14px;flex:0 0 14px;margin-left:auto;color:var(--zs-benefits-accent,#A8794A);opacity:.8;transition:transform .25s ease}
  .zs-benefits__content--link:hover .zs-benefits__arrow{transform:translateX(3px)}
  @media(max-width:1099px){.zs-benefits__wrap{grid-template-columns:repeat(2,minmax(0,1fr));padding-inline:20px}.zs-benefits__item:nth-child(2)::after{display:none}.zs-benefits__item:nth-child(-n+2){border-bottom:1px solid var(--zs-benefits-border,#E6DACE)}.zs-benefits__content{min-height:112px;padding:19px 24px}}
  @media(max-width:600px){.zs-benefits__wrap{padding-inline:12px}.zs-benefits__content{min-height:156px;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:10px;padding:17px 10px}.zs-benefits__icon{flex:0 0 44px;width:44px;height:44px}.zs-benefits__icon svg{width:23px;height:23px}.zs-benefits__title{font-size:1.03rem;line-height:1.12}.zs-benefits__description{font-size:.71rem;line-height:1.35}.zs-benefits__copy{gap:6px}.zs-benefits__arrow{display:none}.zs-benefits__item:nth-child(odd)::after{top:12%;height:76%}}
  @media(prefers-reduced-motion:reduce){.zs-benefits__content,.zs-benefits__arrow{transition:none}}
{% endstylesheet %}
{% schema %}
{
  "name": "ZAISEN Shopping Benefits",
  "tag": "div",
  "class": "zs-benefits-section",
  "settings": [
    {"type":"text","id":"accessible_label","label":"Section accessibility label","default":"Why shop ZAISEN"},
    {"type":"color","id":"background_color","label":"Background color","default":"#FBF9F6"},
    {"type":"color","id":"text_color","label":"Text color","default":"#2C2A29"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#A8794A"},
    {"type":"color","id":"border_color","label":"Border color","default":"#E6DACE"}
  ],
  "blocks": [
    {
      "type":"benefit","name":"Shopping benefit",
      "settings":[
        {"type":"select","id":"icon","label":"Icon","options":[{"value":"wood","label":"Wood and craftsmanship"},{"value":"delivery","label":"Delivery truck"},{"value":"secure","label":"Secure payment"},{"value":"care","label":"Customer support"}],"default":"wood"},
        {"type":"text","id":"title","label":"Title","default":"Handcrafted Pure Wood"},
        {"type":"text","id":"description","label":"Description","default":"Naturally beautiful, made with care."},
        {"type":"url","id":"link","label":"Optional destination"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"ZAISEN Shopping Benefits","blocks":[{"type":"benefit","settings":{"icon":"wood","title":"Handcrafted Pure Wood","description":"Natural grain, refined by hand."}},{"type":"benefit","settings":{"icon":"delivery","title":"Free Delivery","description":"On eligible orders to countries we serve."}},{"type":"benefit","settings":{"icon":"secure","title":"Secure Checkout","description":"Shop confidently with protected payments."}},{"type":"benefit","settings":{"icon":"care","title":"Here to Help","description":"Support for damaged or incorrect items."}}]}]
}
{% endschema %}