{%- comment -%}
  ZAISEN slim delivery and customer support marquee. All messages are editable.
  Four identical groups create a seamless CSS marquee without JavaScript.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- comment -%}
  Homepage delivery marquee: country-specific free-shipping thresholds (USD).
  Shopify checkout remains authoritative for rate eligibility.
{%- endcomment -%}
{%- liquid
  assign zs_marquee_minimum = 0
  assign zs_marquee_country = ''
  case localization.country.iso_code
    when 'GB'
      assign zs_marquee_minimum = 60
      assign zs_marquee_country = 'UK'
    when 'US'
      assign zs_marquee_minimum = 60
      assign zs_marquee_country = 'USA'
    when 'DE'
      assign zs_marquee_minimum = 60
      assign zs_marquee_country = 'GERMANY'
    when 'FR'
      assign zs_marquee_minimum = 60
      assign zs_marquee_country = 'FRANCE'
    when 'AE'
      assign zs_marquee_minimum = 60
      assign zs_marquee_country = 'UAE'
    when 'CA'
      assign zs_marquee_minimum = 100
      assign zs_marquee_country = 'CANADA'
    when 'AU'
      assign zs_marquee_minimum = 100
      assign zs_marquee_country = 'AUSTRALIA'
  endcase
  if zs_marquee_minimum > 0
    assign zs_marquee_shipping_message = blank
  else
    assign zs_marquee_shipping_message = s.message_1 | default: 'SHIPPING DETAILS AT CHECKOUT'
  endif
-%}
<section id="zsm-{{ section.id }}" class="zsm" aria-label="ZAISEN shopping benefits and support"
  style="--zsm-bg:{{ s.background }};--zsm-text:{{ s.text_color }};--zsm-accent:{{ s.accent_color }};--zsm-h:{{ s.height }}px;--zsm-speed:{{ s.duration }}s">
  <div class="zsm__viewport">
    <div class="zsm__track">
      {% for repeat in (1..4) %}
        <div class="zsm__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {% if zs_marquee_minimum > 0 %}
            <span class="zsm__message">FREE SHIPPING TO {{ zs_marquee_country | escape }} ON ORDERS
              <span data-zs-usd-amount-cents="{{ zs_marquee_minimum | times: 100 }}" data-zs-currency-kind="minimum" data-zs-currency-suffix="+" data-zs-currency-fallback="LOCAL MINIMUM">{% if localization.country.currency.iso_code == 'USD' %}&#36;{{ zs_marquee_minimum }}+{% else %}LOCAL MINIMUM{% endif %}</span>
            </span><span class="zsm__separator" aria-hidden="true">✦</span>
          {% elsif zs_marquee_shipping_message != blank %}
            <span class="zsm__message">{{ zs_marquee_shipping_message | strip | escape }}</span><span class="zsm__separator" aria-hidden="true">✦</span>
          {% endif %>
          {% if s.message_2 != blank %}<span class="zsm__message">{{ s.message_2 | escape }}</span><span class="zsm__separator" aria-hidden="true">✦</span>{% endif %}
          {% if s.message_3 != blank %}<span class="zsm__message">{{ s.message_3 | escape }}</span><span class="zsm__separator" aria-hidden="true">✦</span>{% endif %}
          {% if s.message_4 != blank %}<span class="zsm__message">{{ s.message_4 | escape }}</span><span class="zsm__separator" aria-hidden="true">✦</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}
.zsm{display:block;width:100%;margin:0;padding:0;background:var(--zsm-bg,#2B1D17);background-image:linear-gradient(100deg,color-mix(in srgb,var(--zsm-bg,#2B1D17) 87%,#7A5942),var(--zsm-bg,#2B1D17) 31%);color:var(--zsm-text,#F7F3EE);overflow:hidden}
.zsm *{box-sizing:border-box}
.zsm__viewport{display:flex;align-items:center;width:100%;height:var(--zsm-h,54px);overflow:hidden}
.zsm__track{display:flex;flex:0 0 auto;align-items:center;min-width:max-content;width:max-content;white-space:nowrap;animation:zsm-shipping-flow var(--zsm-speed,45s) linear infinite;will-change:transform}
.zsm__group{display:flex;flex:0 0 auto;align-items:center;gap:clamp(20px,2.7vw,36px);padding-inline:clamp(12px,1.8vw,22px);white-space:nowrap}
.zsm__message{display:inline-block;flex:0 0 auto;font-size:clamp(10px,.86vw,12px);font-weight:600;line-height:1.35;letter-spacing:.11em;text-transform:uppercase;white-space:nowrap}
.zsm__separator{flex:0 0 auto;color:var(--zsm-accent,#D8B56A);font-size:10px;line-height:1}
.zsm:hover .zsm__track,.zsm:focus-within .zsm__track{animation-play-state:paused}
@keyframes zsm-shipping-flow{from{transform:translateX(0)}to{transform:translateX(-25%)}}
@media(max-width:749px){
  .zsm__viewport{height:48px}
  .zsm__group{gap:20px;padding-inline:14px}
  .zsm__message{font-size:10px;letter-spacing:.08em}
  .zsm__separator{font-size:9px}
}
@media(prefers-reduced-motion:reduce){.zsm__track{animation:none;will-change:auto}}
{% endstylesheet %}
{% schema %}
{
  "name":"ZAISEN Delivery Marquee",
  "tag":"section",
  "class":"section-zs-delivery-marquee",
  "settings":[
    {"type":"header","content":"Shipping and service messages"},
    {"type":"text","id":"message_1","label":"Message 1","default":"SHIPPING DETAILS AT CHECKOUT"},
    {"type":"text","id":"message_2","label":"Message 2","default":"24/7 SUPPORT"},
    {"type":"text","id":"message_3","label":"Message 3","default":"14-DAY REFUNDS"},
    {"type":"text","id":"message_4","label":"Message 4","default":"SECURE PAYMENT"},
    {"type":"header","content":"Design"},
    {"type":"color","id":"background","label":"Background","default":"#2B1D17"},
    {"type":"color","id":"text_color","label":"Text","default":"#F7F3EE"},
    {"type":"color","id":"accent_color","label":"Separators","default":"#D8B56A"},
    {"type":"range","id":"height","label":"Desktop height","min":40,"max":76,"step":2,"unit":"px","default":54},
    {"type":"range","id":"duration","label":"Scroll duration","min":20,"max":80,"step":1,"unit":"s","default":45}
  ],
  "presets":[{"name":"ZAISEN Delivery Marquee"}]
}
{% endschema %}
