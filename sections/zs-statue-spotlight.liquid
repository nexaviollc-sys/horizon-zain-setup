{%- liquid
  assign s = section.settings
  assign product = s.product
  assign current_variant = product.selected_or_first_available_variant
  assign current_price = product.price
  assign compare_price = product.compare_at_price
-%}

<section
  id="zs-statue-{{ section.id }}"
  class="zs-statue"
  style="
    --zs-statue-bg: {{ s.bg_color }};
    --zs-statue-text: {{ s.text_color }};
    --zs-statue-accent: {{ s.accent_color }};
    --zs-statue-wood: {{ s.wood_color }};
    --zs-statue-line: {{ s.line_color }};
    --zs-statue-pt: {{ s.padding_top }}px;
    --zs-statue-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="zs-statue__shell">
    <div class="zs-statue__layout">
      <div class="zs-statue__content">
        {% if s.heading != blank %}
          <h2 class="zs-statue__heading">{{ s.heading }}</h2>
        {% elsif product != blank %}
          <h2 class="zs-statue__heading">{{ product.title | escape }}</h2>
        {% endif %}
        {% if s.description != blank %}
          <div class="zs-statue__description">{{ s.description }}</div>
        {% endif %}

        <div class="zs-statue__purchase">
          <div class="zs-statue__price-wrap">
            {% if product != blank %}
              <div class="zs-statue__price-row">
                <span class="zs-statue__price">{{ current_price | money }}</span>
                {% if compare_price > current_price %}
                  <s class="zs-statue__compare">{{ compare_price | money }}</s>
                {% endif %}
                {% if s.offer_label != blank %}
                  <span class="zs-statue__offer">{{ s.offer_label | escape }}</span>
                {% endif %}
              </div>
              {% if s.price_note != blank %}
                <p class="zs-statue__price-note">{{ s.price_note | escape }}</p>
              {% endif %}
            {% else %}
              <div class="zs-statue__price-row">
                <span class="zs-statue__price">$81.99</span>
                <span class="zs-statue__offer">{{ s.offer_label | escape }}</span>
              </div>
            {% endif %}
          </div>

          {% if product != blank %}
            <a class="zs-statue__cta" href="{{ product.url }}">
              <span>{{ s.button_label | default: 'Shop This Sculpture' | escape }}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          {% elsif request.design_mode %}
            <span class="zs-statue__cta is-disabled">
              <span>{{ s.button_label | default: 'Shop This Sculpture' | escape }}</span>
            </span>
          {% endif %}
        </div>
      </div>

      <div class="zs-statue__gallery-wrap">
        <div
          class="zs-statue__gallery"
          data-zs-statue-gallery
          tabindex="0"
          aria-label="{{ product.title | default: s.heading | escape }} image gallery"
        >
          {% if product != blank and product.images.size > 0 %}
            {% for image in product.images limit: 5 %}
              {% assign gallery_alt = image.alt | default: product.title %}
              <figure class="zs-statue__slide" data-zs-statue-slide>
                {{
                  image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'zs-statue__image',
                    widths: '420, 640, 820, 1040, 1200, 1400',
                    sizes: '(max-width: 989px) 94vw, 48vw',
                    loading: 'lazy',
                    alt: gallery_alt
                }}
              </figure>
            {% endfor %}
          {% else %}
            <figure class="zs-statue__slide zs-statue__slide--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'zs-statue__placeholder' }}
            </figure>
          {% endif %}
        </div>

        <div class="zs-statue__gallery-chrome">
          {% if s.gallery_label != blank %}
            <span class="zs-statue__gallery-label">{{ s.gallery_label | escape }}</span>
          {% endif %}

          {% if product != blank and product.images.size > 1 %}
            <div class="zs-statue__arrows" aria-label="Gallery controls">
              <button class="zs-statue__arrow" type="button" data-zs-statue-prev aria-label="Previous image">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5M11 6l-6 6 6 6"/>
                </svg>
              </button>
              <button class="zs-statue__arrow" type="button" data-zs-statue-next aria-label="Next image">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .zs-statue {
    background:
      radial-gradient(840px 520px at 8% 8%, color-mix(in srgb, var(--zs-statue-accent) 8%, transparent), transparent 70%),
      radial-gradient(900px 600px at 92% 92%, color-mix(in srgb, var(--zs-statue-wood) 7%, transparent), transparent 72%),
      var(--zs-statue-bg, #f5f0e7);
    color: var(--zs-statue-text, #2c2a29);
    padding-block: var(--zs-statue-pt) var(--zs-statue-pb);
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-line) 62%, transparent);
    overflow: clip;
  }

  .zs-statue * { box-sizing: border-box; }

  .zs-statue__shell {
    width: min(calc(100% - 40px), 1500px);
    margin-inline: auto;
  }

  .zs-statue__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
    align-items: center;
  }

  .zs-statue__content {
    position: relative;
    max-width: 590px;
    padding: 0;
  }

  .zs-statue__content::before {
    content: '';
    display: block;
    width: 54px;
    height: 1px;
    margin-bottom: 24px;
    background: linear-gradient(90deg, var(--zs-statue-accent), transparent);
  }

  .zs-statue__heading {
    max-width: 10.5ch;
    margin: 0;
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(48px, 5.4vw, 76px);
    font-weight: 500;
    line-height: .96;
    letter-spacing: -.032em;
    color: var(--zs-statue-text);
    text-wrap: balance;
  }

  .zs-statue__heading em {
    font-style: italic;
    font-weight: 450;
    color: var(--zs-statue-accent);
  }

  .zs-statue__description {
    max-width: 46ch;
    margin-top: 24px;
    font-size: 15px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--zs-statue-text) 72%, transparent);
  }

  .zs-statue__description p { margin: 0; }

  .zs-statue__purchase {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-line) 58%, transparent);
  }

  .zs-statue__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .zs-statue__price {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 34px;
    font-weight: 550;
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--zs-statue-wood);
  }

  .zs-statue__compare {
    font-size: 13px;
    color: color-mix(in srgb, var(--zs-statue-text) 44%, transparent);
  }

  .zs-statue__offer {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    border: 1px solid color-mix(in srgb, var(--zs-statue-accent) 26%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--zs-statue-accent) 9%, white);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .11em;
    color: color-mix(in srgb, var(--zs-statue-accent) 88%, var(--zs-statue-text));
  }

  .zs-statue__price-note {
    margin: 7px 0 0;
    font-size: 10.5px;
    line-height: 1.45;
    color: color-mix(in srgb, var(--zs-statue-text) 50%, transparent);
  }

  .zs-statue__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 48px;
    padding: 13px 20px;
    border: 1px solid color-mix(in srgb, var(--zs-statue-wood) 84%, black);
    border-radius: 999px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--zs-statue-wood) 96%, white), color-mix(in srgb, var(--zs-statue-wood) 90%, black));
    color: #fbf9f6;
    text-decoration: none;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .13em;
    text-transform: uppercase;
    box-shadow:
      0 10px 24px color-mix(in srgb, var(--zs-statue-wood) 16%, transparent),
      inset 0 1px 0 rgba(255,255,255,.14);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .zs-statue__cta.is-disabled { opacity: .55; }

  .zs-statue__gallery-wrap {
    position: relative;
    min-width: 0;
  }

  .zs-statue__gallery {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    border-radius: 30px;
    background:
      radial-gradient(circle at 50% 18%, rgba(255,255,255,.78), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--zs-statue-bg) 88%, white), color-mix(in srgb, var(--zs-statue-bg) 78%, var(--zs-statue-accent)));
    border: 1px solid color-mix(in srgb, white 56%, var(--zs-statue-line));
    box-shadow:
      0 34px 76px color-mix(in srgb, var(--zs-statue-wood) 10%, transparent),
      inset 0 1px 0 rgba(255,255,255,.78);
    outline: none;
  }

  .zs-statue__gallery::-webkit-scrollbar { display: none; }

  .zs-statue__slide {
    flex: 0 0 100%;
    width: 100%;
    margin: 0;
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
    overflow: hidden;
  }

  .zs-statue__image,
  .zs-statue__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .zs-statue__placeholder {
    fill: color-mix(in srgb, var(--zs-statue-wood) 15%, white);
  }

  .zs-statue__gallery-chrome {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    pointer-events: none;
  }

  .zs-statue__gallery-label {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 8px 13px;
    border: 1px solid rgba(255,255,255,.52);
    border-radius: 999px;
    background: rgba(248,244,237,.74);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #4a392d;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
  }

  .zs-statue__arrows {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  .zs-statue__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 50%;
    background: rgba(248,244,237,.82);
    color: #6f4d35;
    cursor: pointer;
    box-shadow:
      0 8px 20px rgba(58,38,22,.09),
      inset 0 1px 0 rgba(255,255,255,.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: transform .22s ease, background-color .22s ease, color .22s ease;
  }

  @media (hover:hover) and (pointer:fine) {
    .zs-statue__cta:hover {
      transform: translateY(-1px);
      box-shadow:
        0 14px 30px color-mix(in srgb, var(--zs-statue-wood) 20%, transparent),
        inset 0 1px 0 rgba(255,255,255,.16);
    }

    .zs-statue__arrow:hover {
      transform: translateY(-1px);
      background: #fffaf3;
      color: var(--zs-statue-accent);
    }
  }

  @media (min-width: 990px) {
    .zs-statue__shell {
      width: min(calc(100% - 96px), 1500px);
    }

    .zs-statue__layout {
      grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
      gap: clamp(54px, 6vw, 96px);
    }

    .zs-statue__content {
      order: 1;
      margin-inline: 0;
    }

    .zs-statue__gallery-wrap {
      order: 2;
    }

    .zs-statue__gallery {
      max-height: 700px;
    }

    .zs-statue__slide {
      aspect-ratio: 5 / 6;
      max-height: 700px;
    }
  }

  @media (max-width: 989px) {
    .zs-statue__gallery-wrap { order: 1; }
    .zs-statue__content { order: 2; }
  }

  @media (max-width: 749px) {
    .zs-statue {
      padding-block: 54px 58px;
    }

    .zs-statue__shell {
      width: min(calc(100% - 28px), 1500px);
    }

    .zs-statue__layout {
      gap: 20px;
    }

    .zs-statue__gallery {
      border-radius: 20px;
    }

    .zs-statue__slide {
      aspect-ratio: 4 / 3;
      max-height: 340px;
    }

    .zs-statue__image {
      object-position: center center;
    }

    .zs-statue__gallery-chrome {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }

    .zs-statue__gallery-label {
      min-height: 30px;
      padding: 6px 10px;
      font-size: 8px;
    }

    .zs-statue__arrow {
      width: 38px;
      height: 38px;
    }

    .zs-statue__content {
      padding: 6px 4px 0;
    }

    .zs-statue__content::before {
      width: 42px;
      margin-bottom: 18px;
    }

    .zs-statue__heading {
      max-width: 10ch;
      font-size: clamp(40px, 11vw, 48px);
      line-height: .97;
    }

    .zs-statue__description {
      margin-top: 18px;
      max-width: 100%;
      font-size: 13.8px;
      line-height: 1.62;
    }

    .zs-statue__purchase {
      align-items: stretch;
      flex-direction: column;
      margin-top: 24px;
      padding-top: 18px;
    }

    .zs-statue__price {
      font-size: 31px;
    }

    .zs-statue__cta {
      width: 100%;
      min-height: 50px;
    }

  }

  @media (max-width: 390px) {
    .zs-statue {
      padding-block: 48px 52px;
    }

    .zs-statue__slide {
      max-height: 300px;
    }

    .zs-statue__heading {
      font-size: clamp(34px, 9.6vw, 39px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-statue__gallery { scroll-behavior: auto; }
    .zs-statue__cta,
    .zs-statue__arrow { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  const initZsStatueGallery = (root = document) => {
    root.querySelectorAll('.zs-statue').forEach((section) => {
      const gallery = section.querySelector('[data-zs-statue-gallery]');
      const prev = section.querySelector('[data-zs-statue-prev]');
      const next = section.querySelector('[data-zs-statue-next]');
      if (!gallery || !prev || !next || gallery.dataset.zsReady === 'true') return;

      gallery.dataset.zsReady = 'true';

      const move = (direction) => {
        gallery.scrollBy({
          left: gallery.clientWidth * direction,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };

      prev.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
    });
  };

  initZsStatueGallery();

  document.addEventListener('shopify:section:load', (event) => {
    initZsStatueGallery(event.target);
  });
{% endjavascript %}

{% schema %}
{
  "name": "ZAISEN Statue Spotlight",
  "tag": "section",
  "class": "section-zaisen-statue-spotlight",
  "max_blocks": 4,
  "settings": [
    { "type": "product", "id": "product", "label": "Featured statue product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handcrafted Wooden Horse Sculpture" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>One of ZAISEN’s signature art pieces, this handcrafted wooden horse captures movement, strength and character in a sculptural form. Natural grain and hand-finished detail give every piece a distinctive presence — made to stand apart in refined interiors.</p>"
    },
    { "type": "text", "id": "offer_label", "label": "Offer label", "default": "60% OFF" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Signature ZAISEN art piece • limited batch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit Product" },
    { "type": "text", "id": "gallery_label", "label": "Gallery label", "default": "Handcrafted Art Piece" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2A29" },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#A8794A" },
    { "type": "color", "id": "wood_color", "label": "Walnut accent", "default": "#7A5238" },
    { "type": "color", "id": "line_color", "label": "Divider", "default": "#D8C7B3" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [
    { "name": "ZAISEN Statue Spotlight" }
  ]
}
{% endschema %}
