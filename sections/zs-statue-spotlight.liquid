{%- liquid
  assign s = section.settings
  assign product = s.product
-%}
<section class="za-signature" aria-labelledby="za-signature-title-{{ section.id }}">
  <div class="za-signature__shell">
    <div class="za-signature__visual">
      {%- if product != blank and product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'za-signature__photo', loading: 'lazy', widths: '450, 700, 900, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: product.title }}
      {%- else -%}
        <span class="za-signature__fallback">ZAISEN</span>
      {%- endif -%}
    </div>
    <div class="za-signature__editorial">
      <span class="za-signature__overline">THE SIGNATURE COLLECTION <span> / 001</span></span>
      <h2 id="za-signature-title-{{ section.id }}">{{ s.heading | escape }}</h2>
      <div class="za-signature__description rte">{{ s.description }}</div>
      {%- if product != blank -%}
        <div class="za-signature__pricing">
          <strong>{{ product.price | money }}</strong>
          {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
        </div>
        <a class="za-signature__button" href="{{ product.url }}">{{ s.button_label | escape }} <span aria-hidden="true">↗</span></a>
      {%- endif -%}
      <p class="za-signature__closing">NATURAL GRAIN. LASTING PRESENCE.</p>
    </div>
  </div>
</section>
{% stylesheet %}
.za-signature{background:#F7F6F2;color:#24211E;overflow:hidden}
.za-signature *{box-sizing:border-box}
.za-signature__shell{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,.94fr);max-width:1850px;margin:0 auto}
.za-signature__visual{min-height:590px;position:relative;overflow:hidden;background:#EAE4DB}
.za-signature__photo{display:block;width:100%;height:100%;position:absolute;inset:0;object-fit:cover}
.za-signature__fallback{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--font-heading--family,Georgia,serif);letter-spacing:.16em;color:#988878;font-size:5rem}
.za-signature__editorial{padding:clamp(64px,8vw,124px) clamp(28px,6.6vw,105px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.za-signature__overline{font-family:var(--font-body--family,Arial,sans-serif);color:#74533C;font-size:.66rem;letter-spacing:.18em;font-weight:700}
.za-signature__overline span{color:#B49A80;padding-left:9px}
.za-signature__editorial h2{font-family:var(--font-heading--family,Georgia,serif);font-size:clamp(3.15rem,5.05vw,6.2rem);font-weight:500;line-height:1.01;letter-spacing:-.051em;margin:27px 0;max-width:11ch}
.za-signature__description{font-family:var(--font-body--family,Arial,sans-serif);font-size:.93rem;line-height:1.83;max-width:45ch;color:#686158}
.za-signature__description p{margin:0 0 12px}
.za-signature__pricing{display:flex;align-items:baseline;gap:17px;margin:26px 0 22px;font-family:var(--font-body--family,Arial,sans-serif)}
.za-signature__pricing strong{font-weight:600;font-size:1.1rem}
.za-signature__pricing s{font-weight:400;font-size:.86rem;color:#8F877D}
.za-signature__button{display:inline-flex;align-items:center;gap:34px;padding:16px 18px;min-height:54px;background:#74533C;color:#F7F6F2;text-transform:uppercase;letter-spacing:.13em;text-decoration:none;font-size:.71rem;font-weight:700;font-family:var(--font-body--family,Arial,sans-serif);transition:background .2s}
.za-signature__button:hover{background:#5A3C28}
.za-signature__closing{font-family:var(--font-body--family,Arial,sans-serif);font-size:.6rem;letter-spacing:.18em;color:#97897C;margin:42px 0 0}
.za-signature a:focus-visible{outline:2px solid #74533C;outline-offset:4px}
@media(max-width:990px){.za-signature__shell{grid-template-columns:1fr}.za-signature__visual{min-height:500px}.za-signature__editorial{padding:65px 6vw}}
@media(max-width:600px){.za-signature__visual{min-height:400px}.za-signature__editorial{padding:59px 22px 76px}.za-signature__editorial h2{font-size:clamp(3rem,12vw,4.4rem)}}
{% endstylesheet %}

{% schema %}
{
  "name": "ZAISEN Statue Spotlight",
  "tag": "section",
  "class": "section-zaisen-statue-spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured statue product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handcrafted Wooden Horse Sculpture"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>One of ZAISEN’s signature art pieces, this handcrafted wooden horse captures movement, strength and character in a sculptural form. Natural grain and hand-finished detail give every piece a distinctive presence — made to stand apart in refined interiors.</p>"
    },
    {
      "type": "text",
      "id": "offer_label",
      "label": "Offer label",
      "default": "SAVE 60%"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Signature ZAISEN art piece • limited batch"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Visit Product"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#28221D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B69A6A"
    },
    {
      "type": "color",
      "id": "wood_color",
      "label": "Walnut accent",
      "default": "#77523A"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider",
      "default": "#EBE6DE"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "ZAISEN Statue Spotlight"
    }
  ]
}
{% endschema %}
