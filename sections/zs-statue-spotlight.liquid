{%- liquid
  assign s = section.settings
  assign product = s.product
  assign current_price = product.price
  assign compare_price = product.compare_at_price
-%}

<section
  id="zs-statue-{{ section.id }}"
  class="zs-statue"
  style="
    --zs-statue-bg: {{ s.bg_color }};
    --zs-statue-text: {{ s.text_color }};
    --zs-statue-accent: {{ s.accent_color }};
    --zs-statue-wood: {{ s.wood_color }};
    --zs-statue-line: {{ s.line_color }};
    --zs-statue-pt: {{ s.padding_top }}px;
    --zs-statue-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="zs-statue__shell">
    <div class="zs-statue__card">
      <div class="zs-statue__gallery-wrap">
        <div
          class="zs-statue__gallery"
          data-zs-statue-gallery
          tabindex="0"
          aria-label="{{ product.title | default: s.heading | escape }} image gallery"
        >
          {% if product != blank and product.images.size > 0 %}
            {% for image in product.images limit: 5 %}
              {% assign gallery_alt = image.alt | default: product.title %}
              <figure class="zs-statue__slide" data-zs-statue-slide>
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'zs-statue__image',
                    widths: '360, 520, 720, 900, 1100, 1200',
                    sizes: '(max-width: 989px) calc(100vw - 48px), 470px',
                    loading: 'lazy',
                    alt: gallery_alt
                }}
              </figure>
            {% endfor %}
          {% else %}
            <figure class="zs-statue__slide zs-statue__slide--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'zs-statue__placeholder' }}
            </figure>
          {% endif %}
        </div>

        {% if product != blank and product.images.size > 1 %}
          <div class="zs-statue__arrows" aria-label="Gallery controls">
            <button class="zs-statue__arrow" type="button" data-zs-statue-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M11 6l-6 6 6 6"/>
              </svg>
            </button>
            <button class="zs-statue__arrow" type="button" data-zs-statue-next aria-label="Next image">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>

      <div class="zs-statue__content">
        <span class="zs-statue__kicker" aria-hidden="true"></span>

        {% if s.heading != blank %}
          <h2 class="zs-statue__heading">{{ s.heading }}</h2>
        {% elsif product != blank %}
          <h2 class="zs-statue__heading">{{ product.title | escape }}</h2>
        {% endif %}

        {% if s.description != blank %}
          <div class="zs-statue__description">{{ s.description }}</div>
        {% endif %}

        <div class="zs-statue__purchase">
          <div class="zs-statue__price-wrap">
            {% if product != blank %}
              <div class="zs-statue__price-row">
                <span class="zs-statue__price">{{ current_price | money }}</span>
                {% if compare_price > current_price %}
                  <s class="zs-statue__compare">{{ compare_price | money }}</s>
                {% endif %}
                {% if s.offer_label != blank %}
                  <span class="zs-statue__offer">{{ s.offer_label | escape }}</span>
                {% endif %}
              </div>
              {% if s.price_note != blank %}
                <p class="zs-statue__price-note">{{ s.price_note | escape }}</p>
              {% endif %}
            {% else %}
              <div class="zs-statue__price-row">
                <span class="zs-statue__price">$81.99</span>
                {% if s.offer_label != blank %}
                  <span class="zs-statue__offer">{{ s.offer_label | escape }}</span>
                {% endif %}
              </div>
            {% endif %}
          </div>

          {% if product != blank %}
            <a class="zs-statue__cta" href="{{ product.url }}">
              <span>{{ s.button_label | default: 'Visit Product' | escape }}</span>
              <span class="zs-statue__cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </span>
            </a>
          {% elsif request.design_mode %}
            <span class="zs-statue__cta is-disabled">
              <span>{{ s.button_label | default: 'Visit Product' | escape }}</span>
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .zs-statue {
    background:
      radial-gradient(700px 420px at 92% 12%, color-mix(in srgb, var(--zs-statue-accent) 7%, transparent), transparent 72%),
      var(--zs-statue-bg, #f5f0e7);
    color: var(--zs-statue-text, #2c2a29);
    padding-block: var(--zs-statue-pt) var(--zs-statue-pb);
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-line) 56%, transparent);
    overflow: clip;
  }

  .zs-statue * { box-sizing: border-box; }

  .zs-statue__shell {
    width: min(calc(100% - 40px), 1180px);
    margin-inline: auto;
  }

  .zs-statue__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, white 66%, var(--zs-statue-line));
    border-radius: 24px;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, white 66%, transparent),
        color-mix(in srgb, var(--zs-statue-bg) 88%, transparent)
      );
    box-shadow:
      0 18px 42px color-mix(in srgb, var(--zs-statue-wood) 7%, transparent),
      inset 0 1px 0 rgba(255,255,255,.84);
  }

  .zs-statue__gallery-wrap {
    position: relative;
    min-width: 0;
    background:
      radial-gradient(circle at 50% 28%, rgba(255,255,255,.96), transparent 36%),
      linear-gradient(145deg, #fbf8f2, color-mix(in srgb, var(--zs-statue-bg) 90%, var(--zs-statue-accent)));
  }

  .zs-statue__gallery {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    outline: none;
  }

  .zs-statue__gallery::-webkit-scrollbar { display: none; }

  .zs-statue__slide {
    flex: 0 0 100%;
    width: 100%;
    margin: 0;
    aspect-ratio: 1 / 1;
    scroll-snap-align: start;
    overflow: hidden;
  }

  .zs-statue__image,
  .zs-statue__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 18px;
  }

  .zs-statue__placeholder {
    fill: color-mix(in srgb, var(--zs-statue-wood) 14%, white);
  }

  .zs-statue__arrows {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 3;
    display: flex;
    gap: 7px;
  }

  .zs-statue__arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgba(255,255,255,.66);
    border-radius: 50%;
    background: rgba(250,247,241,.88);
    color: #6f4d35;
    cursor: pointer;
    box-shadow:
      0 7px 16px rgba(58,38,22,.08),
      inset 0 1px 0 rgba(255,255,255,.9);
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    transition: transform .22s ease, background-color .22s ease, color .22s ease;
  }

  .zs-statue__content {
    padding: 28px 28px 30px;
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-line) 55%, transparent);
  }

  .zs-statue__kicker {
    display: block;
    width: 42px;
    height: 1px;
    margin-bottom: 17px;
    background: linear-gradient(90deg, var(--zs-statue-accent), transparent);
  }

  .zs-statue__heading {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-heading--family, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(40px, 4.1vw, 54px);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.03em;
    color: var(--zs-statue-text);
    text-wrap: balance;
  }

  .zs-statue__description {
    max-width: 46ch;
    margin-top: 17px;
    font-size: 13.5px;
    line-height: 1.62;
    color: color-mix(in srgb, var(--zs-statue-text) 70%, transparent);
  }

  .zs-statue__description p { margin: 0; }

  .zs-statue__purchase {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-line) 54%, transparent);
  }

  .zs-statue__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 9px;
  }

  .zs-statue__price {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 29px;
    font-weight: 550;
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--zs-statue-wood);
  }

  .zs-statue__compare {
    font-size: 12px;
    color: color-mix(in srgb, var(--zs-statue-text) 42%, transparent);
  }

  .zs-statue__offer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    padding: 4px 8px;
    border-top: 1px solid color-mix(in srgb, var(--zs-statue-accent) 32%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--zs-statue-accent) 32%, transparent);
    color: color-mix(in srgb, var(--zs-statue-accent) 86%, var(--zs-statue-text));
    font-size: 8.5px;
    font-weight: 760;
    letter-spacing: .12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .zs-statue__offer::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: .72;
  }

  .zs-statue__price-note {
    margin: 7px 0 0;
    font-size: 10px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--zs-statue-text) 48%, transparent);
  }

  .zs-statue__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 44px;
    padding: 8px 9px 8px 15px;
    border: 1px solid color-mix(in srgb, var(--zs-statue-wood) 76%, black);
    border-radius: 10px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--zs-statue-wood) 97%, white), color-mix(in srgb, var(--zs-statue-wood) 91%, black));
    color: #fbf9f6;
    text-decoration: none;
    font-size: 9.5px;
    font-weight: 760;
    letter-spacing: .115em;
    text-transform: uppercase;
    box-shadow:
      0 7px 16px color-mix(in srgb, var(--zs-statue-wood) 12%, transparent),
      inset 0 1px 0 rgba(255,255,255,.15);
    transition: transform .22s ease, box-shadow .22s ease;
  }

  .zs-statue__cta-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 50%;
    background: rgba(255,255,255,.06);
  }

  .zs-statue__cta.is-disabled { opacity: .55; }

  @media (hover:hover) and (pointer:fine) {
    .zs-statue__cta:hover {
      transform: translateY(-1px);
      box-shadow:
        0 10px 22px color-mix(in srgb, var(--zs-statue-wood) 15%, transparent),
        inset 0 1px 0 rgba(255,255,255,.17);
    }

    .zs-statue__arrow:hover {
      transform: translateY(-1px);
      background: #fffaf3;
      color: var(--zs-statue-accent);
    }
  }

  @media (min-width: 990px) {
    .zs-statue__shell {
      width: min(calc(100% - 72px), 1180px);
    }

    .zs-statue__card {
      grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
      align-items: stretch;
    }

    .zs-statue__gallery-wrap {
      order: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      border-left: 1px solid color-mix(in srgb, var(--zs-statue-line) 54%, transparent);
    }

    .zs-statue__gallery {
      width: min(100%, 470px);
    }

    .zs-statue__content {
      order: 1;
      display: flex;
      min-height: 470px;
      flex-direction: column;
      justify-content: center;
      padding: 38px 42px;
      border-top: 0;
    }

    .zs-statue__purchase {
      margin-top: 26px;
    }
  }

  @media (max-width: 749px) {
    .zs-statue {
      padding-block: 38px 42px;
    }

    .zs-statue__shell {
      width: min(calc(100% - 24px), 1180px);
    }

    .zs-statue__card {
      border-radius: 20px;
    }

    .zs-statue__slide {
      aspect-ratio: 1 / 1;
    }

    .zs-statue__image,
    .zs-statue__placeholder {
      padding: 12px;
    }

    .zs-statue__arrows {
      right: 10px;
      bottom: 10px;
    }

    .zs-statue__arrow {
      width: 36px;
      height: 36px;
    }

    .zs-statue__content {
      padding: 22px 18px 20px;
    }

    .zs-statue__kicker {
      width: 34px;
      margin-bottom: 13px;
    }

    .zs-statue__heading {
      max-width: 11ch;
      font-size: clamp(33px, 9.2vw, 39px);
      line-height: .99;
    }

    .zs-statue__description {
      margin-top: 13px;
      max-width: 100%;
      font-size: 12.8px;
      line-height: 1.55;
    }

    .zs-statue__purchase {
      align-items: stretch;
      flex-direction: column;
      gap: 14px;
      margin-top: 18px;
      padding-top: 15px;
    }

    .zs-statue__price {
      font-size: 27px;
    }

    .zs-statue__cta {
      width: 100%;
      min-height: 44px;
    }
  }

  @media (max-width: 390px) {
    .zs-statue {
      padding-block: 34px 38px;
    }

    .zs-statue__heading {
      font-size: clamp(31px, 8.7vw, 35px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-statue__gallery { scroll-behavior: auto; }
    .zs-statue__cta,
    .zs-statue__arrow { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  const initZsStatueGallery = (root = document) => {
    root.querySelectorAll('.zs-statue').forEach((section) => {
      const gallery = section.querySelector('[data-zs-statue-gallery]');
      const prev = section.querySelector('[data-zs-statue-prev]');
      const next = section.querySelector('[data-zs-statue-next]');
      if (!gallery || !prev || !next || gallery.dataset.zsReady === 'true') return;

      gallery.dataset.zsReady = 'true';

      const move = (direction) => {
        gallery.scrollBy({
          left: gallery.clientWidth * direction,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };

      prev.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
    });
  };

  initZsStatueGallery();

  document.addEventListener('shopify:section:load', (event) => {
    initZsStatueGallery(event.target);
  });
{% endjavascript %}

{% schema %}
{
  "name": "ZAISEN Statue Spotlight",
  "tag": "section",
  "class": "section-zaisen-statue-spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Featured statue product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handcrafted Wooden Horse Sculpture" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>One of ZAISEN’s signature art pieces, this handcrafted wooden horse captures movement, strength and character in a sculptural form. Natural grain and hand-finished detail give every piece a distinctive presence — made to stand apart in refined interiors.</p>"
    },
    { "type": "text", "id": "offer_label", "label": "Offer label", "default": "SAVE 60%" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Signature ZAISEN art piece • limited batch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2A29" },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#A8794A" },
    { "type": "color", "id": "wood_color", "label": "Walnut accent", "default": "#7A5238" },
    { "type": "color", "id": "line_color", "label": "Divider", "default": "#D8C7B3" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 52 }
  ],
  "presets": [
    { "name": "ZAISEN Statue Spotlight" }
  ]
}
{% endschema %}
