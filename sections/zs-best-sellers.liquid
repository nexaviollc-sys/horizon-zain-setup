{% liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign collection_link = section.settings.collection
%}

<section
  class="zs-best-sellers"
  style="
    --zsbs-bg: {{ section.settings.bg_color }};
    --zsbs-heading: {{ section.settings.heading_color }};
    --zsbs-text: {{ section.settings.text_color }};
    --zsbs-accent: {{ section.settings.accent_color }};
    --zsbs-wood: {{ section.settings.wood_color }};
    --zsbs-max: {{ section.settings.max_width }}px;
    --zsbs-pt: {{ section.settings.padding_top }}px;
    --zsbs-pb: {{ section.settings.padding_bottom }}px;
    --zsbs-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="zs-best-sellers__inner">
    <header class="zs-best-sellers__header">
      {% if section.settings.eyebrow != blank %}
        <div class="zs-best-sellers__eyebrow">
          <span class="zs-best-sellers__rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
          <span class="zs-best-sellers__rule" aria-hidden="true"></span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <{{ heading_tag }} class="zs-best-sellers__heading">
          {% if section.settings.heading == 'Our Best Sellers' %}
            <span>Our </span><em>Best Sellers</em>
          {% else %}
            {{ section.settings.heading | escape }}
          {% endif %}
        </{{ heading_tag }}>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="zs-best-sellers__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="zs-best-sellers__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank or request.design_mode %}
          <article class="zs-best-sellers__card" {{ block.shopify_attributes }}>
            {% if product != blank %}
              <a class="zs-best-sellers__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                <span class="zs-best-sellers__media">
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'zs-best-sellers__image',
                        widths: '320,480,640,800,900',
                        sizes: '(max-width: 749px) 50vw, 25vw',
                        loading: 'lazy',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'zs-best-sellers__placeholder' }}
                  {% endif %}

                  {% if section.settings.show_badge %}
                    <span class="zs-best-sellers__badge">{{ section.settings.badge_text | escape }}</span>
                  {% endif %}
                </span>
              </a>

              <div class="zs-best-sellers__info">
                <a class="zs-best-sellers__title" href="{{ product.url }}">{{ product.title | escape }}</a>

                <div class="zs-best-sellers__price" aria-label="Price">
                  {% if product.price_varies %}
                    <span class="zs-best-sellers__price-current">From {{ product.price_min | money_with_currency }}</span>
                  {% else %}
                    <span class="zs-best-sellers__price-current">{{ product.price | money_with_currency }}</span>
                  {% endif %}

                  {% if product.compare_at_price_max > product.price %}
                    <span class="zs-best-sellers__price-compare">{{ product.compare_at_price_max | money_with_currency }}</span>
                  {% endif %}
                </div>
              </div>
            {% else %}
              <span class="zs-best-sellers__media">
                {{ 'product-1' | placeholder_svg_tag: 'zs-best-sellers__placeholder' }}
              </span>
              <div class="zs-best-sellers__info">
                <span class="zs-best-sellers__title">Choose a product</span>
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if collection_link != blank %}
      <div class="zs-best-sellers__footer">
        <a class="zs-best-sellers__view-all" href="{{ collection_link.url }}">
          <span>{{ section.settings.link_text | escape }}</span>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .zs-best-sellers {
    background: var(--zsbs-bg);
    color: var(--zsbs-text);
    padding-block: var(--zsbs-pt) var(--zsbs-pb);
  }

  .zs-best-sellers *,
  .zs-best-sellers *::before,
  .zs-best-sellers *::after { box-sizing: border-box; }

  .zs-best-sellers__inner {
    max-width: var(--zsbs-max);
    margin-inline: auto;
    padding-inline: clamp(20px,4.5vw,48px);
  }

  .zs-best-sellers__header {
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    max-width:760px;
    margin:0 auto clamp(34px,4.5vw,56px);
  }

  .zs-best-sellers__eyebrow {
    display:inline-flex;
    align-items:center;
    gap:12px;
    margin-bottom:16px;
    font-family:var(--font-body--family,inherit);
    font-size:11px;
    font-weight:700;
    letter-spacing:.24em;
    line-height:1.2;
    text-transform:uppercase;
    color:var(--zsbs-accent);
  }

  .zs-best-sellers__rule {
    width:34px;
    height:2px;
    border-radius:2px;
    background:var(--zsbs-accent);
  }

  .zs-best-sellers__heading {
    margin:0;
    font-family:var(--font-heading--family,"Cormorant Garamond",Georgia,serif);
    font-size:clamp(38px,5vw,52px);
    font-weight:550;
    line-height:1.04;
    letter-spacing:-.02em;
    color:var(--zsbs-heading);
    text-wrap:balance;
  }

  .zs-best-sellers__heading em {
    color:var(--zsbs-accent);
    font-style:italic;
    font-weight:450;
  }

  .zs-best-sellers__subheading {
    margin:16px 0 0;
    font-family:var(--font-body--family,inherit);
    font-size:15px;
    line-height:1.65;
    color:color-mix(in srgb,var(--zsbs-text) 72%,transparent);
  }

  .zs-best-sellers__grid {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:28px;
  }

  .zs-best-sellers__card { min-width:0; }

  .zs-best-sellers__image-link {
    display:block;
    color:inherit;
    text-decoration:none;
  }

  .zs-best-sellers__media {
    position:relative;
    display:block;
    overflow:hidden;
    aspect-ratio:4 / 5;
    border-radius:var(--zsbs-radius);
    background:color-mix(in srgb,var(--zsbs-wood) 13%,var(--zsbs-bg));
  }

  .zs-best-sellers__image,
  .zs-best-sellers__placeholder {
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
  }

  .zs-best-sellers__image {
    transition:transform .55s cubic-bezier(.2,.7,.2,1);
  }

  .zs-best-sellers__badge {
    position:absolute;
    top:14px;
    left:14px;
    z-index:2;
    display:inline-flex;
    align-items:center;
    min-height:28px;
    padding:6px 11px;
    border-radius:999px;
    background:rgba(251,249,246,.92);
    color:var(--zsbs-wood);
    border:1px solid color-mix(in srgb,var(--zsbs-accent) 34%,transparent);
    backdrop-filter:blur(8px);
    font-family:var(--font-body--family,inherit);
    font-size:10px;
    font-weight:700;
    line-height:1;
    letter-spacing:.12em;
    text-transform:uppercase;
  }

  .zs-best-sellers__info {
    padding-top:15px;
  }

  .zs-best-sellers__title {
    display:block;
    color:var(--zsbs-heading);
    text-decoration:none;
    font-family:var(--font-heading--family,"Cormorant Garamond",Georgia,serif);
    font-size:clamp(1.05rem,1.35vw,1.28rem);
    font-weight:550;
    line-height:1.28;
    letter-spacing:-.005em;
    text-wrap:balance;
    transition:color .25s ease;
  }

  .zs-best-sellers__price {
    display:flex;
    flex-wrap:wrap;
    align-items:baseline;
    gap:8px;
    margin-top:8px;
    font-family:var(--font-body--family,inherit);
  }

  .zs-best-sellers__price-current {
    color:var(--zsbs-wood);
    font-size:.91rem;
    font-weight:650;
  }

  .zs-best-sellers__price-compare {
    color:color-mix(in srgb,var(--zsbs-text) 48%,transparent);
    font-size:.79rem;
    text-decoration:line-through;
  }

  .zs-best-sellers__footer {
    display:flex;
    justify-content:flex-end;
    margin-top:34px;
  }

  .zs-best-sellers__view-all {
    display:inline-flex;
    align-items:center;
    gap:9px;
    color:var(--zsbs-wood);
    text-decoration:none;
    font-family:var(--font-body--family,inherit);
    font-size:.82rem;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    border-bottom:1px solid color-mix(in srgb,var(--zsbs-accent) 55%,transparent);
    padding-bottom:5px;
  }

  .zs-best-sellers__view-all svg {
    transition:transform .3s ease;
  }

  @media (hover:hover) and (pointer:fine) {
    .zs-best-sellers__card:hover .zs-best-sellers__image { transform:scale(1.045); }
    .zs-best-sellers__title:hover { color:var(--zsbs-accent); }
    .zs-best-sellers__view-all:hover svg { transform:translateX(3px); }
  }

  @media (max-width:989px) {
    .zs-best-sellers__grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }

  @media (max-width:749px) {
    .zs-best-sellers {
      padding-block:calc(var(--zsbs-pt) * .7) calc(var(--zsbs-pb) * .7);
    }

    .zs-best-sellers__header {
      margin-bottom:30px;
    }

    .zs-best-sellers__eyebrow {
      gap:9px;
      margin-bottom:13px;
      font-size:10px;
    }

    .zs-best-sellers__rule { width:28px; }

    .zs-best-sellers__heading {
      font-size:clamp(35px,10vw,44px);
    }

    .zs-best-sellers__subheading {
      margin-top:13px;
      font-size:14px;
    }

    .zs-best-sellers__grid {
      column-gap:14px;
      row-gap:24px;
    }

    .zs-best-sellers__media {
      border-radius:3px;
    }

    .zs-best-sellers__badge {
      top:9px;
      left:9px;
      min-height:24px;
      padding:5px 8px;
      font-size:8.5px;
      letter-spacing:.09em;
    }

    .zs-best-sellers__info { padding-top:10px; }

    .zs-best-sellers__title {
      font-size:.98rem;
      line-height:1.24;
    }

    .zs-best-sellers__price {
      margin-top:6px;
      gap:6px;
    }

    .zs-best-sellers__price-current { font-size:.83rem; }
    .zs-best-sellers__price-compare { font-size:.72rem; }

    .zs-best-sellers__footer {
      justify-content:center;
      margin-top:28px;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    .zs-best-sellers *,
    .zs-best-sellers *::before,
    .zs-best-sellers *::after {
      transition:none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name":"ZAISEN Best Sellers",
  "tag":"section",
  "class":"section-zaisen-best-sellers",
  "max_blocks":4,
  "settings":[
    { "type":"text","id":"eyebrow","label":"Eyebrow","default":"ZAISEN FAVORITES" },
    { "type":"text","id":"heading","label":"Heading","default":"Our Best Sellers" },
    {
      "type":"select",
      "id":"heading_tag",
      "label":"Heading tag",
      "default":"h2",
      "options":[
        {"value":"h2","label":"H2"},
        {"value":"h3","label":"H3"}
      ]
    },
    { "type":"text","id":"subheading","label":"Subheading","default":"Most-loved handcrafted pieces." },
    { "type":"collection","id":"collection","label":"Best Sellers collection" },
    { "type":"text","id":"link_text","label":"Collection link text","default":"Shop Best Sellers" },
    { "type":"checkbox","id":"show_badge","label":"Show product badge","default":true },
    { "type":"text","id":"badge_text","label":"Badge text","default":"Best Seller" },
    { "type":"range","id":"max_width","label":"Maximum width","min":1000,"max":1600,"step":20,"unit":"px","default":1440 },
    { "type":"range","id":"card_radius","label":"Image corner radius","min":0,"max":20,"step":1,"unit":"px","default":4 },
    { "type":"color","id":"bg_color","label":"Background","default":"#FBF9F6" },
    { "type":"color","id":"heading_color","label":"Heading","default":"#2C2A29" },
    { "type":"color","id":"text_color","label":"Text","default":"#2C2A29" },
    { "type":"color","id":"accent_color","label":"Accent","default":"#A8794A" },
    { "type":"color","id":"wood_color","label":"Wood","default":"#7A5238" },
    { "type":"range","id":"padding_top","label":"Top padding","min":40,"max":140,"step":4,"unit":"px","default":80 },
    { "type":"range","id":"padding_bottom","label":"Bottom padding","min":40,"max":140,"step":4,"unit":"px","default":80 }
  ],
  "blocks":[
    {
      "type":"product",
      "name":"Product",
      "settings":[
        { "type":"product","id":"product","label":"Product" }
      ]
    }
  ],
  "presets":[
    {
      "name":"ZAISEN Best Sellers",
      "blocks":[
        {"type":"product"},
        {"type":"product"},
        {"type":"product"},
        {"type":"product"}
      ]
    }
  ]
}
{% endschema %}
