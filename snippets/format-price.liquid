{%- doc -%}
  Formats a price value with or without currency code based on settings

  @param {number} price - The price to format (defaults to 0 if not provided)
  @param {string} [type] - Type of price formatting ('regular', 'per_item', or 'market_cart' for market-aware cart labels)

  @example
  {% render 'format-price', price: variant.price %}
  {% render 'format-price', price: variant.price, type: 'per_item' %}
  {% render 'format-price', price: variant.compare_at_price %}
{%- enddoc -%}

{% liquid
  assign price_value = price | default: 0
  assign price_type = type | default: 'regular'

  assign show_currency = settings.currency_code_enabled_product_pages

  if price_type == 'market_cart'
    # Presentment amounts are already converted by Shopify Markets.
    # Only the visible symbol is customized; no arithmetic or rate conversion.
    assign currency = localization.country.currency.iso_code | default: cart.currency.iso_code
    assign prefix = blank
    assign prefix_class = 'zs-cart-currency-code--symbol'
    case currency
      when 'USD'
        assign prefix = '$'
      when 'CAD'
        assign prefix = 'CAD$'
        assign prefix_class = 'zs-cart-currency-code--label'
      when 'AUD'
        assign prefix = 'AUD$'
        assign prefix_class = 'zs-cart-currency-code--label'
      when 'EUR'
        assign prefix = '€'
      when 'GBP'
        assign prefix = '£'
      when 'AED'
        assign prefix = 'AED '
    endcase
    if prefix == blank
      assign formatted_price = price_value | money_with_currency
    else
      assign amount_without_currency = price_value | money_without_currency
      capture formatted_price
        echo '<span class="zs-cart-currency-code ' | append: prefix_class | append: '">' | append: prefix | append: '</span>' | append: amount_without_currency
      endcapture
    endif
  elsif show_currency
    assign formatted_price = price_value | money_with_currency
  else
    assign formatted_price = price_value | money
  endif

  # callers using this in attributes strip the bdi via strip_html
  assign formatted_price = '<bdi>__PRICE__</bdi>' | replace: '__PRICE__', formatted_price

  if price_type == 'per_item'
    assign per_item_text = 'content.quantity_per_item' | t
    assign formatted_price = formatted_price | append: per_item_text
  endif
%}

{{- formatted_price -}}
{% stylesheet %}
  /* Cart labels: only CAD$/AUD$ shrink; $, €, £ and AED stay full-size. */
  .zs-cart-currency-code--label { font-size:.73em; font-weight:600; letter-spacing:0; white-space:nowrap; margin-inline-end:.08em; }
  .zs-cart-currency-code--symbol { font-size:1em; font-weight:inherit; margin-inline-end:0; }
{% endstylesheet %}
