{% comment %}
  ZAISEN shipping qualification is based on the active shopper's country
  and Shopify's discounted cart total (not compare-at prices).
  All thresholds are USD. Shopify shipping rates and discounts are finalized
  at checkout, which remains authoritative.
{% endcomment %}
{%- liquid
  assign zs_shipping_usd = 0
  assign zs_shipping_standard_cents = 0
  case localization.country.iso_code
    when 'GB'
      assign zs_shipping_usd = 60
      assign zs_shipping_standard_cents = 699
    when 'US', 'DE', 'FR'
      assign zs_shipping_usd = 60
      assign zs_shipping_standard_cents = 999
    when 'AE'
      assign zs_shipping_usd = 60
      assign zs_shipping_standard_cents = 599
    when 'CA', 'AU'
      assign zs_shipping_usd = 100
      assign zs_shipping_standard_cents = 1499
  endcase

  assign zs_shipping_bundle_code = false
  for zs_discount in cart.discount_applications
    if zs_discount.title contains 'ZS-BUNDLESHIP-2026'
      assign zs_shipping_bundle_code = true
      break
    endif
  endfor
  if zs_shipping_bundle_code == false and zs_shipping_usd > 0 and cart.item_count >= 2
    for zs_cart_line in cart.items
      for zs_allocation in zs_cart_line.line_level_discount_allocations
        if zs_allocation.discount_application.title contains 'ZS-BUNDLE15-2026' or zs_allocation.discount_application.title contains 'ZS-BUNDLE25-2026'
          assign zs_shipping_bundle_code = true
          break
        endif
      endfor
      if zs_shipping_bundle_code
        break
      endif
    endfor
  endif
  assign zs_shipping_threshold_cents = zs_shipping_usd | times: 100
  assign zs_shipping_usd_qualified = false
  if zs_shipping_usd > 0 and cart.currency.iso_code == 'USD' and cart.total_price >= zs_shipping_threshold_cents
    assign zs_shipping_usd_qualified = true
  endif
  comment
    Bundle product discounts remain in place; they do not independently
    prove a free-shipping rate. Final rates are decided at checkout.
  endcomment
  assign zs_shipping_qualified = zs_shipping_usd_qualified
-%}
{% if zs_shipping_usd > 0 %}
  <div
    class="zs-cart-shipping{% if zs_shipping_qualified %} is-qualified{% endif %}"
    data-zs-shipping-progress
    data-threshold-usd-cents="{{ zs_shipping_threshold_cents }}"
    data-standard-shipping-usd-cents="{{ zs_shipping_standard_cents }}"
    data-cart-total-cents="{{ cart.total_price }}"
    data-currency="{{ cart.currency.iso_code | default: localization.country.currency.iso_code | escape }}"
    data-shop-currency="{{ shop.currency | escape }}"
    data-country-name="{{ localization.country.name | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-bundle-shipping="{% if zs_shipping_bundle_code %}true{% else %}false{% endif %}"
    aria-live="polite"
  >
    <div class="zs-cart-shipping__country-row">
      <span class="zs-cart-shipping__country-caption">
        {% case request.locale.iso_code %}
          {% when 'de' %}Lieferland
          {% when 'fr' %}Pays de livraison
          {% when 'ar' %}بلد التوصيل
          {% else %}Deliver to
        {% endcase %}
      </span>
      {% form 'localization', id: 'ZsCartCountryForm', class: 'zs-cart-shipping__country-form' %}
        <label class="visually-hidden" for="ZsCartCountrySelect">Shipping destination</label>
        <select id="ZsCartCountrySelect" name="country_code" class="zs-cart-shipping__country-select" data-current-country="{{ localization.country.iso_code | escape }}" aria-label="Shipping country — select to update automatically">
          {% for zs_country in localization.available_countries %}
            {% if zs_country.iso_code == 'GB' or zs_country.iso_code == 'US' or zs_country.iso_code == 'DE' or zs_country.iso_code == 'FR' or zs_country.iso_code == 'AE' or zs_country.iso_code == 'CA' or zs_country.iso_code == 'AU' %}
              <option value="{{ zs_country.iso_code }}" {% if zs_country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ zs_country.name | escape }}</option>
            {% endif %}
          {% endfor %}
        </select>
        <noscript>
        <button type="submit" class="zs-cart-shipping__country-apply" aria-label="Apply shipping country">
          {% case request.locale.iso_code %}
            {% when 'de' %}Ändern
            {% when 'fr' %}Changer
            {% when 'ar' %}تغيير
            {% else %}Update
          {% endcase %}
        </button>
        </noscript>
      {% endform %}
    </div>
    <div class="zs-cart-shipping__message">
      <span class="zs-cart-shipping__check" aria-hidden="true">✓</span>
      <span data-zs-shipping-message>
        {% if zs_shipping_qualified %}
          {% case request.locale.iso_code %}
            {% when 'de' %}Kostenloser Versand nach {{ localization.country.name | escape }} möglich.
            {% when 'fr' %}Livraison gratuite possible vers {{ localization.country.name | escape }}.
            {% when 'ar' %}طلبك مؤهل للشحن المجاني إلى {{ localization.country.name | escape }}.
            {% else %}You've unlocked free shipping to {{ localization.country.name | escape }}.
          {% endcase %}
        {% else %}
          {% case request.locale.iso_code %}
            {% when 'de' %}Noch mehr einkaufen für kostenlosen Versand nach {{ localization.country.name | escape }}.
            {% when 'fr' %}Ajoutez des articles pour la livraison gratuite vers {{ localization.country.name | escape }}.
            {% when 'ar' %}أضف المزيد للحصول على شحن مجاني إلى {{ localization.country.name | escape }}.
            {% else %}Add more for free shipping.
          {% endcase %}
        {% endif %}
      </span>
    </div>
    <div
      class="zs-cart-shipping__track"
      role="progressbar"
      aria-label="Progress toward free-shipping minimum"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-zs-shipping-track
      hidden
    >
      <span class="zs-cart-shipping__fill" data-zs-shipping-fill></span>
    </div>
    <p class="zs-cart-shipping__disclaimer" data-zs-shipping-note>
      {% case request.locale.iso_code %}
        {% when 'de' %}Versand voraussichtlich · endgültiger Preis an der Kasse
        {% when 'fr' %}Livraison estimée · montant final à la caisse
        {% when 'ar' %}الشحن تقديري · السعر النهائي عند الدفع
        {% else %}Estimated shipping · Final rate at checkout
      {% endcase %}
    </p>
  </div>
{% endif %}
