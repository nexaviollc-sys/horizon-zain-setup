{%- comment -%}
  Automatic navigation: all Online Store collections, including future ones.
  The frontpage utility collection and the current collection are excluded.
{%- endcomment -%}
{%- for nav_collection in collections -%}
  {%- unless nav_collection.handle == 'frontpage' or nav_collection.handle == collection.handle -%}
    {%- liquid
      assign nav_image = nav_collection.image
      if nav_image == blank
        assign nav_image = nav_collection.products.first.featured_image
      endif
    -%}
    <a class="zs-collection-nav__link" href="{{ nav_collection.url }}">
      <span class="zs-collection-nav__thumb">
        {%- if nav_image != blank -%}
          {{ nav_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '60px', alt: nav_collection.title }}
        {%- else -%}
          <span class="zs-collection-nav__fallback" aria-hidden="true">Z</span>
        {%- endif -%}
      </span>
      <span class="zs-collection-nav__name">{{ nav_collection.title | escape }}</span>
      <span class="zs-collection-nav__arrow" aria-hidden="true">›</span>
    </a>
  {%- endunless -%}
{%- endfor -%}
