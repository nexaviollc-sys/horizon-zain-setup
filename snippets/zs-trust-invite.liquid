{% comment %}
  ZAISEN shared product-page trust and Etsy review prompt.
  The 5-star claim refers to a customer review on the official Etsy shop,
  not a product-specific rating or a shop-wide aggregate score.
  Replaces the prior trust invite; it is shown once through the existing
  product buy-buttons block and does not alter prices, checkout or inventory.
{% endcomment %}
{% liquid
  case request.locale.iso_code
    when 'de'
      assign zs_ti_review = '5-Sterne-Kundenbewertung auf Etsy'
      assign zs_ti_etsy_action = 'Auf Etsy ansehen'
      assign zs_ti_heading = 'Neu bei ZAISEN?'
      assign zs_ti_copy = 'Lernen Sie uns vor Ihrer Bestellung kennen.'
      assign zs_ti_action = 'Warum ZAISEN vertrauen?'
    when 'fr'
      assign zs_ti_review = 'Avis client 5 étoiles sur Etsy'
      assign zs_ti_etsy_action = 'Voir sur Etsy'
      assign zs_ti_heading = 'Vous découvrez ZAISEN ?'
      assign zs_ti_copy = 'Apprenez à nous connaître avant de commander.'
      assign zs_ti_action = 'Pourquoi faire confiance à ZAISEN ?'
    when 'ar'
      assign zs_ti_review = 'تقييم عميل بخمس نجوم على إتسي'
      assign zs_ti_etsy_action = 'شاهده على إتسي'
      assign zs_ti_heading = 'هل زايسن جديدة عليك؟'
      assign zs_ti_copy = 'تعرّف علينا قبل تقديم طلبك.'
      assign zs_ti_action = 'لماذا تثق بزايسن؟'
    else
      assign zs_ti_review = '5-star customer review on Etsy'
      assign zs_ti_etsy_action = 'See on Etsy'
      assign zs_ti_heading = 'New to ZAISEN?'
      assign zs_ti_copy = 'Get to know us before ordering.'
      assign zs_ti_action = 'Why Trust ZAISEN?'
  endcase
%}
{% if pages['why-trust-zaisen'] != blank %}
  <aside class="zs-trust-invite" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
    <div class="zs-trust-invite__review">
      <div class="zs-trust-invite__review-copy">
        <span class="zs-trust-invite__stars" aria-hidden="true">★★★★★</span>
        <strong class="zs-trust-invite__review-label">{{ zs_ti_review | escape }}</strong>
      </div>
      <a class="zs-trust-invite__etsy" href="https://www.etsy.com/shop/ZAISEN" target="_blank" rel="noopener noreferrer">
        {{ zs_ti_etsy_action | escape }} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="zs-trust-invite__bottom">
      <span class="zs-trust-invite__intro"><strong>{{ zs_ti_heading | escape }}</strong> {{ zs_ti_copy | escape }}</span>
      <a class="zs-trust-invite__learn" href="{{ routes.root_url }}pages/why-trust-zaisen">
        {{ zs_ti_action | escape }} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </aside>
{% endif %}
<style>
.zs-trust-invite{width:100%;box-sizing:border-box;margin-top:12px;border:1px solid #e4d9c9;border-radius:9px;background:#faf7f1;overflow:hidden;color:#382b20}
.zs-trust-invite *{box-sizing:border-box}
.zs-trust-invite__review{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 16px}
.zs-trust-invite__review-copy{display:flex;align-items:center;gap:11px;flex-wrap:wrap;min-width:0}
.zs-trust-invite__stars{color:#a8793c;font-size:15px;letter-spacing:.12em;line-height:1;white-space:nowrap}
.zs-trust-invite__review-label{font-size:12px;line-height:1.5;font-weight:650;color:#382b20}
.zs-trust-invite__etsy{display:inline-flex;align-items:center;gap:5px;color:#70502f!important;font-size:11.5px;line-height:1.5;font-weight:700;text-decoration:underline!important;text-underline-offset:3px;white-space:nowrap}
.zs-trust-invite__etsy:hover,.zs-trust-invite__learn:hover{color:#9a6d39!important}
.zs-trust-invite__bottom{display:flex;justify-content:space-between;align-items:baseline;gap:8px 16px;flex-wrap:wrap;border-top:1px solid #e7ded2;padding:10px 16px}
.zs-trust-invite__intro{font-size:11px;line-height:1.6;color:#7b6a58}.zs-trust-invite__intro strong{color:#4d3929;font-weight:700}
.zs-trust-invite__learn{display:inline-flex;gap:4px;align-items:center;font-size:11px;line-height:1.6;font-weight:650;color:#70502f!important;text-decoration:underline!important;text-underline-offset:3px}
.zs-trust-invite a:focus-visible{outline:2px solid #9e7849;outline-offset:3px;border-radius:2px}
@media(max-width:480px){.zs-trust-invite{margin-top:10px}.zs-trust-invite__review{padding:12px 13px;align-items:flex-start;gap:7px}.zs-trust-invite__review-copy{display:grid;gap:6px}.zs-trust-invite__stars{font-size:14px}.zs-trust-invite__review-label{font-size:11.5px}.zs-trust-invite__etsy{font-size:11px;align-self:center}.zs-trust-invite__bottom{padding:10px 13px;gap:3px 10px}.zs-trust-invite__intro,.zs-trust-invite__learn{font-size:10.7px}}
</style>
