{% comment %}Compact ZAISEN trust invitation under product purchasing controls. Does not modify pricing, carts, or native purchase logic.{% endcomment %}
{% liquid
  case request.locale.iso_code
    when 'de'
      assign zs_ti_heading = 'Neu bei ZAISEN?'
      assign zs_ti_copy = 'Lernen Sie unsere Werkstatt und unseren Service vor dem Kauf kennen.'
      assign zs_ti_action = 'Warum ZAISEN vertrauen?'
    when 'fr'
      assign zs_ti_heading = 'Vous découvrez ZAISEN ?'
      assign zs_ti_copy = 'Rencontrez notre atelier et notre équipe avant de commander.'
      assign zs_ti_action = 'Pourquoi faire confiance à ZAISEN ?'
    when 'ar'
      assign zs_ti_heading = 'هل زايسن جديدة عليك؟'
      assign zs_ti_copy = 'تعرّف على ورشتنا وفريقنا قبل تقديم الطلب.'
      assign zs_ti_action = 'لماذا تثق بزايسن؟'
    else
      assign zs_ti_heading = 'New to ZAISEN?'
      assign zs_ti_copy = 'Meet our makers and get to know us before you order.'
      assign zs_ti_action = 'Why Trust ZAISEN?'
  endcase
%}
{% if pages['why-trust-zaisen'] != blank %}
  <aside class="zs-trust-invite" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
    <span class="zs-trust-invite__glyph" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4.5 5v5.8c0 5.3 3.2 9.2 7.5 11.2 4.3-2 7.5-5.9 7.5-11.2V5L12 2Z"/><path d="m8.5 12 2.3 2.3 4.7-4.8"/></svg>
    </span>
    <div class="zs-trust-invite__content">
      <strong>{{ zs_ti_heading | escape }}</strong>
      <span>{{ zs_ti_copy | escape }}</span>
      <a href="{{ routes.root_url }}pages/why-trust-zaisen">{{ zs_ti_action | escape }} <span aria-hidden="true">↗</span></a>
    </div>
  </aside>
{% endif %}
<style>
.zs-trust-invite{display:flex;gap:11px;align-items:flex-start;width:100%;padding:13px 14px;margin-top:10px;background:#f9f6f0;border:1px solid #e4d9cb;border-radius:7px;color:#34281e;box-sizing:border-box}
.zs-trust-invite__glyph{width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;border-radius:50%;color:#7f6344;background:#efe7db}
.zs-trust-invite__content{flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:3px 7px;line-height:1.55}
.zs-trust-invite__content strong{font-size:12px;font-weight:700;color:#32251b;white-space:nowrap}
.zs-trust-invite__content>span{font-size:11.5px;color:#6b5c4f}
.zs-trust-invite__content a{display:inline;color:#6a4e2e!important;font-size:11.5px;font-weight:700;text-underline-offset:3px;text-decoration:underline}
.zs-trust-invite__content a:hover{color:#382618!important}
.zs-trust-invite__content a:focus-visible{outline:2px solid #9e7849;outline-offset:3px}
@media(max-width:480px){.zs-trust-invite{padding:11px 12px;gap:9px}.zs-trust-invite__content{display:block}.zs-trust-invite__content strong,.zs-trust-invite__content>span,.zs-trust-invite__content a{display:inline;margin-inline-end:4px}}
</style>