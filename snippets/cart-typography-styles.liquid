{% doc %}
  Shared cart typography styles, used by both cart-products and cart-summary.

  @example
  {% render 'cart-typography-styles' %}
{% enddoc %}

{% stylesheet %}
  .cart-primary-typography {
    font-family: var(--cart-primary-font-family);
    font-style: var(--cart-primary-font-style);
    font-weight: var(--cart-primary-font-weight);
  }

  .cart-secondary-typography {
    font-family: var(--cart-secondary-font-family);
    font-style: var(--cart-secondary-font-style);
    font-weight: var(--cart-secondary-font-weight);
  }
  /* Only Canadian and Australian dollar codes shrink; other symbols retain price size. */
  .zs-cart-currency-code--label {
    font-size: .73em;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
    margin-inline-end: .08em;
  }
  .zs-cart-currency-code--symbol {
    font-size: 1em;
    font-weight: inherit;
    margin-inline-end: 0;
  }
{% endstylesheet %}
