{% comment %}
  ZAISEN — estimated delivery above add-to-cart.
  Mirrors shipping ranges configured Oct 22 2026: GB 4–5 days; US, DE, FR, CA, AU, AE, SA 7–9 days.
  Plus one calendar day for order processing. Review if Shopify shipping rates change.
  Delivery dates are estimates, not guaranteed arrival dates.
{% endcomment %}
{% liquid
  assign zs_country = localization.country.iso_code | upcase
  assign zs_shipping_min = 7
  assign zs_shipping_max = 9
  assign zs_supported = false
  case zs_country
    when 'GB'
      assign zs_shipping_min = 4
      assign zs_shipping_max = 5
      assign zs_supported = true
    when 'US', 'DE', 'FR', 'CA', 'AU', 'AE', 'SA'
      assign zs_supported = true
  endcase
  assign zs_arrival_min = zs_shipping_min | plus: 1
  assign zs_arrival_max = zs_shipping_max | plus: 1
  assign zs_language = request.locale.iso_code | slice: 0, 2
%}
{% if zs_supported %}
  {% capture zs_delivery %}
    {% case zs_language %}
      {% when 'de' %}Voraussichtliche Lieferung
      {% when 'fr' %}Livraison estimée
      {% when 'ar' %}التوصيل المتوقع
      {% else %}Estimated delivery
    {% endcase %}
  {% endcapture %}
  {% capture zs_refunds %}
    {% case zs_language %}
      {% when 'de' %}14 Tage Rückgabe & Erstattung
      {% when 'fr' %}Retours et remboursements sous 14 jours
      {% when 'ar' %}إرجاع واسترداد خلال 14 يومًا
      {% else %}14-Day Returns & Refunds
    {% endcase %}
  {% endcapture %}
  {% capture zs_refunds_detail %}
    {% case zs_language %}
      {% when 'de' %}Ab dem Tag der Zustellung
      {% when 'fr' %}À compter de la livraison
      {% when 'ar' %}تبدأ المدة عند استلام طلبك
      {% else %}Starting the day your order arrives
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft %}
    {% case zs_language %}
      {% when 'de' %}Von Hand aus echtem Holz gefertigt
      {% when 'fr' %}Fabriqué à la main en bois véritable
      {% when 'ar' %}مصنوع يدويًا من الخشب الطبيعي
      {% else %}Handcrafted From Real Wood
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft_detail %}
    {% case zs_language %}
      {% when 'de' %}Mit Liebe von unseren Händen gefertigt
      {% when 'fr' %}Créé à la main avec soin
      {% when 'ar' %}صنعناه بأيدينا وبكل عناية
      {% else %}Made by our hands, with care
    {% endcase %}
  {% endcapture %}
  {% capture zs_shipping_country %}
    {% case zs_language %}
      {% when 'de' %}Kostenloser Versand nach {{ localization.country.name | escape }}
      {% when 'fr' %}Livraison gratuite vers {{ localization.country.name | escape }}
      {% when 'ar' %}شحن مجاني إلى {{ localization.country.name | escape }}
      {% else %}Free shipping to {{ localization.country.name | escape }}
    {% endcase %}
  {% endcapture %}
  {% capture zs_support %}
    {% case zs_language %}
      {% when 'de' %}Wir helfen gern
      {% when 'fr' %}Nous sommes là pour vous
      {% when 'ar' %}نحن هنا للمساعدة
      {% else %}Here to Help
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_prompt %}
    {% case zs_language %}
      {% when 'de' %}Noch Fragen?
      {% when 'fr' %}Une question ?
      {% when 'ar' %}هل لديك أي استفسار؟
      {% else %}Have a question?
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_link %}
    {% case zs_language %}
      {% when 'de' %}ZAISEN kontaktieren
      {% when 'fr' %}Contacter ZAISEN
      {% when 'ar' %}تواصل مع ZAISEN
      {% else %}Contact ZAISEN
    {% endcase %}
  {% endcapture %}
  {% capture zs_days %}
    {% case zs_language %}
      {% when 'de' %}Tage
      {% when 'fr' %}jours
      {% when 'ar' %}أيام
      {% else %}days
    {% endcase %}
  {% endcapture %}

  {% capture zs_promise %}
    {% case zs_language %}
      {% when 'de' %}Das ZAISEN Versprechen
      {% when 'fr' %}La promesse ZAISEN
      {% when 'ar' %}وعد زايسن
      {% else %}THE ZAISEN PROMISE
    {% endcase %}
  {% endcapture %}

  <div class="zs-delivery-estimate zs-product-benefits"
    data-zs-delivery-estimate
    data-min-days="{{ zs_arrival_min }}"
    data-max-days="{{ zs_arrival_max }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    dir="{% if zs_language == 'ar' %}rtl{% else %}ltr{% endif %}"
    aria-label="{% if zs_language == 'de' %}Produktvorteile{% elsif zs_language == 'fr' %}Avantages du produit{% elsif zs_language == 'ar' %}مزايا المنتج{% else %}Product benefits{% endif %}">
    <div class="zs-product-benefits__heading">
      <span>{{ zs_promise | strip }}</span>
      <span class="zs-product-benefits__rule" aria-hidden="true"></span>
    </div>

    <div class="zs-product-benefits__grid">
      <div class="zs-product-benefits__item zs-product-benefits__item--delivery">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h11v11H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="18" cy="17.5" r="2"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_delivery | strip }}</span>
          <strong class="zs-product-benefits__detail zs-product-benefits__date" data-zs-delivery-dates>{{ zs_arrival_min }}–{{ zs_arrival_max }} {{ zs_days | strip }}</strong>
          <span class="zs-product-benefits__detail zs-product-benefits__country">{{ zs_shipping_country | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--refund">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 10a9 9 0 1 1 2.5 6.3"/><path d="M3 4v6h6"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_refunds | strip }}</span>
          <span class="zs-product-benefits__detail">{{ zs_refunds_detail | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--craft">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 4c-8 0-14 4-14 11a5 5 0 0 0 5 5c7 0 11-6 9-16Z"/><path d="M4 21c2-5 5-8 11-12"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_craft | strip }}</span>
          <span class="zs-product-benefits__detail">{{ zs_craft_detail | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--support">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 14v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="13" width="4" height="7" rx="2"/><rect x="17" y="13" width="4" height="7" rx="2"/><path d="M19 20a5 5 0 0 1-5 2h-2"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_support | strip }}</span>
          <span class="zs-product-benefits__detail">
            {{ zs_support_prompt | strip }}
            <a class="zs-product-benefits__link" href="{{ routes.root_url }}pages/contact">{{ zs_support_link | strip }} <span aria-hidden="true">↗</span></a>
          </span>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ZAISEN Promise: condensed editorial benefit grid; product page only. */
    .product-information .product-details .zs-product-benefits {
      display:block !important; flex:none !important; align-self:stretch !important;
      width:100% !important; min-width:0 !important; max-width:100%;
      height:auto !important; min-height:0 !important;
      margin:2px 0 7px !important; padding:0 !important; border:0 !important;
      background:transparent !important; color:var(--zs-text,#322b26);
      text-align:start; font-family:var(--font-body--family,inherit);
    }
    .product-information .zs-product-benefits__heading {
      display:flex; align-items:center; gap:10px; margin:0 0 7px;
      font-size:10px; font-weight:750; letter-spacing:.13em; line-height:1.3;
      text-transform:uppercase; color:var(--zs-walnut,#443126);
    }
    .product-information .zs-product-benefits__rule {
      flex:1; min-width:10px; height:1px;
      background:linear-gradient(to right,rgba(110,76,54,.32),rgba(110,76,54,.06));
    }
    .product-information .zs-product-benefits__grid {
      display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)) !important;
      grid-template-rows:auto !important; grid-auto-rows:auto !important;
      align-items:stretch !important; gap:7px !important;
      width:100%; min-width:0; height:auto !important; min-height:0 !important;
    }
    .product-information .zs-product-benefits__item {
      display:grid !important; grid-template-columns:29px minmax(0,1fr) !important;
      grid-template-rows:auto !important; align-items:center !important;
      justify-content:start !important; gap:9px !important; position:relative;
      box-sizing:border-box; width:100%; min-width:0; height:auto !important;
      min-height:0 !important; max-height:none !important; margin:0 !important;
      padding:9px 10px !important; border:1px solid #e8dcd0 !important;
      border-radius:9px !important; background:#f8f3ed !important;
      box-shadow:0 1px 3px rgba(59,40,25,.035) !important;
      color:#443126 !important; text-align:start;
    }
    .product-information .zs-product-benefits__top {
      display:grid; place-items:center; width:29px; min-width:0; margin:0;
    }
    .product-information .zs-product-benefits__icon-frame {
      display:grid; place-items:center; width:29px; height:29px;
      border:1px solid rgba(105,73,49,.10); border-radius:8px;
      background:#efe3d5 !important; color:#694a36 !important;
    }
    .product-information .zs-product-benefits__icon {width:16px; height:16px;}
    .product-information .zs-product-benefits__copy {
      display:flex !important; flex-direction:column !important;
      align-items:flex-start !important; justify-content:center !important;
      gap:2px !important; width:100%; min-width:0; height:auto !important;
      min-height:0 !important; line-height:1.25; overflow-wrap:anywhere;
    }
    .product-information .zs-product-benefits__title {
      font-size:12px; font-weight:700; line-height:1.25; color:#443126 !important;
    }
    .product-information .zs-product-benefits__detail {
      display:block; font-size:10.5px; font-weight:400; line-height:1.32;
      color:#706157 !important; opacity:1;
    }
    .product-information .zs-product-benefits__date {
      font-family:var(--font-body--family,inherit); font-size:11.5px;
      font-weight:700; line-height:1.25; letter-spacing:0; color:#443126 !important;
    }
    .product-information .zs-product-benefits__link {
      display:inline; color:#5d3e2c !important; font-weight:700;
      text-decoration:underline; text-underline-offset:2px; white-space:normal;
    }
    .product-information .zs-product-benefits__link:hover {text-decoration-thickness:2px;}
    .product-information .zs-product-benefits__link:focus-visible {
      outline:2px solid currentColor; outline-offset:2px;
    }
    @media (max-width:749px) {
      .product-information .product-details .zs-product-benefits {margin:2px 0 7px !important;}
      .product-information .zs-product-benefits__grid {gap:6px !important;}
      .product-information .zs-product-benefits__item {
        grid-template-columns:25px minmax(0,1fr) !important;
        gap:6px !important; padding:8px !important;
      }
      .product-information .zs-product-benefits__top,
      .product-information .zs-product-benefits__icon-frame {width:25px;}
      .product-information .zs-product-benefits__icon-frame {height:25px; border-radius:7px;}
      .product-information .zs-product-benefits__icon {width:15px; height:15px;}
      .product-information .zs-product-benefits__title {font-size:11px;}
      .product-information .zs-product-benefits__detail {font-size:10px;}
      .product-information .zs-product-benefits__date {font-size:11px;}
    }
    @media (max-width:340px) {
      .product-information .zs-product-benefits__grid {grid-template-columns:minmax(0,1fr) !important;}
    }
  </style>
  <script>
    (function () {
      function updateDeliveryDates() {
        document.querySelectorAll('[data-zs-delivery-estimate]').forEach(function (root) {
          var target = root.querySelector('[data-zs-delivery-dates]');
          if (!target) return;
          var low = Number(root.dataset.minDays), high = Number(root.dataset.maxDays);
          if (!Number.isInteger(low) || !Number.isInteger(high)) return;
          var today = new Date();
          var early = new Date(today.getFullYear(), today.getMonth(), today.getDate() + low, 12);
          var late = new Date(today.getFullYear(), today.getMonth(), today.getDate() + high, 12);
          var locale = root.dataset.locale || 'en';
          try {
            var formatter = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' });
            target.textContent = formatter.format(early) + ' – ' + formatter.format(late);
          } catch (error) {
            // Keep the server-rendered estimate when Intl is unavailable.
          }
        });
      }
      updateDeliveryDates();
      document.addEventListener('shopify:section:load', updateDeliveryDates);
    })();
  </script>
{% endif %}
