{% comment %}
  ZAISEN — estimated delivery above add-to-cart.
  Mirrors shipping ranges configured Oct 22 2026: GB 4–5 days; US, DE, FR, CA, AU, AE, SA 7–9 days.
  Plus one calendar day for order processing. Review if Shopify shipping rates change.
  Delivery dates are estimates, not guaranteed arrival dates.
{% endcomment %}
{% liquid
  assign zs_country = localization.country.iso_code | upcase
  assign zs_shipping_min = 7
  assign zs_shipping_max = 9
  assign zs_supported = false
  case zs_country
    when 'GB'
      assign zs_shipping_min = 4
      assign zs_shipping_max = 5
      assign zs_supported = true
    when 'US', 'DE', 'FR', 'CA', 'AU', 'AE', 'SA'
      assign zs_supported = true
  endcase
  assign zs_arrival_min = zs_shipping_min | plus: 1
  assign zs_arrival_max = zs_shipping_max | plus: 1
  assign zs_language = request.locale.iso_code | slice: 0, 2
%}
{% if zs_supported %}
  {% capture zs_delivery %}
    {% case zs_language %}
      {% when 'de' %}Heute bestellen, erhalten
      {% when 'fr' %}Commandez aujourd'hui, recevez
      {% when 'ar' %}اطلب اليوم، واستلم
      {% else %}Order today, receive
    {% endcase %}
  {% endcapture %}
  {% capture zs_refunds %}
    {% case zs_language %}
      {% when 'de' %}14 Tage Rückgabe & Erstattung
      {% when 'fr' %}Retours et remboursements sous 14 jours
      {% when 'ar' %}إرجاع واسترداد خلال 14 يومًا
      {% else %}14-Day Returns & Refunds
    {% endcase %}
  {% endcapture %}
  {% capture zs_refunds_detail %}
    {% case zs_language %}
      {% when 'de' %}Ab dem Tag der Zustellung
      {% when 'fr' %}À compter de la livraison
      {% when 'ar' %}تبدأ المدة عند استلام طلبك
      {% else %}Starting the day your order arrives
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft %}
    {% case zs_language %}
      {% when 'de' %}Von Hand aus echtem Holz gefertigt
      {% when 'fr' %}Fabriqué à la main en bois véritable
      {% when 'ar' %}مصنوع يدويًا من الخشب الطبيعي
      {% else %}Handcrafted From Real Wood
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft_detail %}
    {% case zs_language %}
      {% when 'de' %}Mit Liebe von unseren Händen gefertigt
      {% when 'fr' %}Créé à la main avec soin
      {% when 'ar' %}صنعناه بأيدينا وبكل عناية
      {% else %}Made by our hands, with care
    {% endcase %}
  {% endcapture %}
  {% capture zs_shipping_country %}
    {% case zs_language %}
      {% when 'de' %}Kostenloser Versand nach {{ localization.country.name | escape }}
      {% when 'fr' %}Livraison gratuite vers {{ localization.country.name | escape }}
      {% when 'ar' %}شحن مجاني إلى {{ localization.country.name | escape }}
      {% else %}Free shipping to {{ localization.country.name | escape }}
    {% endcase %}
  {% endcapture %}
  {% capture zs_support %}
    {% case zs_language %}
      {% when 'de' %}24/7 Kundenservice
      {% when 'fr' %}Assistance 24h/24, 7j/7
      {% when 'ar' %}دعم على مدار الساعة
      {% else %}24/7 Support
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_prompt %}
    {% case zs_language %}
      {% when 'de' %}Noch Fragen?
      {% when 'fr' %}Une question ?
      {% when 'ar' %}هل لديك أي استفسار؟
      {% else %}Have a question?
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_link %}
    {% case zs_language %}
      {% when 'de' %}ZAISEN kontaktieren
      {% when 'fr' %}Contacter ZAISEN
      {% when 'ar' %}تواصل مع ZAISEN
      {% else %}Contact ZAISEN
    {% endcase %}
  {% endcapture %}
  {% capture zs_days %}
    {% case zs_language %}
      {% when 'de' %}Tage
      {% when 'fr' %}jours
      {% when 'ar' %}أيام
      {% else %}days
    {% endcase %}
  {% endcapture %}

  {% capture zs_promise %}
    {% case zs_language %}
      {% when 'de' %}Das ZAISEN Versprechen
      {% when 'fr' %}La promesse ZAISEN
      {% when 'ar' %}وعد زايسن
      {% else %}THE ZAISEN PROMISE
    {% endcase %}
  {% endcapture %}

  <div class="zs-delivery-estimate zs-product-benefits"
    data-zs-delivery-estimate
    data-min-days="{{ zs_arrival_min }}"
    data-max-days="{{ zs_arrival_max }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    dir="{% if zs_language == 'ar' %}rtl{% else %}ltr{% endif %}"
    aria-label="{% if zs_language == 'de' %}Produktvorteile{% elsif zs_language == 'fr' %}Avantages du produit{% elsif zs_language == 'ar' %}مزايا المنتج{% else %}Product benefits{% endif %}">
    <div class="zs-product-benefits__heading">
      <span>{{ zs_promise | strip }}</span>
      <span class="zs-product-benefits__rule" aria-hidden="true"></span>
    </div>

    <div class="zs-product-benefits__grid">
      <div class="zs-product-benefits__item zs-product-benefits__item--delivery">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h11v11H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="18" cy="17.5" r="2"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_delivery | strip }}</span>
          <strong class="zs-product-benefits__detail zs-product-benefits__date" data-zs-delivery-dates>{{ zs_arrival_min }}–{{ zs_arrival_max }} {{ zs_days | strip }}</strong>
          <span class="zs-product-benefits__detail zs-product-benefits__country">{{ zs_shipping_country | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--refund">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 10a9 9 0 1 1 2.5 6.3"/><path d="M3 4v6h6"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_refunds | strip }}</span>
          <span class="zs-product-benefits__detail">{{ zs_refunds_detail | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--craft">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 4c-8 0-14 4-14 11a5 5 0 0 0 5 5c7 0 11-6 9-16Z"/><path d="M4 21c2-5 5-8 11-12"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_craft | strip }}</span>
          <span class="zs-product-benefits__detail">{{ zs_craft_detail | strip }}</span>
        </div>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--support">
        <div class="zs-product-benefits__top">
          <span class="zs-product-benefits__icon-frame">
            <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 14v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="13" width="4" height="7" rx="2"/><rect x="17" y="13" width="4" height="7" rx="2"/><path d="M19 20a5 5 0 0 1-5 2h-2"/>
            </svg>
          </span>
        </div>
        <div class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_support | strip }}</span>
          <span class="zs-product-benefits__detail">
            {{ zs_support_prompt | strip }}
            <a class="zs-product-benefits__link" href="{{ routes.root_url }}pages/contact">{{ zs_support_link | strip }} <span aria-hidden="true">↗</span></a>
          </span>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ZAISEN promise cards — one coordinated cream finish and content-sized rows. */
    .product-information .product-details .zs-product-benefits {
      display: block !important;
      flex: none !important;
      align-self: start !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100%;
      box-sizing: border-box;
      margin: 6px 0 12px !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      color: var(--zs-text,#322b26);
      text-align: start;
      font-family: var(--font-body--family,inherit);
      overflow: visible;
    }
    .zs-product-benefits__heading {
      display: flex;
      align-items: center;
      gap: 11px;
      margin: 0 0 9px;
      color: var(--zs-walnut,#443126);
      font-size: 9.5px;
      font-weight: 750;
      letter-spacing: .15em;
      line-height: 1.3;
      text-transform: uppercase;
    }
    .zs-product-benefits__rule {
      flex: 1;
      height: 1px;
      min-width: 8px;
      background: linear-gradient(to right,rgba(110,76,54,.35),rgba(110,76,54,.08));
    }
    .zs-product-benefits__grid {
      display: grid !important;
      grid-template-columns: repeat(2,minmax(0,1fr)) !important;
      grid-template-rows: repeat(2,max-content) !important;
      grid-auto-rows: max-content !important;
      align-content: start !important;
      align-items: stretch !important;
      gap: 8px !important;
      width: 100%;
      min-width: 0;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
    }
    .zs-product-benefits__item,
    .zs-product-benefits__item--delivery,
    .zs-product-benefits__item--craft,
    .zs-product-benefits__item--support {
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: stretch !important;
      align-self: stretch !important;
      gap: 0 !important;
      position: relative;
      overflow: hidden;
      box-sizing: border-box;
      width: 100%;
      min-width: 0;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 11px 12px 12px !important;
      border: 1px solid #e3d5c6 !important;
      border-radius: 9px !important;
      background: linear-gradient(145deg,#fbf6ef,#f3e9dd) !important;
      box-shadow: 0 2px 8px rgba(59,40,25,.045) !important;
      color: #443126 !important;
      text-align: start;
    }
    .zs-product-benefits__top {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 6px;
      margin-block-end: 6px;
    }
    .zs-product-benefits__icon-frame,
    .zs-product-benefits__item--delivery .zs-product-benefits__icon-frame {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 29px;
      width: 29px;
      height: 29px;
      border: 1px solid rgba(105,73,49,.09);
      border-radius: 8px;
      background: #ebdfd1 !important;
      color: #684833 !important;
    }
    .zs-product-benefits__icon { width: 18px; height: 18px; }
    .zs-product-benefits__copy {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 2px;
      min-width: 0;
      height: auto !important;
      min-height: 0 !important;
      line-height: 1.33;
      overflow-wrap: break-word;
    }
    .zs-product-benefits__title {
      color: #443126 !important;
      font-size: 12.5px;
      font-weight: 700;
      line-height: 1.35;
    }
    .zs-product-benefits__detail {
      color: #65584e !important;
      font-size: 11.5px;
      font-weight: 400;
      line-height: 1.4;
      opacity: 1;
    }
    .zs-product-benefits__date {
      color: #443126 !important;
      font-family: var(--font-heading--family,Georgia,serif);
      font-size: 17px;
      font-weight: 700;
      line-height: 1.16;
      letter-spacing: -.015em;
      opacity: 1;
    }
    .zs-product-benefits__link {
      display: inline;
      color: #5d3e2c !important;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      white-space: normal;
    }
    .zs-product-benefits__link:hover { text-decoration-thickness: 2px; }
    .zs-product-benefits__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
    @media(max-width:749px) {
      .product-information .product-details .zs-product-benefits { margin: 5px 0 10px !important; }
      .zs-product-benefits__heading { margin-block-end: 8px; font-size: 9px; }
      .zs-product-benefits__grid { gap: 7px !important; }
      .zs-product-benefits__item,
      .zs-product-benefits__item--delivery,
      .zs-product-benefits__item--craft,
      .zs-product-benefits__item--support {
        min-height: 0 !important;
        padding: 10px !important;
      }
      .zs-product-benefits__top { margin-block-end: 5px; }
      .zs-product-benefits__icon-frame,
      .zs-product-benefits__item--delivery .zs-product-benefits__icon-frame {
        flex-basis: 27px;
        width: 27px;
        height: 27px;
        border-radius: 7px;
      }
      .zs-product-benefits__icon { width: 17px; height: 17px; }
      .zs-product-benefits__title { font-size: 11.75px; }
      .zs-product-benefits__detail { font-size: 11px; }
      .zs-product-benefits__date { font-size: 15.5px; }
    }
    @media(max-width:340px) {
      .zs-product-benefits__grid {
        grid-template-columns: minmax(0,1fr) !important;
        grid-template-rows: auto !important;
      }
    }
  </style>
  <script>
    (function () {
      function updateDeliveryDates() {
        document.querySelectorAll('[data-zs-delivery-estimate]').forEach(function (root) {
          var target = root.querySelector('[data-zs-delivery-dates]');
          if (!target) return;
          var low = Number(root.dataset.minDays), high = Number(root.dataset.maxDays);
          if (!Number.isInteger(low) || !Number.isInteger(high)) return;
          var today = new Date();
          var early = new Date(today.getFullYear(), today.getMonth(), today.getDate() + low, 12);
          var late = new Date(today.getFullYear(), today.getMonth(), today.getDate() + high, 12);
          var locale = root.dataset.locale || 'en';
          try {
            var formatter = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' });
            target.textContent = formatter.format(early) + ' – ' + formatter.format(late);
          } catch (error) {
            // Keep the server-rendered estimate when Intl is unavailable.
          }
        });
      }
      updateDeliveryDates();
      document.addEventListener('shopify:section:load', updateDeliveryDates);
    })();
  </script>
{% endif %}
