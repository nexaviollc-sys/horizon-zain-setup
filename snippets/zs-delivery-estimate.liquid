{% comment %}
  ZAISEN Promise badges above add-to-cart. Delivery dates deliberately omitted.
{% endcomment %}
{% liquid
  assign zs_country = localization.country.iso_code | upcase
  assign zs_supported = false
  assign zs_shipping_threshold_usd = 0
  assign zs_country_short = localization.country.name
  case zs_country
    when 'GB', 'US', 'DE', 'FR', 'AE'
      assign zs_supported = true
      assign zs_shipping_threshold_usd = 60
    when 'CA', 'AU'
      assign zs_supported = true
      assign zs_shipping_threshold_usd = 100
  endcase
  case zs_country
    when 'GB'
      assign zs_country_short = 'UK'
    when 'US'
      assign zs_country_short = 'USA'
    when 'AE'
      assign zs_country_short = 'UAE'
  endcase
  assign zs_language = request.locale.iso_code | slice: 0, 2
%}
{% if zs_supported %}
  {% capture zs_refunds %}
    {% case zs_language %}
      {% when 'de' %}14 Tage Rückgabe & Erstattung
      {% when 'fr' %}Retours et remboursements sous 14 jours
      {% when 'ar' %}إرجاع واسترداد خلال 14 يومًا
      {% else %}14-Day Returns & Refunds
    {% endcase %}
  {% endcapture %}
  {% capture zs_refunds_detail %}
    {% case zs_language %}
      {% when 'de' %}Ab dem Tag der Zustellung
      {% when 'fr' %}À compter de la livraison
      {% when 'ar' %}تبدأ المدة عند استلام طلبك
      {% else %}Starting the day your order arrives
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft %}
    {% case zs_language %}
      {% when 'de' %}Von Hand aus echtem Holz gefertigt
      {% when 'fr' %}Fabriqué à la main en bois véritable
      {% when 'ar' %}مصنوع يدويًا من الخشب الطبيعي
      {% else %}Handcrafted From Real Wood
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft_detail %}
    {% case zs_language %}
      {% when 'de' %}Mit Liebe von unseren Händen gefertigt
      {% when 'fr' %}Créé à la main avec soin
      {% when 'ar' %}صنعناه بأيدينا وبكل عناية
      {% else %}Made by our hands, with care
    {% endcase %}
  {% endcapture %}
  {% capture zs_shipping_country %}
    {% case zs_language %}
      {% when 'de' %}Kostenloser Versand nach {{ localization.country.name | escape }} ab &#36;{{ zs_shipping_threshold_usd }} USD. Endgültige Versandkosten an der Kasse.
      {% when 'fr' %}Livraison gratuite vers {{ localization.country.name | escape }} dès &#36;{{ zs_shipping_threshold_usd }} USD. Frais définitifs à la caisse.
      {% when 'ar' %}الشحن المجاني إلى {{ localization.country.name | escape }} للطلبات المؤهلة من &#36;{{ zs_shipping_threshold_usd }} دولار أمريكي. يتم تأكيد الشحن عند الدفع.
      {% else %}Free shipping to {{ localization.country.name | escape }} on eligible orders of &#36;{{ zs_shipping_threshold_usd }} USD or more. Final shipping confirmed at checkout.
    {% endcase %}
  {% endcapture %}
  {% capture zs_support %}
    {% case zs_language %}
      {% when 'de' %}Wir helfen gern
      {% when 'fr' %}Nous sommes là pour vous
      {% when 'ar' %}نحن هنا للمساعدة
      {% else %}Here to Help
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_prompt %}
    {% case zs_language %}
      {% when 'de' %}Noch Fragen?
      {% when 'fr' %}Une question ?
      {% when 'ar' %}هل لديك أي استفسار؟
      {% else %}Have a question?
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_link %}
    {% case zs_language %}
      {% when 'de' %}ZAISEN kontaktieren
      {% when 'fr' %}Contacter ZAISEN
      {% when 'ar' %}تواصل مع ZAISEN
      {% else %}Contact ZAISEN
    {% endcase %}
  {% endcapture %}
  {% capture zs_promise %}
    {% case zs_language %}
      {% when 'de' %}Das ZAISEN Versprechen
      {% when 'fr' %}La promesse ZAISEN
      {% when 'ar' %}وعد زايسن
      {% else %}THE ZAISEN PROMISE
    {% endcase %}
  {% endcapture %}

  {% comment %}
    Short, translated labels keep the Promise compact while retaining the
    original translated delivery, refund, craft and support details for screen readers.
  {% endcomment %}
  {% capture zs_free_shipping_short %}
    {% case zs_language %}
      {% when 'de' %}Gratis ab &#36;{{ zs_shipping_threshold_usd }}
      {% when 'fr' %}Livraison dès &#36;{{ zs_shipping_threshold_usd }}
      {% when 'ar' %}شحن مجاني من &#36;{{ zs_shipping_threshold_usd }}
      {% else %}Free Shipping &#36;{{ zs_shipping_threshold_usd }}+
    {% endcase %}
  {% endcapture %}
  {% capture zs_shipping_sub %}
    {% case zs_language %}
      {% when 'de' %}Nach {{ zs_country_short | escape }} · ab Mindestwert
      {% when 'fr' %}Vers {{ zs_country_short | escape }} · commande éligible
      {% when 'ar' %}إلى {{ zs_country_short | escape }} · للطلبات المؤهلة
      {% else %}To {{ zs_country_short | escape }} · eligible orders
    {% endcase %}
  {% endcapture %}
  {% capture zs_returns_short %}
    {% case zs_language %}
      {% when 'de' %}14 Tage Rückgabe
      {% when 'fr' %}Retours sous 14 jours
      {% when 'ar' %}إرجاع خلال 14 يومًا
      {% else %}14-Day Returns
    {% endcase %}
  {% endcapture %}
  {% capture zs_returns_sub %}
    {% case zs_language %}
      {% when 'de' %}Hilfe bei Schäden oder Fehlern
      {% when 'fr' %}Aide si abîmé ou non conforme
      {% when 'ar' %}استرداد للضرر أو عدم المطابقة
      {% else %}Refunds if damaged or not as shown
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft_short %}
    {% case zs_language %}
      {% when 'de' %}Handarbeit aus Holz
      {% when 'fr' %}Bois fait main
      {% when 'ar' %}خشب مصنوع يدويًا
      {% else %}Handcrafted Wood
    {% endcase %}
  {% endcapture %}
  {% capture zs_craft_sub %}
    {% case zs_language %}
      {% when 'de' %}Echtes Holz, mit Sorgfalt gefertigt
      {% when 'fr' %}Bois véritable, fait avec soin
      {% when 'ar' %}خشب حقيقي صُنع بعناية
      {% else %}Real wood, crafted with care
    {% endcase %}
  {% endcapture %}
  {% capture zs_support_short %}
    {% case zs_language %}
      {% when 'de' %}Kundenservice
      {% when 'fr' %}Service client
      {% when 'ar' %}دعم العملاء
      {% else %}Customer Support
    {% endcase %}
  {% endcapture %}

  {% capture zs_support_sub %}
    {% case zs_language %}
      {% when 'de' %}Wir helfen dir gerne
      {% when 'fr' %}Toujours là pour vous
      {% when 'ar' %}نحن هنا لمساعدتك
      {% else %}Questions? We're here to help
    {% endcase %}
  {% endcapture %}

  <div class="zs-delivery-estimate zs-product-benefits"
    dir="{% if zs_language == 'ar' %}rtl{% else %}ltr{% endif %}"
    aria-label="{% if zs_language == 'de' %}Produktvorteile{% elsif zs_language == 'fr' %}Avantages du produit{% elsif zs_language == 'ar' %}مزايا المنتج{% else %}Product benefits{% endif %}">
    <div class="zs-product-benefits__heading">
      <span>{{ zs_promise | strip }}</span>
      <span class="zs-product-benefits__rule" aria-hidden="true"></span>
    </div>
    <div class="zs-product-benefits__grid">
      <div class="zs-product-benefits__item zs-product-benefits__item--delivery">
        <span class="zs-product-benefits__icon-frame" aria-hidden="true">
          <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h11v11H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="18" cy="17.5" r="2"/>
          </svg>
        </span>
        <span class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_free_shipping_short | strip }}</span>
          <span class="zs-product-benefits__subtitle">{{ zs_shipping_sub | strip }}</span>
          <span class="zs-product-benefits__sr-only">{{ zs_shipping_country | strip }}</span>
        </span>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--refund">
        <span class="zs-product-benefits__icon-frame" aria-hidden="true">
          <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10a9 9 0 1 1 2.5 6.3"/><path d="M3 4v6h6"/>
          </svg>
        </span>
        <span class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_returns_short | strip }}</span>
          <span class="zs-product-benefits__subtitle">{{ zs_returns_sub | strip }}</span>
          <span class="zs-product-benefits__sr-only">{{ zs_refunds | strip }}. {{ zs_refunds_detail | strip }}</span>
        </span>
      </div>

      <div class="zs-product-benefits__item zs-product-benefits__item--craft">
        <span class="zs-product-benefits__icon-frame" aria-hidden="true">
          <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 4c-8 0-14 4-14 11a5 5 0 0 0 5 5c7 0 11-6 9-16Z"/><path d="M4 21c2-5 5-8 11-12"/>
          </svg>
        </span>
        <span class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_craft_short | strip }}</span>
          <span class="zs-product-benefits__subtitle">{{ zs_craft_sub | strip }}</span>
          <span class="zs-product-benefits__sr-only">{{ zs_craft | strip }}. {{ zs_craft_detail | strip }}</span>
        </span>
      </div>

      <a class="zs-product-benefits__item zs-product-benefits__item--support" href="{{ routes.root_url }}pages/contact">
        <span class="zs-product-benefits__icon-frame" aria-hidden="true">
          <svg class="zs-product-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 14v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="13" width="4" height="7" rx="2"/><rect x="17" y="13" width="4" height="7" rx="2"/><path d="M19 20a5 5 0 0 1-5 2h-2"/>
          </svg>
        </span>
        <span class="zs-product-benefits__copy">
          <span class="zs-product-benefits__title">{{ zs_support_short | strip }}</span>
          <span class="zs-product-benefits__subtitle">{{ zs_support_sub | strip }}</span>
          <span class="zs-product-benefits__sr-only">{{ zs_support | strip }}. {{ zs_support_prompt | strip }} {{ zs_support_link | strip }}</span>
        </span>
      </a>
    </div>
  </div>

  <style>
    /* Ultra-compact ZAISEN Promise, scoped to the main product information. */
    .product-information .product-details .zs-product-benefits {
      display: block !important;
      flex: none !important;
      align-self: stretch !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100%;
      height: auto !important;
      min-height: 0 !important;
      margin: 0 0 5px !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      color: var(--zs-text, #322b26);
      text-align: start;
      font-family: var(--font-body--family, inherit);
    }
    .product-information .zs-product-benefits__heading {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 6px;
      color: var(--zs-walnut, #443126);
      font-size: 9.5px;
      font-weight: 750;
      line-height: 1.25;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .product-information .zs-product-benefits__rule {
      flex: 1;
      min-width: 8px;
      height: 1px;
      background: linear-gradient(to right, rgba(110,76,54,.32), rgba(110,76,54,.07));
    }
    .product-information .zs-product-benefits__grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      grid-template-rows: auto !important;
      grid-auto-rows: auto !important;
      align-items: stretch !important;
      gap: 6px !important;
      width: 100%;
      min-width: 0;
      height: auto !important;
      min-height: 0 !important;
    }
    .product-information .zs-product-benefits__item {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 7px !important;
      box-sizing: border-box;
      min-width: 0;
      width: 100%;
      height: auto !important;
      min-height: 44px !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 5px 8px !important;
      border: 1px solid #e8dcd0 !important;
      border-radius: 7px !important;
      background: #f8f3ed !important;
      color: #443126 !important;
      text-align: start;
      text-decoration: none !important;
      box-shadow: none !important;
    }
    .product-information .zs-product-benefits__icon-frame {
      display: flex !important;
      flex: 0 0 23px !important;
      align-items: center;
      justify-content: center;
      width: 23px !important;
      height: 23px !important;
      border: 0;
      border-radius: 6px;
      background: #eee2d5 !important;
      color: #684833 !important;
    }
    .product-information .zs-product-benefits__icon {
      display: block;
      width: 15px !important;
      height: 15px !important;
    }
    .product-information .zs-product-benefits__copy {
      display: flex !important;
      flex: 1 1 auto;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: center !important;
      gap: 2px !important;
      min-width: 0;
      width: auto !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      line-height: 1.2;
    }
    .product-information .zs-product-benefits__title {
      display: block;
      margin: 0;
      color: #443126 !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      line-height: 1.2 !important;
      letter-spacing: 0;
      overflow-wrap: break-word;
    }
    .product-information .zs-product-benefits__subtitle {
      display: block;
      width: 100%;
      min-width: 0;
      margin: 0;
      color: #806d5d !important;
      font-size: 9.2px !important;
      font-weight: 500 !important;
      line-height: 1.15 !important;
      letter-spacing: 0;
      white-space: normal;
      overflow-wrap: break-word;
    }
    .product-information .zs-product-benefits__sr-only {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0,0,0,0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }
    .product-information a.zs-product-benefits__item--support:hover {
      border-color: #bda28c !important;
      background: #f4eadf !important;
    }
    .product-information a.zs-product-benefits__item--support:focus-visible {
      outline: 2px solid #684833;
      outline-offset: 2px;
    }
    @media (max-width: 749px) {
      .product-information .zs-product-benefits__heading { margin-bottom: 5px; font-size: 9px; }
      .product-information .zs-product-benefits__grid { gap: 5px !important; }
      .product-information .zs-product-benefits__item {
        gap: 6px !important;
        padding: 5px 6px !important;
        min-height: 43px !important;
      }
      .product-information .zs-product-benefits__icon-frame {
        flex-basis: 21px !important;
        width: 21px !important;
        height: 21px !important;
      }
      .product-information .zs-product-benefits__icon { width: 14px !important; height: 14px !important; }
      .product-information .zs-product-benefits__title { font-size: 10.3px !important; }
      .product-information .zs-product-benefits__subtitle { font-size: 8.8px !important; line-height: 1.14 !important; }
    }
    @media (max-width: 340px) {
      .product-information .zs-product-benefits__grid {
        grid-template-columns: minmax(0, 1fr) !important;
      }
    }
  </style>
{% endif %}
