{% comment %}
  ZAISEN — estimated delivery above add-to-cart.
  Mirrors shipping ranges configured Oct 22 2026: GB 4–5 days; US, DE, FR, CA, AU, AE, SA 7–9 days.
  Plus one calendar day for order processing. Review if Shopify shipping rates change.
  Delivery dates are estimates, not guaranteed arrival dates.
{% endcomment %}
{% liquid
  assign zs_country = localization.country.iso_code | upcase
  assign zs_shipping_min = 7
  assign zs_shipping_max = 9
  assign zs_supported = false
  case zs_country
    when 'GB'
      assign zs_shipping_min = 4
      assign zs_shipping_max = 5
      assign zs_supported = true
    when 'US', 'DE', 'FR', 'CA', 'AU', 'AE', 'SA'
      assign zs_supported = true
  endcase
  assign zs_arrival_min = zs_shipping_min | plus: 1
  assign zs_arrival_max = zs_shipping_max | plus: 1
  assign zs_language = request.locale.iso_code | slice: 0, 2
%}
{% if zs_supported %}
  {% capture zs_heading %}
    {% case zs_language %}
      {% when 'de' %}Heute bestellen · Voraussichtliche Lieferung
      {% when 'fr' %}Commandez aujourd’hui · Livraison estimée
      {% when 'ar' %}اطلب اليوم · التسليم المتوقع
      {% else %}Order today · Estimated delivery
    {% endcase %}
  {% endcapture %}
  {% capture zs_subline %}
    {% case zs_language %}
      {% when 'de' %}1 Tag Bearbeitungszeit · Kostenloser Versand
      {% when 'fr' %}1 jour de préparation · Livraison gratuite
      {% when 'ar' %}يوم واحد لتجهيز الطلب · شحن مجاني
      {% else %}1 day order processing · Free shipping
    {% endcase %}
  {% endcapture %}
  {% capture zs_tracking %}
    {% case zs_language %}
      {% when 'de' %}Sendungsnummer wird nach dem Versand bereitgestellt
      {% when 'fr' %}Numéro de suivi fourni après l’expédition
      {% when 'ar' %}سيتم توفير رقم التتبع بعد الشحن
      {% else %}Tracking number provided after dispatch
    {% endcase %}
  {% endcapture %}
  {% capture zs_days %}
    {% case zs_language %}
      {% when 'de' %}Tage
      {% when 'fr' %}jours
      {% when 'ar' %}أيام
      {% else %}days
    {% endcase %}
  {% endcapture %}

  <div class="zs-delivery-estimate"
    data-zs-delivery-estimate
    data-min-days="{{ zs_arrival_min }}"
    data-max-days="{{ zs_arrival_max }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    dir="{% if zs_language == 'ar' %}rtl{% else %}ltr{% endif %}">
    <div class="zs-delivery-estimate__primary">
      <svg class="zs-delivery-estimate__truck" aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>
      </svg>
      <div class="zs-delivery-estimate__body">
        <span class="zs-delivery-estimate__label">{{ zs_heading | strip }}</span>
        <strong class="zs-delivery-estimate__dates" data-zs-delivery-dates>{{ zs_arrival_min }}–{{ zs_arrival_max }} {{ zs_days | strip }}</strong>
      </div>
    </div>
    <div class="zs-delivery-estimate__details">
      <span class="zs-delivery-estimate__processing">{{ zs_subline | strip }}</span>
      <span class="zs-delivery-estimate__tracking">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg>
        <span>{{ zs_tracking | strip }}</span>
      </span>
    </div>
  </div>
  <style>
    /* Slim editorial delivery strip, scoped to the product purchase area. */
    .product-form-buttons > .zs-delivery-estimate,
    .product-form-buttons--stacked > .zs-delivery-estimate {
      display:block;
      flex:0 0 100% !important;
      width:100% !important;
      min-width:0 !important;
      max-width:100%;
      box-sizing:border-box;
      margin:4px 0 1px;
      padding:12px 0 4px;
      border:0;
      border-top:1px solid var(--zs-border, rgba(68,49,38,.17));
      border-radius:0;
      background:transparent;
      color:inherit;
      font-family:var(--font-body--family,inherit);
      text-align:start;
    }
    .zs-delivery-estimate__primary{
      display:flex;align-items:center;gap:10px;min-width:0;
      color:var(--zs-text,inherit);
      font-size:13px;line-height:1.45;
    }
    .zs-delivery-estimate__truck{flex:0 0 19px;opacity:.85}
    .zs-delivery-estimate__body{
      display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 6px;min-width:0;
    }
    .zs-delivery-estimate__label{font-size:13px;font-weight:450;color:inherit}
    .zs-delivery-estimate__dates{font-size:14px;font-weight:700;white-space:normal;color:inherit;letter-spacing:0}
    .zs-delivery-estimate__details{
      display:flex;align-items:center;flex-wrap:wrap;column-gap:13px;row-gap:3px;
      margin-block-start:5px;padding-inline-start:29px;
      font-size:11.5px;line-height:1.5;color:inherit;opacity:.75;
    }
    .zs-delivery-estimate__tracking{display:inline-flex;align-items:center;gap:5px;min-width:0}
    .zs-delivery-estimate__tracking svg{flex:0 0 13px}
    @media(max-width:749px){
      .product-form-buttons > .zs-delivery-estimate,
      .product-form-buttons--stacked > .zs-delivery-estimate{padding-block:10px 3px;margin-block:3px 0}
      .zs-delivery-estimate__label{font-size:12px}
      .zs-delivery-estimate__dates{font-size:13px}
      .zs-delivery-estimate__details{font-size:11px;column-gap:10px}
    }
  </style>
  <script>
    (function () {
      function updateDeliveryDates() {
        document.querySelectorAll('[data-zs-delivery-estimate]').forEach(function (root) {
          var target = root.querySelector('[data-zs-delivery-dates]');
          if (!target) return;
          var low = Number(root.dataset.minDays), high = Number(root.dataset.maxDays);
          if (!Number.isInteger(low) || !Number.isInteger(high)) return;
          var today = new Date();
          var early = new Date(today.getFullYear(), today.getMonth(), today.getDate() + low, 12);
          var late = new Date(today.getFullYear(), today.getMonth(), today.getDate() + high, 12);
          var locale = root.dataset.locale || 'en';
          try {
            var formatter = new Intl.DateTimeFormat(locale, { day:'numeric', month:'short' });
            target.textContent = formatter.format(early) + ' – ' + formatter.format(late);
          } catch (error) {
            // Keep the server-rendered day range if Intl is unavailable.
          }
        });
      }
      updateDeliveryDates();
      document.addEventListener('shopify:section:load', updateDeliveryDates);
    })();
  </script>
{% endif %}
