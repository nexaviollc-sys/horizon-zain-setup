{% comment %}
  ZAISEN product details within the right-side purchase column, after
  the recommended products block. The original Shopify product description
  is the source for the first accordion; the remaining accordions use
  independent, per-product rich-text metafields.
{% endcomment %}
{% if product != blank %}
  {% assign zs_specs = product.metafields.custom.product_specifications %}
  {% assign zs_materials = product.metafields.custom.materials_care %}
  {% assign zs_shipping = product.metafields.custom.shipping_returns %}

  {% assign zs_has_description = false %}
  {% assign zs_has_specs = false %}
  {% assign zs_has_materials = false %}
  {% assign zs_has_shipping = false %}

  {% if product.description != blank %}
    {% assign zs_has_description = true %}
  {% endif %}
  {% if zs_specs != blank and zs_specs.value != blank %}
    {% assign zs_has_specs = true %}
  {% endif %}
  {% if zs_materials != blank and zs_materials.value != blank %}
    {% assign zs_has_materials = true %}
  {% endif %}
  {% if zs_shipping != blank and zs_shipping.value != blank %}
    {% assign zs_has_shipping = true %}
  {% endif %}

  {% if zs_has_description or zs_has_specs or zs_has_materials or zs_has_shipping %}
    <section class="zs-detail-accordions" aria-label="Product details">
      <div class="zs-detail-accordions__inner">
        {% if zs_has_description %}
          <details class="zs-detail-accordions__item" name="zs-details-{{ section_id }}">
            <summary class="zs-detail-accordions__heading">
              <span>Description &amp; Features</span>
              <span class="zs-detail-accordions__icon" aria-hidden="true"></span>
            </summary>
            <div class="zs-detail-accordions__content rte">{{ product.description }}</div>
          </details>
        {% endif %}
        {% if zs_has_specs %}
          <details class="zs-detail-accordions__item" name="zs-details-{{ section_id }}">
            <summary class="zs-detail-accordions__heading">
              <span>Dimensions &amp; Specifications</span>
              <span class="zs-detail-accordions__icon" aria-hidden="true"></span>
            </summary>
            <div class="zs-detail-accordions__content rte">{{ zs_specs | metafield_tag }}</div>
          </details>
        {% endif %}
        {% if zs_has_materials %}
          <details class="zs-detail-accordions__item" name="zs-details-{{ section_id }}">
            <summary class="zs-detail-accordions__heading">
              <span>Materials &amp; Care</span>
              <span class="zs-detail-accordions__icon" aria-hidden="true"></span>
            </summary>
            <div class="zs-detail-accordions__content rte">{{ zs_materials | metafield_tag }}</div>
          </details>
        {% endif %}
        {% if zs_has_shipping %}
          <details class="zs-detail-accordions__item" name="zs-details-{{ section_id }}">
            <summary class="zs-detail-accordions__heading">
              <span>Shipping &amp; Returns</span>
              <span class="zs-detail-accordions__icon" aria-hidden="true"></span>
            </summary>
            <div class="zs-detail-accordions__content rte">{{ zs_shipping | metafield_tag }}</div>
          </details>
        {% endif %}
      </div>
    </section>
  {% endif %}
{% endif %}
