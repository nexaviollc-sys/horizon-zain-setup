{% doc %}
  Applies the ZAISEN visual finish to the native Horizon header.
{% enddoc %}

{% stylesheet %}
  .header.header--zaisen {
    --zs-header-line: color-mix(in srgb, var(--zs-header-accent) 26%, transparent);
    --zs-header-shadow: 84 60 32;
    --header-padding: 14px;
  }

  .header.header--zaisen.header--compact {
    --header-padding: 6px;
  }

  .header--zaisen:not(.header--compact) .header__row--bottom {
    --header-padding: 10px;
  }

  .header--zaisen:not([transparent]) .header__underlay-closed,
  .header--zaisen[transparent='not-sticky'][data-sticky-state='active'] .header__underlay-closed {
    box-shadow: 0 5px 20px rgb(var(--zs-header-shadow) / 0.045), inset 0 1px 0 rgb(255 255 255 / 0.65);
  }

  .header--zaisen[data-sticky-state='active'] .header__underlay-closed {
    box-shadow: 0 10px 30px rgb(var(--zs-header-shadow) / 0.09), inset 0 1px 0 rgb(255 255 255 / 0.65);
  }

  .header--zaisen .header__underlay-closed::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--zs-header-accent) 7%, transparent), transparent 65%);
  }

  .header--zaisen .header__underlay-open {
    border-radius: 0 0 20px 20px;
  }

  .header--zaisen .header__underlay-open::after {
    border-radius: inherit;
    box-shadow: 0 18px 40px rgb(var(--zs-header-shadow) / 0.12);
  }

  .header--zaisen .header-logo {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .header--zaisen .header-logo > span,
  .header--zaisen .header-logo__image {
    max-inline-size: 100%;
  }

  .header--zaisen .header-logo:not(:has(img)) {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.12em;
    line-height: 1.1;
  }

  .header--zaisen .menu-list__link {
    min-block-size: 44px;
    letter-spacing: 0.025em;
  }

  .header--zaisen .menu-list__link-title {
    position: relative;
  }

  .header--zaisen .menu-list__link-title::after {
    content: '';
    position: absolute;
    inset-inline: var(--gap-sm);
    inset-block-end: -7px;
    block-size: 1px;
    background: var(--zs-header-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
    pointer-events: none;
  }

  .header--zaisen .menu-list__link:is(:hover, :focus-visible, [aria-current='page']) .menu-list__link-title::after,
  .header--zaisen .menu-list__trigger:has([aria-expanded='true']) .menu-list__link-title::after {
    transform: scaleX(1);
  }

  .header--zaisen [slot='overflow'] .menu-list__link-title::after {
    inset-inline: 0;
  }

  .header--zaisen .menu-list__submenu-inner {
    border-block-start: 1px solid var(--zs-header-line);
  }

  .header--zaisen :is(.header-actions__action, .header__icon--menu) {
    min-inline-size: 44px;
    min-block-size: 44px;
    border-radius: 999px;
  }

  .header--zaisen .header-actions__action:not(.dropdown-localization__button) {
    background: transparent;
    box-shadow: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .header--zaisen .header-actions__action.header-actions__text-style {
    padding-inline: 16px;
  }

  .header--zaisen .dropdown-localization__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: max-content;
    min-width: 0;
    height: 39px;
    min-height: 39px;
    padding: 0 12px;
    margin-inline: 0;
    border: 1px solid var(--zs-header-line);
    border-radius: 12px;
    background: transparent;
    letter-spacing: 0.015em;
    line-height: 1;
    font-size: 12px;
    white-space: nowrap;
  }

  .header--zaisen .dropdown-localization__button .icon-flag {
    display: inline-block;
    flex: 0 0 22px;
    width: 22px;
    height: 16px;
    margin-inline-end: 0;
    border-radius: 3px;
    clip-path: none;
    background-position: center;
    background-size: cover;
  }

  .header--zaisen .dropdown-localization__button .icon-flag::after {
    border-radius: 3px;
  }

  .header--zaisen .dropdown-localization__button .svg-wrapper.icon-caret {
    width: 13px;
    height: 13px;
  }

  .header--zaisen .localization-wrapper {
    border-color: var(--zs-header-line);
    border-radius: 16px;
    box-shadow: 0 14px 36px rgb(var(--zs-header-shadow) / 0.14);
  }

  .header--zaisen .menu-drawer {
    border-inline-end: 1px solid var(--zs-header-line);
  }

  .header--zaisen .menu-drawer__menu-item--mainlist {
    letter-spacing: 0.015em;
  }

  .header--zaisen .menu-drawer__utility-links {
    border-block-start: 1px solid var(--zs-header-line);
  }

  .header--zaisen :is(a, button, summary):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* ZAISEN homepage transparent state: visually merge the header into the hero.
     Horizon's native not-sticky state restores the normal header automatically on scroll. */
  .header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header__underlay-closed {
    background: transparent !important;
    box-shadow: none !important;
  }

  .header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header__underlay-closed::before {
    opacity: 0;
  }

  .header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header__row--top {
    border-bottom-color: transparent !important;
  }

  .header--zaisen .header__underlay-closed,
  .header--zaisen .header__underlay-closed::before,
  .header--zaisen .header__row--top {
    transition:
      background-color 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      opacity 220ms ease;
  }

  @media screen and (min-width: 750px) {
    .header--zaisen[data-menu-style='menu'] :is(.header__columns, .header__column) {
      column-gap: clamp(16px, 2.2vw, 32px);
    }

    .header--zaisen[data-menu-style='menu'] .header__column--right {
      column-gap: 12px;
    }

    .header--zaisen[data-menu-style='menu'] :is(header-actions, .search-action) {
      margin-inline: 0;
    }

    .header--zaisen[data-menu-style='menu'] header-actions {
      gap: 8px;
    }

    .header--zaisen .menu-list__link-title {
      padding-inline: 12px;
    }

    .header--zaisen [slot='overflow'] .menu-list__link-title {
      padding-inline: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .header--zaisen .header-actions__action:not(.dropdown-localization__button):hover,
    .header--zaisen .header__icon--menu:hover {
      color: color-mix(in srgb, var(--zs-header-accent) 88%, var(--color-foreground));
      background-color: color-mix(in srgb, var(--zs-header-accent) 8%, transparent);
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--zs-header-accent) 28%, transparent),
        0 5px 14px rgb(var(--zs-header-shadow) / 0.07);
      transform: translateY(-1px);
    }

    .header--zaisen .dropdown-localization__button:hover {
      background-color: color-mix(in srgb, var(--zs-header-accent) 6%, transparent);
      border-color: color-mix(in srgb, var(--zs-header-accent) 72%, transparent);
    }
  }

  .header--zaisen .header-actions__action:not(.dropdown-localization__button):focus-visible,
  .header--zaisen .header__icon--menu:focus-visible {
    background-color: color-mix(in srgb, var(--zs-header-accent) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--zs-header-accent) 28%, transparent);
  }


  /* Mobile logo breathing room */
  @media screen and (max-width: 749px) {
    .header--zaisen .header__row--top {
      min-height: 88px;
    }

    .header--zaisen .header__columns {
      min-height: 88px;
      align-items: center;
    }

    .header--zaisen .header__column--center {
      padding-block: 6px;
    }

    .header--zaisen .header-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-block: 4px;
    }

    .header--zaisen .header-logo__image {
      display: block;
      width: auto;
      height: auto;
      max-height: 74px;
    }
  }

  /* ZAISEN individually spaced soft-rectangle navigation and dark-hero utility contrast.
     Scope styles to desktop Horizon menu; preserve native links and dropdown events. */
  @media screen and (min-width: 750px) {
    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__list-item:not([slot='overflow']):not([slot='more']) {
      margin-inline: 6px;
    }

    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__link-title {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 39px;
      padding: 8px 15px;
      border: 1px solid rgba(89, 62, 45, .46);
      border-radius: 12px;
      background: transparent;
      color: #34231B;
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: .005em;
      white-space: nowrap;
      box-shadow: none;
      transition: border-color .2s ease, color .2s ease;
    }

    #header-component.header--zaisen .header-menu .menu-list__link-title::after {
      content: none;
      display: none;
    }

    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__link:is(.menu-list__link--active, [aria-current='page']) .menu-list__link-title {
      background: transparent;
      border-color: #2B1D17;
      color: #2B1D17;
      font-weight: 700;
      box-shadow: inset 0 0 0 .35px #2B1D17;
    }

    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__link:is(:hover, :focus-visible) .menu-list__link-title,
    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__trigger:has(.menu-list__disclosure[aria-expanded='true']) .menu-list__link-title {
      background: transparent;
      border-color: #9A6A44;
      color: #2B1D17;
      box-shadow: none;
    }

    /* The last menu item crosses the brown portion of the homepage banner.
       Make its outline and label readable there without a filled capsule. */
    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4) .menu-list__link-title {
      color: #FFF8F0;
      border-color: rgba(255, 248, 240, .82);
    }
    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4):hover .menu-list__link-title,
    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4):focus-within .menu-list__link-title {
      color: #FFFFFF;
      border-color: #FFFFFF;
    }

    /* Keep the homepage's ivory-on-hero controls ONLY while flyouts are closed.
       Opening Category or Best Sellers reveals the white header; excluding
       open flyouts here prevents ivory search/account/cart icons from disappearing.
       These selectors do not affect their normal colors, size or click behavior. */
    /* Existing liquid navbar changes state on scroll; keep nontransparent
       and sticky header icons their original dark color. */
    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right {
      --color-account-icon: #FFF8F0;
    }

    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right :is(
      .dropdown-localization__button,
      .search-action .header-actions__action,
      header-actions .header-actions__action,
      .account-button
    ) {
      color: #FFF8F0 !important;
      --color-account-icon: #FFF8F0;
    }

    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right :is(
      .dropdown-localization__button,
      .search-action .header-actions__action,
      header-actions .header-actions__action
    ) svg {
      color: currentColor;
    }

    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right .dropdown-localization__button {
      border-color: rgba(255, 248, 240, .58);
      background-color: rgba(43, 29, 23, .28);
      box-shadow: none;
    }

    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right .dropdown-localization__button:is(:hover, :focus-visible) {
      color: #FFFFFF !important;
      border-color: #FFFFFF;
      background: rgba(255, 255, 255, .16);
    }

    #header-component.header--zaisen[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right :is(
      .search-action .header-actions__action,
      header-actions .header-actions__action,
      .account-button
    ):is(:hover, :focus-visible) {
      color: #FFFFFF !important;
      --color-account-icon: #FFFFFF;
      background-color: rgba(255, 255, 255, .14);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .4);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__list-item:not([slot='overflow']):not([slot='more']) {
      margin-inline: 4px;
    }
    #header-component.header--zaisen[data-menu-style='menu'] .header-menu .menu-list__link-title {
      padding-inline: 11px;
      min-height: 37px;
      border-radius: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header--zaisen .menu-list__link-title::after,
    .header--zaisen .header-menu .menu-list__link-title,
    .header--zaisen .header-actions__action:not(.dropdown-localization__button) {
      transition: none;
    }
  }

  /* ZAISEN header region picker: compact, editorial, fully native selection. */
  #header-component.header--zaisen dropdown-localization-component .localization-wrapper {
    width:min(324px,calc(100vw - 32px));
    max-width:calc(100vw - 32px);
    max-height:min(422px,calc(100dvh - 128px));
    padding:8px;
    border:1px solid #E5DACE;
    border-radius:16px;
    background:#FFFCF8;
    color:#34261F;
    box-shadow:0 16px 42px rgba(43,29,23,.17),0 3px 10px rgba(43,29,23,.05);
    overflow:hidden;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form {
    display:flex;flex-direction:column;max-height:inherit;min-height:0;
  }
  #header-component.header--zaisen dropdown-localization-component .country-selector-form__wrapper {
    flex:1 1 auto;min-height:0;overflow:hidden;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list {
    max-height:min(320px,calc(100dvh - 230px));
    overflow-y:auto;
    scrollbar-width:thin;
    scrollbar-color:#D7C8B7 transparent;
    padding:3px 2px 5px;
    font-size:13px;
    line-height:1.4;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list>ul {
    margin:0;padding:0;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item:not([hidden]) {
    display:flex;
    align-items:center;
    gap:9px;
    min-height:42px;
    margin:2px 0;
    padding:8px 10px;
    border:1px solid transparent;
    border-radius:9px;
    background:transparent;
    color:#34261F;
    font-size:13px;
    line-height:1.4;
    transition:background-color .2s ease,border-color .2s ease;
  }
  #header-component.header--zaisen dropdown-localization-component .zs-localization-country-flag {
    display:block;
    flex:0 0 22px;
    width:22px;
    height:16px;
    border:1px solid rgba(65,40,23,.1);
    border-radius:3px;
    background-position:center;
    background-size:cover;
    background-repeat:no-repeat;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item .country {
    min-width:0;flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;
    color:#34261F;font-size:13px;font-weight:400;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item .svg-wrapper.icon-checkmark {
    flex:0 0 14px;width:14px;color:#916B47;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item:is(:hover,:focus,[aria-selected='true']) {
    background:#F8F2EB;border-color:#E9DED2;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item[aria-current='true'] {
    background:#F3E9DD;border-color:#E6D4C0;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item[aria-current='true'] .country {
    color:#2B1D17;font-weight:600;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__list-item:focus-visible {
    outline:2px solid #B18A5F;outline-offset:-2px;
  }
  #header-component.header--zaisen dropdown-localization-component .localization-form__currency {
    flex:0 0 auto;font-size:10px;letter-spacing:.01em;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector.language-selector {
    min-height:52px;
    margin-top:7px;
    padding:9px 9px 2px;
    border-top:1px solid #E9DED1;
    background:#FFFCF8;
    box-shadow:none;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector--top-shadow::before {
    display:none;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector__label {
    color:#756455;font-size:12px;font-weight:500;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector .localization-form__select {
    min-height:34px;
    max-width:165px;
    padding:7px 29px 7px 12px;
    border:1px solid #EADCCB;
    border-radius:9px;
    background:#F8F2EB;
    color:#34261F;
    font-size:12px;
    font-weight:500;
    line-height:1.3;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector .localization-form__select:is(:hover,:focus-visible) {
    background:#F3E7D9;border-color:#B99A79;
  }
  #header-component.header--zaisen dropdown-localization-component .language-selector .svg-wrapper.icon-caret {
    inset-inline-end:20px;color:#76543D;
  }
  #header-component.header--zaisen dropdown-localization-component .country-filter {
    padding:5px 4px 8px;
  }
  #header-component.header--zaisen dropdown-localization-component .country-filter__input {
    height:38px;
    border:1px solid #DFD1C2;
    border-radius:9px;
    background:#FAF7F3;
    color:#34261F;
    font-size:12px;
  }
  @media(prefers-reduced-motion:reduce) {
    #header-component.header--zaisen dropdown-localization-component .localization-form__list-item:not([hidden]){transition:none}
  }

  /*
   * ZAISEN product-page transparent header.
   * The homepage overlaps dark hero imagery and deliberately has ivory utility
   * icons / a white fourth navigation link. Product galleries are light, so
   * keep those controls walnut while the native transparent header is idle.
   * Scroll-sticky and open-flyout states use the existing theme behavior.
   */
  #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right {
    --color-account-icon: #2B1D17;
  }
  #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right :is(
    .dropdown-localization__button,
    .search-action .header-actions__action,
    header-actions .header-actions__action,
    .account-button
  ) {
    color: #2B1D17 !important;
    --color-account-icon: #2B1D17;
  }
  #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right .dropdown-localization__button {
    background: rgba(247,243,238,.78);
    border-color: rgba(91,67,50,.35);
  }
  #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right .dropdown-localization__button:is(:hover,:focus-visible) {
    color: #2B1D17 !important;
    border-color: #9A6A44;
    background: rgba(238,226,211,.94);
  }
  #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']):not(:has(.zs-nav-flyout:not([inert]))) .header__column--right :is(
    .search-action .header-actions__action,
    header-actions .header-actions__action,
    .account-button
  ):is(:hover,:focus-visible) {
    color: #2B1D17 !important;
    --color-account-icon: #2B1D17;
    background: rgba(228,214,196,.42);
    box-shadow: inset 0 0 0 1px rgba(112,81,58,.25);
  }
  @media screen and (min-width: 750px) {
    #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__link-title {
      color: #2B1D17;
    }
    #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4) .menu-list__link-title,
    #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4):hover .menu-list__link-title,
    #header-component.header--zaisen.header--zaisen-product[transparent='not-sticky']:not([data-sticky-state='active']) .header-menu .menu-list__list-item:nth-child(4):focus-within .menu-list__link-title {
      color: #2B1D17;
      border-color: rgba(89,62,45,.46);
    }
  }

  /*
   * Product pages: reserve a clean breathing zone for the transparent header.
   * Horizon otherwise pulls the first section up by the whole header group,
   * then pulls .sticky-content up by the header height again. That leaves
   * the gallery and product details beneath the logo/navigation.
   *
   * Keep the header transparent, sticky behavior native, and all unrelated
   * pages untouched. Both the square media and product details start below it.
   */
  body:has(#header-component.header--zaisen-product[transparent])
    .content-for-layout > .shopify-section:first-child {
    margin-top: 0;
  }
  body:has(#header-component.header--zaisen-product[transparent])
    .content-for-layout > .shopify-section:first-child .product-information.section.spacing-style {
    --section-top-offset: calc(var(--header-height, 90px) + clamp(14px, 1.6vw, 24px));
  }
  body:has(#header-component.header--zaisen-product[transparent])
    .content-for-layout > .shopify-section:first-child .product-information media-gallery.sticky-content {
    margin-top: 0;
  }

  /* ZAISEN — Premium mobile drawer, native Shopify navigation kept intact.
     Design: layered walnut masthead, warm ivory menu cards, subtle physical
     depth, crisp controls. Scope all styling to the mobile drawer only. */
  @media screen and (max-width: 749px) {
    #header-component.header--zaisen header-drawer .menu-drawer {
      --color-background: #F8F4EE;
      --color-background-rgb: 248 244 238;
      --color-foreground: #2B1D17;
      --color-foreground-rgb: 43 29 23;
      --color-foreground-subdued: #604B3C;
      --color-foreground-muted: #705847;
      --color-border: #DED0C0;
      --menu-top-level-font-color: #2B1D17;
      --menu-top-level-font-color-rgb: 43 29 23;
      background: linear-gradient(166deg,#FCFAF6 0%,#F6F0E8 62%,#EEE3D5 100%) !important;
      border-inline-end: 1px solid #CBB49A;
      box-shadow: 16px 0 55px rgba(24,15,10,.32);
      color: #2B1D17;
      padding-block-end: max(16px,var(--safe-area-inset-bottom));
      -webkit-font-smoothing: antialiased;
    }

    #header-component.header--zaisen header-drawer .zs-drawer-brand {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      flex: 0 0 auto;
      min-height: 125px;
      margin-bottom: 13px;
      padding: 24px 68px 20px 25px;
      color: #FFF9F1;
      background:
        radial-gradient(ellipse at 7% 0%,rgba(216,181,106,.20),transparent 61%),
        linear-gradient(110deg,#533B2B 0%,#38271E 54%,#2B1D17 100%);
      border-bottom: 1px solid rgba(216,181,106,.34);
      box-shadow: inset 0 1px 0 rgba(255,246,227,.20),
                  0 8px 22px rgba(43,29,23,.13);
    }
    #header-component.header--zaisen header-drawer .zs-drawer-brand__name {
      font-family: var(--font-heading--family,Georgia,serif);
      font-size: 31px;
      font-weight: 550;
      line-height: 1.08;
      letter-spacing: .085em;
      color: #FFF9F1;
    }
    #header-component.header--zaisen header-drawer .zs-drawer-brand__tagline {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .19em;
      color: #E1C49B;
    }

    #header-component.header--zaisen header-drawer .menu-drawer > .menu-drawer__close-button {
      position: absolute;
      z-index: 3;
      top: calc(var(--safe-area-inset-top) + 25px);
      inset-inline-end: 20px;
      width: 42px;
      height: 42px;
      padding: 11px;
      display: grid;
      place-items: center;
      color: #F7F3EE;
      background: rgba(255,252,248,.10);
      border: 1px solid rgba(216,181,106,.43);
      border-radius: 12px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
    }
    #header-component.header--zaisen header-drawer .menu-drawer > .menu-drawer__close-button:is(:hover,:focus-visible) {
      color: #2B1D17;
      background: #F7F3EE;
    }

    #header-component.header--zaisen header-drawer .menu-drawer__navigation {
      padding: 4px 0 12px;
      flex: 0 0 auto;
      color: #2B1D17;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu {
      display: flex;
      flex-direction: column;
      gap: 11px;
      margin: 0;
      padding: 0 17px;
      list-style: none;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li {
      width: 100%;
      min-height: 0;
      margin: 0;
      border: 0;
      display: block;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li > a.menu-drawer__menu-item,
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li > details > summary.menu-drawer__menu-item,
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li > accordion-custom > details > summary.menu-drawer__menu-item {
      min-height: 58px;
      padding: 13px 16px 13px 18px;
      border-radius: 13px;
      border: 1px solid #DAC9B5;
      background: linear-gradient(162deg,#FFFFFF 0%,#F8F2E9 100%);
      box-shadow: inset 0 1px 0 #FFFFFF,
                  inset 0 -1px 0 rgba(145,109,77,.08),
                  0 3px 8px rgba(62,42,26,.075);
      color: #302118;
      --menu-top-level-font-color: #302118;
      font-size: 15px;
      font-weight: 650;
      letter-spacing: .005em;
      line-height: 1.35;
      transition: background .18s ease, border-color .18s ease, box-shadow .18s ease, color .18s ease;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li :is(a.menu-drawer__menu-item--mainlist,summary.menu-drawer__menu-item--mainlist):is(:hover,:focus-visible),
    #header-component.header--zaisen header-drawer .menu-drawer__navigation > .menu-drawer__menu > li > :is(details,accordion-custom) > details[open] > summary.menu-drawer__menu-item {
      color: #2B1D17;
      border-color: #BE9D72;
      background: linear-gradient(160deg,#FFF9EF,#F0E2CF);
      box-shadow: inset 0 1px 0 #FFFFFF,0 5px 13px rgba(88,56,32,.14);
    }

    #header-component.header--zaisen header-drawer .menu-drawer__menu-item--active,
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item[aria-current='page'] {
      border-color: #AC8557 !important;
      background: #F2E4D0 !important;
      color: #2B1D17 !important;
      box-shadow: inset 3px 0 0 #9E7145,0 3px 10px rgba(62,42,26,.09);
    }
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item-text {
      color: inherit;
      white-space: normal;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item > .svg-wrapper,
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item .icon-plus,
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item .icon-caret {
      flex: 0 0 32px;
      width: 32px;
      height: 32px;
      padding: 8px;
      margin: 0 0 0 8px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      color: #77523A;
      background: #F0E1CD;
      border: 1px solid rgba(161,119,79,.24);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.76);
    }
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item > .svg-wrapper svg {
      width: 16px;
      height: 16px;
    }

    /* Accordions: clearly separated inset links, not a long flat list. */
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--childlist,
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--grandchildlist {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 10px 7px 8px 14px;
      margin: 0 0 4px;
      border: 0;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--childlist > li,
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--grandchildlist > li {
      flex: 0 0 auto;
      min-height: 0;
      width: 100%;
      margin: 0;
      padding: 0;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--childlist .menu-drawer__menu-item,
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--grandchildlist .menu-drawer__menu-item {
      min-height: 45px;
      padding: 11px 13px;
      border-radius: 9px;
      border: 1px solid transparent;
      background: rgba(255,255,255,.57);
      color: #413024;
      font-size: 13px;
      font-weight: 550;
      line-height: 1.35;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--childlist .menu-drawer__menu-item:is(:hover,:focus-visible),
    #header-component.header--zaisen header-drawer .menu-drawer__navigation .menu-drawer__menu--grandchildlist .menu-drawer__menu-item:is(:hover,:focus-visible) {
      color: #2B1D17;
      background: #EEE0CE;
      border-color: #CFB69A;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
    }

    /* Native three-level submenu stays functional and gets the same palette. */
    #header-component.header--zaisen header-drawer .menu-drawer__submenu {
      --color-foreground: #2B1D17;
      --color-foreground-rgb: 43 29 23;
      --color-background: #F8F4EE;
      background: linear-gradient(164deg,#FCFAF6,#F1E6D9);
      color: #2B1D17;
      box-shadow: inset 5px 0 16px rgba(64,42,26,.05);
    }
    #header-component.header--zaisen header-drawer .menu-drawer__nav-buttons {
      min-height: 77px;
      background: linear-gradient(110deg,#533B2B,#2B1D17);
      border-bottom: 1px solid rgba(216,181,106,.34);
      box-shadow: 0 6px 18px rgba(53,34,23,.12);
      color: #F7F3EE;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__nav-buttons .menu-drawer__title {
      color: #F7F3EE;
      font-size: 15px;
      font-weight: 650;
      line-height: 1.35;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__nav-buttons :is(.menu-drawer__back-button,.menu-drawer__close-button) {
      color: #F7F3EE;
      background: transparent;
      border: 0;
      min-width: 46px;
      min-height: 46px;
      border-radius: 10px;
      box-shadow: none;
    }
    #header-component.header--zaisen header-drawer .menu-drawer__nav-buttons :is(.menu-drawer__back-button,.menu-drawer__close-button):is(:hover,:focus-visible) {
      background: rgba(216,181,106,.16);
      color: #FFFFFF;
    }

    /* Region/language utility has its own raised, accessible card. */
    #header-component.header--zaisen header-drawer .menu-drawer__utility-links {
      margin: 13px 17px 14px;
      padding: 0;
      border-top: 1px solid #D7C3AB;
    }
    #header-component.header--zaisen header-drawer .drawer-localization__button {
      width: 100%;
      min-height: 55px;
      margin: 14px 0 0;
      padding: 9px 14px;
      justify-content: space-between;
      border: 1px solid #D6C1A7;
      border-radius: 12px;
      color: #302118 !important;
      background: linear-gradient(155deg,#FFFDF9,#F0E3D2);
      box-shadow: inset 0 1px 0 #FFFFFF, 0 3px 9px rgba(59,40,27,.08);
      font-size: 13px;
      font-weight: 650;
    }
    #header-component.header--zaisen header-drawer .drawer-localization__button:is(:hover,:focus-visible) {
      color: #2B1D17 !important;
      background: #EAD9C4;
      border-color: #B99369;
    }
    #header-component.header--zaisen header-drawer .drawer-localization__button .icon-caret {
      color: #77523A;
    }

    #header-component.header--zaisen header-drawer .drawer-localization .localization-form,
    #header-component.header--zaisen header-drawer .drawer-localization .localization-form__list,
    #header-component.header--zaisen header-drawer .drawer-localization .language-selector,
    #header-component.header--zaisen header-drawer .drawer-localization .country-selector-form__wrapper {
      --color-foreground: #2B1D17;
      --color-foreground-rgb: 43 29 23;
      --color-foreground-subdued: #66503E;
      --color-background: #F8F4EE;
      color: #2B1D17;
    }
    #header-component.header--zaisen header-drawer .drawer-localization .localization-form__list-item {
      --button-color: #2B1D17;
      --color-foreground: #2B1D17;
      --color-foreground-rgb: 43 29 23;
      min-height: 46px;
      border: 1px solid transparent;
      border-radius: 9px;
      color: #2B1D17;
    }
    #header-component.header--zaisen header-drawer .drawer-localization .localization-form__list-item:is(:hover,:focus-visible,[aria-current='true'],[aria-selected='true']) {
      --button-color: #2B1D17 !important;
      background: #EADBC8;
      color: #2B1D17 !important;
      border-color: #D2B79A;
    }
    #header-component.header--zaisen header-drawer .drawer-localization .localization-form__list-item :is(.country,.localization-form__currency,.svg-wrapper) {
      color: #2B1D17 !important;
      opacity: 1;
    }

    #header-component.header--zaisen header-drawer :is(a,button,summary,select,input):focus-visible {
      outline: 2px solid #9C6E40;
      outline-offset: 2px;
    }

    #header-component.header--zaisen header-drawer .menu-drawer__backdrop {
      backdrop-filter: blur(4px) brightness(.60);
      -webkit-backdrop-filter: blur(4px) brightness(.60);
    }
  }

  /* Current / hovered country options must retain DARK lettering on the
     cream popover, regardless of the dark main header foreground. */
  #header-component.header--zaisen .dropdown-localization localization-form-component .localization-form__list-item:is(:hover,:focus,[aria-selected='true'],[aria-current='true']) {
    --button-color: #2B1D17 !important;
    --color-foreground-subdued: #2B1D17;
    background: #F1E4D4 !important;
    color: #2B1D17 !important;
  }
  #header-component.header--zaisen .dropdown-localization localization-form-component .localization-form__list-item:is(:hover,:focus,[aria-selected='true'],[aria-current='true']) :is(.country,.localization-form__currency,.svg-wrapper) {
    color: #2B1D17 !important;
    opacity: 1 !important;
  }
  #header-component.header--zaisen .dropdown-localization localization-form-component .language-selector .localization-form__select:is(:hover,:focus-visible) {
    color: #2B1D17 !important;
    background: #EADBC8 !important;
  }

  /* On the inner-page DARK header, the country selector button's hover
     background is ivory. Force dark labels/caret to follow that background. */
  #header-component.header--zaisen-dark .dropdown-localization__button:is(:hover,:focus-visible),
  #header-component.header--zaisen-dark .dropdown-localization__button:is(:hover,:focus-visible) :is(span:not(.visually-hidden),svg) {
    color: #2B1D17 !important;
    --button-color: #2B1D17;
  }

  @media (prefers-reduced-motion: reduce) {
    #header-component.header--zaisen header-drawer .menu-drawer__menu-item {
      transition: none !important;
    }
  }
{% endstylesheet %}
