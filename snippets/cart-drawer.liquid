{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>
  <script
    type="module"
    src="{{ 'zs-cart-carousel.js' | asset_url }}"
    fetchpriority="low"
  ></script>
  {{ 'zs-cart-v2.css' | asset_url | stylesheet_tag }}

  {% capture empty_cart_drawer_content %}
    <div class="cart-drawer__content zs-cart-empty" aria-label="{{ 'accessibility.cart' | t }}">
      <div class="zs-cart-empty__icon" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M3 8h18l-1.5 12H4.5L3 8Z"></path>
          <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
          <path d="M9 13h6"></path>
        </svg>
      </div>
      <h3>
        {% case request.locale.iso_code %}
          {% when 'de' %}Dein Warenkorb ist leer
          {% when 'fr' %}Votre panier est vide
          {% when 'ar' %}سلتك فارغة
          {% else %}Your cart is empty
        {% endcase %}
      </h3>
      <p>
        {% case request.locale.iso_code %}
          {% when 'de' %}Entdecke handgefertigte Holzstücke für dein Zuhause.
          {% when 'fr' %}Découvrez des pièces en bois façonnées à la main.
          {% when 'ar' %}اكتشف منتجاتنا الخشبية المصنوعة يدويًا.
          {% else %}Find something beautiful, shaped by hand for your home.
        {% endcase %}
      </p>
      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    overlay-mode
    no-persist
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {% liquid
            assign zs_drawer_title = 'Your Cart'
            case request.locale.iso_code
              when 'de'
                assign zs_drawer_title = 'Warenkorb'
              when 'fr'
                assign zs_drawer_title = 'Votre panier'
              when 'ar'
                assign zs_drawer_title = 'سلتك'
            endcase
          %}
          {% capture cart_badge_html %}
            <span class="theme-drawer__badge" aria-label="{{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}">{{ cart.item_count }}</span>
          {% endcapture %}
          {% render 'theme-drawer-header',
            title: zs_drawer_title,
            drawer_id: 'cart-drawer',
            heading_id: 'cart-drawer-heading',
            title_append: cart_badge_html
          %}

          {% capture cart_items_children %}
            {% if cart.empty? %}
              {{ empty_cart_drawer_content }}
            {% else %}
              <div class="cart-drawer__content" aria-label="{{ 'accessibility.cart' | t }}">
                {% render 'zs-cart-shipping' %}
                <div class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </div>
                {% render 'zs-cart-upsells' %}
              </div>

              <div class="cart-drawer__summary">
                {% liquid
                  assign zs_cart_savings = cart.original_total_price | minus: cart.total_price
                  assign zs_shipping_usd = 0
                  assign zs_shipping_standard_label = ''
                  case localization.country.iso_code
                    when 'GB'
                      assign zs_shipping_usd = 60
                      assign zs_shipping_standard_label = '$6.99 USD'
                    when 'US', 'DE', 'FR'
                      assign zs_shipping_usd = 60
                      assign zs_shipping_standard_label = '$9.99 USD'
                    when 'AE'
                      assign zs_shipping_usd = 60
                      assign zs_shipping_standard_label = '$5.99 USD'
                    when 'CA', 'AU'
                      assign zs_shipping_usd = 100
                      assign zs_shipping_standard_label = '$14.99 USD'
                  endcase
                  assign zs_free_shipping = false
                  assign zs_shipping_usd_cents = zs_shipping_usd | times: 100
                  if zs_shipping_usd > 0 and cart.currency.iso_code == 'USD' and cart.total_price >= zs_shipping_usd_cents
                    assign zs_free_shipping = true
                  endif
                  comment
                    Preserve all cart/bundle discount applications. A product
                    discount does not prove a free shipping rate; checkout
                    remains authoritative for the shipping charge.
                  endcomment
                %}
                <div class="zs-cart-breakdown" aria-label="Order summary">
                  <div class="zs-cart-breakdown__row">
                    <span class="zs-cart-breakdown__label">
                      {% case request.locale.iso_code %}
                        {% when 'de' %}Zwischensumme
                        {% when 'fr' %}Sous-total
                        {% when 'ar' %}المجموع الفرعي
                        {% else %}Subtotal
                      {% endcase %}
                    </span>
                    <strong>{{ cart.original_total_price | money }}</strong>
                  </div>
                  <div class="zs-cart-breakdown__row zs-cart-breakdown__row--shipping{% if zs_free_shipping %} is-free{% endif %}" data-zs-shipping-summary>
                    <span class="zs-cart-breakdown__label">
                      {% case request.locale.iso_code %}
                        {% when 'de' %}Versand nach {{ localization.country.name | escape }}
                        {% when 'fr' %}Livraison vers {{ localization.country.name | escape }}
                        {% when 'ar' %}الشحن إلى {{ localization.country.name | escape }}
                        {% else %}Shipping to {{ localization.country.name | escape }}
                      {% endcase %}
                    </span>
                    <strong data-zs-shipping-status>
                      {% if zs_free_shipping %}
                        {% case request.locale.iso_code %}
                          {% when 'de' %}Vorauss. kostenlos
                          {% when 'fr' %}Gratuite (est.)
                          {% when 'ar' %}مجاني (تقديري)
                          {% else %}Est. FREE
                        {% endcase %}
                      {% elsif zs_shipping_standard_label != blank %}
                        {% case request.locale.iso_code %}
                          {% when 'de' %}ca. {{ zs_shipping_standard_label }}
                          {% when 'fr' %}env. {{ zs_shipping_standard_label }}
                          {% when 'ar' %}تقديري {{ zs_shipping_standard_label }}
                          {% else %}Est. {{ zs_shipping_standard_label }}
                        {% endcase %}
                      {% else %}
                        {% case request.locale.iso_code %}
                          {% when 'de' %}An der Kasse
                          {% when 'fr' %}À la caisse
                          {% when 'ar' %}عند الدفع
                          {% else %}At checkout
                        {% endcase %}
                      {% endif %}
                    </strong>
                  </div>
                  <div class="zs-cart-breakdown__row zs-cart-breakdown__row--savings{% if zs_cart_savings <= 0 %} zs-cart-breakdown__row--no-savings{% endif %}">
                    <span class="zs-cart-breakdown__label">
                      {% case request.locale.iso_code %}
                        {% when 'de' %}Ersparnis
                        {% when 'fr' %}Économies
                        {% when 'ar' %}التوفير
                        {% else %}Savings
                      {% endcase %}
                    </span>
                    <strong>{% if zs_cart_savings > 0 %}-{% endif %}{{ zs_cart_savings | money }}</strong>
                  </div>
                </div>
                {% render 'cart-summary', section_id: 'cart-drawer-section' %}

              </div>
            {% endif %}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

{% endstylesheet %}
