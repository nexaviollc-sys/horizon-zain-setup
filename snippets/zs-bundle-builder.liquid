{% comment %}
  ZAISEN automatic app-free bundle selector for the entire active catalog; includes a change-product popup.
  Automatic recommendations use shared collections and the all-products catalog.
  This is not a Shopify composite inventory item.
  Native Shopify discount codes:
  ZS-BUNDLE15-2026 (min 2, 15% of eligible live prices);
  ZS-BUNDLE25-2026 (min 3, 25% of eligible live prices);
  ZS-BUNDLESHIP-2026 (min 2, supported shipping countries).
{% endcomment %}
{%- liquid
  assign zs_recommendation_one = blank
  assign zs_recommendation_two = blank

  # Pick an in-stock piece from a shared collection, starting after the
  # current product and wrapping around if it is last in the collection.
  # This works for newly published products with no per-product setup.
  for zs_collection in product.collections
    if zs_collection.handle != 'all' and zs_collection.handle != 'best-sellers'
      assign zs_after_main = false
      for zs_candidate in zs_collection.products
        if zs_candidate.id == product.id
          assign zs_after_main = true
        elsif zs_after_main and zs_candidate.available
          assign zs_recommendation_one = zs_candidate
          break
        endif
      endfor
      if zs_recommendation_one == blank
        for zs_candidate in zs_collection.products
          if zs_candidate.id != product.id and zs_candidate.available
            assign zs_recommendation_one = zs_candidate
            break
          endif
        endfor
      endif
    endif
    if zs_recommendation_one != blank
      break
    endif
  endfor

  # A rotating second recommendation from the automatic All collection
  # ensures fresh arrivals also appear on existing products' bundle cards.
  assign zs_all_collection = collections['all']
  assign zs_after_main = false
  for zs_candidate in zs_all_collection.products
    if zs_candidate.id == product.id
      assign zs_after_main = true
    elsif zs_after_main and zs_candidate.available
      if zs_recommendation_one == blank
        assign zs_recommendation_one = zs_candidate
      elsif zs_candidate.id != zs_recommendation_one.id
        assign zs_recommendation_two = zs_candidate
        break
      endif
    endif
  endfor

  # Wrap to the beginning. Never recommend the current product, duplicates,
  # or unavailable products.
  if zs_recommendation_one == blank or zs_recommendation_two == blank
    for zs_candidate in zs_all_collection.products
      if zs_candidate.id != product.id and zs_candidate.available
        if zs_recommendation_one == blank
          assign zs_recommendation_one = zs_candidate
        elsif zs_recommendation_two == blank and zs_candidate.id != zs_recommendation_one.id
          assign zs_recommendation_two = zs_candidate
          break
        endif
      endif
    endfor
  endif

  # For large catalogs, try another assigned collection if the first
  # available assortment did not yield two distinct bundle options.
  if zs_recommendation_one == blank or zs_recommendation_two == blank
    for zs_collection in product.collections
      for zs_candidate in zs_collection.products
        if zs_candidate.id != product.id and zs_candidate.available
          if zs_recommendation_one == blank
            assign zs_recommendation_one = zs_candidate
          elsif zs_recommendation_two == blank and zs_candidate.id != zs_recommendation_one.id
            assign zs_recommendation_two = zs_candidate
            break
          endif
        endif
      endfor
      if zs_recommendation_one != blank and zs_recommendation_two != blank
        break
      endif
    endfor
  endif

  assign zs_main_variant = product.selected_or_first_available_variant
  assign zs_country = localization.country.iso_code | upcase
  assign zs_bundle_shipping_supported = false
  assign zs_shipping_threshold_usd = 0
  case zs_country
    when 'US', 'GB', 'DE', 'FR', 'AE'
      assign zs_bundle_shipping_supported = true
      assign zs_shipping_threshold_usd = 60
    when 'CA', 'AU'
      assign zs_bundle_shipping_supported = true
      assign zs_shipping_threshold_usd = 100
  endcase
-%}
{% if product != blank and zs_recommendation_one != blank and zs_recommendation_two != blank and zs_main_variant != blank and zs_main_variant.available %}
  {{ 'zs-bundle-builder.css' | asset_url | stylesheet_tag }}
  {% comment %}Keep compact market currency prefix styling with the snippet so it works even before asset cache refreshes.{% endcomment %}
  <style>
    .zs-bundle .zs-bundle__currency-prefix{font-size:.74em;font-weight:600;letter-spacing:0;white-space:nowrap;margin-inline-end:.08em}
    .zs-bundle .zs-bundle__currency-prefix--symbol{font-size:1em;font-weight:inherit;margin-inline-end:0}
  </style>
  <script src="{{ 'zs-bundle-builder.js' | asset_url }}" defer></script>
  {% comment %}Compatibility for older cached JS assets: plain $ in the US market.
  Automatically does nothing after the new bundle asset reaches Shopify.{% endcomment %}
  <script>
    customElements.whenDefined('zs-bundle-builder').then(function () {
      document.querySelectorAll('zs-bundle-builder[data-currency="USD"]').forEach(function (builder) {
        if (builder.currencyPrefix !== 'US$') return;
        builder.currencyPrefix = '$';
        builder.isCurrencySymbol = true;
        if (typeof builder.refresh === 'function') builder.refresh();
      });
    });
  </script>
  <zs-bundle-builder
    class="zs-bundle"
    data-product-id="{{ product.id }}"
    data-currency="{{ localization.country.currency.iso_code | default: shop.currency | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-country="{{ zs_country }}"
    data-free-shipping="{{ zs_bundle_shipping_supported }}"
    data-shipping-threshold-cents="{{ zs_shipping_threshold_usd | times: 100 }}"
    data-country-name="{{ localization.country.name | escape }}"
    data-cart-path="{{ routes.root_url }}cart/"
  >
    <div class="zs-bundle__delivery" data-zs-delivery-zone aria-live="polite">
      <div class="zs-bundle__delivery-top">
        <span class="zs-bundle__delivery-check" data-zs-shipping-check aria-hidden="true" hidden>✓</span>
        <strong class="zs-bundle__delivery-label" data-zs-shipping-label>Free shipping progress</strong>
      </div>
      <div class="zs-bundle__delivery-track" data-zs-progress role="progressbar"
        aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="zs-bundle__delivery-fill" data-zs-progress-fill style="width:0%"></span>
      </div>
    </div>
    <header class="zs-bundle__head">
      <div>
        <p class="zs-bundle__eyebrow">ADD 1 &amp; SAVE 15% · ADD 2 &amp; SAVE 25%</p>
        <h2 class="zs-bundle__heading">Complete Your Collection</h2>
      </div>
      <span class="zs-bundle__badge" data-zs-tier>UP TO 25% OFF</span>
    </header>

    <div class="zs-bundle__rows">
      {%- comment -%}The current product is always included in totals and checkout but is not repeated in recommendation cards.{%- endcomment -%}
      <div data-zs-row data-zs-main
        data-variant-id="{{ zs_main_variant.id }}"
        data-price-cents="{{ zs_main_variant.price }}"
        hidden></div>
      <select class="zs-bundle__main-variants" data-zs-main-variants hidden aria-hidden="true" tabindex="-1">
        {% for v in product.variants %}
          <option value="{{ v.id }}" data-price="{{ v.price }}" {% if v.id == zs_main_variant.id %}selected{% endif %}>{{ v.title | escape }}</option>
        {% endfor %}
      </select>

      {% assign zs_bundle_rec = zs_recommendation_one %}
      {% render 'zs-bundle-item', item: zs_bundle_rec, index: 1 %}
      {% assign zs_bundle_rec = zs_recommendation_two %}
      {% render 'zs-bundle-item', item: zs_bundle_rec, index: 2 %}
    </div>

    {% comment %}
      The existing bundle now includes an in-place product picker. Shopify
      renders localized prices and available variants for each of ZAISEN's
      eight active storefront collections. No new section or app is required.
    {% endcomment %}
    {% assign zs_picker_collection_handles = 'lighting|kitchen-dining|wall-clocks|wooden-drinkware|home-decor|gifts|handcrafted-wooden-statues|wooden-desk-shelf-decor' | split: '|' %}
    <dialog class="zs-bundle__picker" data-zs-picker aria-labelledby="zs-bundle-picker-title-{{ product.id }}">
      <div class="zs-bundle__picker-shell">
        <header class="zs-bundle__picker-head">
          <div>
            <p class="zs-bundle__picker-eyebrow">PERSONALIZE YOUR BUNDLE</p>
            <h3 id="zs-bundle-picker-title-{{ product.id }}" class="zs-bundle__picker-title">Choose your wooden piece</h3>
            <p class="zs-bundle__picker-subtitle">Browse the ZAISEN collections and replace either suggested piece.</p>
          </div>
          <button type="button" class="zs-bundle__picker-close" data-zs-picker-close aria-label="Close product picker">×</button>
        </header>
        <div class="zs-bundle__picker-tools">
          <label class="zs-bundle__picker-search-wrap">
            <span class="visually-hidden">Search ZAISEN products</span>
            <span class="zs-bundle__picker-search-icon" aria-hidden="true">⌕</span>
            <input data-zs-picker-search type="search" placeholder="Search wooden products…" autocomplete="off">
          </label>
          <div class="zs-bundle__picker-tabs" aria-label="Filter products by collection">
            <button type="button" data-zs-picker-collection="all" aria-pressed="true" class="is-active">All collections</button>
            {% for zs_picker_handle in zs_picker_collection_handles %}
              {% assign zs_picker_collection = collections[zs_picker_handle] %}
              {% if zs_picker_collection != blank %}
                <button type="button" data-zs-picker-collection="{{ zs_picker_handle }}" aria-pressed="false">{{ zs_picker_collection.title | escape }}</button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="zs-bundle__picker-scroll" data-zs-picker-scroll>
          {% for zs_picker_handle in zs_picker_collection_handles %}
            {% assign zs_picker_collection = collections[zs_picker_handle] %}
            {% if zs_picker_collection != blank %}
              <section class="zs-bundle__picker-group" data-zs-picker-group data-collection="{{ zs_picker_handle }}">
                <h4 class="zs-bundle__picker-group-title">{{ zs_picker_collection.title | escape }}</h4>
                <div class="zs-bundle__picker-grid">
                  {% for zs_picker_product in zs_picker_collection.products %}
                    {% if zs_picker_product.available and zs_picker_product.id != product.id %}
                      {% assign zs_picker_selected_variant = zs_picker_product.selected_or_first_available_variant %}
                      {% if zs_picker_selected_variant != blank and zs_picker_selected_variant.available %}
                        <button
                          type="button"
                          class="zs-bundle__picker-card"
                          data-zs-picker-choose
                          data-zs-picker-product-id="{{ zs_picker_product.id }}"
                          data-zs-picker-product-title="{{ zs_picker_product.title | escape }}"
                          data-zs-picker-product-image="{% if zs_picker_product.featured_image %}{{ zs_picker_product.featured_image | image_url: width: 260 | escape }}{% endif %}"
                          aria-label="Choose {{ zs_picker_product.title | escape }} for your bundle"
                        >
                          <span class="zs-bundle__picker-card-media">
                            {% if zs_picker_product.featured_image %}
                              {{ zs_picker_product.featured_image | image_url: width: 260 | image_tag: loading: 'lazy', widths: '110,160,220,260', sizes: '(min-width: 750px) 155px, 44vw', alt: zs_picker_product.title }}
                            {% else %}
                              <span>ZAISEN</span>
                            {% endif %}
                          </span>
                          <span class="zs-bundle__picker-card-body">
                            <span class="zs-bundle__picker-card-name">{{ zs_picker_product.title | escape }}</span>
                            <span class="zs-bundle__picker-card-price">{{ zs_picker_selected_variant.price | money }}</span>
                            <span class="zs-bundle__picker-card-action">Choose piece <span aria-hidden="true">↗</span></span>
                          </span>
                          <template data-zs-picker-variants>
                            <select aria-label="Choose an option for {{ zs_picker_product.title | escape }}">
                              {% for zs_picker_variant in zs_picker_product.variants %}
                                <option value="{{ zs_picker_variant.id }}" data-price="{{ zs_picker_variant.price }}" {% if zs_picker_variant.id == zs_picker_selected_variant.id %}selected{% endif %} {% unless zs_picker_variant.available %}disabled{% endunless %}>{{ zs_picker_variant.title | escape }}</option>
                              {% endfor %}
                            </select>
                          </template>
                        </button>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              </section>
            {% endif %}
          {% endfor %}
          <p class="zs-bundle__picker-empty" data-zs-picker-empty hidden>No matching available products. Try another collection or search.</p>
        </div>
        <footer class="zs-bundle__picker-footer">Your selection updates the bundle instantly. Discounts and shipping are confirmed at checkout.</footer>
      </div>
    </dialog>

    <div class="zs-bundle__summary">
      <div class="zs-bundle__summary-row"><span>Regular total</span><s data-zs-regular-total>—</s></div>
      <div class="zs-bundle__summary-row zs-bundle__summary-row--total">
        <span>Bundle total</span><strong data-zs-bundle-total>—</strong>
      </div>
      <div class="zs-bundle__summary-row zs-bundle__summary-row--save">
        <span data-zs-tier-description>Choose 1 or 2 matching pieces to save</span><strong data-zs-save-total>—</strong>
      </div>
    </div>

    <p class="zs-bundle__footnote">
      Your current product is included automatically. Add a matching piece to save 15%, or both to save 25%. Final discounts are confirmed at checkout.
    </p>
    <p class="zs-bundle__error" data-zs-error role="status" hidden></p>
  </zs-bundle-builder>
{% endif %}
