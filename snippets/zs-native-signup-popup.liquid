
{% comment %}
  ZAISEN native email signup — uses Shopify's customer form (no popup app).
  Newsletter tag plus ZAISEN_POPUP10 segment tag; checkout eligibility enforced
  by native Shopify discount ZAISENWELCOME10, once per eligible customer.
  This form creates/updates a Shopify customer profile, not a logged-in account.
{% endcomment %}
<div id="zs-native-signup" class="zs-native-signup" hidden
  data-already-subscribed="{% if customer and customer.accepts_marketing %}true{% else %}false{% endif %}"
  data-page-type="{{ template.name | escape }}">
  <div class="zs-native-signup__dialog" role="dialog" aria-modal="true" aria-labelledby="zs-native-signup-title" aria-describedby="zs-native-signup-intro" tabindex="-1">
    <div class="zs-native-signup__visual" aria-label="A ZAISEN handcrafted wooden tea set photographed for the product catalog">
      <span class="zs-native-signup__visual-caption">CRAFTED FROM REAL WOOD</span>
    </div>
    <div class="zs-native-signup__content">
      <button type="button" class="zs-native-signup__close" aria-label="Close signup offer" data-zs-signup-close>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <span class="zs-native-signup__eyebrow">AN INVITATION FROM ZAISEN</span>
      <h2 id="zs-native-signup-title" class="zs-native-signup__title">Something special <em>for your home.</em></h2>
      <div class="zs-native-signup__offer"><span>10%</span> OFF</div>
      <p id="zs-native-signup-intro" class="zs-native-signup__intro">Discover new pieces, thoughtful details and stories from ZAISEN. Join us for 10% off your first order.</p>
      {% form 'customer', id: 'zs-native-signup-form', class: 'zs-native-signup__form' %}
        {% if form.posted_successfully? %}
          <div class="zs-native-signup__success" data-zs-signup-success role="status" aria-live="polite">
            <p class="zs-native-signup__success-heading">Welcome to ZAISEN.</p>
            <p>Your welcome code is ready. Use your subscribed email at checkout; confirm your email first if prompted.</p>
            <div class="zs-native-signup__code" aria-label="Your welcome discount code"><strong id="zs-native-signup-code">ZAISENWELCOME10</strong>
              <button type="button" data-zs-signup-copy aria-label="Copy your discount code">Copy</button>
            </div>
            <a class="zs-native-signup__shop-link" href="/discount/ZAISENWELCOME10?redirect=/collections/all">Explore the collection</a>
          </div>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter, ZAISEN_POPUP10">
          <label class="zs-native-signup__sr-only" for="zs-native-signup-email">Your email address</label>
          <input class="zs-native-signup__email" type="email" name="contact[email]" id="zs-native-signup-email"
            placeholder="Your email address" autocomplete="email" inputmode="email" required
            {% if form.errors %}aria-invalid="true" aria-describedby="zs-native-signup-error"{% endif %}>
          <label class="zs-native-signup__consent">
            <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
            <span>Yes, send me ZAISEN news and offers. I can unsubscribe at any time.</span>
          </label>
          <button class="zs-native-signup__submit" type="submit">GET MY 10% OFF <span aria-hidden="true">→</span></button>
          {% if form.errors %}
            <div class="zs-native-signup__error" id="zs-native-signup-error" role="alert" data-zs-signup-error>{{ form.errors | default_errors }}</div>
          {% endif %}
          <p class="zs-native-signup__fineprint">For new subscribers • One use per customer</p>
        {% endif %}
      {% endform %}
      <p class="zs-native-signup__footnote">Made by hand. Meant to be kept.</p>
    </div>
  </div>
</div>
<button type="button" id="zs-native-signup-launcher" class="zs-native-signup__launcher" hidden
  aria-label="Claim 10% off your first ZAISEN order" aria-controls="zs-native-signup" aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="9" width="17" height="12" rx="1.5"/><path d="M12 9v12M3 13h18M12 9c-4 0-7.5-2.2-6-5 2-3.5 6 2 6 5Zm0 0c4 0 7.5-2.2 6-5-2-3.5-6 2-6 5Z"/></svg>
  <span>Claim <strong>10% Off</strong></span>
</button>
<style>

  .zs-native-signup[hidden],.zs-native-signup__launcher[hidden]{display:none!important}
  /* Compact offer opener. Anchored low-left, outside modal flow; never covers content with a large panel. */
  .zs-native-signup__launcher{position:fixed;inset:auto auto max(18px,env(safe-area-inset-bottom,0px)) 15px;z-index:2147482990;display:flex;align-items:center;gap:8px;min-height:43px;padding:0 13px 0 11px;max-width:calc(100vw - 28px);border:1px solid rgba(122,87,62,.25);border-radius:7px;background:#faf7f1;color:#543a2a;box-shadow:0 4px 17px rgba(39,27,20,.14);font-family:inherit;font-size:11px;letter-spacing:.015em;line-height:1.1;cursor:pointer;transition:box-shadow .2s ease,transform .2s ease;white-space:nowrap}
  .zs-native-signup__launcher svg{flex:0 0 auto;color:#856344}
