  @media(max-height:600px) and (max-width:700px){
    .zs-native-signup__visual{height:82px}
    .zs-native-signup__content{padding-top:14px;padding-bottom:13px}
    .zs-native-signup__title{font-size:25px!important}
  }

</style>
<script>
(function(){
  var root=document.getElementById('zs-native-signup');
  var launcher=document.getElementById('zs-native-signup-launcher');
  if(!root||!launcher)return;
  var dialog=root.querySelector('.zs-native-signup__dialog');
  var success=!!root.querySelector('[data-zs-signup-success]');
  var error=!!root.querySelector('[data-zs-signup-error]');
  var closeBtn=root.querySelector('[data-zs-signup-close]');
  var copyBtn=root.querySelector('[data-zs-signup-copy]');
  var previousFocus=null;
  var signedKey='zs_native_signup_complete_v1';
  function get(k){try{return window.localStorage.getItem(k)}catch(e){return null}}
  function set(k,v){try{window.localStorage.setItem(k,v)}catch(e){}}
  function show(){
    if(!root.hidden)return;
    previousFocus=document.activeElement;
    launcher.hidden=true;
    root.hidden=false;
    document.documentElement.classList.add('zs-native-signup-open');
    window.requestAnimationFrame(function(){
      // On phones, don't trigger the keyboard until the customer taps the email field.
      var focusTarget=window.matchMedia('(max-width:700px)').matches
        ? dialog
        : (success?(copyBtn||dialog):(root.querySelector('#zs-native-signup-email')||dialog));
      if(focusTarget&&focusTarget.focus)focusTarget.focus();
    });
  }
  function close(){
    root.hidden=true;
    document.documentElement.classList.remove('zs-native-signup-open');
    // Do NOT store dismissals: on the next visit or refresh the offer returns.
    if(!success)launcher.hidden=false;
    if(previousFocus&&previousFocus.focus)previousFocus.focus();
  }
  closeBtn.addEventListener('click',close);
  launcher.addEventListener('click',show);
  root.addEventListener('click',function(ev){if(ev.target===root)close()});
  document.addEventListener('keydown',function(ev){
    if(root.hidden)return;
    if(ev.key==='Escape'){ev.preventDefault();close()}
    if(ev.key==='Tab'){
      var items=Array.prototype.slice.call(dialog.querySelectorAll('a[href],button:not([disabled]),input:not([disabled])')).filter(function(el){return el.getClientRects().length>0});
      if(!items.length){ev.preventDefault();dialog.focus();return}
      if(ev.shiftKey&&document.activeElement===items[0]){ev.preventDefault();items[items.length-1].focus()}
      if(!ev.shiftKey&&document.activeElement===items[items.length-1]){ev.preventDefault();items[0].focus()}
    }
  });
  if(copyBtn){
    copyBtn.addEventListener('click',function(){
      var code='ZAISENWELCOME10';
      if(navigator.clipboard&&window.isSecureContext){
        navigator.clipboard.writeText(code).then(function(){copyBtn.textContent='Copied!'}).catch(function(){copyBtn.textContent='Select the code'});
      } else {
        var el=document.getElementById('zs-native-signup-code');
        if(el){var sel=window.getSelection();var range=document.createRange();range.selectNodeContents(el);sel.removeAllRanges();sel.addRange(range);copyBtn.textContent='Code selected'}
      }
    });
  }
  // A confirmed Shopify customer-form submission is the only anonymous-browser
  // success flag. An authenticated marketing subscriber is likewise excluded.
  if(success){set(signedKey,'1');show();return}
  if(root.getAttribute('data-already-subscribed')==='true'||get(signedKey)==='1')return;
  if(error){show();return}
  // Keep the subtle left offer available throughout the site.
  launcher.hidden=false;
  // Auto-open on homepage and product pages, including after closing and
  // refreshing. No 7-day dismissal or session dismissal is remembered.
  if(root.getAttribute('data-page-type')==='index'||root.getAttribute('data-page-type')==='product'){
    if(window.Shopify&&window.Shopify.designMode)return;
    window.setTimeout(function(){if(!document.hidden)show()},2200);
  }
})();
</script>
