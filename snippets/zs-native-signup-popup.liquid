
{% comment %}
  ZAISEN native email signup — uses Shopify's customer form (no popup app).
  Newsletter tag plus ZAISEN_POPUP10 segment tag; checkout eligibility enforced
  by native Shopify discount ZAISENWELCOME10, once per eligible customer.
  This form creates/updates a Shopify customer profile, not a logged-in account.
{% endcomment %}
<div id="zs-native-signup" class="zs-native-signup" hidden
  data-already-subscribed="{% if customer and customer.accepts_marketing %}true{% else %}false{% endif %}">
  <div class="zs-native-signup__dialog" role="dialog" aria-modal="true" aria-labelledby="zs-native-signup-title" aria-describedby="zs-native-signup-intro" tabindex="-1">
    <div class="zs-native-signup__visual" aria-label="An authentic ZAISEN wooden horse sculpture">
      <span class="zs-native-signup__visual-caption">NATURE, SHAPED BY HAND</span>
    </div>
    <div class="zs-native-signup__content">
      <button type="button" class="zs-native-signup__close" aria-label="Close signup offer" data-zs-signup-close>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <span class="zs-native-signup__eyebrow">AN INVITATION FROM ZAISEN</span>
      <h2 id="zs-native-signup-title" class="zs-native-signup__title">A little welcome, <em>just for you.</em></h2>
      <div class="zs-native-signup__offer"><span>10%</span> OFF</div>
      <p id="zs-native-signup-intro" class="zs-native-signup__intro">Join our community for first access to thoughtful woodcraft, new collections and a special first-order gift.</p>
      {% form 'customer', id: 'zs-native-signup-form', class: 'zs-native-signup__form' %}
        {% if form.posted_successfully? %}
          <div class="zs-native-signup__success" data-zs-signup-success role="status" aria-live="polite">
            <p class="zs-native-signup__success-heading">Welcome to ZAISEN.</p>
            <p>Your first-order code is below. Use the same email at checkout. If email confirmation is required, please complete it first.</p>
            <div class="zs-native-signup__code" aria-label="Your welcome discount code"><strong id="zs-native-signup-code">ZAISENWELCOME10</strong>
              <button type="button" data-zs-signup-copy aria-label="Copy your discount code">Copy</button>
            </div>
            <a class="zs-native-signup__shop-link" href="/discount/ZAISENWELCOME10?redirect=/collections/all">Explore the collection</a>
          </div>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter, ZAISEN_POPUP10">
          <label class="zs-native-signup__sr-only" for="zs-native-signup-email">Your email address</label>
          <input class="zs-native-signup__email" type="email" name="contact[email]" id="zs-native-signup-email"
            placeholder="Your email address" autocomplete="email" inputmode="email" required
            {% if form.errors %}aria-invalid="true" aria-describedby="zs-native-signup-error"{% endif %}>
          <label class="zs-native-signup__consent">
            <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
            <span>I agree to receive emails from ZAISEN about collections and offers. I can unsubscribe at any time.</span>
          </label>
          <button class="zs-native-signup__submit" type="submit">UNLOCK MY 10% OFF <span aria-hidden="true">→</span></button>
          {% if form.errors %}
            <div class="zs-native-signup__error" id="zs-native-signup-error" role="alert" data-zs-signup-error>{{ form.errors | default_errors }}</div>
          {% endif %}
          <p class="zs-native-signup__fineprint">For new customers • Once per customer • 10% off your first order</p>
        {% endif %}
      {% endform %}
      <p class="zs-native-signup__footnote">Handcrafted pieces. Made with care.</p>
    </div>
  </div>
</div>
<style>
  .zs-native-signup[hidden]{display:none!important}
  .zs-native-signup{position:fixed;inset:0;z-index:2147483000;display:flex;justify-content:center;align-items:center;padding:22px;background:rgba(24,19,16,.66);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);overflow-y:auto}
  html.zs-native-signup-open{overflow:hidden}
  .zs-native-signup__dialog{position:relative;width:min(100%,850px);min-height:475px;display:grid;grid-template-columns:45% 55%;margin:auto;overflow:hidden;border-radius:12px;background:#f9f6ef;color:#30231d;box-shadow:0 30px 100px rgba(0,0,0,.29);isolation:isolate}
  .zs-native-signup__visual{min-height:475px;display:flex;align-items:end;justify-content:center;background-image:linear-gradient(0deg,rgba(27,17,11,.65),rgba(27,17,11,0) 45%),url('https://cdn.shopify.com/s/files/1/1019/0884/0741/files/b2.jpg?v=1791831955');background-size:cover;background-position:52% center;background-repeat:no-repeat}
  .zs-native-signup__visual-caption{padding:0 16px 26px;color:#fffaf4;text-align:center;letter-spacing:.21em;font-size:10px;font-weight:600;text-shadow:0 2px 10px rgba(0,0,0,.5)}
  .zs-native-signup__content{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:46px 49px 25px;text-align:center;min-width:0}
  .zs-native-signup__close{position:absolute;right:15px;top:13px;width:36px;height:36px;border:0;border-radius:50%;background:transparent;color:#654c3a;display:grid;place-items:center;cursor:pointer;z-index:3}
  .zs-native-signup__close:hover,.zs-native-signup__close:focus-visible{background:#e9ded1;outline-offset:2px}
  .zs-native-signup__eyebrow{color:#95764f;font-family:inherit;font-size:10px;font-weight:650;letter-spacing:.2em;line-height:1.5}
  .zs-native-signup__title{margin:13px 0 4px;color:#34261d!important;font-family:Georgia,'Times New Roman',serif!important;font-size:34px!important;font-weight:400!important;line-height:1.04!important;letter-spacing:-.025em!important;text-wrap:balance}
  .zs-native-signup__title em{display:block;margin-top:5px;font-style:italic;color:#805a3d}
  .zs-native-signup__offer{display:flex;align-items:baseline;gap:7px;margin-top:14px;font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#69482e;line-height:1}
  .zs-native-signup__offer span{font-size:42px;letter-spacing:-.045em}
  .zs-native-signup__intro{max-width:350px;margin:13px 0 19px;font-size:13px;line-height:1.65;color:#6d6258}
  .zs-native-signup__form{width:100%;max-width:350px}
  .zs-native-signup__sr-only{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important}
  .zs-native-signup__email{width:100%;height:46px;min-height:46px;padding:0 14px;border:1px solid #d6cbbd;background:#fff;color:#30231d;border-radius:5px;font-family:inherit;font-size:13px;box-shadow:none;outline-offset:3px}
  .zs-native-signup__email:focus-visible{border-color:#846247}
  .zs-native-signup__email::placeholder{color:#9a8b7e}
  .zs-native-signup__consent{display:flex;align-items:flex-start;gap:9px;margin:11px 0 13px;text-align:left;color:#6b6057;font-size:10.5px;line-height:1.5;cursor:pointer}
  .zs-native-signup__consent input{flex:0 0 auto;accent-color:#6b4a34;width:14px;height:14px;margin:1px 0 0}
  .zs-native-signup__submit,.zs-native-signup__shop-link{width:100%;min-height:45px;display:flex;align-items:center;justify-content:center;gap:10px;border-radius:5px;border:1px solid #523724;background:#523724;color:#fff!important;font-family:inherit;font-size:11px;font-weight:650;letter-spacing:.1em;text-decoration:none!important;cursor:pointer;transition:background .2s ease,transform .2s ease}
  .zs-native-signup__submit:hover,.zs-native-signup__shop-link:hover{background:#694930;transform:translateY(-1px)}
  .zs-native-signup__submit span{font-size:17px;line-height:1}
  .zs-native-signup__fineprint{margin:12px 0 0;color:#827468;font-size:10px;line-height:1.5}
  .zs-native-signup__footnote{margin:18px 0 0;color:#a38e76;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:13px}
  .zs-native-signup__error{margin-top:11px;color:#a33f2a;text-align:left;font-size:12px}
  .zs-native-signup__error ul{margin:4px 0;padding-inline-start:20px}
  .zs-native-signup__success-heading{margin:0 0 8px;font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#4a3022}
  .zs-native-signup__success p{margin:4px 0 14px;font-size:12px;line-height:1.5;color:#736558}
  .zs-native-signup__code{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px;padding:7px 7px 7px 12px;background:#fff;border:1px dashed #aa9279;border-radius:5px;text-align:left}
  .zs-native-signup__code strong{font-size:12px;letter-spacing:.065em;color:#563c29;overflow-wrap:anywhere}
  .zs-native-signup__code button{padding:7px 12px;border:0;border-radius:4px;background:#f1e7da;color:#5b3c2b;font-size:12px;cursor:pointer}
  @media(max-width:700px){
    .zs-native-signup{padding:12px;align-items:center}
    .zs-native-signup__dialog{width:min(100%,390px);max-height:calc(100dvh - 24px);min-height:0;grid-template-columns:1fr;overflow-y:auto;border-radius:10px}
    .zs-native-signup__visual{height:165px;min-height:165px;background-position:54% 51%}
    .zs-native-signup__visual-caption{padding-bottom:15px;font-size:9px}
    .zs-native-signup__content{padding:29px 26px 22px}
    .zs-native-signup__close{top:11px;right:11px;background:rgba(249,246,239,.94);color:#402c20}
    .zs-native-signup__title{font-size:29px!important;margin-top:9px}
    .zs-native-signup__offer{margin-top:12px}.zs-native-signup__offer span{font-size:37px}
    .zs-native-signup__intro{font-size:12px;margin:9px 0 14px}
    .zs-native-signup__footnote{margin-top:13px}
  }
  @media(max-width:350px){.zs-native-signup__visual{height:122px;min-height:122px}.zs-native-signup__content{padding:22px 17px 17px}.zs-native-signup__title{font-size:26px!important}}
  @media(prefers-reduced-motion:reduce){.zs-native-signup__submit,.zs-native-signup__shop-link{transition:none}}
</style>
<script>
(function(){
  var root=document.getElementById('zs-native-signup');
  if(!root)return;
  var dialog=root.querySelector('.zs-native-signup__dialog');
  var success=!!root.querySelector('[data-zs-signup-success]');
  var error=!!root.querySelector('[data-zs-signup-error]');
  var closeBtn=root.querySelector('[data-zs-signup-close]');
  var copyBtn=root.querySelector('[data-zs-signup-copy]');
  var previousFocus=null;
  var signedKey='zs_native_signup_complete_v1';
  var dismissedKey='zs_native_signup_dismissed_v1';
  function get(k){try{return window.localStorage.getItem(k)}catch(e){return null}}
  function set(k,v){try{window.localStorage.setItem(k,v)}catch(e){}}
  function show(){
    if(!root.hidden)return;
    previousFocus=document.activeElement;
    root.hidden=false;
    document.documentElement.classList.add('zs-native-signup-open');
    window.requestAnimationFrame(function(){(success?copyBtn:root.querySelector('#zs-native-signup-email')||dialog).focus()});
  }
  function close(){
    root.hidden=true;
    document.documentElement.classList.remove('zs-native-signup-open');
    if(!success)set(dismissedKey,String(Date.now()));
    if(previousFocus&&previousFocus.focus)previousFocus.focus();
  }
  closeBtn.addEventListener('click',close);
  root.addEventListener('click',function(ev){if(ev.target===root)close()});
  document.addEventListener('keydown',function(ev){
    if(root.hidden)return;
    if(ev.key==='Escape'){ev.preventDefault();close()}
    if(ev.key==='Tab'){
      var items=Array.prototype.slice.call(dialog.querySelectorAll('a[href],button:not([disabled]),input:not([disabled])')).filter(function(el){return el.getClientRects().length>0});
      if(!items.length){ev.preventDefault();dialog.focus();return}
      if(ev.shiftKey&&document.activeElement===items[0]){ev.preventDefault();items[items.length-1].focus()}
      if(!ev.shiftKey&&document.activeElement===items[items.length-1]){ev.preventDefault();items[0].focus()}
    }
  });
  if(copyBtn){
    copyBtn.addEventListener('click',function(){
      var code='ZAISENWELCOME10';
      if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(code).then(function(){copyBtn.textContent='Copied!'}).catch(function(){copyBtn.textContent='Select the code'})}
      else{var el=document.getElementById('zs-native-signup-code');if(el){var sel=window.getSelection();var range=document.createRange();range.selectNodeContents(el);sel.removeAllRanges();sel.addRange(range);copyBtn.textContent='Code selected'}}
    });
  }
  if(success){set(signedKey,'1');show();return}
  if(error){show();return}
  if(root.getAttribute('data-already-subscribed')==='true'||get(signedKey)==='1')return;
  var dismissed=Number(get(dismissedKey)||'0');
  if(dismissed&&Date.now()-dismissed<7*24*60*60*1000)return;
  if(window.Shopify&&window.Shopify.designMode)return;
  window.setTimeout(function(){if(!document.hidden&&!root.querySelector('[data-zs-signup-success]'))show()},6500);
})();
</script>
